interface IERC20 {
    function totalSupply() external view returns (uint256);
    function transfer(address recipient, uint amount) external returns (bool);
    function decimals() external view returns (uint8);
    function symbol() external view returns (string memory);
    function balanceOf(address) external view returns (uint);
    function transferFrom(address sender, address recipient, uint amount) external returns (bool);
    function allowance(address owner, address spender) external view returns (uint);
    function approve(address spender, uint value) external returns (bool);

    event Transfer(address indexed from, address indexed to, uint value);
    event Approval(address indexed owner, address indexed spender, uint value);
}

interface IRouter {
    function pairFor(address tokenA, address tokenB, bool stable) external view returns (address pair);
    function swapExactTokensForTokensSimple(uint amountIn, uint amountOutMin, address tokenFrom, address tokenTo, bool stable, address to, uint deadline) external returns (uint[] memory amounts);
    function getAmountOut(uint amountIn, address tokenIn, address tokenOut, bool stable) external view returns (uint amount);
	function getReserves(address tokenA, address tokenB, bool stable) external view returns (uint, uint);
    function addLiquidity(
        address tokenA,
        address tokenB,
        bool stable,
        uint amountADesired,
        uint amountBDesired,
        uint amountAMin,
        uint amountBMin,
        address to,
        uint deadline
    ) external returns (uint, uint, uint);
}

interface IOptionToken {
    function mint(address _to, uint256 _amount) external;
    function exercise(
        uint256 _amount,
        uint256 _maxPaymentAmount,
        address _recipient
    ) external returns (uint256);
    function paymentToken() external returns (address);
    function underlyingToken() external returns (address);
    function getDiscountedPrice(uint256 _amount) external view returns (uint256);
}

/**
 * @title BuyBackAndBurnOTokenStrategy
 * @dev A strategy contract for buying back and burning the underlying token of an option token.
 * Receives paymentTokens from option revenue, buys back and burns the underlying token, and if 
 * a ratio is set, will also send revenue to treasury.
 */
contract BuyBackAndBurnOTokenStrategy is Ownable, ReentrancyGuard {
    address constant burnAddress = 0x000000000000000000000000000000000000dEaD;

    address public treasury;
    address public optionToken;
    address public router;
    address public paymentToken;
    address public underlyingToken;

    uint256 public ratio = 80; // actual % of how much paymentTokens will swap for underlyingTokens

    event Disperse(
        uint256 paymentTokenSwapped,
        uint256 underlyingTokenBurned,
        uint256 treasuryAmountTransferred
    );

    /**
     * @dev Sets initial values for the strategy.
     * @param _treasury Address of the treasury.
     * @param _optionToken Address of the option token.
     * @param _router Address of the router.
     */
    constructor(address _treasury ,address _optionToken, address _router) {
        treasury = _treasury;
        router = _router;
        optionToken = _optionToken;
        paymentToken = IOptionToken(optionToken).paymentToken();
        underlyingToken = IOptionToken(optionToken).underlyingToken();
        giveAllowances();
    }

    /**
     * @dev Sets a new treasury address.
     * @param _treasury The address of the new treasury.
     */
    function setTreasury(address _treasury) external onlyOwner {
        require (_treasury != address(0));
        treasury = _treasury;
    }

    /**
     * @dev Sets a new router address.
     * @param _router The address of the new router.
     */
    function setRouter(address _router) external onlyOwner {
        require (_router != address(0));
        router = _router;
    }

    /**
     * @dev Sets the ratio of payment tokens to be swapped.
     * @param _ratio The new ratio.
     */
    function setRatio(uint256 _ratio) external onlyOwner {
        ratio = _ratio;
    }

    /**
     * @dev Returns the balance of the underlying token held by the contract.
     * @return The balance of the underlying token.
     */
    function balanceOfUnderlyingToken() public view returns (uint){
        return IERC20(underlyingToken).balanceOf(address(this));
    }

    /**
     * @dev Returns the balance of the payment token held by the contract.
     * @return The balance of the payment token.
     */
    function balanceOfPaymentToken() public view returns (uint){
        return IERC20(paymentToken).balanceOf(address(this));
    }

    /**
     * @dev Allows the owner to retrieve tokens that get stuck in the contract.
     * @param _token The address of the token to retrieve.
     * @param _to The address where to send the retrieved tokens.
     */
    function inCaseTokensGetStuck(address _token, address _to) external onlyOwner {
        uint256 amount = IERC20(_token).balanceOf(address(this));
        IERC20(_token).transfer(_to, amount);
    }

    /**
     * @dev Sets maximum router allowance for the payment token.
     */
    function giveAllowances() public onlyOwner {
        IERC20(paymentToken).approve(router, type(uint256).max);
    }

    /**
     * @dev Revokes router allowance for the payment token.
     */
    function removeAllowances() external onlyOwner {
        IERC20(paymentToken).approve(router, 0);
    }

    /**
     * @dev Executes the strategy to swap payment tokens for underlying tokens of oToken and burns them.
     * Swaps a portion of the payment tokens for underlying tokens based on the set ratio, then burns the underlying tokens.
     * The remaining payment tokens are sent to treasury.
     */
    function disperse() public nonReentrant {
        uint256 paymentTokenBal = balanceOfPaymentToken();
        uint256 paymentTokenToSwap;
        uint256 underlyingTokenBal;
        if (ratio > 0) {
            paymentTokenToSwap = paymentTokenBal * ratio / 100;

            IRouter(router).swapExactTokensForTokensSimple(paymentTokenToSwap, 1, paymentToken, underlyingToken, false, address(this), block.timestamp);
            
            paymentTokenBal = balanceOfPaymentToken();
            underlyingTokenBal = balanceOfUnderlyingToken();

            IERC20(underlyingToken).transfer(burnAddress, underlyingTokenBal);
        }

        IERC20(paymentToken).transfer(treasury, paymentTokenBal);

        emit Disperse(paymentTokenToSwap, underlyingTokenBal, paymentTokenBal);
    }
}