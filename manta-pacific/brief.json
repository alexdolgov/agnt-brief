  "topography": {
    "project_purpose": "Manta Pacific is a Layer 2 scaling solution for Ethereum that uses the OP Stack to enable fast and low-cost transactions. It provides a canonical bridge for transferring assets between Ethereum and the Manta Pacific network.",
