     *
     * Requirements:
     *
     * - `spender` cannot be the zero address.
     * - `spender` must have allowance for the caller of at least
     * `subtractedValue`.
     */
    function decreaseAllowance(
        address spender,
        uint256 subtractedValue
    ) public returns (bool) {
        (bool success, uint256 newAllowance) = Math.trySub(
            _allowances[_msgSender()][spender],
            subtractedValue
        );
        require(success, "BEP20: decreased allowance below zero");
        _approve(_msgSender(), spender, newAllowance);
        return true;
    }

    /**
