        depositAsset.safeIncreaseAllowance(vault, depositAmount);

        // Deposit and obtain vault shares.
        uint256 shares = teller.bulkDeposit(
            depositAsset,
            depositAmount,
            minimumMint,
            owner
        );

        bytes memory ret = abi.encode(shares);
        return ret;
    }
}

