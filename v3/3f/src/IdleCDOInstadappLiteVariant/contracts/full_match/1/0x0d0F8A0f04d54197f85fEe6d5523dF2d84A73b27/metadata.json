ount` of `token`","params":{"_amount":"amount of `token` to deposit"},"returns":{"_0":"BB tranche tokens minted"}},"depositBBRef(uint256,address)":{"details":"msg.sender should approve this contract first to spend `_amount` of `token`","params":{"_amount":"amount of `token` to deposit","_referral":"address of the referral"},"returns":{"_0":"BB tranche tokens minted"}},"emergencyShutdown()":{"details":"can be called by both the owner and the guardian"},"getApr(address)":{"params":{"_tranche":"tranche address"},"returns":{"_0":"actual apr given current ratio between AA and BB tranches"}},"getContractValue()":{"details":"unclaimed rewards (gov tokens) and `unclaimedFees` are not counted.  Harvested rewards are counted only if enough blocks have passed (`_lockedRewards`)"},"getCurrentAARatio()":{"details":"_virtualBalance is used to have a more accurate/recent value for the AA ratio because it calculates the balance after splitting the accrued interest since the last depositXX/withdrawXX/harvest","returns":{"_0":"AA tranches ratio (in underlying value) considering all interest"}},"getIncentiveTokens()":{"returns":{"_0":"array with addresses of incentiveTokens (can be empty)"}},"harvest(bool[],bool[],uint256[],uint256[],bytes[])":{"details":"can be called only by the rebalancer or the owner","params":{"_extraData":"bytes to be passed to the redeemRewards call","_minAmount":"array of min amounts for uniswap trades. Lenght should be equal to the _skipReward array","_sellAmounts":"array of amounts (of reward tokens) to sell on uniswap. Lenght should be equal to the _minAmount array if a sellAmount is 0 the whole contract balance for that token is swapped","_skipFlags":"array of flags, [0] = skip reward redemption, [1] = skip incentives update, [2] = skip fee deposit, [3] = skip all","_skipReward":"array of flags for skipping the market sell of specific rewards. Length should be equal to the `IIdleCDOStrategy(strategy).getRewardTokens()` array"},"returns":{"_res":"array of arrays with the following elements:   [0] _soldAmounts array with amounts of rewards actually sold   [1] _swappedAmounts array with amounts of _token actually bought   [2] _redeemedRewards array with amounts of rewards redeemed"}},"initialize(uint256,address,address,address,address,address,uint256,uint256,address[])":{"details":"Initialize the upgradable contract","params":{"":"// deprecated _incentiveTokens array of addresses for incentive tokens","_governanceFund":"address where funds will be sent in case of emergency","_guardedToken":"underlying token","_limit":"contract value limit, can be 0","_owner":"guardian address (can pause, unpause and call emergencyShutdown)","_rebalancer":"rebalancer address","_strategy":"strategy address","_trancheAPRSplitRatio":"trancheAPRSplitRatio value"}},"liquidate(uint256,bool)":{"details":"can be called only by the rebalancer or the owner","params":{"_amount":"in underlyings to liquidate from lending provider","_revertIfNeeded":"flag to revert if amount liquidated is too low"},"returns":{"_0":"liquidated amount in underlyings"}},"owner()":{"details":"Returns the address of the current owner."},"pause()":{"details":"can be called by both the owner and the guardian"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"restoreOperations()":{"details":"can be called by the owner only"},"setAllowAAWithdraw(bool)":{"params":{"_allowed":"flag to allow AA withdraws"}},"setAllowBBWithdraw(bool)":{"params":{"_allowed":"flag to allow BB withdraws"}},"setFee(uint256)":{"params":{"_fee":"new fee"}},"setFeeReceiver(address)":{"params":{"_feeReceiver":"new fee receiver address"}},"setGuardian(address)":{"params":{"_guardian":"new guardian (pauser) address"}},"setIsAYSActive(bool)":{"params":{"_active":"flag to allow Adaptive Yield Split"}},"setLiquidationTolerance(uint256)":{"params":{"_diff":"max liquidation diff tolerance in underlyings"}},"setLiquidationToleranceBps(uint256)":{"params":{"_diffBps":"tolerance in % (FULL_ALLOC = 100%) for allowing loss on redeems for msg.sender "}},"setLossToleranceBps(uint256)":{"params":{"_diffBps":"tolerance in % (FULL_ALLOC = 100%) for socializing small losses "}},"setMaxDecreaseDefault(uint256)":{"details":"automatically reverts if strategyPrice decreased more than `_maxDecreaseDefault`","params":{"_maxDecreaseDefault":"max value, in % where `100000` = 100%, of accettable price decrease for the strategy"}},"setMinAprSplitAYS(uint256)":{"params":{"_aprSplit":"min apr split for AA, considering FULL_ALLOC = 100%"}},"setRebalancer(address)":{"params":{"_rebalancer":"new rebalancer address"}},"setReleaseBlocksPeriod(uint256)":{"params":{"_releaseBlocksPeriod":"new # of blocks after an harvest during which harvested rewards gets progressively redistriburted to users"}},"setRevertIfTooLow(bool)":{"params":{"_allowed":"flag to enable the check if redeemed amount during liquidations is enough"}},"setSkipDefaultCheck(bool)":{"params":{"_allowed":"flag to enable the 'default' check (whether _strategyPrice decreased or not)"}},"setStkIDLEPerUnderlying(uint256)":{"params":{"_val":"stkIDLE per underlying required for deposits"}},"setTrancheAPRSplitRatio(uint256)":{"params":{"_trancheAPRSplitRatio":"new apr split ratio"}},"setUnlentPerc(uint256)":{"params":{"_unlentPerc":"new unlent percentage"}},"tranchePrice(address)":{"params":{"_tranche":"tranche address"},"returns":{"_0":"tranche price, in underlyings, at the last interaction (not considering interest earned  since last interaction)"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"transferToken(address,uint256)":{"params":{"_token":"address of the token to transfer","_value":"amount to transfer"}},"unpause()":{"details":"can be called by both the owner and the guardian"},"virtualPrice(address)":{"params":{"_tranche":"address of the requested tranche"},"returns":{"_virtualPrice":"tranche price considering all interest/losses"}},"withdrawAA(uint256)":{"params":{"_amount":"amount of AA tranche tokens to burn"},"returns":{"_0":"underlying tokens redeemed"}},"withdrawBB(uint256)":{"params":{"_amount":"amount of BB tranche tokens to burn"},"returns":{"_0":"underlying tokens redeemed"}}},"stateVariables":{"liquidationToleranceBps":{"details":"relative to the amount to liquidate"}},"title":"IdleCDO variant for instadapp iETHv2, which can handle a withdraw fee ","version":1},"userdoc":{"kind":"user","methods":{"_setLimit(uint256)":{"notice":"set contract TVL limit"},"depositAA(uint256)":{"notice":"pausable"},"depositAARef(uint256,address)":{"notice":"pausable"},"depositBB(uint256)":{"notice":"pausable in _deposit"},"depositBBRef(uint256,address)":{"notice":"pausable in _deposit"},"emergencyShutdown()":{"notice":"pause deposits and redeems for all classes of tranches"},"getContractValue()":{"notice":"calculates the current net TVL (in `token` terms)"},"getCurrentAARatio()":{"notice":"calculates the current AA tranches ratio"},"getIncentiveTokens()":{"notice":"[DEPRECATED]"},"harvest(bool[],bool[],uint256[],uint256[],bytes[])":{"notice":"This method is used to lend user funds in the lending provider through an IIdleCDOStrategy The method: - redeems rewards (if any) from the lending provider - converts the rewards in underlyings through uniswap v2 or v3 - calls _updateAccounting to update the accounting of the system with the new underlyings received - it then convert fees in tranche tokens - finally it deposits the (initial unlent balance + the underlyings get from uniswap - fees) in the   lending provider through the IIdleCDOStrategy `deposit` call The method will be called by an external, whitelisted, keeper bot which will call the method sistematically (eg once a day)"},"initialize(uint256,address,address,address,address,address,uint256,uint256,address[])":{"notice":"can only be called once"},"liquidate(uint256,bool)":{"notice":"method used to redeem underlyings from the lending provider"},"pause()":{"notice":"Pauses deposits"},"restoreOperations()":{"notice":"allow deposits and redeems for all classes of tranches"},"transferToken(address,uint256)":{"notice":"Emergency method, tokens gets transferred to the governanceRecoveryFund address"},"unpause()":{"notice":"Unpauses deposits"},"updateAccounting()":{"notice":"this method updates the accounting of the contract and effectively splits the yield/loss between the AA and BB tranches. This can be called at any time as is called automatically on each deposit/redeem. It's here just to be called when a default happened, as deposits/redeems are paused, but we need to update the loss for junior holders"},"virtualPrice(address)":{"notice":"calculates the current tranches price considering the interest/loss that is yet to be splitted ie the interest/loss generated since the last update of priceAA and priceBB (done on depositXX/withdrawXX/harvest)"},"withdrawAA(uint256)":{"notice":"pausable in _deposit"},"withdrawBB(uint256)":{"notice":"pausable"}},"version":1}},"settings":{"compilationTarget":{"contracts/IdleCDOInstadappLiteVariant.sol":"IdleCDOInstadappLiteVariant"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":170},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol":{"keccak256":"0x4075622496acc77fd6d4de4cc30a8577a744d5c75afad33fdeacf1704d6eda98","license":"MIT","urls":["bzz-raw://99c8cb3cd19a44bbfb6612605affb7d8b06cee1f6aa9362a37a8672b4f7eeaf8","dweb:/ipfs/QmasyxFDBUp7k5KFgfDWEzM8PYSKEq7GVznzMJ1VxVRF4B"]},"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.