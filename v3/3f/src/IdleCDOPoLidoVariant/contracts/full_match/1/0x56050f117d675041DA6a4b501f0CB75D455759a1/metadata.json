t","returns":{"_0":"AA tranches ratio (in underlying value) considering all interest"}},"getIncentiveTokens()":{"returns":{"_0":"array with addresses of incentiveTokens (can be empty)"}},"harvest(bool[],bool[],uint256[],uint256[],bytes)":{"details":"can be called only by the rebalancer or the owner","params":{"_extraData":"bytes to be passed to the redeemRewards call","_minAmount":"array of min amounts for uniswap trades. Lenght should be equal to the _skipReward array","_sellAmounts":"array of amounts (of reward tokens) to sell on uniswap. Lenght should be equal to the _minAmount array if a sellAmount is 0 the whole contract balance for that token is swapped","_skipFlags":"array of flags, [0] = skip reward redemption, [1] = skip incentives update, [2] = skip fee deposit, [3] = skip all","_skipReward":"array of flags for skipping the market sell of specific rewards. Length should be equal to the `IIdleCDOStrategy(strategy).getRewardTokens()` array"},"returns":{"_res":"array of arrays with the following elements:   [0] _soldAmounts array with amounts of rewards actually sold   [1] _swappedAmounts array with amounts of _token actually bought   [2] _redeemedRewards array with amounts of rewards redeemed"}},"initialize(uint256,address,address,address,address,address,uint256,uint256,address[])":{"details":"Initialize the upgradable contract","params":{"":"// deprecated","_governanceFund":"address where funds will be sent in case of emergency","_guardedToken":"underlying token","_incentiveTokens":"array of addresses for incentive tokens","_limit":"contract value limit, can be 0","_owner":"guardian address (can pause, unpause and call emergencyShutdown)","_rebalancer":"rebalancer address","_strategy":"strategy address","_trancheAPRSplitRatio":"trancheAPRSplitRatio value"}},"liquidate(uint256,bool)":{"details":"can be called only by the rebalancer or the owner","params":{"_amount":"in underlyings to liquidate from lending provider","_revertIfNeeded":"flag to revert if amount liquidated is too low"},"returns":{"_0":"liquidated amount in underlyings"}},"owner()":{"details":"Returns the address of the current owner."},"pause()":{"details":"can be called by both the owner and the guardian"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"restoreOperations()":{"details":"can be called by the owner only"},"setAllowAAWithdraw(bool)":{"params":{"_allowed":"flag to allow AA withdraws"}},"setAllowBBWithdraw(bool)":{"params":{"_allowed":"flag to allow BB withdraws"}},"setFee(uint256)":{"params":{"_fee":"new fee"}},"setFeeReceiver(address)":{"params":{"_feeReceiver":"new fee receiver address"}},"setGuardian(address)":{"params":{"_guardian":"new guardian (pauser) address"}},"setIncentiveTokens(address[])":{"details":"it's REQUIRED to transfer out any incentive tokens accrued before","params":{"_incentiveTokens":"array with new incentive tokens"}},"setIsAYSActive(bool)":{"params":{"_active":"flag to allow Adaptive Yield Split"}},"setRebalancer(address)":{"params":{"_rebalancer":"new rebalancer address"}},"setReleaseBlocksPeriod(uint256)":{"params":{"_releaseBlocksPeriod":"new # of blocks after an harvest during which harvested rewards gets progressively redistriburted to users"}},"setRevertIfTooLow(bool)":{"params":{"_allowed":"flag to enable the check if redeemed amount during liquidations is enough"}},"setSkipDefaultCheck(bool)":{"params":{"_allowed":"flag to enable the 'default' check (whether _strategyPrice decreased or not)"}},"setStakingRewards(address,address)":{"params":{"_AAStaking":"IdleCDOTrancheRewards contract address for AA tranches","_BBStaking":"IdleCDOTrancheRewards contract address 