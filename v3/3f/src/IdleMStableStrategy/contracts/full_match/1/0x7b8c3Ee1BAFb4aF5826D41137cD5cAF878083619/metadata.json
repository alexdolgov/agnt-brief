he zero address. - `sender` must have a balance of at least `amount`. - the caller must have allowance for ``sender``'s tokens of at least `amount`."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."}},"title":"IdleMStableStrategy","version":1},"userdoc":{"kind":"user","methods":{"YEAR()":{"notice":"one year, used to calculate the APR"},"changeUniswapRouterPath(address[])":{"notice":"Change the uniswap router path"},"claimGovernanceTokens(uint256)":{"notice":"Claim governance tokens"},"deposit(uint256)":{"notice":"Deposit the underlying token to vault"},"getApr()":{"notice":"Approximate APR"},"getRewardTokens()":{"notice":"Get the reward token"},"govToken()":{"notice":"address of the governance token. (Here META)"},"idleCDO()":{"notice":"address of the IdleCDO"},"imUSD()":{"notice":"idleToken contract"},"initialize(address,address,address,address,address[],address)":{"notice":"Can be called only once"},"lastApr()":{"notice":"latest saved apr"},"lastIndexAmount()":{"notice":"amount last indexed for calculating APR"},"lastIndexedTime()":{"notice":"time when last deposit/redeem was made, used for calculating the APR"},"latestHarvestBlock()":{"notice":"latest harvest"},"oneToken()":{"notice":"one underlying token"},"price()":{"notice":"net price in underlyings of 1 strategyToken"},"pullStkAAVE()":{"notice":"unused in MStable Strategy"},"redeem(uint256)":{"notice":"Redeem Tokens"},"redeemRewards()":{"notice":"redeem the rewards. Claims all possible rewards"},"redeemRewards(bytes)":{"notice":"redeem the rewards. Claims reward as per the _extraData"},"redeemUnderlying(uint256)":{"notice":"Redeem Tokens"},"releaseBlocksPeriod()":{"notice":"harvested imUSD tokens release delay"},"rewardLastRound()":{"notice":"round for which the last reward is claimed"},"setReleaseBlocksPeriod(uint256)":{"notice":"allow to update whitelisted address"},"setWhitelistedCDO(address)":{"notice":"a