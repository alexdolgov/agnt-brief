entBalanceScaled()":{"notice":"Get the total amount of collaterals available scaled to 18 decimals"},"getYieldSource(address)":{"notice":"Get the yield source for a given address."},"initialize(address,address,address,address,address[])":{"notice":"Initializer (replaces constructor for upgradeable contracts)."},"isParetoDollarCollateralized()":{"notice":"Check if ParetoDollar is fully collateralized (with a threshold)"},"isPausable()":{"notice":"Check if the contract is pausable."},"par()":{"notice":"ParetoDollar contract."},"pause()":{"notice":"Pauser can pause the contract in emergencies."},"redeemFunds(address[],bytes4[],bytes[],uint256)":{"notice":"Redeem funds from yield sources."},"removeYieldSource(address)":{"notice":"Remove yield source."},"requestRedeem(address,uint256)":{"notice":"allow the ParetoDollar contract to request collateral tokens from this contract"},"sPar()":{"notice":"ParetoDollarStaking contract."},"stopEpoch()":{"notice":"Increment the epoch number so to freeze the amount of pending requests."},"totCreditVaultsRequestedScaled()":{"notice":"total amount of collaterals requested from Credit Vaults (scaled to 18 decimals)"},"totReservedWithdrawals()":{"notice":"total amount of USP burned for withdrawals and not yet redeemed this values is equal to the amount of collaterals requested by the user  only when the system is fully collateralized"},"unpause()":{"notice":"Owner can unpause the contract."},"updateYieldSource(address,uint256,(bytes4,uint8)[])":{"notice":"Update yield source."},"userWithdrawalsEpochs(address,uint256)":{"notice":"mapping of withdraw requests per user per epoch"},"yieldSources(address)":{"notice":"mapping of yield sources by address."}},"version":1}},"settings":{"compilationTarget":{"src/ParetoDollarQueue.sol":"ParetoDollarQueue"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":9999},"remappings":[":@openzeppelin/contracts-upgradeable/=node_modules/@openzeppelin/co