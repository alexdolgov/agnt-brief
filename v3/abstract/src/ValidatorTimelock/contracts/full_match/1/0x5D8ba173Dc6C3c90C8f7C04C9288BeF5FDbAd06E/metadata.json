ract is to provide a trustless means of delaying batch execution without modifying the main hyperchain diamond contract. As such, even if this contract is compromised, it will not impact the main contract.zkSync actively monitors the chain activity and reacts to any suspicious activity by freezing the chain. This allows time for investigation and mitigation before resuming normal operations.The contract overloads all of the 4 methods, that are used in state transition. When the batch is committed, the timestamp is stored for it. Later, when the owner calls the batch execution, the contract checks that batch was committed not earlier than X time ago.","events":{"BlockCommit(uint256,bytes32,bytes32)":{"details":"It has the name \"BlockCommit\" and not \"BatchCommit\" due to backward compatibility considerations","params":{"batchHash":"Hash of the L2 batch","batchNumber":"Number of the batch committed","commitment":"Calculated input for the zkSync circuit"}},"BlockExecution(uint256,bytes32,bytes32)":{"details":"It has the name \"BlockExecution\" and not \"BatchExecution\" due to backward compatibility considerations","params":{"batchHash":"Hash of the L2 batch","batchNumber":"Number of the batch executed","commitment":"Verified input for the zkSync circuit"}},"BlocksRevert(uint256,uint256,uint256)":{"details":"It has the name \"BlocksRevert\" and not \"BatchesRevert\" due to backward compatibility considerations","params":{"totalBatchesCommitted":"Total number of committed batches after the revert","totalBatchesExecuted":"Total number of executed batches","totalBatchesVerified":"Total number of verified batches after the revert"}},"BlocksVerification(uint256,uint256)":{"details":"It has the name \"BlocksVerification\" and not \"BatchesVerification\" due to backward compatibility considerations","params":{"currentLastVerifiedBatch":"Batch number of the current last verified batch","previousLastVerifiedBatch":"Batch number of the previous last verified batch"}}},"kind":"dev","methods":{"acceptOwnership()":{"details":"The new owner accepts the ownership transfer."},"addValidator(uint256,address)":{"details":"Sets an address as a validator."},"commitBatches((uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32),(uint64,uint64,uint64,bytes32,uint256,bytes32,bytes32,bytes32,bytes,bytes)[])":{"details":"Records the timestamp for all provided committed batches and make a call to the hyperchain diamond contract with the same calldata."},"commitBatchesSharedBridge(uint256,(uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32),(uint64,uint64,uint64,bytes32,uint256,bytes32,bytes32,bytes32,bytes,bytes)[])":{"details":"Records the timestamp for all provided committed batches and make a call to the hyperchain diamond contract with the same calldata."},"executeBatches((uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32)[])":{"details":"Check that batches were committed at least X time ago and make a call to the hyperchain diamond contract with the same calldata."},"executeBatchesSharedBridge(uint256,(uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32)[])":{"details":"Check that batches were committed at least X time ago and make a call to the hyperchain diamond contract with the same calldata."},"getCommittedBatchTimestamp(uint256,uint256)":{"details":"Returns the timestamp when `_l2BatchNumber` was committed."},"owner()":{"details":"Returns the address of the current owner."},"pendingOwner()":{"details":"Returns the address of the pending owner."},"proveBatches((uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32),(uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32)[],(uint256[],uint256[]))":{"details":"Make a call to the hyperchain diamond contract with the same calldata. Note: We don't track the time when batches are proven, since all information about the batch is known on the commit stage and the proved is not finalized (may be reverted)."},"proveBatchesSharedBridge(uint256,(uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32),(uint64,bytes32,uint64,uint256,bytes32,bytes32,uint256,bytes32)[],(uint256[],uint256[]))":{"details":"Make a call to the hyperchain diamond contract with the same calldata. Note: We don't track the time when batches are proven, since all information about the batch is known on the commit stage and the proved is not finalized (may be reverted)."},"removeValidator(uint256,address)":{"details":"Removes an address as a validator."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"revertBatches(uint256)":{"details":"Make a call to the hyperchain diamond contract with the same calldata. Note: If the batch is reverted, it needs to be committed first before the execution. So it's safe to not override the committed batches."},"revertBatchesSharedBridge(uint256,uint256)":{"details":"Make a call to the hyperchain diamond contract with the same calldata. Note: If the batch is reverted, it needs to be committed first before the execution. So it's safe to not override the committed batches."},"setExecutionDelay(uint32)":{"details":"Set the delay between committing and executing batches."},"setStateTransitionManager(address)":{"details":"Sets a new state transition manager."},"transferOwnership(address)":{"details":"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner."}},"stateVariables":{"ERA_CHAIN_ID":{"details":"Era's chainID"},"committedBatchTimestamp":{"details":"The mapping of L2 chainId => batch number => timestamp when it was committed."},"executionDelay":{"details":"The delay between committing and executing batches."},"getName":{"details":"Part of the IBase interface. Not used in this contract."},"stateTransitionManager":{"details":"The stateTransitionManager smart contract."},"validators":{"details":"The address that can commit/revert/validate/execute batches."}},"version":1},"userdoc":{"errors":{"AddressAlreadyValidator(uint256)":[{"notice":"Error for when an address is already a validator."}],"ValidatorDoesNotExist(uint256)":[{"notice":"Error for when an address is not a validator."}]},"events":{"BlockCommit(uint256,bytes32,bytes32)":{"notice":"Event emitted when a batch is committed"},"BlockExecution(uint256,bytes32,bytes32)":{"notice":"Event emitted when a batch is executed"},"BlocksRevert(uint256,uint256,uint256)":{"notice":"Event emitted when batches are reverted"},"BlocksVerification(uint256,uint256)":{"notice":"Event emitted when batches are verified"},"NewExecutionDelay(uint256)":{"notice":"The delay between committing and executing batches is changed."},"ValidatorAdded(uint256,address)":{"notice":"A new validator has been added."},"ValidatorRemoved(uint256,address)":{"notice":"A validator has been removed."}},"kind":"user","methods":{},"notice":"Intermediate smart contract between the validator EOA account and the hyperchains state transition diamond smart contract.","version":1}},"settings":{"compilationTarget":{"contracts/state-transition/ValidatorTimelock.sol":"ValidatorTimelock"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":9999999},"remappings":[]},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0xba43b97fba0d32eb4254f6a5a297b39a19a247082a02d6e69349e071e2946218","license":"MIT","urls":["bzz-raw://fc980984badf3984b6303b377711220e067722bbd6a135b24669ff5069ef9f32","dweb:/ipfs/QmPHXMSXj99XjSVM21YsY6aNtLLjLVXDbyN76J5HQYvvrz"]},"@openzeppelin/contracts/access/Ownable2Step.sol":{"keccak256":"0xde231558366826d7cb61725af8147965a61c53b77a352cc8c9af38fc5a92ac3c","license":"MIT","urls":["bzz-raw://1fd55624076bf61d44af5ff351919e32dda748