e llamaPayCount is zero."}],"AeraPeriphery__StreamDoesNotExist(address,address,uint216)":[{"details":"Thrown when stream does not exist."}],"AeraPeriphery__StreamNotExpired(uint256)":[{"details":"Thrown when the endDate is in the future when trying to cancel stream or stream does not exist."}],"SafeCastOverflowedIntToUint(int256)":[{"details":"An int value doesn't fit in an uint of `bits` size."}],"SafeCastOverflowedUintToInt(uint256)":[{"details":"An uint value doesn't fit in an int of `bits` size."}]},"events":{"ExpiringStreamCreated(address,address,uint216,uint256)":{"details":"Emitted when a new LlamaPay stream is created."}},"kind":"dev","methods":{"balanceOf(address)":{"details":"Returns the amount of tokens owned by `account`."},"cancelExpiredStream(address,address,uint216)":{"details":"MUST revert if endDate > block.timestamp.MUST revert if stream doesn't exist.","params":{"amountPerSec":"The amount per second of the stream. Must use 20 decimals.","to":"The address of the stream.","token":"The token of the stream."}},"cancelStream(address,address,uint216)":{"details":"MUST revert if not called by vault.MUST revert if stream doesn't exist.","params":{"amountPerSec":"The amount per second of the stream. Must use 20 decimals.","to":"The address of the stream.","token":"The token of the stream."}},"createStream(address,address,uint216,uint256)":{"details":"MUST revert if not called by vault.MUST revert if endDate ≤ block.timestamp.MUST revert if token is not part of a supported LlamaPay contract.","params":{"amountPerSec":"The amount per second of the stream. Must use 20 decimals.","duration":"Duration of the stream in seconds.","to":"The address of the stream.","token":"The token of the stream."}},"decimals()":{"returns":{"_0":"decimals The number of decimals."}},"deposit(address,uint256)":{"details":"MUST revert if not called by vault.MUST revert if stream doesn't exist.","params":{"amount":"The amount to deposit.","token":"The token to deposit."}},"depositAndCreate(address,uint256,address,uint216,uint256)":{"details":"MUST revert if not called by vault.MUST revert if endDate ≤ block.timestamp.MUST revert if stream doesn't exist.","params":{"amountPerSec":"The amount per second to send. Must use 20 decimals.","amountToDeposit":"The amount to deposit.","duration":"Duration of the stream in seconds.","to":"The address to send the stream to.","token":"The token to deposit."}},"endDate(address,address,uint216)":{"params":{"amountPerSec":"The amount per second of the stream. Must use 20 decimals.","to":"The address of the stream.","token":"The token of the stream."},"returns":{"_0":"endDate The end date of the stream."}},"execute((address,uint256,bytes)[])":{"params":{"operations":"The operations to execute."}},"latestRoundData()":{"returns":{"answer":"The price.","answeredInRound":"Optional, doesn't apply to non-Chainlink oracles.","roundId":"Optional, doesn't apply to non-Chainlink oracles.","startedAt":"Optional, doesn't apply to non-Chainlink oracles.","updatedAt":"The most recent timestamp the price was updated"}},"llamaPayInfoList()":{"returns":{"_0":"llamaPayInfoList The LlamaPay Info list."}},"modifyStream(address,address,uint216,address,uint216,uint256)":{"details":"MUST revert if not called by vault.MUST revert if endDate ≤ block.timestamp.MUST revert if stream doesn't exist.","params":{"amountPerSec":"The new amount per second of the stream. Must use 20 decimals.","duration":"Duration of the stream in seconds.","oldAmountPerSec":"The amount per second of the stream. Must use 20 decimals.","oldTo":"The address of the stream.","to":"The new address of the stream.","token":"The token of the stream."}},"pauseStream(address,address,uint216)":{"details":"MUST revert if not called by vault.MUST revert if stream doesn't exist.","params":{"amountPerSec":"The amount per second of the stream. Must use 20 decimals.","to":"The address of the stream.","token":"The token of the stream."}},"totalSupply()":{"details":"Returns the amount of tokens in existence."},"transfer(address,uint256)":{"details":"When called by the vault, this function burns      the token and makes this token unusable."},"vault()":{"returns":{"_0":"vault The Vault address."}},"withdrawPayer(address,uint256)":{"details":"MUST revert if not called by vault.","params":{"amount":"The amount to withdraw. Must use 20 decimals.","token":"The token to withdraw."}},"withdrawPayerAll(address)":{"details":"MUST revert if not called by vault.","params":{"token":"The token to withdraw."}}},"title":"LlamaPayRouterOracle.","version":1},"userdoc":{"errors":{"AeraPeriphery__ApprovalsAreNotAllowed()":[{"notice":"Thrown when a user tries to approve."}],"AeraPeriphery__ExecutionFailed(bytes)":[{"notice":"Error emitted when the execution of an operation fails."}],"AeraPeriphery__InvalidPrice(address,int256)":[{"notice":"Thrown when the price <= 0."}],"AeraPeriphery__TransfersAreNotAllowed()":[{"notice":"Thrown when a user tries to transfer tokens."}],"AeraPeriphery__VaultIsZeroAddress()":[{"notice":"Thrown when the vault address is zero."}]},"events":{"Executed(address,(address,uint256,bytes))":{"notice":"Emitted when operations are executed."}},"kind":"user","methods":{"burned()":{"notice":"Flag to check if the token is burned."},"cancelExpiredStream(address,address,uint216)":{"notice":"Cancel a given stream if block.timestamp ≥ endDate for that stream."},"cancelStream(address,address,uint216)":{"notice":"Cancel a given stream. Just calls the same function on LlamaPay."},"constructor":{"notice":"The constructor for the LlamaPayRouterOracle. The contract does not check for LlamaPay contract duplicates.It is deployer responsibility to ensure that there are no LlamaPay contract duplicates in provided llamaPayInfoList."},"createStream(address,address,uint216,uint256)":{"notice":"Creates a LlamaPay stream and remembers the end date."},"decimals()":{"notice":"Because this contract is oracle and ERC20 token at the same time,         this function represent decimals for oracle price and token decimals."},"deposit(address,uint256)":{"notice":"Forwards a deposit on behalf of vault."},"depositAndCreate(address,uint256,address,uint216,uint256)":{"notice":"Creates a LlamaPay stream with a deposit and remembers the end date."},"endDate(address,address,uint216)":{"notice":"Returns the end date of a given stream."},"execute((address,uint256,bytes)[])":{"notice":"Execute arbitrary actions."},"latestRoundData()":{"notice":"Returns the latest price."},"llamaPayCount()":{"notice":"Number of LlamaPay contracts."},"llamaPayInfoList()":{"notice":"Returns the LlamaPay Info list."},"modifyStream(address,address,uint216,address,uint216,uint256)":{"notice":"Modifies an existing LlamaPay stream."},"name()":{"notice":"Name of ERC20 token."},"pauseStream(address,address,uint216)":{"notice":"Pause a given stream. Just calls the same function on LlamaPay."},"symbol()":{"notice":"Symbol of ERC20 token."},"vault()":{"notice":"Returns Vault address."},"withdrawPayer(address,uint256)":{"notice":"Recover money back to vault."},"withdrawPayerAll(address)":{"notice":"Recover all money back to vault."}},"notice":"An router/oracle that calculates the value of LlamaPay streams.         The router/oracle can create, cancel, pause, modify, deposit and withdraw LlamaPay streams.Note 1: The contract does not check for LlamaPay contract duplicates in constructor.Note 2: All \"amountPerSec\" arguments should use 20 decimals.Note 3: In the withdrawPayer() function, \"amount\" argument should use 20 decimals.### Audit Note: L-01 Vault Value Can Go Below Daily Lower BoundSince a withdrawal action by the beneficiary of a LlamaPay instance does not affect the daily         multiplier of a vault, the value locked within a vault over any 24-hour period can reach a lower         value than would be expected, given the `minDailyValue`.         Assume the following scenario:         * The vault holds `X` amount of value and has a `minDailyValue` multiplier of `0.9`.         * There is `Y = 0.03 * X` amount of value sitting in a LlamaPay contract managed by         the `LlamaPayRouterOracle` contract.         * The beneficiary of the LlamaPay stream withdraws `Y` value. Now there is `X - Y =         0.97 * X` value in the vault, but the `cumulativeDailyMultiplier` stays at `1`.         * The guardian submits a batch of actions which reduces the amount of value in the vault         by `0.09 * X`. This would put the vault at `0.88 * X` value which is below the         threshold of `0.9 * X`. Since the `cumulativeDailyMultiplier` did not account for         the withdrawal of funds from the LlamaPay stream, the calculation of the         `newMultiplier` in the `afterSubmit` hook results in a value greater than `0.9` and         therefore allows it. The exact calculation of `newMultiplier`         in this case is the following: `(1 * (0.88 * X)) / (0.97 * X)`,         which results in `~0.907 > 0.9`. Therefore, the daily multiplier check passes.","version":1}},"settings":{"compilationTarget":{"periphery/LlamaPayRouterOracle.sol":"LlamaPayRouterOracle"},"evmVersion":"shanghai","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@chainlink/=src/v2/dependencies/chainlink/",":@openzeppelin/=src/v2/dependencies/openzeppelin/",":@uniswap/v3-core/=lib/v3-core/",":@uniswap/v3-periphery/=lib/v3-periphery/",":forge-std/=lib/forge-std/src/",":src/=src/",":test/=test/",":v3-core/=lib/v3-core/contracts/",":v3-periphery/=lib/v3-periphery/contracts/"]},"sources":{"periphery/AbstractAssetOracle.sol":{"keccak256":"0xaf792832b56232c91a9f2141e378c4653188bff9bc7320701f78532c7df505aa","license":"BUSL-1.1","urls":["bzz-raw://6ab72956663baad85c07fb6e44e41271424d71fe9adc7eb05d355254e5de7051","dweb:/ipfs/QmY9LHEcXGoCB3WFUbWtpJdokNRZP2eKDVvfJfuW1mxaAh"]},"periphery/Executor.sol":{"keccak256":"0xc5da1b228a0a76c75a42f2721464c46a4e004ed181114d523ea0b74808bb2f00","license":"BUSL-1.1","urls":["bzz-raw