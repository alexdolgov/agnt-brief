ernalType":"address","name":"account","type":"address"},{"internalType":"uint256","name":"snapshotId","type":"uint256"}],"name":"updatePositionTo","outputs":[{"internalType":"uint256","name":"numberOfSnapshots","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address[]","name":"accounts","type":"address[]"}],"name":"updatePositions","outputs":[{"internalType":"uint256","name":"numberOfSnapshots","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"userLastDepositBlock","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"userSnapshots","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"withdrawFeeFactor","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"withdrawFeePeriod","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"receiver","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"withdrawReserve","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"Altitude Labs*","details":"Contract responsible for making snapshots of the vault's stateNote! The snapshot vault storage should be inline with SnapshotableManagerNote! because of the proxy standard(delegateCall)","kind":"dev","methods":{"claimRewards(uint256)":{"params":{"amountRequested":"Amount to be send to the user"}},"harvest(uint256)":{"details":"Adds a new harvest to the list of harvests with updated calculationsWe use error codes because critical functionality mustn't fail if harvest() reverts"},"injectBorrowAssets(uint256)":{"params":{"amount":"The sum of borrow currency to be injected"}},"injectSupply(uint256,uint256,address)":{"details":"Supply shortage could occur when committing a user for supply loss andthere is more loss than his supply balance. In that case the remainingloss will affect the last user to not be able to withdraw his deposited amount.For that reason the admins are responsible to top-up the supply directly to the lenderprovider to not affect the interest index.In case of a deposit fee or rewards they are getting distributed among the users by index","params":{"amountToInject":"supply amount to be injected","atIndex":"index we calculated amountToInject at"}},"updatePosition(address)":{"params":{"account":"User wallet address"}},"updatePositionTo(address,uint256)":{"details":"To update to the latest commit, simply provide snapshotId bigger than snapshots.length","params":{"account":"User wallet address","snapshotId":"Index the user to be commited to."}},"updatePositions(address[])":{"params":{"accounts":"User addresses"},"returns":{"numberOfSnapshots":"total number of harvests and supply losses committed"}},"withdrawReserve(address,uint256)":{"details":"Only executable by owner","params":{"amount":"amount to withdraw from the reserve","receiver":"account receiving the withdraw"}}},"title":"SnapshotableManager","version":1},"userdoc":{"kind":"user","methods":{"activeFarmStrategy()":{"notice":"Farm strategy the vault is currently using for interacting with the farm protocol "},"activeLenderStrategy()":{"notice":"Lender strategy the vault is currently using for interacting with the lending protocol "},"allowOnBehalfList(address,address)":{"notice":"Addresses (not)allowed to interact on behalf of a user "},"borrowUnderlying()":{"notice":"Debt asset "},"borrowVerifier()":{"notice":"Address of the contract that allows borrowing on behalf "},"claimRewards(uint256)":{"notice":"Claim rewards that user has earned from harvests"},"configurableManager()":{"notice":"Implementation of vault configuration logic "},"debtToken()":{"notice":"Wrapped version of borrow asset "},"harvest(uint256)":{"notice":"Snapshot the state of the vault at a given time, allowing distribution of rewards to users"},"ingressControl()":{"notice":"Ingress control rules "},"injectBorrowAssets(uint256)":{"notice":"Deposit funds directly into the farm to cover any deficit"},"injectSupply(uint256,uint256,address)":{"notice":"Add supply in the lender provider directly to cover supply shortage"},"liquidationThreshold()":{"notice":"Percentage value of borrows to supply value above which users can be liquidated "},"onBehalfFunctions(bytes4)":{"notice":"Functions onBehalf validation is disabled for "},"owner()":{"notice":"Owner of the vault(Registry)"},"snapshotSupplyLoss()":{"notice":"SupplyLoss the state of the vault at a time of supply loss, allowing distribution of supply and debt reductions to users and adjusting vault balance (especially where the vault was actively farming). Adds a new supply loss snapshot to the list of snapshots. Resets internal balances used to track interest in both tokens and lender strategy"},"snapshots(uint256)":{"notice":"Harvest & supply loss snapshots "},"supplyThreshold()":{"notice":"How much of their supply value a user can borrow up to "},"supplyToken()":{"notice":"Wrapped version of supply asset "},"supplyUnderlying()":{"notice":"Supply asset "},"swapStrategy()":{"notice":"Swap strategy the vault is using for handling supply loss event "},"targetThreshold()":{"notice":"Percentage value the vault aims to rebalance to in support of farming "},"updatePosition(address)":{"notice":"Update the user's position for all uncomitted harvests and supply losses up to now.It is payable because of deposit is payable"},"updatePositionTo(address,uint256)":{"notice":"Update the user's position for all uncomitted harvests and supply losses up to speicified id."},"updatePositions(address[])":{"notice":"Update of one or more users' positions at batch"},"userLastDepositBlock(address)":{"notice":"Block number user last deposited  "},"userSnapshots(address)":{"notice":"User last commit/snapshot ids "},"withdrawFeeFactor()":{"notice":"Withdraw fee percent "},"withdrawFeePeriod()":{"notice":"How long the withdraw fee is applied (in blocks) "},"withdrawReserve(address,uint256)":{"notice":"Withdraw collected fees from harvests"}},"version":1}},"settings":{"compilationTarget":{"altitude-v2/contracts/vaults/v1/extensions/snapshotable/SnapshotableManager.sol":"SnapshotableManager"},"evmVersion":"cancun","libraries":{"altitude-v2/contracts/libraries/utils/CommitMath.sol:CommitMath":"0x275c7db87b81b401239ed84d25e22a4f785bd50d"},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@altitude/=altitude-v2/",":@chainlink/=altitude-v2/node_modules/@chainlink/",":@eth-optimism/=altitude-v2/node_modules/@pendle/core-v2/node_modules/@eth-optimism/",":@morpho-org/=altitude-v2/node_modules/@morpho-org/",":@openzeppelin/=altitude-v2/node_modules/@openzeppelin/",":@pendle/=altitude-v2/node_modules/@pendle/",":@uniswap/=altitude-v2/node_modules/@uniswap/",":base64-sol/=altitude-v2/node_modules/base64-sol/",":forge-std/=altitude-v2/lib/forge-std/src/",":hardhat/=altitude-v2/node_modules/hardhat/"]},"sources":{"altitude-v2/contracts/interfaces/internal/access/IIngress.sol":{"keccak256":"0x9c4d58116e6f7a7fba9b9c326a4c68628c6c7dd02ef570822afc760f0433c061","license":"AGPL-3.0.","urls":["bzz-raw://341acedb28d97fa659722c54a11d4ba6c2282fdb7f9184b08f39419e4f6625e4","dweb:/ipfs/Qmaq4Wf5BQhQEfsmPBxtMHHW33xfqtgGoc7D6j9P34Jc3w"]},"altitude-v2/contracts/interfaces/internal/misc/IBorrowVerifier.sol":{"keccak256":"0x1a3222aa2a3fa5b0ccd18d096452b76c88c824dcff2d39ade51659f0c31cefd4","license":"AGPL-3.0.","urls":["bzz-raw://8b548fa5b2f80e2b19d54424a779f7ec22da888256c9cb90db3cbaea1ffe6c33","dweb:/ipfs/QmUnYcpej3oLBEcFHfYnEuD1JrDBMnbbVhSRUNUNxHbDdJ"]},"altitude-v2/contract