ss,address[],bool[],uint256[],address[],bytes[])":{"params":{"amo":"Address of the amo to receive funds from","amounts":"Amounts of each tokens we want to burn/transfer from the amo","data":"List of bytes giving additional information when withdrawing","isStablecoin":"Boolean array giving the info on whether we should burn or transfer the tokens","tokens":"Addresses of each tokens we want to burn/transfer from the AMO"}},"recoverERC20(address,address,uint256)":{"details":"Can be used to withdraw bridge tokens for them to be de-bridged on mainnet"},"removeAMO(address)":{"details":"To be successfully removed the AMO should no longer be associated to a token","params":{"amo":"Address of the AMO to be removed"}},"removeTokenRightFromAMO(address,address)":{"params":{"amo":"Address of the AMO who will lose rights on `token`","token":"Address of the `token`"}},"repayDebtFor(address[],address[],uint256[])":{"details":"Caller should have approved the `AMOMinter` contract and have enough tokens in balanceWe typically expect this function to be called by governance to balance gains and losses between AMOs","params":{"amounts":"Amounts of debt reduction to perform","tokens":"Addresses of tokens for which debt should be reduced"}},"sendToAMO(address,address[],bool[],uint256[],bytes[])":{"details":"Only an approved address for the `amo` can call this functionThis function will mint if it is called for an agToken","params":{"amo":"Address of the AMO to transfer funds to","amounts":"Amounts of tokens to be minted/transferred to the AMO","data":"List of bytes giving additional information when depositing","isStablecoin":"Boolean array giving the info whether we should mint or transfer the tokens","tokens":"Addresses of tokens we want to mint/transfer to the AMO"}},"setAMOMinter(address)":{"params":{"amoMinter":"Address of the new `amoMinter` contract"}},"setBorrowCap(address,address,uint256)":{"params":{"amo":"AMO concerned by the change","borrowCap":"New borrow cap value","token":"Token associated to the AMO"}},"setCoreBorrow(address)":{"details":"This function should typically be called on all treasury contracts after the `setCore` function has been called on the `CoreBorrow` contractOne sanity check that can be performed here is to verify whether at least the governor calling the contract is still a governor in the new core"},"toggleCallerToAMO(address,address)":{"params":{"amo":"Address of the AMO","whitelistCaller":"Address of the caller that needs right on send / receive functions associated to the AMo"}}},"title":"AMOMinter","version":1},"userdoc":{"kind":"user","methods":{"addAMO(address)":{"notice":"Adds an AMO to the whitelist"},"addTokenRightToAMO(address,address,uint256)":{"notice":"Adds right for `token` to the `amo`"},"allAMOAddresses()":{"notice":"Returns the list of all AMOs supported by this contract"},"allAMOTokens(address)":{"notice":"Returns the list of all the tokens supported by a given AMO"},"amoDebts(address,address)":{"notice":"AMO debt to the AMOMinter for a given token"},"amoList(uint256)":{"notice":"Array of all supported AMOs"},"amoTokens(address,uint256)":{"notice":"Maps each AMO to the list of tokens it currently supports"},"amosWhitelist(address)":{"notice":"Maps an AMO to whether it is whitelisted"},"amosWhitelistCaller(address,address)":{"notice":"Maps an AMO to whether an address can call the `sendToAMO`/`receiveFromAMO` functions associated to it"},"amosWhitelistToken(address,address)":{"notice":"Maps an AMO to whether it is whitelisted or not for a particular token"},"borrowCaps(address,address)":{"notice":"Max amount borrowable by each `(AMO,token)` pair"},"callerDebt(address)":{"notice":"View function returning current token debt for the msg.sender"},"coreBorrow()":{"notice":"`coreBorrow` used to check roles"},"execute(address,bytes)":{"notice":"Generic function to execute arbitrary calls with the contract"},"initialize(address)":{"notice":"Initializes the `AMOMinter` contract and the access control"},"isApproved(address)":{"notice":"Checks whether an address is approved for `msg.sender` where `msg.sender` is expected to be an AMO"},"isGovernor(address)":{"notice":"View function returning true if `admin` is the governor"},"receiveFromAMO(address,address[],bool[],uint256[],address[],bytes[])":{"notice":"Pulls tokens from an AMO"},"recoverERC20(address,address,uint256)":{"notice":"Recovers any ERC20 token"},"removeAMO(address)":{"notice":"Removes an AMO from whitelist"},"removeTokenRightFromAMO(address,address)":{"notice":"Removes the right on `token` from the `amo`"},"repayDebtFor(address[],address[],uint256[])":{"notice":"Lets someone reimburse the debt of an AMO on behalf of this AMO"},"sendToAMO(address,address[],bool[],uint256[],bytes[])":{"notice":"Sends tokens to be processed by an AMO"},"setAMOMinter(address)":{"notice":"Changes the AMOMinter contract and propagates this change to all underlying AMO contracts"},"setBorrowCap(address,address,uint256)":{"notice":"Sets the borrow cap for a given token and a given amo"},"setCoreBorrow(address)":{"notice":"Sets a new `coreBorrow` contract"},"toggleCallerToAMO(address,address)":{"notice":"Toggles the approval right for an address on an AMO"}},"notice":"Manages Algorithmic Market Operations (AMOs) of the Angle Protocol","version":1}},"settings":{"compilationTarget":{"contracts/amoMinter/AMOMinter.sol":"AMOMinter"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@chainlink/=node_modules/@chainlink/",":@ensdomains/=node_modules/@ensdomains/",":@openzeppelin/=node_modules/@openzeppelin/",":@uniswap/=node_modules/@uniswap/",":base64-sol/=node_modules/base64-sol/",":ds-test/=lib/forge-std/lib/ds-test/src/",":eth-gas-reporter/=node_modules/eth-gas-reporter/",":forge-std/=lib/forge-std/src/",":hardhat-deploy/=node_modules/hardhat-deploy/",":hardhat/=node_modules/hardhat/"]},"sources":{"contracts/amoMinter/AMOMinter.sol":{"keccak256":"0xe4646f332