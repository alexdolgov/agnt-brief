tateMutability":"view","type":"function"}],"devdoc":{"author":"Angle Labs, Inc.","details":"This contract is mostly a helper for APIs built on top of MerklThis contract distinguishes two types of different rewards: - distributions: type of campaign for concentrated liquidity pools created before Feb 15 2024, now deprecated - campaigns: the more global name to describe any reward program on top of Merkl","events":{"AdminChanged(address,address)":{"details":"Emitted when the admin account has changed."},"BeaconUpgraded(address)":{"details":"Emitted when the beacon is upgraded."},"Initialized(uint8)":{"details":"Triggered when the contract has been initialized or reinitialized."},"Upgraded(address)":{"details":"Emitted when the implementation is upgraded."}},"kind":"dev","methods":{"acceptConditions()":{"details":"Users may either call `acceptConditions` here or `sign` the message"},"campaign(bytes32)":{"details":"If a campaign has been overriden, this function still shows the original state of the campaign"},"campaignId((bytes32,address,address,uint256,uint32,uint32,uint32,bytes))":{"details":"The campaign ID is computed as the hash of the following parameters:  - `campaign.chainId`  - `campaign.creator`  - `campaign.rewardToken`  - `campaign.campaignType`  - `campaign.startTimestamp`  - `campaign.duration`  - `campaign.campaignData` This prevents the creation by the same account of two campaigns with the same parameters which is not a huge issue"},"createCampaign((bytes32,address,address,uint256,uint32,uint32,uint32,bytes))":{"details":"If the campaign is badly specified, it will not be handled by the campaign script and rewards may be lostReward tokens sent as part of campaigns must have been whitelisted before and amounts sent should be bigger than a minimum amount specific to each tokenThis function reverts if the sender has not accepted the terms and conditions","returns":{"_0":"The campaignId of the new campaign"}},"createCampaigns((bytes32,address,address,uint256,uint32,uint32,uint32,bytes)[])":{"returns":{"_0":"List of all the campaign amounts actually deposited for each `campaign` in the `campaigns` list"}},"getCampaignsBetween(uint32,uint32,uint32,uint32)":{"details":"For pagniation purpose, in case of out of gas, you can call back the same function but with `skip` set to `lastIndexCampaign`Not to be queried on-chain and hence not optimized for gas consumption","params":{"first":"Limit the length of the returned array to `first`","skip":"Disregard distibutions with a global index lower than `skip`"},"returns":{"_0":"searchCampaigns Eligible campaigns","lastIndexCampaign":"Index of the last campaign assessed in the list of all campaigns"}},"getValidRewardTokens()":{"details":"Not to be queried on-chain and hence not optimized for gas consumption"},"getValidRewardTokens(uint32,uint32)":{"details":"Not to be queried on-chain and hence not optimized for gas consumption"},"overrideCampaign(bytes32,(bytes32,address,address,uint256,uint32,uint32,uint32,bytes))":{"details":"Some overrides maybe incorrect, but their correctness cannot be checked onchain. It is up to the Merkl engine to check the validity of the override. If the override is invalid, then the first campaign details will still apply.Some fields in the new campaign parameters will be disregarded anyway (like the amount)"},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate that the this implementation remains valid after an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"reallocateCampaignRewards(bytes32,address[],address)":{"details":"To prevent manipulations by campaign creators, this function can only be called by the initial campaign creator if the `from` address has never claimed any reward on the chainCompute engine should also make sure when reallocating rewards that `from` claimed amount is still 0 - otherwise double allocation can happenIt is meant to be used for the case of addresses accruing rewards but unable to claim them"},"setCampaignFees(uint32,uint256)":{"details":"To waive the fees for a campaign, set its fees to 1"},"sign(bytes)":{"details":"If you signed the message once, and the message has not been modified, then you do not need to sign again"},"upgradeTo(address)":{"details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."}},"stateVariables":{"__gap":{"details":"This empty reserved space is put in place to allow future versions to add new variables without shifting down storage in the inheritance chain. See https://docs.openzeppelin.com/contracts/4.x/upgradeable#storage_gaps"},"campaignList":{"details":"An attacker could try to populate this list. It shouldn't be an issue as only view functions iterate on it"},"rewardTokenMinAmounts":{"details":"If `rewardTokenMinAmounts[token] == 0`, then `token` cannot be used as a reward"}},"title":"DistributionCreator","version":1},"userdoc":{"kind":"user","methods":{"BASE_9()":{"notice":"Base for fee computation"},"_nonces(address)":{"notice":"Deprecated, kept for storage compatibility"},"acceptConditions()":{"notice":"Allows a user to accept the conditions without signing the message"},"accessControlManager()":{"notice":"`AccessControlManager` contract handling access control"},"campaign(bytes32)":{"notice":"Returns the campaign parameters of a given campaignId"},"campaignId((bytes32,address,address,uint256,uint32,uint32,uint32,bytes))":{"notice":"Returns the campaign ID for a given campaign"},"campaignList(uint256)":{"notice":"List of all rewards ever distributed or to be distributed in the contract"},"campaignListReallocation(bytes32,uint256)":{"notice":"List all reallocated address for a given campaign"},"campaignLookup(bytes32)":{"notice":"Returns the index of a campaign in the campaign list"},"campaignOverrides(bytes32)":{"notice":"Maps a campaignId to a potential override written"},"campaignOverridesTimestamp(bytes32,uint256)":{"notice":"Maps a campaignId to the block numbers at which it's been updated"},"campaignReallocation(bytes32,address)":{"notice":"Maps one address to another one to reallocate rewards for a given campaign"},"campaignSpecificFees(uint32)":{"notice":"Maps a campaign type to the fees for this specific campaign"},"createCampaign((bytes32,address,address,uint256,uint32,uint32,uint32,bytes))":{"notice":"Creates a `campaign` to incentivize a given pool for a specific period of time"},"createCampaigns((bytes32,address,address,uint256,uint32,uint32,uint32,bytes)[])":{"notice":"Same as the function above but for multiple campaigns at once"},"createDistribution((bytes32,address,address,uint256,address[],uint32[],uint32,uint32,uint32,uint32,uint32,uint32,uint32,address,bytes))":{"notice":"Creates a `distribution` to incentivize a given pool for a specific period of time"},"createDistributions((bytes32,address,address,uint256,address[],uint32[],uint32,uint32,uint32,uint32,uint32,uint32,uint32,address,bytes)[])":{"notice":"Same as the function above but for multiple distributions at once"},"defaultFees()":{"notice":"Value (in base 10**9) of the fees taken when creating a campaign"},"distribution(uint256)":{"notice":"Returns the distribution at a given index converted into a campaign"},"distributionList(uint256)":{"notice":"List of all rewards distributed in the contract on campaigns created before mid Feb 2024 for concentrated liquidity pools"},"distributor()":{"notice":"Contract distributing rewards to users"},"feeRebate(address)":{"notice":"Maps an address to its fee rebate"},"feeRecipient()":{"notice":"Address to which fees are forwarded"},"getCampaignsBetween(uint32,uint32,uint32,uint32)":{"notice":"Gets all the campaigns which were live at some point between `start` and `end` timestamp"},"getValidRewardTokens()":{"notice":"Returns the list of all the reward tokens supported as well as their minimum amounts"},"isWhitelistedToken(address)":{"notice":"Maps a token to whether it is whitelisted or not. No fees are to be paid for incentives given on pools with whitelisted tokens"},"message()":{"notice":"Message that needs to be acknowledged by users creating a campaign"},"messageHash()":{"notice":"Hash of the message that needs to be signed"},"overrideCampaign(bytes32,(bytes32,address,address,uint256,uint32,uint32,uint32,bytes))":{"notice":"Overrides a campaign with new parameters"},"reallocateCampaignRewards(bytes32,address[],address)":{"notice":"Reallocates rewards of a given campaign from one address to another"},"recoverFees(address[],address)":{"notice":"Recovers fees accrued on the contract for a list of `tokens`"},"rewardTokenMinAmounts(address)":{"notice":"Maps a token to the minimum amount that must be sent per epoch for a distribution to be valid"},"rewardTokens(uint256)":{"notice":"List of all reward tokens that have at some point been accepted"},"setCampaignFees(uint32,uint256)":{"notice":"Sets the fees specific for a campaign"},"setFeeRecipient(address)":{"notice":"Sets a new address to receive fees"},"setFees(uint256)":{"notice":"Sets the defaultFees on deposit"},"setMessage(string)":{"notice":"Sets the message that needs to be signed by users before posting rewards"},"setNewDistributor(address)":{"notice":"Sets a new `distributor` to which rewards should be distributed"},"setRewardTokenMinAmounts(address[],uint256[])":{"notice":"Sets the minimum amounts per distribution epoch for different reward tokens"},"setUserFeeRebate(address,uint256)":{"notice":"Sets fee rebates for a given user"},"sign(bytes)":{"notice":"Checks whether the `msg.sender`'s `signature` is compatible with the message to sign and stores the signature"},"signAndCreateCampaign((bytes32,address,address,uint256,uint32,uint32,uint32,bytes),bytes)":{"notice":"Combines signing the message and creating a campaign"},"toggleSigningWhitelist(address)":{"notice":"Toggles the whitelist status for `user` when it comes to signing messages before depositing rewards."},"toggleTokenWhitelist(address)":{"notice":"Toggles the fee whitelist for `token`"},"userSignatureWhitelist(address)":{"notice":"Maps a user to whether it is whitelisted for not signing"},"userSignatures(address)":{"notice":"Maps an address to the last valid hash signed"}},"notice":"Manages the distribution of rewards through the Merkl system","version":1}},"settings":{"compilationTarget":{"contracts/DistributionCreator.sol":"DistributionCreator"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100},"remappings":[":@openzeppelin/=node_modules/@openzeppelin/",":@utils/=node_modules/utils/src/",":forge-std/=node_modules/forge-std/src/",":hardhat/=node_modules/hardhat/",":lz/=node_modules/utils/lib/solidity-examples/contracts/",":oz/=node_modules/@openzeppelin/contracts/",":stringutils/=node_modules/utils/lib/solidity-stringutils/src/",":utils/=node_modules/utils/"]},"sources":{"contracts/DistributionCreator.sol":{"keccak256":"0xd47d8989ab439eafbe4149f8329e9242fbac43dfbd98719f6591ded676cb1a59","license":"BUSL-1.1","urls":["bzz-raw://0bdc5a59666cd86ba13bd0d7d3d707d005609e9fb7ae610d1f82af69c8f6ec0e","dweb:/ipfs/QmXCexyy2CMvuTSA1ajHRTcjYESUGN7LmpFbmBXAfAdUPW"]},"contracts/Distributor.sol":{"keccak256":"0x18c6438ad9354c9dc2fc2f1481a9f00773d1a50ab4faef2a58b469d92d07f8a4","license":"BUSL-1.1","urls":["bzz-raw://95035781a9394baec627c4070dfed6639e52e8cad592f01f34d8f159c4e