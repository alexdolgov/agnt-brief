f the host chain is an Arbitrum chain. That means that the block number returned for this is usable for event queries. This function will revert if the given node number does not exist."},"getStaker(address)":{"notice":"Retrieves stored information about a requested staker"},"getStakerAddress(uint64)":{"notice":"Get the address of the staker at the given index"},"isStaked(address)":{"notice":"Check whether the given staker is staked"},"isStakedOnLatestConfirmed(address)":{"notice":"Check whether the given staker is staked on the latest confirmed node, which includes if the staker is staked on a descendent of the latest confirmed node."},"latestStakedNode(address)":{"notice":"Get the latest staked node of the given staker"},"newStakeOnExistingNode(uint64,bytes32)":{"notice":"Create a new stake on an existing node"},"newStakeOnNewNode((((bytes32[2],uint64[2]),uint8),((bytes32[2],uint64[2]),uint8),uint64),bytes32,uint256)":{"notice":"Create a new stake on a new node"},"nodeHasStaker(uint64,address)":{"notice":"Check if the specified node has been staked on by the provided staker. Only accurate at the latest confirmed node and afterwards."},"reduceDeposit(uint256)":{"notice":"Reduce the amount staked for the sender (difference between initial amount staked and target is creditted back to the sender)."},"rejectNextNode(address)":{"notice":"Reject the next unresolved node"},"removeOldZombies(uint256)":{"notice":"Remove any zombies whose latest stake is earlier than the latest confirmed node"},"removeZombie(uint256,uint256)":{"notice":"Remove the given zombie from nodes it is staked on, moving backwords from the latest node it is staked on"},"requireUnresolvedExists()":{"notice":"Verify that there are some number of nodes still unresolved"},"requiredStake(uint256,uint64,uint64)":{"notice":"Calculate the current amount of funds required to place a new stake in the rollup"},"returnOldDeposit(address)":{"notice":"Refund a staker that is currently staked on or before the lates