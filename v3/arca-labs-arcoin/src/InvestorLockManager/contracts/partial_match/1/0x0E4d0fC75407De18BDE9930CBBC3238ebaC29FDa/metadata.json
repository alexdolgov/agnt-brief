ime expired) but still exists for a specific address","reasonCode":"the reason code","reasonString":"the reason for the lock","value":"the value of tokens locked"}},"lockInvestor(string)":{"details":"pause investor","params":{"_investorId":"investor id"}},"removeLockRecord(address,uint256)":{"details":"Releases a specific lock record","params":{"_lockIndex":"the index of the lock note - this may change the order of the locks on an address, so if iterating the iteration should be restarted.","_to":"address to release the tokens for"},"returns":{"_0":"true on success"}},"removeLockRecordForInvestor(string,uint256)":{"details":"Releases a specific lock record for a investor","params":{"_investorId":"investor id to release the tokens for","_lockIndex":"the index of the lock to remove note - this may change the order of the locks on an address, so if iterating the iteration should be restarted."},"returns":{"_0":"true on success"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"unlockInvestor(string)":{"details":"unpauses investor","params":{"_investorId":"investor id"}}},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"compilationTarget":{"contracts/compliance/InvestorLockManager.sol":"InvestorLockManager"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/token/ERC20/IERC20.sol":{"keccak256":"0x287b55befed2961a7eabd7d7b1b2839cbca8a5b80ef8dcbb25ed3d4c2002c305","license":"MIT","urls":["bzz-raw://bd39944e8fc06be6dbe2dd1d8449b5336e23c6a7ba3e8e9ae5ae0f37f35283f5","dweb:/ipfs/QmPV3FGYjVwvKSgAXKUN3r9T9GwniZz83CxBpM7vyj2G53"]},"@openzeppelin/contracts/utils/math/Math.sol":{"keccak256":"0xe4455ac1eb7fc497bb7402579e7b4d64d928b846fce7d2b6fde06d366f21c2b3","license":"MIT","urls":["bzz-raw://cc8841b3cd48ad125e2f46323c8bad3aa0e88e399ec62a