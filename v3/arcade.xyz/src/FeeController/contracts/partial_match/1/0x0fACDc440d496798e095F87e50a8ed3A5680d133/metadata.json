type":"function"}],"devdoc":{"author":"Non-Fungible Technologies, Inc. The Fee Controller is used by LoanCore to query for fees for different loan lifecycle interactions (origiations, rollovers, etc). All fees should have setters and getters and be expressed in BPs. In the future, this contract could be extended to support more complex logic (introducing a mapping of users who get a discount, e.g.). Since LoanCore can change the fee controller reference, any changes to this contract can be newly deployed on-chain and adopted.","kind":"dev","methods":{"getOriginationFee()":{"returns":{"_0":"originationFee       The current fee in bps."}},"getRolloverFee()":{"returns":{"_0":"rolloverFee       The current fee in bps."}},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setOriginationFee(uint256)":{"params":{"_originationFee":"The new origination fee, in bps."}},"setRolloverFee(uint256)":{"params":{"_rolloverFee":"The new rollover fee, in bps."}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."}},"stateVariables":{"MAX_ORIGINATION_FEE":{"details":"Global maximum fees, preventing attacks by owners      which drain principal."},"originationFee":{"details":"Fee for origination - default is 0.5%"},"rolloverFee":{"details":"Fee for rollovers - default is 0.1%"}},"title":"FeeController","version":1},"userdoc":{"errors":{"FC_FeeTooLarge()":[{"notice":"Caller attempted to set a fee which is larger than the global maximum."}]},"kind":"user","methods":{"getOriginationFee()":{"notice":"Get the current origination fee in bps."},"getRolloverFee()":{"notice":"Get the current origination fee in bps."},"setOriginationFee(uint256)":{"notice":"Set the origination fee to the given value. The caller         must be the owner of the contract."},"setRolloverFee(uint256)":{"notice":"Set the origination fee to the given value. The caller         must be the owner of the contract."}},"version":1}},"settings":{"compilationTarget":{"contracts/FeeController.sol":"FeeController"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/access/AccessControl.sol":{"keccak256":"0x183481af1c40d2efb26b86f63d6fe9e22f24c87e436d60a69f261b38500e7cd6","license":"MIT","urls":["bzz-raw://f562746c399ae045994a88b2218d1238a349de07afbfb305aab0c7fdbc2954cc","dweb:/ipfs/QmYoFrDD2c6fi9CpPz1bjCMAyketjZ3G7ByUSVQMntysms"]},"@openzeppelin/contracts/access/AccessControlEnumerable.sol":{"keccak256":"0x313834fba9dbefee1df7717a5e3063ebf567d276e67bc925a03c7f8423f4c50e","license":"MIT","urls":["bzz-raw://76748567d11b8d92db337c17a705c9348ff4c4f3e0c0cd2f5f0b979de078abb6","dweb:/ipfs/QmZrc4aUrUf7GXzvs1Tsadj8Z89YqdoMN4WEaZKJq2ML3J"]},"@openzeppelin/contracts/access/IAccessControl.sol":{"keccak256":"0xfe0edb09653ed10e8a1bfe03eb9b0ff06775666eee817a95bd3d0799f1ee2b44","license":"MIT","urls":["bzz-raw://fbb9d503857eab98f87465df0f02fef03083f30c1dbec82f319f41aaadae19b4","dweb:/ipfs/QmTxDshRAMtoeM45YrTzQZdpmy4mt4scCNHjfZiWSvdETF"]},"@openzeppelin/contracts/access/IAccessControlEnumerable.sol":{"keccak256":"0x6a9a31f278ee3ed0568ab7e3c09ecb72bf92f922475a274760b4c58f87f9ad0c","license":"MIT","urls":["bzz-raw://e29a0ac0b40b9f11469a0a2a4affe2f059d2530c09bafc08d5433ee25f4c20db","dweb:/ipfs/QmbzCk1qyZxxxosAThz1fJTUjUhx3dj1VVMSQCwGtrXV8U"]},"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0x6bb804a310218875e89d12c053e94a13a4607cdf7cc2052f3e52bd32a0dc50a1","license":"MIT","urls":["bzz-raw://b2ebbbe6d0011175bd9e7268b83de3f9c2f9d8d4cbfbaef12aff977d7d727163","dweb:/ipf