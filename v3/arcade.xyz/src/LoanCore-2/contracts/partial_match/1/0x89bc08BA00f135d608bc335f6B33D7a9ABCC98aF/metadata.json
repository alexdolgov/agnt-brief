address,address)":{"params":{"to":"The address to send the fees to.","token":"The contract address of the token to claim fees for."}}},"stateVariables":{"GRACE_PERIOD":{"details":"Grace period for repaying a loan after loan duration."},"MAX_AFFILIATE_SPLIT":{"details":"Max split any affiliate can earn."},"affiliateSplits":{"details":"affiliate code => affiliate split      split contains payout address and a feeShare in bps"},"collateralInUse":{"details":"Lookup table showing what collateral is currently being escrowed.      Key is hash of (collateralAddress, collateralId)."},"feesWithdrawable":{"details":"token => user => amount fees"},"loanIdTracker":{"details":"Counter for serial IDs of all loans created."},"loans":{"details":"Lookup table storing loan data structure."},"noteReceipts":{"details":"tokenId => {token, amount}      can be withdrawn by burning LenderNote of matching tokenId"},"usedNonces":{"details":"Lookup table showing for which user, which nonces have been used.      user => nonce => isUsed"}},"title":"LoanCore","version":1},"userdoc":{"errors":{"LC_AffiliateCodeAlreadySet(bytes32)":[{"notice":"Protocol attempted to set an affiliate code which already exists. Affiliate         codes are immutable."}],"LC_ArrayLengthMismatch()":[{"notice":"Two arrays were provided that must be of matching length, but were not."}],"LC_CannotSettle(uint256,uint256)":[{"notice":"The reported settlements are invalid, and LoanCore would lose tokens         attempting to perform the requested operations."}],"LC_CannotWithdraw(uint256,uint256)":[{"notice":"User attempted to withdraw a pending balance that was in excess         of what is available."}],"LC_CollateralInUse(address,uint256)":[{"notice":"Check collateral is not already used in a active loan."}],"LC_InvalidState(uint8)":[{"notice":"Ensure valid loan state for loan lifceycle operations."}],"LC_NoReceipt(uint256)":[{"notice":"Specified note token ID does not have a redeemable receipt."}],"LC_NonceUsed(address,uint160)":[{"notice":"User address and the specified nonce have already been used."}],"LC_NotExpired(uint256)":[{"notice":"Loan duration has not expired."}],"LC_OverMaxSplit(uint96,uint96)":[{"notice":"A proposed affiliate split was submitted that is over the maximum."}],"LC_ReusedNote()":[{"notice":"Borrower address is same as lender address."}],"LC_ZeroAddress(string)":[{"notice":"Zero address passed in where not allowed."}],"LC_ZeroAmount()":[{"notice":"Zero amount passed in where not allowed."}]},"kind":"user","methods":{"canCallOn(address,address)":{"notice":"Reports if the caller is allowed to call functions on the given vault.         Determined by if they are the borrower for the loan, defined by ownership         of the relevant BorrowerNote."},"cancelNonce(uint160)":{"notice":"Mark a nonce as used in order to invalidate signatures with the nonce.         Does not allow specifying the user, and automatically consumes the nonce         of the caller."},"claim(uint256,uint256)":{"notice":"Claim collateral on a given loan. Can only be called by RepaymentController,         which verifies claim conditions. This method validates that the loan's due         date has passed, and the grace period of 10 mins has also passed. Then it distributes         collateral to the lender. All promissory notes will be burned and the loan         will be marked as complete."},"constructor":{"notice":"Deploys the loan core contract, by setting up roles and external         contract references."},"consumeNonce(address,uint160)":{"notice":"Mark a nonce as used in the context of starting a loan. Reverts if         nonce has already been used. Can only be called by Origination Controller."},"forceRepay(uint256,address,uint256,uint256)":{"notice":"Let the borrower repay the given loan, but do not release principal to the lender:         instead, make it available for withdrawal. Should be used in cases where the borrower wants         to fulfill loan obligations but the lender cannot receive tokens (due to malicious or         accidental behavior, token blacklisting etc)."},"getInterestAmount(uint256,uint256)":{"notice":"Calculate the interest due over a full term."},"getLoan(uint256)":{"notice":"Returns the LoanData struct for the specified loan ID."},"getNoteReceipt(uint256)":{"notice":"Returns the note receipt data for a given loan ID. Does         not revert, returns 0 if no receipt."},"isNonceUsed(address,uint160)":{"notice":"Reports whether the given nonce has been previously used by a user. Returning         false does not mean that the nonce will not clash with another potential off-chain         signature that is stored somewhere."},"redeemNote(uint256,uint256,address)":{"notice":"Burn a lender note, for an already-completed loan, in order to receive         held tokens already paid back by the borrower. Can only be called by the         owner of the note."},"repay(uint256,address,uint256,uint256)":{"notice":"Repay the given loan. Can only be called by RepaymentController,         which verifies repayment conditions. This method will collect         the total interest due from the borrower  and redistribute         principal + interest to the lender, and collateral to the borrower.         All promissory notes will be burned and the loan will be marked as complete."},"rollover(uint256,address,address,(uint256,uint256,address,uint96,uint256,address,uint96,bytes32),uint256,uint256,uint256,uint256)":{"notice":"Roll over a loan, atomically closing one and re-opening a new one with the         same collateral. Instead of full repayment, only net payments from each         party are required. Each rolled-over loan is marked as complete, and the new         loan is given a new unique ID and notes. At the time of calling, any needed         net payments have been collected by the RepaymentController for withdrawal."},"setAffiliateSplits(bytes32[],(address,uint96)[])":{"notice":"Set the affiliate fee splits for the batch of affiliate codes. Codes and splits should         be matched index-wise. Can only be called by protocol admin."},"shutdown()":{"notice":"Shuts down the contract, callable by a designated role. Irreversible.         When the contract is shutdown, loans can only be repaid.         New loans cannot be started, defaults cannot be claimed,         loans cannot be rolled over, and vault utility cannot be         employed. This is an emergency recovery feature."},"startLoan(address,address,(uint256,uint256,address,uint96,uint256,address,uint96,bytes32),uint256,uint256,(uint16,uint16,uint16))":{"notice":"Start a loan, matching a set of terms, with a given         lender and borrower. Collects collateral and distributes         principal, along with collecting an origination fee for the         protocol and/or affiliate. Can only be called by OriginationController."},"withdraw(address,uint256,address)":{"notice":"Claim any feesWithdrawable balance pending for the caller, as specified by token.         This may accumulate from either affiliate fee shares or borrower forced repayments."},"withdrawProtocolFees(address,address)":{"notice":"Claim the protocol fees for the given token. Any token used as principal         for a loan will have accumulated fees. Must be called by contract owner."}},"version":1}},"settings":{"compilationTarget":{"contracts/LoanCore.sol":"LoanCore"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/access/AccessControl.sol":{"keccak256":"0x183481af1c40d2efb26b86f63d6fe9e22f24c87e436d60a69f261b38500e7cd6","license":"MIT","urls":["bzz-raw://f562746c399ae045994a88b2218d1238a349de07afbfb305aab0c7fdbc2954cc","dweb:/ipfs/QmYoFrDD2c6fi9CpPz1bjCMAyketjZ3G7ByUSVQMntysms"]},"@openzeppelin/contracts/access/AccessControlEnumerable.sol":{"keccak256":"0x313834fba9dbefee1df7717a5e3063ebf567d276e67bc925a03c7f8423f4c50e","license":"MIT","urls":["bzz-raw://76748567d11b8d92db337c17a70