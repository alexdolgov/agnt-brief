ult contracts not the badge contract. This contract uses a merkle trie to determine which users are eligible to mint a badge. Only the manager of the contract can update the merkle roots and claim expirations. Additionally, there is an optional mint price which can be set and claimed by the manager.","errors":{"RB_ClaimingExpired(uint48,uint48)":[{"params":{"claimExpiration":"The expiration date for the claim.","currentTimestamp":"The current timestamp."}}],"RB_InvalidClaimAmount(uint256,uint256)":[{"params":{"amountToClaim":"The amount to claim.","totalClaimableAmount":"The total amount entitled to claim."}}],"RB_InvalidExpiration(uint256,uint256)":[{"params":{"currentTime":"The current timestamp.","timeSent":"The passed to function."}}],"RB_InvalidMintFee(uint256,uint256)":[{"params":{"amountSent":"The amount of ETH sent to mint the badge.","mintPrice":"The price to mint the badge."}}],"RB_ZeroAddress(string)":[{"params":{"addressType":"The name of the parameter for which a zero                                   address was provided."}}]},"events":{"ApprovalForAll(address,address,bool)":{"details":"Emitted when `account` grants or revokes permission to `operator` to transfer their tokens, according to `approved`."},"RoleAdminChanged(bytes32,bytes32,bytes32)":{"details":"Emitted when `newAdminRole` is set as ``role``'s admin role, replacing `previousAdminRole` `DEFAULT_ADMIN_ROLE` is the starting admin for all roles, despite {RoleAdminChanged} not being emitted signaling this. _Available since v3.1._"},"RoleGranted(bytes32,address,address)":{"details":"Emitted when `account` is granted `role`. `sender` is the account that originated the contract call, an admin role bearer except when using {AccessControl-_setupRole}."},"RoleRevoked(bytes32,address,address)":{"details":"Emitted when `account` is revoked `role`. `sender` is the account that originated the contract call:   - if using `revokeRole`, it is the admin role bearer   - if using `renounceRole`, it is the role bearer (i.e. `account`)"},"TransferBatch(address,address,address,uint256[],uint256[])":{"details":"Equivalent to multiple {TransferSingle} events, where `operator`, `from` and `to` are the same for all transfers."},"TransferSingle(address,address,address,uint256,uint256)":{"details":"Emitted when `value` tokens of token type `id` are transferred from `from` to `to` by `operator`."},"URI(string,uint256)":{"details":"Emitted when the URI for token type `id` changes to `value`, if it is a non-programmatic URI. If an {URI} event was emitted for `id`, the standard https://eips.ethereum.org/EIPS/eip-1155#metadata-extensions[guarantees] that `value` will equal the value returned by {IERC1155MetadataURI-uri}."}},"kind":"dev","methods":{"balanceOf(address,uint256)":{"details":"See {IERC1155-balanceOf}. Requirements: - `account` cannot be the zero address."},"balanceOfBatch(address[],uint256[])":{"details":"See {IERC1155-balanceOfBatch}. Requirements: - `accounts` and `ids` must have the same length."},"constructor":{"params":{"_descriptor":"The address of the descriptor contract.","_owner":"The owner of the contract."}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getRoleMember(bytes32,uint256)":{"details":"Returns one of the accounts that have `role`. `index` must be a value between 0 and {getRoleMemberCount}, non-inclusive. Role bearers are not sorted in any particular way, and their ordering may change at any point. WARNING: When using {getRoleMember} and {getRoleMemberCount}, make sure you perform all queries on the same block. See the following https://forum.openzeppelin.com/t/iterating-over-elements-on-enumerableset-in-openzeppelin-contracts/2296[forum post] for more information."},"getRoleMemberCount(bytes32)":{"details":"Returns the number of accounts that have `role`. Can be used together with {getRoleMember} to enumerate all bearers of a role."},"grantRole(bytes32,address)":{"details":"Overload {grantRole} to track enumerable memberships"},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"isApprovedForAll(address,address)":{"details":"See {IERC1155-isApprovedForAll}."},"mint(address,uint256,uint256,uint256,bytes32[])":{"params":{"amount":"The amount of a specific badge to claim.","merkleProof":"The merkle proof to verify the claim.","recipient":"The address of the user to mint the badge to.","tokenId":"The ID of the badge to mint.","totalClaimable":"The total amount of a specific badge that can be claimed."}},"publishRoots(uint256[],(uint256,bytes32,uint48)[])":{"params":{"_claimData":"The claim data to update."}},"renounceRole(bytes32,address)":{"details":"Overload {renounceRole} to track enumerable memberships"},"revokeRole(bytes32,address)":{"details":"Overload {revokeRole} to track enumerable memberships"},"safeBatchTransferFrom(address,address,uint256[],uint256[],bytes)":{"details":"See {IERC1155-safeBatchTransferFrom}."},"safeTransferFrom(address,address,uint256,uint256,bytes)":{"details":"See {IERC1155-safeTransferFrom}."},"setApprovalForAll(address,bool)":{"details":"See {IERC1155-setApprovalForAll}."},"setDescriptor(address)":{"params":{"_descriptor":"The new descriptor contract address."}},"uri(uint256)":{"params":{"tokenId":"The ID of the token to get the URI for."},"returns":{"_0":"uri                  The token ID's URI."}},"withdrawFees(address)":{"params":{"recipient":"The address to withdraw the fees to."}}},"stateVariables":{"descriptor":{"details":"Contract for returning tokenURI resources."}},"title":"ReputationBadge","version":1},"userdoc":{"errors":{"RB_ArrayMismatch()":[{"notice":"Thrown when two array lengths do not match."}],"RB_ArrayTooLarge()":[{"notice":"Thrown when the array is larger than 50 elements."}],"RB_ClaimingExpired(uint48,uint48)":[{"notice":"Thrown when the claim expiration has passed for a specific merkle root."}],"RB_InvalidClaimAmount(uint256,uint256)":[{"notice":"Thrown when the amount to claim is greater than recipients total claimable amount."}],"RB_InvalidExpiration(uint256,uint256)":[{"notice":"Thrown when the claim expiration is invalid when publishing data."}],"RB_InvalidMerkleProof()":[{"notice":"Thrown when the merkle proof provided does not validate the user's claim."}],"RB_InvalidMintFee(uint256,uint256)":[{"notice":"Thrown when ETH amount sent to mint is insufficient."}],"RB_NoClaimData()":[{"notice":"Thrown when the claim data array is empty."}],"RB_ZeroAddress(string)":[{"notice":"Zero address passed in where not allowed."}],"RB_ZeroClaimAmount()":[{"notice":"Thrown when user passes zero as the amount to mint function."}],"RB_ZeroTokenId()":[{"notice":"Thrown when user tries to mint tokenId of zero. Token ID zero is excluded         from receiving a multiplier in the NFTBoostVault."}]},"events":{"FeesWithdrawn(address,uint256)":{"notice":"Event emitted when ETH fees are withdrawn from this contract."},"RootsPublished((uint256,bytes32,uint48)[])":{"notice":"Event emitted when a claim data is set for specific tokenId."},"SetDescriptor(address,address)":{"notice":"Event emitted when a new URI descriptor is set."}},"kind":"user","methods":{"ADMIN_ROLE()":{"notice":"access control roles"},"amountClaimed(address,bytes32)":{"notice":"recipient address to claimRoot to amount claimed mapping"},"claimData(uint256)":{"notice":"tokenId to ClaimData mapping"},"constructor":{"notice":"Constructor for the contract. Sets owner and manager addresses."},"mint(address,uint256,uint256,uint256,bytes32[])":{"notice":"Mint a specified number of badges to a user who has a valid claim."},"publishRoots(uint256[],(uint256,bytes32,uint48)[])":{"notice":"Update the claim data that is used to validate user claims."},"setDescriptor(address)":{"notice":"Changes the descriptor contract for reporting tokenURI resources.         Can only be called by a resource manager."},"supportsInterface(bytes4)":{"n