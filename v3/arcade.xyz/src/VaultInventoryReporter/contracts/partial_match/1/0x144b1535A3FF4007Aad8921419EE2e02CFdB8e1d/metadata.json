IVaultInventoryReporter.ItemType","name":"itemType","type":"uint8"},{"internalType":"address","name":"tokenAddress","type":"address"},{"internalType":"uint256","name":"tokenId","type":"uint256"},{"internalType":"uint256","name":"tokenAmount","type":"uint256"}],"internalType":"struct IVaultInventoryReporter.Item","name":"item","type":"tuple"}],"name":"verifyItem","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"}],"devdoc":{"author":"Non-Fungible Technologies, Inc. The VaultInventoryReporter contract is a global tracker of reported inventory in all Arcade Asset Vaults. This reporting should _always_ be accurate, but will _not_ be comprehensive - that is, many vaults will end up having unreported inventory. This contract should be used specifically to verify _whether_ certain items are in the reported inventory, and not to get a sense of truth as to _all_ the items in a particular vault. Based on the method of storing inventory based on an itemsHash, the report is also idempotent - any matching itemsHash will simply update a status or amount, and will not increment any stored value.","kind":"dev","methods":{"DOMAIN_SEPARATOR()":{"returns":{"_0":"separator             The bytes for the domain separator."}},"_checkOwnership(address,address,address)":{"details":"Validates that the caller is directly the owner of the vault,      and that the specified vault exists. Reverts on failed validation.","params":{"caller":"The caller who wishes to deposit.","factory":"The vault ownership token for the specified vault.","vault":"The vault that will be deposited to."}},"add(address,(uint8,address,uint256,uint256)[])":{"params":{"items":"The list of items to add.","vault":"The address of the vault."}},"addWithPermit(address,(uint8,address,uint256,uint256)[],uint256,uint8,bytes32,bytes32)":{"params":{"deadline":"The maximum timestamp the signature is valid for.","items":"The list of items to add.","r":"Component of the signature.","s":"Component of the signature.","v":"Component of the signature.","vault":"The address of the vault."}},"clear(address)":{"params":{"vault":"The address of the vault."}},"clearWithPermit(address,uint256,uint8,bytes32,bytes32)":{"params":{"deadline":"The maximum timestamp the signature is valid for.","r":"Component of the signature.","s":"Component of the signature.","v":"Component of the signature.","vault":"The address of the vault."}},"constructor":{"details":"Initializes the {EIP712} domain separator using the `name` parameter, and setting `version` to `\"1\"`.","params":{"name":"The name of the signing domain."}},"enumerate(address)":{"params":{"vault":"The address of the vault."},"returns":{"items":"                       An array of items in the vault."}},"enumerateOrFail(address)":{"params":{"vault":"The address of the vault."},"returns":{"items":"                       An array of items in the vault."}},"isGloballyApproved(address)":{"params":{"target":"The address to check approval for."},"returns":{"_0":"isApproved                   Whether the target is approved for the vault."}},"isOwnerOrApproved(address,address)":{"params":{"target":"The address to check approval for.","vault":"The vault to check approval for."},"returns":{"_0":"isApproved                   Whether the target is approved for the vault."}},"itemAtIndex(address,uint256)":{"params":{"index":"The index of the key to look up.","vault":"The address of the vault."},"returns":{"_0":"item                         The item at the specified index."}},"keyAtIndex(address,uint256)":{"params":{"index":"The index of the key to look up.","vault":"The address of the vault."},"returns":{"_0":"key                          The key at the specified index."}},"keys(address)":{"params":{"vault":"The address of the vault."},"returns":{"_0":"keys                         An array of lookup keys for all vault items."}},"owner()":{"details":"Returns the address of the current owner."},"permit(address,address,address,uint256,uint8,bytes32,bytes32)":{"params":{"deadline":"The maximum timestamp the signature is valid for.","owner":"The owner of the vault being permitted.","r":"Component of the signature.","s":"Component of the signature.","target":"The address allowed to report inventory for the token.","v":"Component of the signature.","vault":"The given vault for the permission."}},"remove(address,(uint8,address,uint256,uint256)[])":{"params":{"items":"The list of items to remove.","vault":"The address of the vault."}},"removeWithPermit(address,(uint8,address,uint256,uint256)[],uint256,uint8,bytes32,bytes32)":{"params":{"deadline":"The maximum timestamp the signature is valid for.","items":"The list of items to remove.","r":"Component of the signature.","s":"Component of the signature.","v":"Component of the signature.","vault":"The address of the vault."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setApproval(address,address)":{"params":{"target":"The address to set approval for.","vault":"The vault to set approval for."}},"setGlobalApproval(address,bool)":{"params":{"isApproved":"Whether the address should be approved.","target":"The address to set approval for."}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"verify(address)":{"params":{"vault":"The address of the vault."},"returns":{"_0":"verified                     Whether the vault inventory is still accurate."}},"verifyItem(address,(uint8,address,uint256,uint256))":{"params":{"item":"The item to verify.","vault":"The address of the vault."},"returns":{"_0":"verified                     Whether the vault inventory is still accurate."}}},"stateVariables":{"MAX_ITEMS_PER_REGISTRATION":{"details":"To prevent gas consumption issues, registering more than 50 items      in a single transaction will revert."},"_nonces":{"details":"Nonce for permit signatures."}},"title":"VaultInventoryReporter","version":1},"userdoc":{"kind":"user","methods":{"DOMAIN_SEPARATOR()":{"notice":"Returns the domain separator used in the encoding of the signature for {permit}, as defined by {EIP712}."},"add(address,(uint8,address,uint256,uint256)[])":{"notice":"Add items to the vault's registered inventory. If specified items         are not owned by the vault, add will revert."},"addWithPermit(address,(uint8,address,uint256,uint256)[],uint256,uint8,bytes32,bytes32)":{"notice":"Add items to the vault's registered inventory, using permit. If specified items         are not owned by the vault, add will revert."},"approved(address)":{"notice":"Approvals to modify inventory contents for a vault         vault -> approved address"},"clear(address)":{"notice":"Remove all items from the vault's registered inventory."},"clearWithPermit(address,uint256,uint8,bytes32,bytes32)":{"notice":"Remove all items from the vault's registered inventory, using permit."},"enumerate(address)":{"notice":"Return a list of items in the vault. Does not check for staleness."},"enumerateOrFail(address)":{"notice":"Return a list of items in the vault. Checks for staleness and reverts if         a reported asset is no longer owned."},"globalApprovals(address)":{"notice":"Approvals to modify inventory contents for a vault,         which apply to any vault. Can be set by admins.         caller -> isApproved"},"inventoryForVault(address,bytes32)":{"notice":"vault address -> itemHash -> Item metadata"},"isGloballyApproved(address)":{"notice":"Reports whether the target is has been put on the \"global approval\" list         - an admin managed list for contracts which integrate with the reporter."},"isOwnerOrApproved(address,address)":{"notice":"Reports whether the target is an owner of the vault, or approved         to report inventory on behalf of the vault. Note that this approval         does NOT equate to a token approval."},"itemAtIndex(address,uint256)":{"notice":"Return the item stored by the lookup key at the specified index.         Does not check for staleness."},"keyAtIndex(address,uint256)":{"notice":"Return the lookup key at the specified index. Does not check for staleness."},"keys(address)":{"notice":"Return a list of lookup keys for items in the vault, which is each item's         itemHash value. Does not check for staleness."},"permit(address,address,address,uint256,uint8,bytes32,bytes32)":{"notice":"Allows the target to update inventory for a particular vault,         given owner's signed approval. Note that, unlike token approvals,         an inventory reporting approval cannot be \"spent\" - the signature         will work for an unlimited number of applications until the deadline.         Therefore unlike a token permit which is often spent before its         deadline, an inventory permit should be considered unqualified approval         until the deadline."},"remove(address,(uint8,address,uint256,uint256)[])":{"notice":"Remove items from the vault's registered inventory. If specified items         are not registered as inventory, the function will not revert."},"removeWithPermit(address,(uint8,address,uint256,uint256)[],uint256,uint8,bytes32,bytes32)":{"notice":"Remove items from the vault's registered inventory, using permit. If specified items         are not registered as inventory, the function will not revert."},"setApproval(address,address)":{"notice":"Sets an approval for a vault. If approved, a caller is allowed to make updates         to the vault's reported inventory. The caller itself must be the owner or approved         for the vault's corresponding ownership token. Can unset an approval by sending         the zero address as a target."},"setGlobalApproval(address,bool)":{"notice":"Sets a global a