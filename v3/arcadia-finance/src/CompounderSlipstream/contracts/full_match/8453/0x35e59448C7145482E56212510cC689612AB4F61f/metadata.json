ory.","cLFactory":"The contract address of the Slipstream Factory.","owner_":"The address of the Owner.","poolImplementation":"The contract address of the Slipstream Pool Implementation.","positionManager":"The contract address of the Slipstream Position Manager.","rewardToken":"The contract address of the Reward Token (Aero).","routerTrampoline":"The contract address of the Router Trampoline.","stakedSlipstreamAm":"The contract address of the Staked Slipstream Asset Module.","stakedSlipstreamWrapper":"The contract address of the Staked Slipstream Wrapper."}},"executeAction(bytes)":{"details":"The Liquidity Position is already transferred to this contract before executeAction() is called.When rebalancing we will burn the current Liquidity Position and mint a new one with a new tokenId.","params":{"actionTargetData":"A bytes object containing the initiator and initiatorParams."},"returns":{"depositData":"A struct with the asset data of the Liquidity Position and with the leftovers after mint, if any."}},"isPoolBalanced(uint256,(uint256,uint256,uint160,uint160))":{"params":{"cache":"A struct with cached variables.","sqrtPrice":"The sqrtPrice of the pool."},"returns":{"isBalanced":"Bool indicating if the pool is balanced."}},"isPositionManager(address)":{"params":{"positionManager":"the contract address of the position manager to check."}},"onERC721Received(address,address,uint256,bytes)":{"details":"Required to receive ERC721 tokens via safeTransferFrom."},"onSetAssetManager(address,bool,bytes)":{"details":"No need to check that the Account version is 3 or greater (versions with cross account reentrancy guard), since version 1 and 2 don't support the onSetAssetManager hook.","params":{"accountOwner":"The current owner of the Arcadia Account. param status Bool indicating if the Asset Manager is enabled or disabled.","data":"Operator specific data, passed by the Account owner."}},"setAccountInfo(address,address,uint256,uint256,uint256,uint256,bytes)":{"params":{"account_":"The contract address of the Arcadia Account to set the information for.","initiator":"The address of the initiator.","maxClaimFee":"The maximum fee charged on claimed fees/rewards by the initiator, with 18 decimals precision.","maxSwapFee":"The maximum fee charged on the ideal (without slippage) amountIn by the initiator, with 18 decimals precision.","maxTolerance":"The maximum allowed deviation of the actual pool price for any initiator, relative to the price calculated with trusted external prices of both assets, with 18 decimals precision.","metaData_":"Custom metadata to be stored with the account.","minLiquidityRatio":"The ratio of the minimum amount of liquidity that must be minted, relative to the hypothetical amount of liquidity when we rebalance without slippage, with 18 decimals precision."}},"setPauseFlag(bool)":{"params":{"paused_":"Flag indicating if the Asset Manager is paused."}},"skim(address)":{"params":{"token":"The contract address of the token, or address(0) for native tokens."}},"uniswapV3SwapCallback(int256,int256,bytes)":{"params":{"amount0Delta":"The amount of token0 that was sent (negative) or must be received (positive) by the pool by the end of the swap. If positive, the callback must send that amount of token0 to the position.","amount1Delta":"The amount of token1 that was sent (negative) or must be received (positive) by the pool by the end of the swap. If positive, the callback must send that amount of token1 to the position.","data":"Any data passed by this contract via the ICLPool.swap() call."}}},"title":"Compounder for Slipstream Liquidity Positions.","version":1},"userdoc":{"kind":"user","methods":{"changeGuardian(address)":{"notice":"Sets a new guardian."},"compound(address,(address,uint96,uint128,uint128,uint256,uint64,uint64,bytes))":{"notice":"Compounds a Concentrated Liquidity Positions, owned by an Arcadia Account."},"executeAction(bytes)":{"notice":"Callback function called by the Arcadia Account during the flashAction."