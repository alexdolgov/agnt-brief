act symbol (eg. SR  -> MZ -> JR).","prefix_":"The prefix of the contract name (eg. Senior -> Mezzanine -> Junior).","vas":"The amount of Virtual Assets and Shares."}},"convertToAssets(uint256)":{"params":{"shares":"The amount of shares."},"returns":{"assets":"The amount of underlying assets."}},"convertToAssetsAndSync(uint256)":{"details":"This function is a modification of convertToAssets() where interests are realized (state modification).","params":{"shares":"The amount of shares."},"returns":{"assets":"The amount of underlying assets."}},"convertToShares(uint256)":{"params":{"assets":"The amount of underlying assets."},"returns":{"shares":"The amount of shares."}},"convertToSharesAndSync(uint256)":{"details":"This function is a modification of convertToShares() where interests are realized (state modification).","params":{"assets":"The amount of underlying assets."},"returns":{"shares":"The amount of shares."}},"deposit(uint256,address)":{"details":"This contract does not directly transfer the underlying assets from the sender to the receiver. Instead it calls the deposit of the Lending Pool which calls the transferFrom of the underlying assets. Hence the sender should not give this contract an allowance to transfer the underlying asset but the Lending Pool instead.","params":{"assets":"The amount of assets of the underlying ERC20 token being deposited.","receiver":"The address that receives the minted shares."},"returns":{"shares":"The amount of shares minted."}},"lock()":{"details":"This function can only be called by the Lending Pool and is triggered exclusively during a severe default event."},"maxDeposit(address)":{"details":"maxDeposit() according the EIP-4626 specification."},"maxMint(address)":{"details":"maxMint() according the EIP-4626 specification."},"maxRedeem(address)":{"details":"maxRedeem() according the EIP-4626 specification."},"maxWithdraw(address)":{"details":"maxWithdraw() according the EIP-4626 specification."},"mint(uint256,address)":{"details":"This contract does not directly transfer the underlying assets from the sender to the receiver. Instead it calls the deposit of the Lending Pool which calls the transferFrom of the underlying assets. Hence the sender should not give this contract an allowance to transfer the underlying asset but the Lending Pool instead.","params":{"receiver":"The address that receives the minted shares.","shares":"The amount of shares minted."},"returns":{"assets":"The amount of assets of the underlying ERC20 token being deposited."}},"previewDepositAndSync(uint256)":{"details":"This function is a modification of previewDeposit() where interests are realized (state modification).","params":{"assets":"The amount of underlying assets deposited."},"returns":{"shares":"The amount of shares minted."}},"previewMint(uint256)":{"params":{"shares":"The amount of shares minted."},"returns":{"assets":"The amount of underlying assets deposited."}},"previewMintAndSync(uint256)":{"details":"This function is a modification of previewMint() where interests are realized (state modification).","params":{"shares":"The amount of shares minted."},"returns":{"assets":"The amount of underlying assets deposited."}},"previewRedeemAndSync(uint256)":{"details":"This function is a modification of previewRedeem() where interests are realized (state modification).","params":{"shares":"The amount of shares redeemed."},"returns":{"assets":"The amount of underlying assets withdrawn."}},"previewWithdraw(uint256)":{"params":{"assets":"The amount of underlying assets withdrawn."},"returns":{"shares":"The amount of shares redeemed."}},"previewWithdrawAndSync(uint256)":{"details":"This function is a modification of previewWithdraw() where interests are realized (state modification).","params":{"assets":"The amount of underlying assets withdrawn."},"returns":{"shares":"The amount of shares redeemed."}},"redeem(uint256,address,address)":{"params":{"owner_":"The address of the owner of the shares being redeemed.","receiver":"The address of the receiver of the underlying ERC20 tokens.","shares":"The amount of shares being redeemed."},"returns":{"assets":"The corresponding amount of assets withdrawn."}},"setAuctionInProgress(bool)":{"details":"Only the Lending Pool can call this function. This function is to make sure no JIT liquidity is provided during a positive auction, and that no liquidity can be withdrawn during a negative auction.","params":{"auctionInProgress_":"Flag indicating if there are auctions in progress."}},"totalAssets()":{"details":"The Liquidity Pool does the accounting of the outstanding claim on liquidity per tranche.","returns":{"assets":"The total amount of underlying assets."}},"totalAssetsAndSync()":{"details":"Modification of totalAssets() where interests are realised (state modification).","returns":{"assets":"The total amount of underlying assets."}},"unLock()":{"details":"Only the Owner can call this function, since tranches are locked due to complete defaults. This function will only be called to partially refund existing share-holders after a default."},"withdraw(uint256,address,address)":{"params":{"assets":"The amount of assets of the underlying ERC20 token being withdrawn.","owner_":"The address of the owner of the assets being withdrawn.","receiver":"The address of the receiver of the underlying ERC20 tokens."},"returns":{"shares":"The corresponding amount of shares redeemed."}}},"title":"Tranche","version":1},"userdoc":{"kind":"user","methods":{"constructor":{"notice":"The constructor for a tranche."},"convertToAssets(uint256)":{"notice":"Conversion rate from shares to assets."},"convertToAssetsAndSync(uint256)":{"notice":"Conversion rate from shares to assets."},"convertToShares(uint256)":{"notice":"Conversion rate from assets to shares."},"convertToSharesAndSync(uint256)":{"notice":"Conversion rate from assets to shares."},"deposit(uint256,address)":{"notice":"Modification of the standard ERC-4626 deposit implementation."},"lock()":{"notice":"Locks the tranche in case all liquidity of the tranche is written off due to bad debt."},"mint(uint256,address)":{"notice":"Modification of the standard ERC-4626 mint implementation."},"previewDepositAndSync(uint256)":{"notice":"Returns the amount of shares minted that correspond to a certain amount of underlying assets deposited."},"previewMint(uint256)":{"notice":"Returns the amount of underlying assets deposited that correspond to a certain amount of shares minted."},"previewMintAndSync(uint256)":{"notice":"Returns the amount of underlying assets deposited that correspond to a certain amount of shares minted."},"previewRedeemAndSync(uint256)":{"notice":"Returns the amount of underlying assets redeemed that correspond to a certain amount of shares withdrawn."},"previewWithdraw(uint256)":{"notice":"Returns the amount of shares redeemed that correspond to a certain amount of underlying assets withdrawn."},"previewWithdrawAndSync(uint256)":{"notice":"Returns the amount of shares redeemed that correspond to a certain amount of underlying assets withdrawn."},"redeem(uint256,address,address)":{"notice":"Modification of the standard ERC-4626 redeem implementation."},"setAuctionInProgress(bool)":{"notice":"Locks the tranche when an auction is in progress."},"totalAssets()":{"notice":"Returns the total amount of underlying assets, to which liquidity providers have a claim."},"totalAssetsAndSync()":{"notice":"Returns the total amount of underlying assets, to which liquidity providers have a claim."},"unLock()":{"notice":"Unlocks the tranche."},"withdraw(uint256,address,address)":{"notice":"Modification of the standard ERC-4626 withdraw implementation."}},"notice":"Each Lending Pool has one or more Tranche(s). Different Tranches receive different yields, but also have different protections against losses due to bad debt: In general the most junior Tranche will have the highest yield, but it will be the first Tranche to absorb losses when liquidations result in bad debt. The Liquidity Providers do not provide Liquidity directly to the Lending Pool, but via a Tranche. As such Liquidity Providers with different risk/reward preferences can provide liquidity to the same Lending Pool (benefitting borrowers with deeper liquidity), but via different Tranches.","version":1}},"settings":{"compilationTarget":{"src/Tranche.sol":"Tranche"},"evmVersion":"shanghai","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@openzeppelin/=lib/accounts-v2/lib/openzeppelin-contracts/",":@uniswap/v3-core/contracts/=lib/accounts-v2/lib/v3-core/contracts/",":accounts-v2/=lib/accounts-v2/",":ds-test/=lib/forge-std/lib/ds-test/src/",":forge-std/=lib/forge-std/src/",":openzeppelin-contracts/=lib/accounts-v2/lib/openzeppelin-contracts/contracts/",":solmate/=lib/solmate/src/",":v3-core/=lib/accounts-v2/lib/v3-core/",":v3-periphery/=lib/accounts-v2/lib/v3-periphery/contracts/"]},"sources":{"lib/solmate/src/auth/Owned.sol":{"keccak256":"0xfedb27d14c508342c33eb067c9a02eabcdb0f9dcf93b04ded1001f580d12d0ea","license":"AGPL-3.0-only","urls":["bzz-raw://1ff52bbee698b9cf9e4574615e6550be0887ccf355f6571e23d6f25b332e79b4","dweb:/ipfs/QmVorA2apojVRStzS7h8aFccR3Uv32G6HVtBtFHZrE7YXx"]},"lib/solmate/src/mixins/ERC4626.sol":{"keccak256":"0xa404f6f45bd53f24a90cc5ffe95e16b52e3f2dfd88f0d7a1edcb35f815919a7b","license":"AGPL-3.0-only","urls":["bzz-raw://9f01e32d713e05cc58c1563e9938a1c5e096b1da9f52c7ea8424f2317b94adc1","dweb:/ipfs/QmVt5SsbA3kezM5pyovupN7iZLy6QVqY5qQRZKLFqxKJUs"]},"lib/solmate/src/tokens/ERC20.sol":{"keccak256":"0xcdfd8db76b2a3415620e4d18cc5545f3d50de792dbf2c3dd5adb40cbe6f94b10","license":"AGPL-3.0-only","urls":["bzz-raw://57b3ab70cde374af1cf2c9888636e8de6cf660f087b1c9abd805e9271e19fa35","dweb:/ipfs/QmNrLDBAHYFjpjSd12jerm1AdBkDqEYUUaXgnT854BUZ97"]},"lib/solmate/src/utils/FixedPointMathLib.sol":{"keccak256":"0x404e4696ec6f3430f1c541ba139ed1e757deb5e2fdcdda8124f36804e6211313","license":"AGPL-3.0-only","urls":["bzz-raw://