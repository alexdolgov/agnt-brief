its","_escrow":"CRV VotingEscrow (0x5f3b5DfEb7B28CDbD7FAba78963EE202a494e2A2)","_minter":"cvxCRV token (0x62B9c7356A2Dc64a1969e19C23e4f579F9810Aa7)","_staker":"CVX VoterProxy (0x989AEb4d175e16225E39E87d0D97A3360524AD80)"}},"deposit(uint256,bool,address)":{"details":"See depositFor(address, uint256, bool, address) "},"depositFor(address,uint256,bool,address)":{"details":"Can lock immediately or defer locking to someone else by paying a fee.         while users can choose to lock or defer, this is mostly in place so that         the cvx reward contract isnt costly to claim rewards.","params":{"_amount":"Units of CRV to deposit","_lock":"Lock now? or pay ~1% to the locker","_stakeAddress":"Stake in cvxCrv staking?"}}},"title":"CrvDepositor","version":1},"userdoc":{"kind":"user","methods":{"deposit(uint256,bool,address)":{"notice":"Deposit crvBpt for cvxCrv on behalf of another user"},"depositFor(address,uint256,bool,address)":{"notice":"Deposit crvBpt for cvxCrv"},"initialLock()":{"notice":"Called once to deposit the balance of CRV in this contract to the VotingEscrow"},"lockCurve()":{"notice":"Locks the balance of CRV, and gives out an incentive to the caller"}},"notice":"This is the entry point for CRV > cvxCRV wrapping. It accepts CRV, sends to 'staker'          for depositing into Curves VotingEscrow, and then mints cvxCRV at 1:1 via the 'minter' (cCrv) minus          the lockIncentive (initially 1%) which is used to basically compensate users who call the `lock` function on Curves          system (larger depositors would likely want to lock).","version":1}},"settings":{"compilationTarget":{"convex-platform/contracts/contracts/CrvDepositor.sol":"CrvDepositor"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-0.6/math/SafeMath.sol":{"keccak256":"0xcc78a17dd88fa5a2edc60c8489e2f405c0913b377216a5b26b35656b2d0dab52","license":"MIT","urls":["bzz-raw://526