nt256,address)":{"details":"Get amount to send for each gauge by epoch","params":{"_epoch":"Epoch","_gauge":"The gauge address"},"returns":{"_0":"Amount to send"}},"getCurrentEpoch()":{"details":"Get the current epoch"},"owner()":{"details":"Returns the address of the current owner."},"processGaugeRewards(uint256,address[])":{"params":{"_epoch":"The epoch","_gauge":"Array of gauges"}},"processSidechainGaugeRewards(address[],uint256,uint16,address,address,bytes,bytes)":{"params":{"_adapterParams":"The adapter params","_dstChainId":"The LayerZero destination chain ID eg optimism is 111","_epoch":"The epoch","_gauge":"Array of gauges","_zroPaymentAddress":"The LayerZero ZRO payment address"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setChildGaugeVoteRewards(uint16,address)":{"details":"Set child gauge vote rewardsThis is the contract on the sidechain that AURA is sent to        which then gets sent to the ChildStashRewardDistro","params":{"_dstChainId":"The dst chain ID","_voteReward":"The vote reward contract on the sidechain"}},"setDistributor(address)":{"details":"Set distributor who can process rewards","params":{"_distributor":"The distributor account"}},"setDstChainId(address[],uint16)":{"details":"Set the dst chain ID","params":{"_dstChainId":"The dst chain ID","_gauges":"The gauge addresses"}},"setIsNoDepositGauge(address,bool)":{"details":"Set if a gauge does not take deposits eg veBAL, veLIT etc","params":{"_gauge":"Gauge address","_isNoDeposit":"If it is a no deposit gauge"}},"setPoolIds(uint256,uint256)":{"details":"Loop through the booster pools and configure each one","params":{"end":"The end index","start":"The start index"}},"setRewardPerEpoch(uint256)":{"details":"Set number of rewards per epoch","params":{"_rewardPerEpoch":"Reward per epoch"}},"transferERC20(address,address,uint256)":{"details":"Transfer ERC20","params":{"_amount":"Amount of tokens to send","_to":"Address to transfer tokens to","_token":"The token address"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"voteGaugeWeight(address[],uint256[])":{"params":{"_gauge":"Array of the gauges","_weight":"Array of the weights"},"returns":{"_0":"bool for success"}}},"stateVariables":{"EPOCH_DURATION":{"details":"Epoch duration"},"TOTAL_WEIGHT_PER_EPOCH":{"details":"Total vote weight per epoch"},"aura":{"details":"Aura token address"},"auraOFT":{"details":"Aura OFT token"},"booster":{"details":"The Booster contract address"},"distributor":{"details":"Distributor address"},"getChildGaugeVoteRewards":{"details":"Chain ID => ChildGaugeVoteRewards"},"getDstChainId":{"details":"Gauge => Src chain ID"},"getPoolId":{"details":"Gauge => Pool ID"},"getTotalWeight":{"details":"Epoch => total weight"},"getWeightByEpoch":{"details":"Epoch => Gauge => Weight"},"isNoDepositGauge":{"details":"Gauge => Is a no deposit gauge like veBAL"},"isProcessed":{"details":"Epoch => Gauge => Has been processed"},"lzChainId":{"details":"LayerZero chain ID for this chain"},"rewardPerEpoch":{"details":"How much total reward per epoch"},"stashRewardDistro":{"details":"Extra reward distro contract"}},"title":"GaugeVoteRewards","version":1},"userdoc":{"kind":"user","methods":{"processGaugeRewards(uint256,address[])":{"notice":"Process gauge rewards for the given epoch for mainnet"},"processSidechainGaugeRewards(address[],uint256,uint16,address,address,bytes,bytes)":{"notice":"Process gauge rewards for the given epoch for sidechains"},"voteGaugeWeight(address[],uint256[])":{"notice":"Wraps the booster.voteGaugeWeight call to track weights for each epoch          So AURA rewards can be distributed pro rata to those pool stashes"}},"notice":"Distribute AURA rewards to each gauge that receives voting weight          for a given epoch.          Gauges receiving votes fall into 3 categories that we need to deal with:          1.  Mainnet gauges with pools on Aura          2.  Sidechain gauges with pools on a sidechain Aura deployment          3.  Gauge that don't take deposits and are not supported by AURA eg veBAL          The process for setting up this contract is:          1.  setRewardPerEpoch(...)          2.  setPoolIds([0...poolLength])          3.  setIsNoDepositGauge(veBAL, veLIT, ...)          4.  setDstChainId([arbGauge, ...], 110)          4.  setDstChainId([optGauge, ...], 111)          4.  setDstChainId([polGauge, ...], 109)          5.  setChildGaugeVoteRewards(...)          The process for each voting epoch (2 weeks) is:          1.  voteGaugeWeight is called with the gauges and weights          2.  processGaugeRewards is called to distribute AURA to the reward distro              for each gauge          3.  processSidechainGaugeRewards sends AURA to sidechain ChildGaugeVoteRewards              along with a payload containing the gauges and amounts to send for the epoch","version":1}},"settings":{"compilationTarget":{"contracts/rewards/GaugeVoteRewards.sol":"GaugeVoteRewards"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":800},"remappings":[]},"sources":{"@openzeppelin/contracts-0.8/access/Ownable.sol":{"keccak256":"0x24e0364e503a9bbde94c715d26573a76f14cd2a202d45f96f52134ab806b67b9","license":"MIT","urls":["bzz-raw://e12cbaa7378fd9b62280e4e1d164bedcb4399ce238f5f98fc0eefb7e50577981","dweb:/ipfs/QmXRoFGUgfsaRkoPT5bxNMtSayKTQ8GZATLPXf69HcRA51"]},"@openzeppelin/contracts-0.8/token/ERC20/IERC20.sol":{"keccak256":"0x61437cb513a887a1bbad006e7b1c8b414478427d33de47c5600af3c748f108da","license":"MIT","urls":["bzz-raw://2c3d0973630ed74f2b5ce3944677a885dc70ec32fc83b35f55045a10224da32b","dweb:/ipfs/QmbefZ5RoEZKNHXCALfh683