ract IFinalizable","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"auraRedemption","outputs":[{"internalType":"contract IAuraRedemption","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"crvBpt","outputs":[{"internalType":"contract IERC20","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_target","type":"address"},{"internalType":"uint256","name":"_value","type":"uint256"},{"internalType":"bytes","name":"_data","type":"bytes"}],"name":"execute","outputs":[{"internalType":"bytes","name":"","type":"bytes"}],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"rAuraRedemption","outputs":[{"internalType":"contract IFinalizable","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_owner","type":"address"}],"name":"setOwner","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"splitAndFinalize","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"stage","outputs":[{"internalType":"enum WindDownCoordinator.Stage","name":"","type":"uint8"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"unlockAndWithdraw","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"voterProxy","outputs":[{"internalType":"contract IVoterProxy","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"votingEscrow","outputs":[{"internalType":"contract IVotingEscrow","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"kind":"dev","methods":{},"title":"WindDownCoordinator","version":1},"userdoc":{"kind":"user","methods":{"execute(address,uint256,bytes)":{"notice":"Generic escape hatch. Used for rotating VoterProxy owner /         operator, rotating ownership of the redemption contracts,         recovering stray tokens, or any other one-off the multisig         needs. Only the coordinator owner can call."},"splitAndFinalize()":{"notice":"Sweep residual treasury tokens from AuraRedemption into         RAuraRedemption, split the BPT by `auraBalBps` into the two         stage-2 contracts, and finalize both. The coordinator filters         the Stage-2 token lists down to tokens with a positive live         balance so fully claimed residuals do not brick finalization."},"unlockAndWithdraw()":{"notice":"Withdraw the BPT from the veBAL lock via the VoterProxy and         pull it into this contract. The VotingEscrow reverts on its         own if the lock has not expired."}},"notice":"Orchestrates the Stage 2 wind-down once the Booster is shut down          and this contract has been granted VoterProxy owner + operator          and ownership of the three redemption contracts.          Flow:            1. unlockAndWithdraw()   — pull BPT out of veBAL into this contract            2. splitAndFinalize()    — sweep residuals, split BPT 90/10,                                       finalize both stage-2 contracts          A generic onlyOwner `execute` is kept for escape hatches (rotate          VoterProxy owner/operator, rotate redemption contract owners,          recover stray tokens).","version":1}},"settings":{"compilationTarget":{"contracts/wind-down/WindDownCoordinator.sol":"WindDownCoordinator"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":800},"remappings":[]},"sources":{"@openzeppelin/contracts-0.8/security/ReentrancyGuard.sol":{"keccak256":"0x0e9621f60b2faabe65549f7ed0f24e8853a45c1b7990d47e8160e523683f3935","license":"MIT","urls":["bzz-raw://287a2f8d5814dd0f05f22b740f18ca8321acc21c9bd03a6cb2203ea626e2f3f2","dweb:/ip