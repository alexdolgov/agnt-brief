uts":[],"name":"pool","outputs":[{"internalType":"contract BPool","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"poolParams","outputs":[{"internalType":"string","name":"poolTokenSymbol","type":"string"},{"internalType":"string","name":"poolTokenName","type":"string"},{"internalType":"uint256","name":"swapFee","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"registerPool","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"rights","outputs":[{"internalType":"bool","name":"canPauseSwapping","type":"bool"},{"internalType":"bool","name":"canChangeSwapFee","type":"bool"},{"internalType":"bool","name":"canChangeWeights","type":"bool"},{"internalType":"bool","name":"canAddRemoveTokens","type":"bool"},{"internalType":"bool","name":"canWhitelistLPs","type":"bool"},{"internalType":"bool","name":"canChangeCap","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"startBlock","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"startCollateralWeight","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"startPool","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"startTokenWeight","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"swapFee","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"tokenAddress","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"withdrawLBPTokens","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"oiler.network","kind":"dev","methods":{"constructor":{"params":{"_BFactoryAddress":"- Balancer Pools Factory address","_BRegistryAddress":"- Balancer registry address","_CRPFactoryAddress":"- Balancer CRP Factory address","_collateralAddress":"- Collateral address","_endBlock":"- LBP end block. NOTE: LBP duration cannot be longer than 500k blocks (2-3 months)","_owner":"- Address of the Multisig contract to become the owner of the LBP Controller","_startBlock":"- LBP start block. NOTE: must be bigger than the block number in which the LBPController deployment tx will be included to the chain","_tokenAddress":"- Address of the token to be distributed during the LBP"}},"createSmartPool()":{"details":"Needs owner to have approved the tokens and collateral before calling this (manually and externally)This LBPController becomes the Controller of the CRP and holds its liquidity tokensMost of the logic was taken from https://github.com/balancer-labs/bactions-proxy/blob/master/contracts/BActions.sol"},"endPool()":{"details":"Can be called by anyone after LBP end block"},"getWeights()":{"returns":{"collateralWeight":"collateralWeight","tokenWeight":"tokenWeight"}},"owner()":{"details":"Returns the address of the current owner."},"pokeWeights()":{"details":"Can be called by anyone after LBP start blockJust calling CRP function - for simpler FrontEnd access"},"registerPool()":{"details":"Can only be called by the Owner after createSmartPool()"},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"startPool()":{"details":"Can be called by anyone after LBP start block"},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"withdrawLBPTokens()":{"details":"If we withdraw the LP Tokens - we cannot kill the pool with endPool() unless we put 100% of LP Tokens back.All the underlying assets of bPool can be withdrawn if you have LP Tokens - via exitPool() function of CRP.You cannot withdraw 100% of assets because of bPool MIN_BALANCE restriction (minimum balance of any token in bPool should be at least 1 000 000 wei).But you can withdraw 99.999% of assets (BONE*99999/1000) which leaves just 1 Collateral token and 17 Tokens in bPool if called before LBP has any trades.This escape hatch is deliberately not disabled during the LBP run (although we could) - just for the sake of our peace of mind - that we can withdraw anytime.If you do a withdrawal (partial or full) - you can still endPool() if you put all the remaining LP Token balance back to LBPController."}},"stateVariables":{"BFactoryAddress":{"details":"Balancer Pools Factory address"},"BRegistryAddress":{"details":"Balancer's Registry address"},"CRPFactoryAddress":{"details":"Balancer's Configurable Rights Pools Factory address"},"ConstituentsCount":{"details":"Number of different tokens used in the pool -> collateral and token"},"TokenIndex":{"details":"Enum-like constants used as array-indices for better readability"},"collateralAddress":{"details":"Address of the collateral token to be used during the LBP"},"tokenAddress":{"details":"Address of the token to be distributed during the LBP"}},"title":"LBP Controller","version":1},"userdoc":{"kind":"user","methods":{"createSmartPool()":{"notice":"Creates the CRP smart pool and initializes its parameters"},"endPool()":{"notice":"End the trading on the pool, destroys pool, and sends all funds to OwnerWorks only if LBPController has 100% of LP Pool Tokens in it,otherwise one of the removeToken() will lack them and revert the entire endPool() transaction"},"getWeights()":{"notice":"Get the current weights of the LBP"},"pokeWeights()":{"notice":"Poke Weights must be called at regular intervals - so the LBP price gradually changes"},"registerPool()":{"notice":"Registers the newly created BPool into the Balancer Registry, so it appears on Balancer app website"},"startPool()":{"notice":"Starts the trading on the pool"},"withdrawLBPTokens()":{"notice":"Escape Hatch - in case the Owner wants to withdraw Liquidity Tokens"}},"notice":"Helper contract used to initialize and manage the Balancer LBP and its underlying contracts such as BPool and CRP","version":1}},"settings":{"compilationTarget":{"contracts/LBPController.sol":"LBPController"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1000},"remappings":[]},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0x15e2d5bd4c28a88548074c54d220e8086f638a71ed07e6b3ba5a70066fcf458d","license":"MIT","urls":["bzz-raw://90faf5851c02f9bd42c5bfb54d4f0421a2612f50ab80b2c4fa24fa3792071cc2","dweb:/ipfs/QmRGM4F2PcGVF85aTfaA9YBhCHHDqrMhRjyp6fGeBTtirb"]},"@openzeppelin/contracts/token/ERC20/IERC20.sol":{"keccak256":"0x5f02220344881ce43204ae4a6281145a67bc52c2bb1290a791857df3d19d78f5","license":"MIT","urls":["bzz-raw://24427744bd3e6cb73c17010119af12a318289c0253a4d9acb8576c9fb3797b08","dweb:/ipfs/QmTLDqpKRBuxGxRAmjgXt9AkXyACW3MtKzi7PYjm5iMfGC"]},"@openzeppelin/contracts/utils/Context.sol":{"keccak256":"0x8d3cb350f04ff49cfb10aef08d87f19dcbaecc8027b0bed12f3275cd12f38cf0","license":"MIT","urls":["bzz-raw://ded47ec7c96750f9bd04bbbc84f659992d4ba901cb7b532a52cd468272cf378f","dweb:/ipfs/QmfBrGtQP7rZEqEg6Wz6jh2N2Kukpj1z5v3CGWmAqrzm96"]},"contracts/LBPController.sol":{"keccak256":"0x00970a99419e970779b5fdc0cc3f3950ec0fdb703a3f3eb706a84606a8683c06","license":"MIT","urls":["bzz-raw://9dc43b228a23986d0fdd3a66da4a72848d170adeb0a3e2bd4f494f7841eb3b29","dweb:/ipfs/QmS3Ed