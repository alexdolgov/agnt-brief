 to withdraw funds from","to":"destination address for sending remaining funds"}},"withdrawPayment(address,address)":{"params":{"from":"keeper address","to":"address to send the payment to"}}},"version":1},"userdoc":{"kind":"user","methods":{"acceptPayeeship(address)":{"notice":"accepts the safe transfer of payee role for a keeper"},"addFunds(uint256,uint96)":{"notice":"adds LINK funding for an upkeep by tranferring from the sender's LINK balance"},"cancelUpkeep(uint256)":{"notice":"prevent an upkeep from being performed in the future"},"checkUpkeep(uint256,address)":{"notice":"simulated by keepers via eth_call to see if the upkeep needs to be performed. If it does need to be performed then the call simulates the transaction performing upkeep to make sure it succeeds. It then eturns the success status along with payment information and the perform data payload."},"getCanceledUpkeepList()":{"notice":"read the current list canceled upkeep IDs"},"getConfig()":{"notice":"read the current configuration of the registry"},"getKeeperInfo(address)":{"notice":"read the current info about any keeper address"},"getKeeperList()":{"notice":"read the current list of addresses allowed to perform upkeep"},"getUpkeep(uint256)":{"notice":"read all of the details about an upkeep"},"getUpkeepCount()":{"notice":"read the total number of upkeep's registered"},"onTokenTransfer(address,uint256,bytes)":{"notice":"uses LINK's transferAndCall to LINK and add funding to an upkeep"},"performUpkeep(uint256,bytes)":{"notice":"executes the upkeep with the perform data returned from checkUpkeep, validates the keeper's permissions, and pays the keeper."},"recoverFunds()":{"notice":"recovers LINK funds improperly transfered to the registry"},"registerUpkeep(address,uint32,address,bytes)":{"notice":"adds a new upkeep"},"setConfig(uint32,uint24,uint32,uint24,int256,int256)":{"notice":"updates the configuration of the registry"},"setKeepers(address[],address[])":{"notice":"update the list of keepers allo