e":"uint256"},{"name":"_sourceReserveWeight","type":"uint32"},{"name":"_targetReserveBalance","type":"uint256"},{"name":"_targetReserveWeight","type":"uint32"},{"name":"_amount","type":"uint256"}],"name":"crossReserveRate","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"name":"_supply","type":"uint256"},{"name":"_reserveBalance","type":"uint256"},{"name":"_reserveRatio","type":"uint32"},{"name":"_amount","type":"uint256"}],"name":"calculateLiquidateReturn","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"name":"_supply","type":"uint256"},{"name":"_reserveBalance","type":"uint256"},{"name":"_reserveRatio","type":"uint32"},{"name":"_amount","type":"uint256"}],"name":"fundCost","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"name":"_supply","type":"uint256"},{"name":"_reserveBalance","type":"uint256"},{"name":"_reserveWeight","type":"uint32"},{"name":"_amount","type":"uint256"}],"name":"purchaseTargetAmount","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"name":"_supply","type":"uint256"},{"name":"_reserveBalance","type":"uint256"},{"name":"_reserveWeight","type":"uint32"},{"name":"_amount","type":"uint256"}],"name":"saleRate","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"inputs":[],"payable":false,"stateMutability":"nonpayable","type":"constructor"}],"devdoc":{"methods":{"calculateCrossConnectorReturn(uint256,uint32,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"calculateCrossReserveReturn(uint256,uint32,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"calculateFundCost(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"calculateLiquidateReturn(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"calculatePurchaseReturn(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"calculateSaleReturn(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"crossReserveRate(uint256,uint32,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"crossReserveTargetAmount(uint256,uint32,uint256,uint32,uint256)":{"details":"given two reserve balances/weights and a sell amount (in the first reserve token),\r calculates the target amount for a conversion from the source reserve token to the target reserve token\r       * Formula:\r return = _targetReserveBalance * (1 - (_sourceReserveBalance / (_sourceReserveBalance + _amount)) ^ (_sourceReserveWeight / _targetReserveWeight))\r ","params":{"_amount":"source reserve amount\r ","_sourceReserveBalance":"source reserve balance\r","_sourceReserveWeight":"source reserve weight, represented in ppm (1-1000000)\r","_targetReserveBalance":"target reserve balance\r","_targetReserveWeight":"target reserve weight, represented in ppm (1-1000000)\r"},"return":"target reserve amount\r"},"fundCost(uint256,uint256,uint32,uint256)":{"details":"given a smart token supply, reserve balance, reserve ratio and an amount of requested smart tokens,\r calculates the amount of reserve tokens required for purchasing the given amount of smart tokens\r       * Formula:\r return = _reserveBalance * (((_supply + _amount) / _supply) ^ (MAX_WEIGHT / _reserveRatio) - 1)\r ","params":{"_amount":"requested amount of smart tokens\r ","_reserveBalance":"reserve balance\r","_reserveRatio":"reserve ratio, represented in ppm (2-2000000)\r","_supply":"smart token supply\r"},"return":"reserve token amount\r"},"fundSupplyAmount(uint256,uint256,uint32,uint256)":{"details":"given a smart token supply, reserve balance, reserve ratio and an amount of reserve tokens to fund with,\r calculates the amount of smart tokens received for purchasing with the given amount of reserve tokens\r       * Formula:\r return = _supply * ((_amount / _reserveBalance + 1) ^ (_reserveRatio / MAX_WEIGHT) - 1)\r ","params":{"_amount":"amount of reserve tokens to fund with\r ","_reserveBalance":"reserve balance\r","_reserveRatio":"reserve ratio, represented in ppm (2-2000000)\r","_supply":"smart token supply\r"},"return":"smart token amount\r"},"liquidateRate(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"liquidateReserveAmount(uint256,uint256,uint32,uint256)":{"details":"given a smart token supply, reserve balance, reserve ratio and an amount of smart tokens to liquidate,\r calculates the amount of reserve tokens received for selling the given amount of smart tokens\r       * Formula:\r return = _reserveBalance * (1 - ((_supply - _amount) / _supply) ^ (MAX_WEIGHT / _reserveRatio))\r ","params":{"_amount":"amount of smart tokens to liquidate\r ","_reserveBalance":"reserve balance\r","_reserveRatio":"reserve ratio, represented in ppm (2-2000000)\r","_supply":"smart token supply\r"},"return":"reserve token amount\r"},"purchaseRate(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"purchaseTargetAmount(uint256,uint256,uint32,uint256)":{"details":"given a token supply, reserve balance, weight and a deposit amount (in the reserve token),\r calculates the target amount for a given conversion (in the main token)\r       * Formula:\r return = _supply * ((1 + _amount / _reserveBalance) ^ (_reserveWeight / 1000000) - 1)\r ","params":{"_amount":"amount of reserve tokens to get the target amount for\r ","_reserveBalance":"reserve balance\r","_reserveWeight":"reserve weight, represented in ppm (1-1000000)\r","_supply":"smart token supply\r"},"return":"smart token amount\r"},"saleRate(uint256,uint256,uint32,uint256)":{"details":"deprecated, backward compatibility\r"},"saleTargetAmount(uint256,uint256,uint32,uint256)":{"details":"given a token supply, reserve balance, weight and a sell amount (in the main token),\r calculates the target amount for a given conversion (in the reserve token)\r       * Formula:\r return = _reserveBalance * (1 - (1 - _amount / _supply) ^ (1000000 / _reserveWeight))\r ","params":{"_amount":"amount of smart tokens to get the target amount for\r ","_reserveBalance":"reserve balance\r","_reserveWeight":"reserve weight, represented in ppm (1-1000000)\r","_supply":"smart token supply\r"},"return":"reserve token amount\r"}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"BancorFormula.sol":"BancorFormula"},"evmVersion":"byzantium","libraries":{},"optimizer":{"enabled":true,"runs":20000},"remappings":[]},"sources":{"BancorFormula.sol":{"keccak256":"0x2a19167f41fd4f4441454cdfcff7ccdd684960f89b5f1251f2f27816a8475eb4","urls":["bzzr://8df2ced3335339ad6c9dea4a0b560a8e8f2aef83837be703dff4b3d907f281d1"]}},"version":1}