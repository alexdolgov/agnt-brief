"used by a new owner to accept an ownership transfer\r"},"acceptTokenOwnership()":{"details":"used by a new owner to accept a token ownership transfer\r can only be called by the contract owner\r"},"addConnector(address,uint32,bool)":{"details":"defines a new connector for the token\r can only be called by the owner while the converter is inactive\r","params":{"_enableVirtualBalance":"true to enable virtual balance for the connector, false to disable it\r","_token":"address of the connector token\r","_weight":"constant connector weight, represented in ppm, 1-1000000\r"}},"connectorTokenCount()":{"details":"returns the number of connector tokens defined\r","return":"number of connector tokens\r"},"convert(address,address,uint256,uint256)":{"details":"converts a specific amount of _fromToken to _toToken\r","params":{"_amount":"amount to convert, in fromToken\r","_fromToken":"ERC20 token to convert from\r","_minReturn":"if the conversion results in an amount smaller than the minimum return - it is cancelled, must be nonzero\r","_toToken":"ERC20 token to convert to\r"},"return":"conversion return amount\r"},"convertInternal(address,address,uint256,uint256)":{"details":"converts a specific amount of _fromToken to _toToken\r","params":{"_amount":"amount to convert, in fromToken\r","_fromToken":"ERC20 token to convert from\r","_minReturn":"if the conversion results in an amount smaller than the minimum return - it is cancelled, must be nonzero\r","_toToken":"ERC20 token to convert to\r"},"return":"conversion return amount\r"},"disableConnectorPurchases(address,bool)":{"details":"disables purchasing with the given connector token in case the connector token got compromised\r can only be called by the owner\r note that selling is still enabled regardless of this flag and it cannot be disabled by the owner\r","params":{"_connectorToken":"connector token contract address\r","_disable":"true to disable the token, false to re-enable it\r"}},"disableConversions(bool)":{"details":"disables the entire conversion functionality\r this is a safety mechanism in case of a emergency\r can only be called by the manager\r","params":{"_disable":"true to disable conversions, false to re-enable them\r"}},"disableTokenTransfers(bool)":{"details":"disables/enables token transfers\r can only be called by the contract owner\r","params":{"_disable":"true to disable transfers, false to enable them\r"}},"getConnectorBalance(address)":{"details":"returns the connector's virtual balance if one is defined, otherwise returns the actual balance\r","params":{"_connectorToken":"connector token contract address\r"},"return":"connector balance\r"},"getCrossConnectorReturn(address,address,uint256)":{"details":"returns the expected return for selling one of the connector tokens for another connector token\r","params":{"_fromConnectorToken":"contract address of the connector token to convert from\r","_sellAmount":"amount to sell (in the from connector token)\r","_toConnectorToken":"contract address of the connector token to convert to\r"},"return":"expected sale return amount (in the to connector token)\r"},"getPurchaseReturn(address,uint256)":{"details":"returns the expected return for buying the token for a connector token\r","params":{"_connectorToken":"connector token contract address\r","_depositAmount":"amount to deposit (in the connector token)\r"},"return":"expected purchase return amount\r"},"getQuickBuyPathLength()":{"details":"returns the length of the quick buy path array\r","return":"quick buy path length\r"},"getReturn(address,address,uint256)":{"details":"returns the expected return for converting a specific amount of _fromToken to _toToken\r","params":{"_amount":"amount to convert, in fromToken\r","_fromToken":"ERC20 token to convert from\r","_toToken":"ERC20 token to convert to\r"},"return":"expected conversion return amount\r"},"getSaleReturn(address,uint256)":{"details":"returns the expected return for selling the token for one of its connector tokens\r","params":{"_connectorToken":"connector token contract address\r","_sellAmount":"amount to sell (in the smart token)\r"},"return":"expected sale return amount\r"},"quickConvert(address[],uint256,uint256)":{"details":"converts the token to any other token in the bancor network by following a predefined conversion path\r note that when converting from an ERC20 token (as opposed to a smart token), allowance must be set beforehand\r","params":{"_amount":"amount to convert from (in the initial source token)\r","_minReturn":"if the conversion results in an amount smaller than the minimum return - it is cancelled, must be nonzero\r","_path":"conversion path, see conversion path format in the BancorNetwork contract\r"},"return":"tokens issued in return\r"},"quickConvertPrioritized(address[],uint256,uint256,uint256,uint8,bytes32,bytes32)":{"details":"converts the token to any other token in the bancor network by following a predefined conversion path\r note that when converting from an ERC20 token (as opposed to a smart token), allowance must be set beforehand\r","params":{"_amount":"amount to convert from (in the initial source token)\r","_block":"if the current block exceeded the given parameter - it is cancelled\r","_minReturn":"if the conversion results in an amount smaller than the minimum return - it is cancelled, must be nonzero\r","_path":"conversion path, see conversion path format in the BancorNetwork contract\r","_r":"(signature[0:64]) associated with the signer address and helps validating if the signature is legit\r","_s":"(signature[64:128]) associated with the signer address and helps validating if the signature is legit\r","_v":"(signature[128:130]) associated with the signer address and helps validating if the signature is legit\r"},"return":"tokens issued in return\r"},"setConversionFee(uint32)":{"details":"updates the current conversion fee\r can only be called by the manager\r","params":{"_conversionFee":"new conversion fee, represented in ppm\r"}},"transferManagement(address)":{"details":"allows transferring the contract management\r the new manager still needs to accept the transfer\r can only be called by the contract manager\r","params":{"_newManager":"new contract manager\r"}},"transferOwnership(address)":{"details":"allows transferring the contract ownership\r the new owner still needs to accept the transfer\r can only be called by the contract owner\r","params":{"_newOwner":"new contract owner\r"}},"transferTokenOwnership(address)":{"details":"allows transferring the token ownership\r the new owner still need to accept the transfer\r can only be called by the contract owner\r","params":{"_newOwner":"new token owner\r"}},"updateConnector(address,uint32,bool,uint256)":{"details":"updates one of the token connectors\r can only be called by the owner\r","params":{"_connectorToken":"address of the connector token\r","_enableVirtualBalance":"true to enable virtual balance for the connector, false to disable it\r","_virtualBalance":"new connector's virtual balance\r","_weight":"constant connector weight, represented in ppm, 1-1000000\r"}},"withdrawFromToken(address,address,uint256)":{"details":"withdraws tokens held by the controller and sends them to an account\r can only be called by the owner\r","params":{"_amount":"amount to withdraw\r","_to":"account to receive the new amount\r","_token":"ERC20 token contract address\r"}},"withdrawTokens(address,address,uint256)":{"details":"withdraws tokens held by the contract and sends them to an account\r can only be called by the owner\r","params":{"_amount":"amount to withdraw\r","_to":"account to receive the new amount\r","_token":"ERC20 token contract address\r"}}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"BancorConverter.sol":"BancorConverter"},"evmVersion":"byzantium","libraries":{},"optimizer":{"enabled":true,"runs":500},"remappings":[]},"sources":{"BancorConverter.sol":{"keccak256":"0x47499bd80153107099b8115b829e3d66aae84356e2d8da5da002e9dddcee9c4c","urls":["bzzr://9cad91316e47d64ecc2dc1cbb423f0f9046daf83f213c6f024392c80d62ce12d"]}},"version":1}