les DAO to transfer NFTs received","params":{"nftContractAddress":"the address of the NFT contract","recipient":"the address to send the NFT to","tokenId":"the id of the token in the NFT contract"},"returns":{"_0":"success or fail bool"}},"transferNativeToken(address,uint256)":{"details":"enables DAO to transfer the token it is associated with","params":{"amount":"the amount to send","to":"the address to send tokens to"},"returns":{"_0":"success or fail bool"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateProposalStatus(uint256)":{"details":"Moves proposal to the status it should be in","params":{"proposalIndex":"uint proposal key"}},"vote(uint256,bool)":{"details":"Allows any address to vote on a proposal","params":{"_vote":"true = for, false = against","proposalIndex":"key to proposal in mapping"}}},"version":1},"userdoc":{"kind":"user","methods":{"emergencyNftApproval(uint256,uint256)":{"notice":"can only be called after shutdown, is called during shutdown"},"emergencyProposalCancellation(uint256,uint256)":{"notice":"can only be called after shutdown, is called during shutdown"},"emergencyShutdown()":{"notice":"this is an irreversible process!"},"onERC721Received(address,address,uint256,bytes)":{"notice":"calls \"super\" to the OpenZeppelin function inherited"}},"version":1}},"settings":{"compilationTarget":{"contracts/Raphael.sol":"Raphael"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0x1cae4f85f114ff17b90414f5da67365b1d00337abb5bce9bf944eb78a2c0673c","license":"MIT","urls":["bzz-raw://d5ff16b336ce8f906478d5f2eecc6435e00833bdc0b92f6b209cf9e92cb5b2b7","dweb:/ipfs/QmRD1rAZEqQ73C33cdA3QoUyBDMEWnNKNMc6PNkAZWHeQQ"]},"@openzeppelin/contracts/security/ReentrancyGuard.sol":{"keccak256":"0x1278c76b840063ff