unction"},{"inputs":[{"internalType":"address","name":"fleetCommander","type":"address"},{"internalType":"uint256","name":"assets","type":"uint256"}],"name":"exitFleet","outputs":[{"internalType":"uint256","name":"shares","type":"uint256"}],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"fleetCommanderRewardsManagerFactory","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"harborCommand","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"aToken","type":"address"},{"internalType":"uint256","name":"assets","type":"uint256"}],"name":"moveFromAaveToAdmiralsQuarters","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"cToken","type":"address"},{"internalType":"uint256","name":"assets","type":"uint256"}],"name":"moveFromCompoundToAdmiralsQuarters","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"vault","type":"address"},{"internalType":"uint256","name":"shares","type":"uint256"}],"name":"moveFromERC4626ToAdmiralsQuarters","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bytes[]","name":"data","type":"bytes[]"}],"name":"multicall","outputs":[{"internalType":"bytes[]","name":"results","type":"bytes[]"}],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"raft","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"contract IERC20","name":"token","type":"address"},{"internalType":"address","name":"to","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"rescueTokens","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"fleetCommander","type":"address"},{"internalType":"uint256","name":"shares","type":"uint256"}],"name":"stake","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[{"internalType":"contract IERC20","name":"fromToken","type":"address"},{"internalType":"contract IERC20","name":"toToken","type":"address"},{"internalType":"uint256","name":"assets","type":"uint256"},{"internalType":"uint256","name":"minTokensReceived","type":"uint256"},{"internalType":"bytes","name":"swapCalldata","type":"bytes"}],"name":"swap","outputs":[{"internalType":"uint256","name":"swappedAmount","type":"uint256"}],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"tipJar","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"treasury","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"fleetCommander","type":"address"},{"internalType":"uint256","name":"shares","type":"uint256"},{"internalType":"bool","name":"claimRewards","type":"bool"}],"name":"unstakeAndWithdrawAssets","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"contract IERC20","name":"asset","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"withdrawTokens","outputs":[],"stateMutability":"payable","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"details":"A contract for managing deposits and withdrawals to/from FleetCommander contracts,      with integrated swapping functionality using 1inch Router.How to use this contract: 1. Deposit tokens: Use `depositTokens` to deposit ERC20 tokens into the contract. 2. Withdraw tokens: Use `withdrawTokens` to withdraw deposited tokens. 3. Enter a fleet: Use `enterFleet` to deposit tokens into a FleetCommander contract. 4. Exit a fleet: Use `exitFleet` to withdraw tokens from a FleetCommander contract. 5. Swap tokens: Use `swap` to exchange one token for another using the 1inch Router. 6. Rescue tokens: Contract owner can use `rescueTokens` to withdraw any tokens stuck in the contract.Multicall functionality: This contract inherits from OpenZeppelin's Multicall, allowing multiple function calls to be batched into a single transaction. To use Multicall: 1. Encode each function call you want to make as calldata. 2. Pack these encoded function calls into an array of bytes. 3. Call the `multicall` function with this array as the argument. Example Multicall usage: bytes[] memory calls = new bytes[](2); calls[0] = abi.encodeWithSelector(this.depositTokens.selector, tokenAddress, amount); calls[1] = abi.encodeWithSelector(this.enterFleet.selector, fleetCommanderAddress, tokenAddress, amount); (bool[] memory successes, bytes[] memory results) = this.multicall(calls);Security considerations: - All external functions are protected against reentrancy attacks. - The contract uses OpenZeppelin's SafeERC20 for safe token transfers. - Only the contract owner can rescue tokens. - Ensure that the 1inch Router address provided in the constructor is correct and trusted. - Since there is no data exchange between calls - make sure all the tokens are returned to the user","errors":{"AddressEmptyCode(address)":[{"details":"There's no code at `target` (it is not a contract)."}],"FailedCall()":[{"details":"A call to an address target failed. The target may have reverted."}],"OwnableInvalidOwner(address)":[{"details":"The owner is not a valid owner account. (eg. `address(0)`)"}],"OwnableUnauthorizedAccount(address)":[{"details":"The caller account is not authorized to perform an operation."}],"ReentrancyGuardReentrantCall()":[{"details":"Unauthorized reentrant call."}],"SafeERC20FailedOperation(address)":[{"details":"An operation with an ERC-20 token failed."}]},"events":{"AavePositionImported(address,address,uint256)":{"details":"Emitted when a user's aave position is imported.","params":{"aToken":"The address of the aToken being imported.","amount":"The amount of tokens being imported.","user":"The address of the user whose position is imported."}},"CompoundPositionImported(address,address,uint256)":{"details":"Emitted when a user's compound position is imported.","params":{"amount":"The amount of tokens being imported.","cToken":"The address of the cToken being imported.","user":"The address of the user whose position is imported."}},"ERC4626PositionImported(address,address,uint256)":{"details":"Emitted when a user's erc4626 position is imported.","params":{"amount":"The amount of tokens being imported.","user":"The address of the user whose position is imported.","vault":"The address of the vault being imported."}},"FleetEntered(address,address,uint256,uint256)":{"details":"Emitted when a user enters a fleet with their tokens.","params":{"fleetCommander":"The address of the FleetCommander contract.","inputAmount":"The amount of tokens the user input into the fleet.","sharesReceived":"The amount of shares the user received in return.","user":"The address of the user who entered the fleet."}},"FleetExited(address,address,uint256,uint256)":{"details":"Emitted when a user exits a fleet, withdrawing their tokens.","params":{"fleetCommander":"The address of the FleetCommander contract.","outputAmount":"The amount of tokens received in return.","user":"The address of the user who exited the fleet.","withdrawnAmount":"The amount of shares withdrawn from the fleet."}},"FleetSharesStaked(address,address,uint256)":{"details":"Emitted when a user stakes their fleet shares.","params":{"amount":"The amount of shares staked.","fleetCommander":"The address of the FleetCommander contract.","user":"The address of the user who staked their shares."}},"FleetSharesUnstaked(address,address,uint256)":{"details":"Emitted when a user unstakes their fleet shares.","params":{"amount":"The amount of shares unstaked.","fleetCommander":"The address of the FleetCommander contract.","user":"The address of the user who unstaked their shares."}},"Swapped(address,address,address,uint256,uint256)":{"details":"Emitted when a token swap occurs.","params":{"fromAmount":"The amount of tokens swapped from.","fromToken":"The address of the token being swapped from.","toAmount":"The amount of tokens received in the swap.","toToken":"The address of the token being swapped to.","user":"The address of the user who performed the swap."}},"TokensDeposited(address,address,uint256)":{"details":"Emitted when tokens are deposited into the AdmiralsQuarters.","params":{"amount":"The amount of tokens that were deposited.","token":"The address of the token that was deposited.","user":"The address of the user who deposited the tokens."}},"TokensRescued(address,address,uint256)":{"details":"Emitted when tokens are rescued from the contract by the owner.","params":{"amount":"The amount of tokens that were rescued.","to":"The address that received the rescued tokens.","token":"The address of the token that was rescued."}},"TokensWithdrawn(address,address,uint256)":{"details":"Emitted when tokens are withdrawn from the AdmiralsQuarters.","params":{"amount":"The amount of tokens that were withdrawn.","token":"The address of the token that was withdrawn.","user":"The address of the user who withdrew the tokens."}}},"kind":"dev","methods":{"claimFleetRewards(address[],address)":{"params":{"fleetCommanders":"Array of FleetCommander addresses","rewardToken":"Address of the reward token to claim"}},"claimGovernanceRewards(address,address)":{"params":{"govRewardsManager":"Address of the governance rewards manager","rewardToken":"Address of the reward token to claim"}},"claimMerkleRewards(address,uint256[],uint256[],bytes32[][],address)":{"params":{"amounts":"Array of merkle proof amounts","indices":"Array of merkle proof indices","proofs":"Array of merkle proof data","rewardsRedeemer":"Address of the rewards redeemer contract","user":"Address to claim rewards for"}},"depositTokens(address,uint256)":{"details":"Emits a TokensDeposited event","params":{"amount":"The amount of tokens to deposit","asset":"The token to be deposited"}},"enterFleet(address,uint256,address)":{"details":"Emits a FleetEntered event","params":{"assets":"The amount of inputToken to be deposited (0 for all)","fleetCommander":"The address of the FleetCommander contract","receiver":"The address to receive the shares"},"returns":{"shares":"The number of shares received from the FleetCommander"}},"exitFleet(address,uint256)":{"details":"Emits a FleetExited event","params":{"assets":"The amount of shares to withdraw (0 for all)","fleetCommander":"The address of the FleetCommander contract"},"returns":{"shares":"The amount of assets received from the FleetCommander"}},"fleetCommanderRewardsManagerFactory()":{"returns":{"_0":"The address of the Fleet Commander Rewards Manager Factory contract"}},"harborCommand()":{"returns":{"_0":"The address of the HarborCommand contract"}},"moveFromAaveToAdmiralsQuarters(address,uint256)":{"details":"If zero amount is provided, the full balance of the aToken is importedneeds approval from the user to transfer from their wallet (e.g. aUSDC.approve(address(admiralsQuarters), type(uint256).max))approval requires small buffer due to constant accrual of interestEmits an AavePositionImported event","params":{"aToken":"The address of the Aave aToken","amount":"The amount of tokens to import"}},"moveFromCompoundToAdmiralsQuarters(address,uint256)":{"details":"If zero amount is provided, the full balance of the cToken is importedneeds approval from the user to withdraw on their behalf (e.g. cUSDC.allow(address(admiralsQuarters),true))Emits a CompoundPositionImported event","params":{"amount":"The amount of tokens to import","cToken":"The address of the Compound cToken"}},"moveFromERC4626ToAdmiralsQuarters(address,uint256)":{"details":"If zero shares are provided, the full balance of the vault is importedneeds approval from the user to withdraw on their behalf (e.g. ERC4626Vault.approve(address(admiralsQuarters), type(uint256).max))Emits an ERC4626PositionImported event","params":{"shares":"The amount of vault tokens to import","vault":"The address of the ERC4626 vault"}},"multicall(bytes[])":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Receives and executes a batch of function calls on this contract."},"owner()":{"details":"Returns the address of the current owner."},"raft()":{"returns":{"_0":"The address of the Raft contract"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"rescueTokens(address,address,uint256)":{"details":"Can only be called by the contract ownerEmits a TokensRescued event","params":{"amount":"The amount of tokens to rescue","to":"The address to send the rescued tokens to","token":"The address of the ERC20 token to rescue"}},"stake(address,uint256)":{"details":"If zero shares are provided, the full balance of the FleetCommander is stakedEmits a FleetSharesStaked event","params":{"fleetCommander":"The address of the FleetCommander contract","shares":"The amount of shares to stake"}},"swap(address,address,uint256,uint256,bytes)":{"details":"Emits a Swapped event","params":{"amount":"The amount of fromToken to swap","fromToken":"The token to swap from","minTokensReceived":"The minimum amount of toToken to receive after the swap","swapCalldata":"The calldata for the 1inch swap","toToken":"The token to swap to"},"returns":{"swappedAmount":"The amount of toToken received after the swap"}},"tipJar()":{"returns":{"_0":"The address of the TipJar contract"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"treasury()":{"returns":{"_0":"The address of the Treasury contract"}},"unstakeAndWithdrawAssets(address,uint256,bool)":{"details":"If zero shares are provided, the full balance of the FleetCommander is unstakedEmits a FleetSharesUnstaked event","params":{"claimRewards":"Whether to claim rewards before unstaking","fleetCommander":"The address of the FleetCommander contract","shares":"The amount of shares to unstake"}},"withdrawTokens(address,uint256)":{"details":"Emits a TokensWithdrawn event","params":{"amount":"The amount of tokens to withdraw (0 for all)","asset":"The token to be withdrawn"}}},"title":"AdmiralsQuarters","version":1},"userdoc":{"errors":{"AssetMismatch()":[{"notice":"Thrown when there's a mismatch between expected and actual assets in an operation."}],"InsufficientOutputAmount()":[{"notice":"Thrown when the output amount from an operation is less than the expected minimum."}],"InvalidFleetCommander()":[{"notice":"Thrown when an invalid FleetCommander address is provided or used."}],"InvalidNativeAmount()":[{"notice":"Thrown when the provided native amount does not match the expected native amount."}],"InvalidNativeTokenAddress()":[{"notice":"Thrown when an invalid WETH address is provided or used."}],"InvalidRewardsManager()":[{"notice":"Thrown when the provided rewards manager is invalid."}],"InvalidRewardsRedeemer()":[{"notice":"Thrown when the provided rewards redeemer is invalid."}],"InvalidRouterAddress()":[{"notice":"Thrown when an invalid router address is provided or used."}],"InvalidToken()":[{"notice":"Thrown when an invalid token address is pr