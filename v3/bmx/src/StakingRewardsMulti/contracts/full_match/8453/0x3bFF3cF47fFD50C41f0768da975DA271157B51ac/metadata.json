dress)":{"details":"Checks for all rewardTokens.","params":{"_account":"Account to check earned balance for."},"returns":{"pending":"Amount of reward token(s) pending claim."}},"getOneReward(address)":{"details":"Can claim rewards even if no tokens still staked.","params":{"_rewardsToken":"Address of the rewards token to claim."}},"getReward()":{"details":"Can claim rewards even if no tokens still staked."},"getRewardForDuration(address)":{"details":"These values are only updated when notifying, adding, or adjust duration of rewards.","params":{"_rewardsToken":"Reward token to check."},"returns":{"_0":"Total reward token remaining to be paid out."}},"initialize(address,address,address)":{"details":"This should only be called by the clone function above.","params":{"_owner":"Owner of the new staking contract.","_stakingToken":"Address of our staking token.","_zapContract":"Address of our zap contract."}},"lastTimeRewardApplicable(address)":{"params":{"_rewardsToken":"Reward token to check."},"returns":{"_0":"Timestamp of last time reward applicable for token."}},"notifyRewardAmount(address,uint256)":{"details":"May only be called by rewards distribution role. Set up token first via addReward().","params":{"_rewardAmount":"Amount of reward tokens to add.","_rewardsToken":"Address of the rewards token."}},"owner()":{"details":"Returns the address of the current owner."},"pendingOwner()":{"details":"Returns the address of the pending owner."},"recoverERC20(address,uint256)":{"details":"May only be called by owner. If a pool has multiple tokens to sweep out, call this once for each.","params":{"_tokenAddress":"Address of token to sweep.","_tokenAmount":"Amount of tokens to sweep."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"rewardPerToken(address)":{"params":{"_rewardsToken":"Reward token to check."},"returns":{"rewardAmount":"Reward paid out per whole token."}},"setRewardsDistributor(address,address)":{"details":"May only be called by owner, and can't be set to zero address.","params":{"_rewardsDistributor":"Address of the rewards distributor. This is the only address that can add new rewards  for this token.","_rewardsToken":"Address of the rewards token."}},"setRewardsDuration(address,uint256)":{"details":"May only be called by rewards distributor, and must be done after most recent period ends.","params":{"_rewardsDuration":"New length of period in seconds.","_rewardsToken":"Address of the rewards token."}},"stake(uint256)":{"details":"Can't stake zero.","params":{"_amount":"Amount of vault tokens to deposit."}},"stakeFor(address,uint256)":{"details":"Can't stake zero.","params":{"_amount":"Amount of vault token to deposit.","_recipient":"Address of user these vault tokens are being staked for."}},"transferOwnership(address)":{"details":"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner."},"withdraw(uint256)":{"details":"Can't withdraw zero. If trying to claim, call getReward() instead.","params":{"_amount":"Amount of vault tokens to withdraw."}},"withdrawFor(address,uint256,bool)":{"details":"Can't withdraw zero. May only be called by zap contract.","params":{"_amount":"Amount of vault tokens to withdraw.","_exit":"If true, withdraw all and claim all rewards","_recipient":"Address of user these vault tokens are being withdrawn for."}}},"stateVariables":{"isRetired":{"details":"Reward sweep can only be performed at least 90 days after final reward period ends."},"rewards":{"details":"Mapping order is user -> reward token -> amount"},"userRewardPerTokenPaid":{"details":"Note that this is not the same as amount of rewards claimed. Mapping order is user -> reward token -> amount"}},"title":"Yearn Vault Staking MultiRewards","version":1},"userdoc":{"kind":"user","methods":{"addReward(address,address,uint256)":{"notice":"Add a new reward token to the staking contract."},"balanceOf(address)":{"notice":"The balance a given user has staked."},"balanceOfUnderlying(address)":{"notice":"The balance a given user has staked, converted to underlying."},"cloneStakingPool(address,address,address)":{"notice":"Use this to clone an exact copy of this staking pool."},"earned(address,address)":{"notice":"Amount of reward token pending claim by an account."},"earnedMulti(address)":{"notice":"Amount of reward token(s) pending claim by an account."},"exit()":{"notice":"Unstake all of the sender's tokens and claim any outstanding rewards."},"getOneReward(address)":{"notice":"Claim any one earned reward token."},"getReward()":{"notice":"Claim any (and all) earned reward tokens."},"getRewardForDuration(address)":{"notice":"Total reward that will be paid out over the reward duration."},"initialize(address,address,address)":{"notice":"Initialize the staking pool."},"isOriginal()":{"notice":"Will only be true on the original deployed contract and not on clones; we don't want to clone a clone."},"isRetired()":{"notice":"Bool for if this staking contract is shut down and remaining rewards have been swept out."},"lastTimeRewardApplicable(address)":{"notice":"Either the current timestamp or end of the most recent period."},"notifyRewardAmount(address,uint256)":{"notice":"Notify staking contract that it has more reward to account for."},"recoverERC20(address,uint256)":{"notice":"Sweep out tokens accidentally sent here."},"rewardData(address)":{"notice":"The address of our reward token => reward info."},"rewardPerToken(address)":{"notice":"Reward paid out per whole token."},"rewardTokens(uint256)":{"notice":"Array containing the addresses of all of our reward tokens."},"rewardTokensLength()":{"notice":"How many reward tokens we currently have."},"rewards(address