,"balanceOf(address)":{"details":"See {IERC20-balanceOf}."},"decimals()":{"details":"Returns the decimals of the token."},"decreaseAllowance(address,uint256)":{"details":"Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"increaseAllowance(address,uint256)":{"details":"Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address."},"lock(uint256,uint256,uint256)":{"params":{"id":"optionId","premium":"Premium paid to liquidity pool to lock the above funds","tokenXAmount":"Amount of funds that should be locked in an option"}},"name()":{"details":"Returns the name of the token."},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `account`."},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role."},"send(uint256,address,uint256)":{"params":{"id":"Id of LockedLiquidity","to":"Provider","tokenXAmount":"Funds that should be sent"}},"setMaxLiquidity(uint256)":{"params":{"_maxLiquidity":"New limit"}},"shareOf(address)":{"params":{"account":"Provider's address"},"returns":{"share":"Provider's share in X"}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"totalTokenXBalance()":{"returns":{"balance":"Pool balance"}},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `recipient` cannot be the zero address. - the caller must have a balance of at least `amount`."},"unlock(uint256)":{"params":{"id":"Id of LockedLiquidity that should be unlocked"}},"unlockWithoutProfit(uint256)":{"params":{"id":"Id of LockedLiquidity that should be unlocked"}},"withdraw(uint256)":{"params":{"tokenXAmount":"Amount of X to receive"}},"withdrawForAccount(uint256,address)":{"params":{"account":"Account to withdraw for","tokenXAmount":"Amount of X to receive"}}},"title":"Buffer TokenX Liquidity Pool","version":1},"userdoc":{"kind":"user","methods":{"availableBalance()":{"notice":"Returns the amount of X available for withdrawals"},"lock(uint256,uint256,uint256)":{"notice":"Called by BufferCallOptions to lock the funds"},"send(uint256,address,uint256)":{"notice":"Called by BufferCallOptions to send funds to liquidity providers after an option's expiration"},"setMaxLiquidity(uint256)":{"notice":"Used for adjusting the max limit of the pool"},"shareOf(address)":{"notice":"Returns provider's share in X"},"totalTokenXBalance()":{"notice":"Returns the total balance of X provided to the pool"},"unlock(uint256)":{"notice":"Called by BufferOptions to unlock the funds"},"unlockWithoutProfit(uint256)":{"notice":"Called by BufferOptions to unlock the funds"},"withdraw(uint256)":{"notice":"withdraw burns BLP and receives X from the pool"},"withdrawForAccount(uint256,address)":{"notice":"withdraw burns BLP and receives X from the pool to be called by the Handler"}},"notice":"Accumulates liquidity in TokenX from LPs and distributes P&L in TokenX","version":1}},"settings":{"compilationTarget":{"BufferBinaryIBFRPoolBinary.sol":"BufferBinaryIBFRPoolBinary"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1},"remappings":[]},"sources":{"BufferBinaryIBFRPoolBinary.sol":{"keccak256":"0x51d7a81b2e761fd50248418dfce44865c8f285f6aa61054f68ec9b9f8cf48cb0","urls":["bzz-raw://411876be1a708d3ec4a5d8031b565c943fb75cde9f6ea203ae8edada82a05690","dweb:/ipfs/QmciYbP62a9TgMBWDAxpgrByF1jvvWnJHPSWqJM9oJMwt2"]}},"version":1}