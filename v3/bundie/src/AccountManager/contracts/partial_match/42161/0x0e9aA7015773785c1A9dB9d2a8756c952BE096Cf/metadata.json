s has deployed code to prevent misconfiguration.","params":{"newFeeManager":"Address of the FeeManager proxy (must be a deployed contract)"}},"setWeth(address)":{"params":{"_weth":"Address of the WETH contract (must be a deployed contract)"}},"transferOwnership(address)":{"details":"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."},"updateValidator(address)":{"params":{"newValidator":"New validator address (must be non-zero)"}},"upgradeImplementation(address)":{"details":"Must be called with the same implementation that was queued. Enforces delay.","params":{"newImplementation":"Address of the new implementation (must match queued)"}},"whitelistedTokenList(uint256)":{"params":{"index":"Zero-based index into the set"},"returns":{"_0":"token Token address at that index"}}},"stateVariables":{"_isRegisteredAccount":{"details":"Internal registry check used by routers to ensure only real accounts can call privileged flows."},"_whitelistedTokenSet":{"details":"EnumerableSet provides O(1) add/remove/contains."},"weth":{"details":"Used by Account._deposit() for auto-wrapping ETH to WETH on native ETH deposits"}},"title":"AccountManager","version":1},"userdoc":{"errors":{"AccountAlreadyExists(address)":[{"notice":"Thrown when attempting to create an account for a user who already has one"}],"IndexOutOfBounds(uint256,uint256)":[{"notice":"Thrown when array index is out of bounds"}],"InvalidAddress()":[{"notice":"Thrown when a required address parameter is zero"}],"InvalidImplementation(address)":[{"notice":"Thrown when implementation address is invalid"}],"InvalidValidator(address)":[{"notice":"Thrown when validator address is invalid (zero)"}],"TokenAlreadyWhitelisted(address)":[{"notice":"Thrown when attempting to whitelist a token that is already whitelisted"}],"