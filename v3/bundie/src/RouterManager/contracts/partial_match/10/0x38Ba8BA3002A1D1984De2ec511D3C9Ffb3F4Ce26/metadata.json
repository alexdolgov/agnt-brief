48"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"pendingUpgradeImplementation","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"protocols","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"}],"name":"queueRouterBaseLogic","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"string","name":"","type":"string"}],"name":"routers","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_accountManager","type":"address"}],"name":"setAccountManager","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"string","name":"protocol","type":"string"},{"components":[{"internalType":"string","name":"name","type":"string"},{"internalType":"address","name":"vaultAddress","type":"address"},{"internalType":"address","name":"assetToken","type":"address"},{"internalType":"address","name":"shareToken","type":"address"},{"internalType":"address","name":"bridgeModule","type":"address"},{"internalType":"address","name":"vaultModule","type":"address"},{"internalType":"uint32","name":"chainId","type":"uint32"},{"internalType":"bool","name":"enabled","type":"bool"},{"internalType":"uint256","name":"minDeposit","type":"uint256"}],"internalType":"struct Router.Strategy","name":"strategy","type":"tuple"}],"name":"setStrategyOnRouter","outputs":[{"internalType":"bytes32","name":"id","type":"bytes32"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"name":"strategyToRouter","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"}],"name":"upgradeRouterBaseLogic","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"Bundie Team","details":"Manages the lifecycle of protocol routers using the beacon proxy pattern.      Each protocol (Aave, Morpho, Yearn) has exactly one router deployed through this manager.      Only owner can deploy routers, configure strategies, and upgrade. ## Architecture - Single UpgradeableBeacon shared by all protocol routers - Each protocol gets exactly one BeaconProxy (ProtocolRouter) - Strategy registration creates strategyId → router mappings - Accounts use `getRouterForStrategy()` to find the right router for any strategy ## Upgrade Safety - MIN_UPGRADE_DELAY (1 day) between scheduling and execution - New implementation must have correct ROUTER_MANAGER reference - Upgrading beacon upgrades ALL protocol routers simultaneously","errors":{"ExternalCallFailed()":[{"details":"Used in try/catch wrappers that already emit `Events.ErrorLogBytes(lowLevelData)`"}],"InvalidAccountManager(address)":[{"params":{"accountManager":"The invalid accountManager address"}}],"InvalidImplementation(address)":[{"params":{"impl":"The invalid implementation address"}}],"InvalidRouter(address)":[{"params":{"router":"The invalid router address"}}],"OwnableInvalidOwner(address)":[{"details":"The owner is not a valid owner account. (eg. `address(0)`)"}],"OwnableUnauthorizedAccount(address)":[{"details":"The caller account is not authorized to perform an operation."}],"ProtocolAlreadyExists(string)":[{"params":{"protocol":"The protocol name that already has a router"}}],"ProtocolNotFound(string)":[{"params":{"protocol":"The protocol name that was not found"}}],"StrategyNotFound(bytes32)":[{"params":{"strategyId":"The strategy identifier that was not found"}}],"UpgradeAlreadyScheduled(address)":[{"params":{"pendingImpl":"The implementation already queued for upgrade"}}],"UpgradeDelayNotElapsed(uint48,uint48)":[{"params":{"current":"The current block timestamp","eta":"The earliest timestamp when upgrade can execute"}}]},"events":{"AccountManagerSet(address)":{"params":{"accountManager":"AccountManager contract address"}},"RouterDeployed(string,address)":{"params":{"protocol":"Protocol name","router":"Deployed router proxy address"}},"RouterUpgradeCancelled(address)":{"params":{"pendingImpl":"The implementation that was cancelled"}},"RouterUpgradeQueued(address,address,uint48)":{"params":{"eta":"Timestamp after which the upgrade can be executed","newImpl":"New implementation address","oldImpl":"Previous implementation address"}},"RouterUpgraded(address,address)":{"params":{"newImpl":"New implementation address","oldImpl":"Previous implementation address"}}},"kind":"dev","methods":{"acceptOwnership()":{"details":"The new owner accepts the ownership transfer."},"deployRouter(string)":{"details":"Creates a BeaconProxy pointing to ROUTER_BEACON and initializes it with the protocol name.      Each protocol can only have one router (prevents duplicates).","params":{"protocol":"Protocol name (e.g., \"aave\", \"morpho\") — must be non-empty and unique"},"returns":{"router":"Address of the newly deployed BeaconProxy router"}},"enableStrategyOnRouter(string,bytes32,bool)":{"params":{"enabled":"True to enable, false to disable","id":"Strategy identifier to enable/disable","protocol":"Protocol name whose router manages the strategy"}},"executeRouterCall(string,bytes)":{"details":"Low-level call for admin operations not covered by specific functions.      Reverts if the call fails (propagates the router's revert reason).","params":{"callData":"ABI-encoded function call data","protocol":"Protocol name whose router to call"},"returns":{"returnData":"Return data from the router call","success":"Always true (reverts on failure)"}},"getRouter(string)":{"params":{"protocol":"Protocol name (e.g., \"aave\", \"morpho\")"},"returns":{"router":"Address of the protocol's router (reverts if not deployed)"}},"getRouterForStrategy(bytes32)":{"params":{"strategyId":"Strategy identifier (keccak256 hash)"},"returns":{"router":"Router address managing this strategy (reverts if not found)"}},"isRegisteredAccount(address)":{"details":"Delegates to AccountManager. Returns false if accountManager is not set.","params":{"account":"Address to check"},"returns":{"isRegistered":"True if the address is a registered account"}},"owner()":{"details":"Returns the address of the current owner."},"pendingOwner()":{"details":"Returns the address of the pending owner."},"queueRouterBaseLogic(address)":{"details":"Validates ROUTER_MANAGER reference on the new implementation before queueing.      Upgrade can be executed after MIN_UPGRADE_DELAY elapses.","params":{"newImplementation":"Address of the new ProtocolRouter implementation"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"setAccountManager(address)":{"details":"Validates the address is a contract that implements isRegisteredAccount().      This is a one-time setup step after deployment (can be updated if needed).","params":{"_accountManager":"Address of the AccountManager contract"}},"setStrategyOnRouter(string,(string,address,address,address,address,address,uint32,bool,uint256))":{"details":"Registers the strategy on the router and records the strategyId → router mapping.      Strategy ID is deterministic (keccak256 of protocol + strategy name + chainId).","params":{"protocol":"Protocol name whose router to configure","strategy":"Strategy configuration struct"},"returns":{"id":"The computed strategy identifier"}},"transferOwnership(address)":{"details":"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."},"upgradeRouterBaseLogic(address)":{"details":"Re-validates ROUTER_MANAGER reference and executes the queued upgrade.      Must be called with the same implementation that was queued.","params":{"newImplementation":"Address of the new ProtocolRouter implementation (must match queued)"}}},"stateVariables":{"ROUTER_BEACON":{"details":"Created in constructor with initial ProtocolRouter implementation. Owned by this contract."},"accountManager":{"details":"Set post-deployment via setAccountManager(). Used by routers to verify account callers."},"protocols":{"details":"Append-only; protocol names are never removed."},"routers":{"details":"Each protocol (e.g., \"aave\", \"morpho\") maps to exactly one BeaconProxy router."},"strategyToRouter":{"details":"Updated when strategies are registered via setStrategyOnRouter().      Vaults use this to find the correct router for any strategyId."}},"title":"RouterManager","version":1},"userdoc":{"errors":{"EmptyProtocolName()":[{"notice":"Thrown when protocol name is empty during router deployment"}],"ExternalCallFailed()":[{"notice":"Thrown when an external call fails and the revert data is emitted separately"}],"InvalidAccountManager(address)":[{"notice":"Thrown when account manager is not a contract or does not conform to the expected interface"}],"InvalidAddress()":[{"notice":"Thrown when a required address parameter is zero"}],"InvalidImplementation(address)":[{"notice":"Thrown when implementation address is invalid"}],"InvalidRouter(address)":[{"notice":"Thrown when router address i