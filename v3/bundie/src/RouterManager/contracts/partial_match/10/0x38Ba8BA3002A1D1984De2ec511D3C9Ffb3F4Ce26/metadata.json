uterForStrategy(bytes32)":{"notice":"Get router address that manages a specific strategy"},"isRegisteredAccount(address)":{"notice":"Check if an address is a registered account"},"pendingUpgradeEta()":{"notice":"Timestamp after which the pending implementation can be executed"},"pendingUpgradeImplementation()":{"notice":"Pending implementation queued for upgrade"},"protocols(uint256)":{"notice":"Array of all deployed protocol names for enumeration"},"queueRouterBaseLogic(address)":{"notice":"Queue an upgrade of the base router implementation with enforced delay"},"routers(string)":{"notice":"Mapping of protocol name to router address"},"setAccountManager(address)":{"notice":"Set the AccountManager reference"},"setStrategyOnRouter(string,(string,address,address,address,address,address,uint32,bool,uint256))":{"notice":"Set or update a strategy on a specific router"},"strategyToRouter(bytes32)":{"notice":"Mapping of strategy ID to router address"},"upgradeRouterBaseLogic(address)":{"notice":"Upgrade base router logic for ALL protocol routers"}},"notice":"Factory and registry for deploying and managing protocol routers","version":1}},"settings":{"compilationTarget":{"src/router/RouterManager.sol":"RouterManager"},"evmVersion":"prague","libraries":{},"metadata":{"appendCBOR":false,"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":3000},"remappings":[":@layerzerolabs/=lib/devtools/packages/",":@layerzerolabs/lz-evm-messagelib-v2/=lib/LayerZero-v2/packages/layerzero-v2/evm/messagelib/",":@layerzerolabs/lz-evm-oapp-v2/contracts/=lib/LayerZero-v2/packages/layerzero-v2/evm/oapp/contracts/",":@layerzerolabs/lz-evm-protocol-v2/=lib/LayerZero-v2/packages/layerzero-v2/evm/protocol/",":@layerzerolabs/oapp-evm/=lib/devtools/packages/oapp-evm/",":@layerzerolabs/oft-evm/=lib/devtools/packages/oft-evm/",":@layerzerolabs/test-devtools-evm-foundry/contracts/=lib/devtools/packages/test-devtools-evm-foundry/contracts/",":@openzeppelin-upgradeable/=lib/openzeppelin-contracts-upgrad