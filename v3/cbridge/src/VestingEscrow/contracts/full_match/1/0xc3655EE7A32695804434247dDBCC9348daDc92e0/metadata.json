me":"vestingCliff","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"vestingEnd","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"}],"devdoc":{"author":"Lyra","details":"Sets a vesting schedule on the Lyra token for a recipient. After the cliff date, tokens vest linearly. Holds functionality to interact with the safety module. The recipient receives the voting power of the locked tokens to use them in governance. The owner holds the power of stopping the vesting, reclaiming the tokens amount not vested.","kind":"dev","methods":{"cancelVesting()":{"details":"Cancels the vesting and withdraws the amount not vested. Only the owner can call this method. Unclaimed SafetyModule rewards will remain assigned to this contract after executing this function."},"claim()":{"details":"Claim the vested tokens for the recipient. Anyone can call this method. If there are tokens staked in the safety module, the staked token representation will have priority to be transferred first. Unclaimed SafetyModule rewards will remain assigned to this contract after executing this function."},"constructor":{"details":"Stores the `token` and the `delegateRegistry`.","params":{"delegateRegistry_":"The address of the voting power delegation registry","token_":"The address of the ERC20 to be distributed"}},"getClaimable()":{"details":"Gets the amount available for claim","returns":{"_0":"the amount of vested tokens"}},"initialize(address,uint256,uint256,uint256,uint256)":{"details":"Initializes the owner and vest parameters","params":{"recipient_":"The address of the recipient that will be receiving the tokens","vestingAmount_":"Amount of tokens being vested for `recipient`","vestingBegin_":"Epoch time when tokens begin to vest","vestingCliff_":"Duration after which the first portion vests","vestingEnd_":"Epoch Time until all the amount should be vested"},"returns":{"_0":"Bool indicating the correct initialization"}},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"smClaimRewards(address,uint256)":{"details":"Claims an `amount` of generated rewards by the staked Tokens Unclaimed rewards will remain assigned to this contract after claiming vested tokens.","params":{"amount":"Amount to claim. Use the max integer to claim all available rewards*","to":"Address that will receive the rewards"}},"smCooldown()":{"details":"Activates the stakedToken's cooldown period to unstake.*"},"smRedeem(uint256)":{"details":"Redeems staked tokens, and stop earning rewards. This must be called after the cooldown period.","params":{"amount":"Amount to redeem*"}},"smStake(uint256)":{"details":"Stakes tokens in the safety module, and start earning rewards. Receives the same amount of a erc20 staked token representation.","params":{"amount":"Amount to stake*"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."}},"title":"VestingEscrow","version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"compilationTarget":{"contracts/escrow/VestingEscrow.sol":"VestingEscrow"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol":{"keccak256":"0xba7ba5b188c0b27489bad1efee8d8b1dcebb502785192b22e3d69824a802983d","license":"MIT","urls":["bzz-raw://9f75966b1b75eee4372f7bb11527ca364811d13383bac8cb80f053fb363385d8","dweb:/ipfs/QmWtP47c3NQ34fvujoBu1nqwYMCspWJpJfKUQv5g