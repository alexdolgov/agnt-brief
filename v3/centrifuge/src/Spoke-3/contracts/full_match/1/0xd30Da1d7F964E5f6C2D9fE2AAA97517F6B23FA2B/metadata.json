":"Dispatched when there is a re-entrancy issue"}]},"kind":"user","methods":{"addPool(uint64)":{"notice":"New pool details from an existing Centrifuge pool are added."},"addShareClass(uint64,bytes16,string,string,uint8,bytes32,address)":{"notice":"New share class details from an existing Centrifuge pool are added."},"assetToId(address,uint256)":{"notice":"Returns assetId given the asset address and tokenId."},"crosschainTransferShares(uint16,uint64,bytes16,bytes32,uint128,uint128)":{"notice":"transfers share class tokens to a cross-chain recipient address"},"deny(address)":{"notice":"Remove user as a ward (remove admin access)"},"deployVault(uint64,bytes16,uint128,address)":{"notice":"Deploys a new vault"},"executeTransferShares(uint64,bytes16,bytes32,uint128)":{"notice":"Mints share class tokens to a recipient"},"file(bytes32,address)":{"notice":"Updates a contract parameter"},"idToAsset(uint128)":{"notice":"Returns the asset address and tokenId associated with a given asset id."},"isLinked(address)":{"notice":"Checks whether a given vault is eligible for investing into a share class of a pool"},"isPoolActive(uint64)":{"notice":"Returns whether the given pool id is active"},"linkVault(uint64,bytes16,uint128,address)":{"notice":"Links a deployed vault to the given pool, share class and asset."},"markersPricePoolPerAsset(uint64,bytes16,uint128)":{"notice":"Returns the age related markers for an asset price"},"markersPricePoolPerShare(uint64,bytes16)":{"notice":"Returns the age related markers for a share class price"},"pricePoolPerAsset(uint64,bytes16,uint128,bool)":{"notice":"Returns the price per asset for a given pool, share class and the underlying asset id. The Provided price is defined as POOL_UNIT/ASSET_UNIT."},"pricePoolPerShare(uint64,bytes16,bool)":{"notice":"Returns the price per share for a given pool and share class. The Provided price is defined as POOL_UNIT/SHARE_UNIT."},"pricesPoolPer(uint64,bytes16,uint128,bool)":{"notice":"Returns the both prices per pool for a given pool, share class and the underlying asset id. The Provided prices is defined as POOL_UNIT/ASSET_UNIT and POOL_UNIT/SHARE_UNIT."},"recoverTokens(address,address,uint256)":{"notice":"Used to recover any ERC-20 token."},"recoverTokens(address,uint256,address,uint256)":{"notice":"Used to recover any ERC-20 or ERC-6909 token."},"registerAsset(uint16,address,uint256)":{"notice":"Registers an ERC-20 or ERC-6909 asset in another chain."},"registerVault(uint64,bytes16,uint128,address,uint256,address,address)":{"notice":"Register a vault."},"rely(address)":{"notice":"Make user a ward (give them admin access)"},"request(uint64,bytes16,uint128,bytes)":{"notice":"Handles a request originating from the Spoke side."},"requestCallback(uint64,bytes16,uint128,bytes)":{"notice":"Handles a request callback originating from the Hub side."},"setMaxAssetPriceAge(uint64,bytes16,uint128,uint64)":{"notice":"Updates the max price age of an asset"},"setMaxSharePriceAge(uint64,bytes16,uint64)":{"notice":"Updates the max price age of a share"},"setRequestManager(uint64,bytes16,uint128,address)":{"notice":"Updates the request manager for a specific asset"},"shareToken(uint64,bytes16)":{"notice":"Returns the share class token for a given pool and share class id."},"unlinkVault(uint64,bytes16,uint128,address)":{"notice":"Removes the link between a vault and the given pool, share class and asset."},"updatePricePoolPerAsset(uint64,bytes16,uint128,uint128,uint64)":{"notice":"Updates the price of an asset, i.e. the factor of pool currency amount per asset unit"},"updatePricePoolPerShare(uint64,bytes16,uint128,uint64)":{"notice":"Updates the price of a share class token, i.e. the factor of pool currency amount per share class token"},"updateRestriction(uint64,bytes16,bytes)":{"notice":"Updates the restrictions on a share class token for a specific user"},"updateShareHook(uint64,bytes16,address)":{"notice":"Updates the hook of a share class token"},"updateShareMetadata(uint64,bytes16,