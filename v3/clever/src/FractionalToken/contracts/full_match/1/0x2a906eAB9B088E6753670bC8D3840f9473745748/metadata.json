`.","params":{"multiple":"The multiplier used to update the nav, multiplied by 1e18."},"returns":{"_0":"The new net asset value of the token."}}},"stateVariables":{"PRECISION":{"details":"The precision used to compute nav."}},"version":1},"userdoc":{"events":{"UpdateNav(uint256,uint256)":{"notice":"Emitted when the net asset value for the token is updated."}},"kind":"user","methods":{"burn(address,uint256)":{"notice":"Burn some token from someone."},"getNav(int256)":{"notice":"Compute the new nav with multiple."},"mint(address,uint256)":{"notice":"Mint some token to someone."},"nav()":{"notice":"Return the net asset value for the token."},"setNav(uint256)":{"notice":"Update the net asset value by direct setting."},"treasury()":{"notice":"The address of Treasury contract."},"updateNav(int256)":{"notice":"Update the net asset value by times `(1 + multiple / 1e18)`."}},"version":1}},"settings":{"compilationTarget":{"contracts/f(x)/FractionalToken.sol":"FractionalToken"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/math/SafeMathUpgradeable.sol":{"keccak256":"0xfffa644e2e08507310f561f04060db8f19d39e95cc2ad46926aa51043a86e73c","license":"MIT","urls":["bzz-raw://9d95abd13667236e8eb09c2edd377935dc970d8381318c4f7a4584abeccb69f0","dweb:/ipfs/QmU63QnccBDkbHzPKzTaL1HBp2Qj4H1FodpKw5FVmmTcaw"]},"@openzeppelin/contracts-upgradeable/proxy/Initializable.sol":{"keccak256":"0xd8e4eb08dcc1d1860fb347ba5ffd595242b9a1b66d49a47f2b4cb51c3f35017e","license":"MIT","urls":["bzz-raw://7dbc89479d30592e82442edc38053b380f611037a5e6ceafc7bf57a7aa1f0305","dweb:/ipfs/QmcdYtt56WmjeYvsFjK69FnahnAriw88VzY3XRZwXkQKKN"]},"@openzeppelin/contracts-upgradeable/token/ERC20/ERC20Upgradeable.sol":{"keccak256":"0xe505ac660798c206f644c72ca76cc484011616f601f10478e3cdeef9a115cc9b","license":"MIT","urls":["bzz-raw://3a9460300dc2ee8c73c50a0f3e7db731493673aac816016aad262adb53ae63ca","dw