. | + pool_type = 7: CurveMetaPool or CurveFactoryMetaPool   customized = |   160 bits   | 3 bits |  3 bits  |   3 bits  | ... |                | pool address | tokens | index in | index out | ... | + pool_type = 8: CurveCryptoPool or CurveFactoryCryptoPool   customized = |   160 bits   | 3 bits |  3 bits  |   3 bits  |  1 bit  | ... |                | pool address | tokens | index in | index out | use_eth | ... | + pool_type = 9: ERC4626   customized = |   160 bits   | ... |                | pool address | ... | Note: tokens + 1 is the number of tokens of the pool + action = 0: swap + action = 1: add liquidity / wrap / stake + action = 2: remove liquidity / unwrap / unstake","params":{"amountIn":"The amount of input token.","encoding":"The encoding used to convert.","recipient":"The address of token receiver."},"returns":{"_amountOut":"The amount of output token received."}},"getTokenPair(uint256)":{"params":{"route":"The encoding of the route."},"returns":{"_0":"The address of input token.","_1":"The address of output token."}},"owner()":{"details":"Returns the address of the current owner."},"queryConvert(uint256,uint256)":{"details":"See the comments in `convert` for the meaning of encoding.","params":{"amountIn":"The amount of input token.","amountOut":"The amount of output token received.","encoding":"The encoding used to convert."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateSupportedPoolTypes(uint256)":{"params":{"_supportedPoolTypes":"The mask of pool types supported."}},"withdrawFund(address,address)":{"params":{"recipient":"The addr