pragma solidity 0.8.28;

/**
 * @title IVeSDT v2 Interface
 * @notice Interface for veSDT v2 with migration to vlSDT
 * @dev v2 Changes:
 *      - All deposit functions disabled (create_lock, increase_amount,
 *        increase_unlock_time, deposit_for, deposit_for_from)
 *      - Added migrate() for users to move to vlSDT
 *      - Added forceMigrate() for governance to migrate users
 */
interface IVeSDT {
    // =========================================================================
    //                                 STRUCTS
    // =========================================================================

    /// @notice Lock data for a user (returned as tuple from locked())
    /// @param amount The locked SDT amount (int128 in Vyper)
    /// @param end The unlock timestamp
    struct LockedBalance {
        int128 amount;
        uint256 end;
    }

    // =========================================================================
    //                                 EVENTS
    // =========================================================================

    event CommitOwnership(address admin);
    event ApplyOwnership(address admin);
    event Deposit(address indexed provider, uint256 value, uint256 indexed locktime, int128 _type, uint256 ts);
    event Withdraw(address indexed provider, uint256 value, uint256 ts);
    event Supply(uint256 prevSupply, uint256 supply);

    /// @notice Emitted when a user migrates to vlSDT
    /// @param sender The address that initiated the migration (user or admin)
    /// @param user The user whose lock was migrated
    /// @param amount The amount of SDT migrated
    /// @param ts The timestamp of the migration
    event Migrate(address indexed sender, address indexed user, uint256 amount, uint256 ts);

    // =========================================================================
    //                            STATE VARIABLES
    // =========================================================================

    /// @notice The SDT token address
    function token() external view returns (address);

    /// @notice Total locked SDT supply
    function supply() external view returns (uint256);

    /// @notice Get lock data for a user
    /// @param user The user address
    /// @return amount The locked amount (int128)
    /// @return end The unlock timestamp
    function locked(address user) external view returns (int128 amount, uint256 end);

    /// @notice Current global epoch
    function epoch() external view returns (uint256);

    /// @notice Current admin address
    function admin() external view returns (address);

    /// @notice Pending admin address (for 2-step transfer)
    // solhint-disable-next-line func-name-mixedcase
    function future_admin() external view returns (address);

    /// @notice Smart wallet checker contract
    // solhint-disable-next-line func-name-mixedcase
    function smart_wallet_checker() external view returns (address);

    /// @notice Pending smart wallet checker
    // solhint-disable-next-line func-name-mixedcase
    function future_smart_wallet_checker() external view returns (address);

    /// @notice Token name
    function name() external view returns (string memory);

    /// @notice Token symbol
    function symbol() external view returns (string memory);

    /// @notice Token decimals
    function decimals() external view returns (uint256);

    /// @notice Whether the contract has been initialized (v1)
    function initialized() external view returns (bool);

    /// @notice Whether the contract has been initialized (v2)
    function initializedV2() external view returns (bool);

    // =========================================================================
    //                          CONSTANT GETTERS (v2)
    // =========================================================================

    /// @notice Get the vlSDT contract address (constant)
    /// @return The vlSDT address for migration
    function vlSDT() external view returns (address);

    // =========================================================================
    //                         DISABLED FUNCTIONS (v2)
    // =========================================================================

    /// @notice DISABLED in v2 - Always reverts with "Migration enabled, no new locks"
    // solhint-disable-next-line func-name-mixedcase, var-name-mixedcase
    function create_lock(uint256 value, uint256 unlock_time) external;

    /// @notice DISABLED in v2 - Always reverts with "Migration enabled, no new deposits"
    // solhint-disable-next-line func-name-mixedcase
    function increase_amount(uint256 value) external;

    /// @notice DISABLED in v2 - Always reverts with "Migration enabled, no lock extensions"
    // solhint-disable-next-line func-name-mixedcase, var-name-mixedcase
    function increase_unlock_time(uint256 unlock_time) external;

    /// @notice DISABLED in v2 - Always reverts with "Migration enabled, no new deposits"
    // solhint-disable-next-line func-name-mixedcase
    function deposit_for(address addr, uint256 value) external;

    /// @notice DISABLED in v2 - Always reverts with "Migration enabled, no new deposits"
    // solhint-disable-next-line func-name-mixedcase
    function deposit_for_from(address addr, uint256 value) external;

    // =========================================================================
    //                        MIGRATION FUNCTIONS (v2)
    // =========================================================================

    /// @notice Migrate caller's locked SDT to vlSDT
    /// @dev Transfers full locked amount regardless of remaining lock time.
    ///      Emits Migrate(msg.sender, msg.sender, amount, timestamp)
    function migrate() external;

    /// @notice Force migrate a user's locked SDT to vlSDT
    /// @dev Only callable by admin. Use for unresponsive users.
    ///      Emits Migrate(admin, user, amount, timestamp)
    /// @param user The user to force migrate
    function forceMigrate(address user) external;

    /// @notice Initialize the contract
    /// @param _vlSDT The address of the vlSDT contract
    function initialize(address _vlSDT) external;

    // =========================================================================
    //                         UNCHANGED FUNCTIONS
    // =========================================================================

    /// @notice Withdraw all tokens for msg.sender (only if lock expired)
    function withdraw() external;

    /// @notice Record global data to checkpoint
    function checkpoint() external;

    // =========================================================================
    //                           VIEW FUNCTIONS
    // =========================================================================

    /// @notice Get current voting power for a user
    /// @param addr User wallet address
    /// @return User voting power
    function balanceOf(address addr) external view returns (uint256);

    /// @notice Get voting power for a user at a specific time
    /// @param addr User wallet address
    /// @param t Epoch time to query
    /// @return User voting power at time t
    function balanceOf(address addr, uint256 t) external view returns (uint256);

    /// @notice Get voting power at a specific block (historical)
    /// @param addr User wallet address
    /// @param _block Block number to query
    /// @return Voting power at that block
    function balanceOfAt(address addr, uint256 _block) external view returns (uint256);

    /// @notice Get voting power at a specific block (ERC20Votes compatible)
    /// @param addr User wallet address
    /// @param _block Block number to query
    /// @return Voting power at that block
    function getPastVotes(address addr, uint256 _block) external view returns (uint256);

    /// @notice Get current total voting power
    /// @return Total voting power
    function totalSupply() external view returns (uint256);

    /// @notice Get total voting power at a specific time
    /// @param t Epoch time to query
    /// @return Total voting power at time t
    function totalSupply(uint256 t) external view returns (uint256);

    /// @notice Get total voting power at a specific block (historical)
    /// @param _block Block number to query
    /// @return Total voting power at that block
    function totalSupplyAt(uint256 _block) external view returns (uint256);

    /// @notice Get timestamp when a user's lock finishes
    /// @param addr User wallet address
    /// @return Epoch time of the lock end
    // solhint-disable-next-line func-name-mixedcase
    function locked__end(address addr) external view returns (uint256);

    /// @notice Get the most recently recorded rate of voting power decrease
    /// @param addr User wallet address
    /// @return Value of the slope
    // solhint-disable-next-line func-name-mixedcase
    function get_last_user_slope(address addr) external view returns (int128);

    /// @notice Get the timestamp for a user's checkpoint
    /// @param addr User wallet address
    /// @param idx User epoch number
    /// @return Epoch time of the checkpoint
    // solhint-disable-next-line func-name-mixedcase
    function user_point_history__ts(address addr, uint256 idx) external view returns (uint256);

    // =========================================================================
    //                          ADMIN FUNCTIONS
    // =========================================================================

    /// @notice Commit transfer of ownership to a new address
    /// @param addr New admin address
    // solhint-disable-next-line func-name-mixedcase
    function commit_transfer_ownership(address addr) external;

    /// @notice Accept pending ownership transfer (called by future_admin)
    // solhint-disable-next-line func-name-mixedcase
    function accept_transfer_ownership() external;

    /// @notice Commit a new smart wallet checker
    /// @param addr New checker address
    // solhint-disable-next-line func-name-mixedcase
    function commit_smart_wallet_checker(address addr) external;

    /// @notice Apply the pending smart wallet checker
    // solhint-disable-next-line func-name-mixedcase
    function apply_smart_wallet_checker() external;
}
