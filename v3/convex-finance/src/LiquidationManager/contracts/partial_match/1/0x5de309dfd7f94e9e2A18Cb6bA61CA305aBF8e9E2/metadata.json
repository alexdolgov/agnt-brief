nt256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"DECIMAL_PRECISION","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"PERCENT_DIVISOR","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"contract ITroveManager","name":"troveManager","type":"address"},{"internalType":"address[]","name":"_troveArray","type":"address[]"}],"name":"batchLiquidateTroves","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"borrowerOperations","outputs":[{"internalType":"contract IBorrowerOperations","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"contract ITroveManager","name":"_troveManager","type":"address"}],"name":"enableTroveManager","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"factory","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"contract ITroveManager","name":"troveManager","type":"address"},{"internalType":"address","name":"borrower","type":"address"}],"name":"liquidate","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"contract ITroveManager","name":"troveManager","type":"address"},{"internalType":"uint256","name":"maxTrovesToLiquidate","type":"uint256"},{"internalType":"uint256","name":"maxICR","type":"uint256"}],"name":"liquidateTroves","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"stabilityPool","outputs":[{"internalType":"contract IStabilityPool","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"kind":"dev","methods":{"batchLiquidateTroves(address,address[])":{"details":"Reverts if there is not a single trove that can be liquidated","params":{"_troveArray":"List of borrower addresses to liquidate. Troves that were already liquidated, or cannot be liquidated, are ignored."}},"liquidate(address,address)":{"details":"Reverts if the trove is not active, or cannot be liquidated","params":{"borrower":"Borrower address to liquidate"}},"liquidateTroves(address,uint256,uint256)":{"details":"Iterates through troves starting with the lowest ICR","params":{"maxICR":"Maximum ICR to liquidate. Should be set to MCR if the system is not in recovery mode, to minimize gas costs for this call.","maxTrovesToLiquidate":"The maximum number of troves to liquidate"}}},"title":"Prisma Liquidation Manager","version":1},"userdoc":{"kind":"user","methods":{"batchLiquidateTroves(address,address[])":{"notice":"Liquidate a custom list of troves"},"liquidate(address,address)":{"notice":"Liquidate a single trove"},"liquidateTroves(address,uint256,uint256)":{"notice":"Liquidate a sequence of troves"}},"notice":"Based on Liquity's `TroveManager` https://github.com/liquity/dev/blob/main/packages/contracts/contracts/TroveManager.sol This contract has a 1:n relationship with `TroveManager`, handling liquidations for every active collateral within the system. Anyone can call to liquidate an eligible trove at any time. There is no requirement that liquidations happen in order according to trove ICRs. There are three ways that a liquidation can occur: 1. ICR <= 100 The trove's entire debt and collateral is redistributed between remaining active troves. 2. 100 < ICR < MCR The trove is liquidated using stability pool deposits. The collateral is distributed amongst stability pool depositors. If the stability pool's balance is insufficient to completely repay the trove, the remaining debt and collateral is redistributed between the remaining active troves. 3. MCR <= ICR < TCR && TCR < CCR The trove is liquidated using stability pool deposits. Collateral equal to MCR of the value of the debt is distributed between stability pool depositors. The remaining collateral is left claimable by the trove owner.","version":1}},"settings":{"compilationTarget":{"LiquidationManager.sol":"LiquidationManager"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"IBorrowerOperations.sol":{"keccak256":"0x4ee398dc4c414f4158c1fe0843770889c32f3120096155184e81b1642ae0bf51","license":"MIT","urls":["bzz-raw://ee0dbf08a7d4c7bef746169a75689b5b4419ce69601e5ad6077c850e1bb2dcb9","dweb:/ipfs/QmQvQJPyNsELFnJDRJCgcebdkWLXfpDMM5ffVpvEhqsifW"]},"IERC20.sol":{"keccak256":"0x9750c6b834f7b43000631af5cc30001c5f547b3ceb3635488f140f60e897ea6b","license":"MIT","urls":["bzz-raw://5a7d5b1ef5d8d5889ad2ed89d8619c09383b80b72ab226e0fe7bde1636481e34","dweb:/ipfs/QmebXWgtEfumQGBdVeM6c71McLixYXQP5Bk6kKXuoY4Bmr"]},"ISortedTroves.sol":{"keccak256":"0x1cef5f0ae6ec1440e23078d4fd5318c5152d1c21e52378ff3c2d14c9a6e3ac59","license":"MIT","urls":["bzz-raw://0ddcda80f1740801a3fbc06f44cbcc94f65a8f56f14a706b768fcf3c63ff2748","dweb:/ipfs/QmbjcAFneDF9LCUrPycabiwkh6jbVcwRCM4aZ3KAvsiTBq"]},"IStabilityPool.sol":{"keccak256":"0x64d2589a076942334f6c4957210cafc09a6bd99a75b36abc9b368910433f57e2","license":"MIT","urls":["bzz-raw://866a6a62f676a82c511534196abb26889280ecae3f93e917bd31e4fa58c5ed79","dweb:/ipfs/QmdtfeDikc6Nzz9c4bQCxzAKqoe9o1kT51euj1kz8zkpPx"]},"ITroveManager.sol":{"keccak256":"0x619ca60f038d378e0d6b3fb849a0ed8bc3ced5a59e6c49eadab4ebae590306d5","license":"MIT","urls":["bzz-raw://6ceda54b7ec0201fda94e30c3ad6b91c2077b4d5a6d8f9a661701893490fb441","dweb:/ipfs/QmfWCCxNyRpvyQ81drjHNLuFwgHVXuVBFcfEnzV8Cn2iDk"]},"LiquidationManager.sol":{"keccak256":"0x5e9e71447d2cb9ae9630ab7aaaa7747e93fa3a63a6da8146909fd1ebb1bf706e","license":"MIT","urls":["bzz-raw://a9d35a4d34ecdc0ec5994c660588359871ee36ca165ad56c8fc894097a32c495","dweb:/ipfs/QmVQQ2BBfCTcf49KB6AJg7ACqHptCjgw9gUWV5yXoanR6g"]},"PrismaBase.sol":{"keccak256":"0xd0f814be0111e7e6d61e60bb4d1525eaf5f15f9a3ec9ea05993644405337ec51","license":"