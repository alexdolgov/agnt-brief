)":{"details":"Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."},"deposit(address,uint256)":{"params":{"_amount":"- the amount of underlying to deposit","_to":"- the address that will receive the shares"},"returns":{"_shares":"- the amount of shares issued"}},"depositAll(address)":{"params":{"_to":"- the address that will receive the shares"},"returns":{"_shares":"- the amount of shares issued"}},"harvest()":{"details":"No slippage protection, swapping for cvxCRV"},"harvest(uint256)":{"details":"swapping for cvxCRV by default","params":{"_minAmountOut":"- min amount of cvxCRV to receive for harvest"}},"harvest(uint256,bool)":{"details":"Can be called by whitelisted account or anyone against an ETH incentiveHarvest logic in the strategy contractHarvest can be called even if permissioned when last staker is      withdrawing from the vault.","params":{"_forceLock":"- force locking even if there's a discount for swapping","_minAmountOut":"- min amount of cvxCrv to receive for harvest"}},"harvestAndSetRewardWeight(uint256,bool,uint256)":{"details":"Always only available to owner or authorized harvesters","params":{"_lock":"- whether to lock or swap lp tokens for cvxCrv","_minAmountOut":"- min amount of cvxCrv to receive for harvest","_weight":"the desired weight: 0 = full group 0, 10k = full group 1"}},"increaseAllowance(address,uint256)":{"details":"Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address."},"name()":{"details":"Returns the name of the token."},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setCallIncentive(uint256)":{"params":{"_incentive":"- the amount of the new incentive (in BIPS)"}},"setHarvestPermissions(bool)":{"params":{"_status":"Whether or not harvests are permissioned"}},"setPlatform(address)":{"params":{"_platform":"- the new platform wallet address"}},"setPlatformFee(uint256)":{"params":{"_fee":"- the amount of the new platform fee (in BIPS)"}},"setRewardWeight(uint256)":{"details":"Always only available to owner or authorized harvesters","params":{"_weight":"the desired weight: 0 = full group 0, 10k = full group 1"}},"setStrategy(address)":{"details":"Can only be set once","params":{"_strategy":"- address of the strategy contract"}},"setWithdrawalPenalty(uint256)":{"params":{"_penalty":"- the amount of the new penalty (in BIPS)"}},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"totalUnderlying()":{"returns":{"total":"- the total amount of tokens staked"}},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `recipient` cannot be the zero address. - the caller must have a balance of at least `amount`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. Requirements: - `sender` and `recipient` cannot be the zero address. - `sender` must have a balance of at least `amount`. - the caller must have allowance for ``sender``'s tokens of at least `amount`."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateAuthorizedHarvesters(address,bool)":{"params":{"_authorized":"Whether to add or remove harvester","_harvester":"address of the authorized harvester"}},"withdraw(address,uint256)":{"params":{"_shares":"- the number of shares sent","_to":"- address to send underlying to"},"returns":{"withdrawn":"- the amount of underlying returned to the user"}},"withdrawAll(address)":{"params":{"_to":"- address to send underlying to"},"returns":{"withdrawn":"- the amount of underlying returned to the user"}}},"version":1},"userdoc":{"kind":"user","methods":{"balanceOfUnderlying(address)":{"notice":"Returns the amount of underlying a user can claim"},"deposit(address,uint256)":{"notice":"Deposit user funds in the autocompounder and mints tokens representing user's share of the pool in exchange"},"depositAll(address)":{"notice":"Deposit all of user's underlying balance"},"harvest()":{"notice":"Claim rewards and swaps them to cvxCRV for restaking"},"harvest(uint256)":{"notice":"Claim rewards and swaps them to cvxCRV for restaking"},"harvest(uint256,bool)":{"notice":"Claim rewards and swaps them to cvxCrv for restaking"},"harvestAndSetRewardWeight(uint256,bool,uint256)":{"notice":"Updates the strategy's reward weight before harvesting"},"setCallIncentive(uint256)":{"notice":"Updates the caller incentive for harvests"},"setHarvestPermissions(bool)":{"notice":"Sets whether only whitelisted addresses can harvest"},"setPlatform(address)":{"notice":"Updates the address to which platform fees are paid out"},"setPlatformFee(uint256)":{"notice":"Updates the part of yield redirected to the platform"},"setRewardWeight(uint256)":{"notice":"set the strategy's reward weight"},"setStrategy(address)":{"notice":"Set the address of the strategy contract"},"setWithdrawalPenalty(uint256)":{"notice":"Updates the withdrawal p