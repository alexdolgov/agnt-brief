nction"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"address","name":"tokenOut","type":"address"}],"name":"previewClaimFees","outputs":[{"internalType":"uint256","name":"amountOut","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"}],"name":"previewClaimFees","outputs":[{"internalType":"uint256","name":"amount0","type":"uint256"},{"internalType":"uint256","name":"amount1","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"}],"name":"previewCompoundFees","outputs":[{"internalType":"uint128","name":"liquidity","type":"uint128"},{"internalType":"uint256","name":"added0","type":"uint256"},{"internalType":"uint256","name":"added1","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"poolAddress","type":"address"},{"internalType":"uint256","name":"amountIn0","type":"uint256"},{"internalType":"uint256","name":"amountIn1","type":"uint256"},{"internalType":"int24","name":"tickLower","type":"int24"},{"internalType":"int24","name":"tickUpper","type":"int24"}],"name":"previewCreatePosition","outputs":[{"internalType":"uint128","name":"liquidity","type":"uint128"},{"internalType":"uint256","name":"amount0Used","type":"uint256"},{"internalType":"uint256","name":"amount1Used","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"uint256","name":"amountIn0","type":"uint256"},{"internalType":"uint256","name":"amountIn1","type":"uint256"}],"name":"previewIncreaseLiquidity","outputs":[{"internalType":"uint128","name":"liquidity","type":"uint128"},{"internalType":"uint256","name":"added0","type":"uint256"},{"internalType":"uint256","name":"added1","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"int24","name":"newLower","type":"int24"},{"internalType":"int24","name":"newUpper","type":"int24"}],"name":"previewMoveRange","outputs":[{"internalType":"uint128","name":"liquidity","type":"uint128"},{"internalType":"uint256","name":"amount0","type":"uint256"},{"internalType":"uint256","name":"amount1","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"uint32","name":"percent","type":"uint32"}],"name":"previewWithdraw","outputs":[{"internalType":"uint256","name":"amount0","type":"uint256"},{"internalType":"uint256","name":"amount1","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"uint32","name":"percent","type":"uint32"},{"internalType":"address","name":"tokenOut","type":"address"}],"name":"previewWithdraw","outputs":[{"internalType":"uint256","name":"amountOut","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"protocolFeeCollector","outputs":[{"internalType":"contract IProtocolFeeCollector","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"uint32","name":"percent","type":"uint32"},{"internalType":"address","name":"recipient","type":"address"},{"internalType":"address","name":"tokenOut","type":"address"},{"internalType":"uint256","name":"minAmountOut","type":"uint256"}],"name":"withdraw","outputs":[{"internalType":"uint256","name":"amountOut","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"positionId","type":"uint256"},{"internalType":"uint32","name":"percent","type":"uint32"},{"internalType":"address","name":"recipient","type":"address"},{"internalType":"uint256","name":"minAmountOut0","type":"uint256"},{"internalType":"uint256","name":"minAmountOut1","type":"uint256"}],"name":"withdraw","outputs":[{"internalType":"uint256","name":"amount0","type":"uint256"},{"internalType":"uint256","name":"amount1","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"details":"Wraps common flows: create a position, claim fees (optionally in a single token),      compound fees back into the position, increase liquidity with auto-rebalancing of inputs,      migrate a position range, and withdraw in one or two tokens.      Key behavior and assumptions:      - The contract is a helper: the NFT remains owned by the user; approvals are required        for both the Pancake V3 `positionManager` and ERC20 tokens.      - Protocol fees are charged via an external `protocolFeeCollector` and may differ by flow:          • createPosition/_openPosition: FeeType.LIQUIDITY on provided amounts          • increaseLiquidity:         FeeType.DEPOSIT on added amounts          • compoundFees:              FeeType.FEES on accrued rewards only          • withdraw/moveRange:        FeeType.LIQUIDITY on withdrawn outputs      - Some flows perform swaps to rebalance inputs. Swaps use conservative price limits when        rebalancing to avoid crossing the range unexpectedly.","errors":{"SafeERC20FailedOperation(address)":[{"details":"An operation with an ERC-20 token failed."}]},"events":{"PositionCreated(uint256,uint128,uint256,uint256,int24,int24,uint256)":{"params":{"amount0":"Actual amount of token0 supplied","amount1":"Actual amount of token1 supplied","liquidity":"Minted liquidity value","positionId":"Newly minted position NFT id","sqrtPriceX96":"Current pool sqrt price (Q96) at creation","tickLower":"Lower tick boundary","tickUpper":"Upper tick boundary"}}},"kind":"dev","methods":{"claimFees(uint256,address,address,uint256)":{"details":"Applies protocol FEES fee, then performs an internal swap in the pool for the non-selected token.      The final `amountOut` is post-fee and post-swap. Reverts if caller is not the position owner      or if `tokenOut` is neither token0 nor token1 of the pool.","params":{"minAmountOut":"Minimal acceptable output amount (post-fee and post-swap)","positionId":"Position id","recipient":"Receiver of the claimed fees","tokenOut":"Desired output token (must be pool token0 or token1)"}},"claimFees(uint256,address,uint256,uint256)":{"details":"Applies protocol FEES fee on the claimed rewards, then transfers both tokens to `recipient`.      Reverts if caller is not the position owner.","params":{"minAmountOut0":"Minimal acceptable token0 amount (post-fee)","minAmountOut1":"Minimal acceptable token1 amount (post-fee)","positionId":"Position id","recipient":"Receiver of the claimed fees"}},"compoundFees(uint256,uint128)":{"details":"Only callable by the position owner. Collects pending fees, applies protocol FEES fee,      rebalances and increases liquidity on the same position.","params":{"minLiquidity":"Minimal acceptable liquidity increase","positionId":"Position id"}},"constructor":{"params":{"_positionManager":"Pancake V3 NonfungiblePositionManager","_protocolFeeCollector":"Protocol fee collector"}},"createPosition(address,uint256,uint256,int24,int24,address,uint256)":{"details":"Pulls tokens from `msg.sender`, applies protocol LIQUIDITY fee on inputs, then rebalances via bounded      swaps and mints the position. Any unused tokens are returned to `msg.sender`.      Reverts if minted liquidity is less than `minLiquidity`.","params":{"amountIn0":"Amount of token0 to supply (before protocol fee)","amountIn1":"Amount of token1 to supply (before protocol fee)","minLiquidity":"Minimal acceptable liquidity minted","poolAddress":"Target pool address","recipient":"NFT recipient","tickLower":"Lower tick bound","tickUpper":"Upper tick bound"},"returns":{"amount0":"Actual amount of token0 used","amount1":"Actual amount of token1 used","liquidity":"Minted liquidity","positionId":"New NFT id"}},"getCurrentSqrtPriceX96(address)":{"params":{"pool":"Pool address"},"returns":{"sqrtPriceX96":"Current sqrt price in Q96 format"}},"getPoolInfo(address)":{"params":{"poolAddress":"Address of the Uniswap V3 pool"},"returns":{"_0":"PoolInfo Struct with pool address, token0, token1, and fee"}},"getPosition(uint256)":{"params":{"positionId":"The Uniswap V3 position token id"},"returns":{"position":"Populated struct with pool, tokens, liquidity, unclaimed/claimed fees and price"}},"increaseLiquidity(uint256,uint256,uint256,uint128)":{"details":"Pulls tokens from `msg.sender`, applies protocol DEPOSIT fee, rebalances and increases liquidity.      Any unused tokens are returned to `msg.sender`. Reverts if resulting liquidity increase is      less than `minLiquidity`.","params":{"amountIn0":"Amount of token0 to add (before protocol fee)","amountIn1":"Amount of token1 to add (before protocol fee)","minLiquidity":"Minimal acceptable liquidity increase","positionId":"Position id"}},"moveRange(uint256,address,int24,int24,uint256)":{"details":"Only callable by the position owner. Withdraws 100% of liquidity, collects any pending tokens,      applies protocol LIQUIDITY fee on the amounts, and opens a new position with the provided range.      This effectively charges the LIQUIDITY fee on principal and accrued fees;      Reverts if minted liquidity is less than `minLiquidity`.","params":{"minLiquidity":"Minimal acceptable liquidity for the new position","newLower":"New lower tick","newUpper":"New upper tick","positionId":"Position id to migrate from","recipient":"Recipient of the new position"},"returns":{"amount0":"Amount of token0 supplied in the new position","amount1":"Amount of token1 supplied in the new position","liquidity":"Minted liquidity in the new position","newPositionId":"Newly minted NFT id"}},"pancakeV3SwapCallback(int256,int256,bytes)":{"details":"Validates caller pool and settles the exact input/output leg by transferring tokens back to pool.","params":{"amount0Delta":"The amount of token0 that was sent (negative) or must be received (positive) by the pool by the end of the swap. If positive, the callback must send that amount of token0 to the pool.","amount1Delta":"The amount of token1 that was sent (negative) or must be received (positive) by the pool by the end of the swap. If positive, the callback must send that amount of token1 to the pool.","data":"Any data passed through by the caller via the IPancakeV3PoolActions#swap call"}},"previewClaimFees(uint256)":{"params":{"positionId":"Position id"},"returns":{"amount0":"Expected amount of token0 claimed (after protocol fee)","amount1":"Expected amount of token1 claimed (after protocol fee)"}},"previewClaimFees(uint256,address)":{"params":{"positionId":"Position id","tokenOut":"Desired output token (must be pool token0 or token1)"},"returns":{"amountOut":"Expected output amount (post-fee and post-swap)"}},"previewCompoundFees(uint256)":{"params":{"positionId":"Position id"},"returns":{"added0":"Expected amount of token0 added","added1":"Expected amount of token1 added","liquidity":"Expected liquidity increase"}},"previewCreatePosition(address,uint256,uint256,int24,int24)":{"params":{"amountIn0":"Amount of token0 to supply (before protocol fee)","amountIn1":"Amount of token1 to supply (before protocol fee)","poolAddress":"Target pool address","tickLower":"Lower tick bound","tickUpper":"Upper tick bound"},"returns":{"amount0Used":"Expected amount of token0 used","amount1Used":"Expected amount of token1 used","liquidity":"Expected minted liquidity"}},"previewIncreaseLiquidity(uint256,uint256,uint256)":{"params":{"amountIn0":"Amount of token0 to add (before protocol fee)","amountIn1":"Amount of token1 to add (before protocol fee)","positionId":"Position id"},"returns":{"added0":"Expected amount of token0 added","added1":"Expected amount of token1 added","liquidity":"Expected liquidity increase"}},"previewMoveRange(uint256,int24,int24)":{"params":{"newLower":"New lower tick","newUpper":"New upper tick","positionId":"Position id to migrate from"},"returns":{"amount0":"Expected amount of token0 supplied in the new position","amount1":"Expected amount of token1 supplied in the new position","liquidity":"Expected minted liquidity in the new position"}},"previewWithdraw(uint256,uint32)":{"params":{"percent":"Basis points of liquidity to withdraw (1e4 = 100%)","positionId":"Position id"},"returns":{"amount0":"Expected amount of token0 withdrawn (after protocol fee)","amount1":"Expected amount of token1 withdrawn (after protocol fee)"}},"previewWithdraw(uint256,uint32,address)":{"params":{"percent":"Basis points of liquidity to withdraw (1e4 = 100%)","positionId":"Position id","tokenOut":"Desired output token (must be pool token0 or token1)"},"returns":{"amountOut":"Expected output amount (post-fee and post-swap)"}},"withdraw(uint256,uint32,address,address,uint256)":{"details":"Only callable by the position owner. Applies protocol LIQUIDITY fee after performing the      internal swap, then transfers `amountOut` to `recipient`.","params":{"minAmountOut":"Minimal acceptable output (post-fee and post-swap)","percent":"Basis points of liquidity to withdraw (1e4 = 100%)","positionId":"Position id","recipient":"Receiver of withdrawn tokens","tokenOut":"Desired output token (must be pool token0 or token1)"}},"withdraw(uint256,uint32,address,uint256,uint256)":{"details":"Only callable by the position owner. Applies protocol LIQUIDITY fee on withdrawn amounts      before transferring to `recipient`.","params":{"minAmountOut0":"Minimal acceptable token0 amount (post-fee)","minAmountOut1":"Minimal acceptable token1 amount (post-fee)","percent":"Basis points of liquidity to withdraw (1e4 = 100%)","positionId":"Position id","recipient":"Receiver of withdrawn tokens"}}},"title":"PancakeV3LPManager","version":1},"userdoc":{"errors":{"Amount0LessThanMin()":[{"notice":"Thrown when token0 output is less than the user-provided minimum"}],"Amount1LessThanMin()":[{"notice":"Thrown when token1 output is less than the user-provided minimum"}],"AmountLessThanMin()":[{"notice":"Thrown when output amount is less than the user-provided minimum"}],"InvalidSwapCallbackCaller()":[{"notice":"Thrown by swap callback when the caller is not the expected pool"}],"InvalidSwapCallbackDeltas()":[{"notice":"Thrown by swap callback when deltas are invalid (no payment due)"}],"InvalidTokenOut()":[{"notice":"Thrown when provided tokenOut is not a token of the pool"}],"LiquidityLessThanMin()":[{"notice":"Thrown when resulting liquidity is less than the user-provided minimum"}],"NotPositionOwner()":[{"notice":"Thrown when msg.sender is not the owner of the specified position"}]},"events":{"ClaimedFees(uint256,uint256,uint256)":{"notice":"Emitted after fees are claimed in both tokens"},"ClaimedFeesInToken(uint256,address,uint256)":{"notice":"Emitted after fees are claimed in a single token (with internal swap)"},"CompoundedFees(uint256,uint256,uint256)":{"notice":"Emitted after compounding fees back into the position"},"LiquidityIncreased(uint256,uint256,uint256)":{"notice":"Emitted after increasing liquidity"},"PositionCreated(uint256,uint128,uint256,uint256,int24,int24,uint256)":{"notice":"Emitted when a position is created"},"RangeMoved(uint256,uint256,int24,int24,uint256,uint256)":{"notice":"Emitted after moving the range (migrating liquidity) to a new position"},"WithdrawnBothTokens(uint256,address,address,uint256,uint256)":{"notice":"Emitted after withdrawing both tokens"},"WithdrawnSingleToken(uint256,address,uint256,uint256,uint256)":{"notice":"Emitted after withdrawing to a single token"}},"kind":"user","methods":{"PRECISION()":{"notice":"Basis points precision used across the contract (1e4 = 100%)"},"claimFees(uint256,address,address,uint256)":{"notice":"Claims all accrued fees for a position and swaps them into a single token"},"claimFees(uint256,address,uint256,uint256)":{"notice":"Claims all accrued fees for a position in both tokens"},"compoundFees(uint256,uint128)":{"notice":"Compounds currently accrued fees back into the same position using auto-rebalancing"},"constructor":{"notice":"Initializes PancakeV3LPManager with Pancake V3 position manager and protocol fee collector"},"createPosition(address,uint256,uint256,int24,int24,address,uint256)":{"notice":"Creates a new Uniswap V3 position with best-effort input rebalancing to maximize liquidity"},"factory()":{"notice":"Uniswap V3 factory used to resolve pool addresses"},"getCurrentSqrtPriceX96(address)":{"notice":"Returns current sqrt price (Q96) for the given pool"},"getPoolInfo(address)":{"notice":"Returns basic pool information (addresses of tokens and fee tier)"},"getPosition(uint256)":{"notice":"Returns a comprehensive snapshot of a position including live unclaimed fees and current price"},"increaseLiquidity(uint256,uint256,uint256,uint128)":{"notice":"Adds liquidity to an existing position using input auto-rebalancing"},"moveRange(uint256,address,int24,int24,uint256)":{"notice":"Migrates liquidity to a new range by withdrawing and minting a new position within the same pool"},"pancakeV3SwapCallback(int256,int256,bytes)":{"notice":"Called to `msg.sender` after executing a swap via IPancakeV3Pool#swap."},"positionManager()":{"notice":"Uniswap V3 NonfungiblePositionManager used for position operations"},"previewClaimFees(uint256)":{"notice":"Preview the result of claiming fees in both tokens"},"previewClaimFees(uint256,address)":{"notice":"Preview the result of claiming fees in a single token"},"previewCompoundFees(uint256)":{"notice":"Preview the result of compounding fees"},"previewCreatePosition(address,uint256,uint256,int24,int24)":{"notice":"Preview the result of creating a new position without executing the transaction"},"previewIncreaseLiquidity(uint256,uint256,uint256)":{"notice":"Preview the result of increasing liquidity"},"previewMoveRange(uint256,int24,int24)":{"notice":"Preview the result of moving range (migrating li