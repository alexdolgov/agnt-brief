":"function"}],"devdoc":{"author":"HessianX","custom:developer":"BowTiedPickleBowTiedOriole","details":"The inputGuard functions are designed to be overriden by the inheriting contract.          Key assumptions:              1. Inheritor MUST ensure that the swap path and index token are acceptable.              2. Inheritor MAY check size, leverage, and option direction if desired.              3. Inheritor MUST validate the callback target address.              4. Inheritor MUST validate the receiver address.              5. Input guards MUST revert if their criteria are not met.          Failure to meet these assumptions may result in unsafe behavior!Several functions are payable to allow passing an execution fee to the Position Router.          Execution fee ETH must be provided with msg.value.Warning: This contract is intended for use as a facet of diamond proxy contracts.          Calling it directly may produce unintended or undesirable results.","kind":"dev","methods":{"constructor":{"params":{"_gmx_positionRouter":"GMX PositionRouter address","_gmx_router":"GMX Router address"}},"gmx_cancelDecreasePosition(bytes32,address)":{"params":{"_executionFeeReceiver":"Execution fee receiver address","_key":"Key"}},"gmx_cancelIncreasePosition(bytes32,address)":{"params":{"_executionFeeReceiver":"Execution fee receiver address","_key":"Key"}},"gmx_createDecreasePosition(address[],address,uint256,uint256,bool,address,uint256,uint256,uint256,bool,address)":{"details":"Approval must be handled via another function","params":{"_acceptablePrice":"Acceptable price","_callbackTarget":"Callback target","_collateralDelta":"Collateral delta","_executionFee":"Execution fee","_indexToken":"Index token address","_isLong":"Is long position","_minOut":"Minimum amount out","_path":"Path","_receiver":"Receiver address","_sizeDelta":"Size delta","_withdrawETH":"Withdraw ETH"}},"gmx_createIncreasePosition(address[],address,uint256,uint256,uint256,bool,uint256,uint256,bytes32,address)":{