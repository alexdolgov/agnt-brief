tract.\r"},"getController()":{"details":"Gets the current controller.\r","return":"Address of the controller.\r"},"mintTo(address,uint256)":{"details":"Mints new tokens.\r","params":{"amount":"Number of tokens to mint.\r","to":"Address to credit the tokens.\r"}},"reclaimContract(address)":{"details":"Reclaim ownership of Ownable contracts\r","params":{"_contractAddr":"The address of the Ownable to be reclaimed.\r"}},"reclaimEther()":{"details":"Transfer all Ether held by the contract to the owner.\r"},"reclaimToken(address)":{"details":"Reclaim all ERC20Basic compatible tokens\r","params":{"_token":"ERC20Basic The address of the token contract\r"}},"recover(address,address,bytes32,uint8,bytes32,bytes32)":{"details":"Recovers tokens from an address and reissues them to another address.\r In case a user loses its private key the tokens can be recovered by burning\r the tokens from that address and reissuing to a new address.\r To recover tokens the contract owner needs to provide a signature\r proving that the token owner has authorized the owner to do so.\r","params":{"from":"Address to burn tokens from.\r","h":"Hash which the token owner signed.\r","r":"Signature component.\r","s":"Sigature component.\r","to":"Address to mint tokens to.\r","v":"Signature component.\r"},"return":"Amount recovered.\r"},"renounceOwnership()":{"details":"Allows the current owner to relinquish control of the contract.\r"},"setController(address)":{"details":"Sets a new controller.\r","params":{"address_":"Address of the controller.\r"}},"tokenFallback(address,uint256,bytes)":{"details":"Reject all ERC223 compatible tokens\r","params":{"_data":"Bytes The data passed from the caller.\r","_from":"address The address that is transferring the tokens\r","_value":"uint256 the amount of the specified token\r"}},"totalSupply()":{"details":"Returns the total supply.\r","return":"Number of tokens.\r"},"transfer(address,uint256)":{"details":"Transfers tokens [ERC20].\r","params":{"amount":"Number of tokens to transfer.\r","to":"Recipient address.\r"}},"transferAndCall(address,uint256,bytes)":{"details":"Transfers tokens and subsequently calls a method on the recipient [ERC677].\r If the recipient is a non-contract address this method behaves just like transfer.\r","params":{"amount":"Number of tokens to transfer.\r","data":"Additional data passed to the recipient's tokenFallback method.\r","to":"Recipient address.\r"}},"transferFrom(address,address,uint256)":{"details":"Transfers tokens from a specific address [ERC20].\r The address owner has to approve the spender beforehand.\r","params":{"amount":"Number of tokens to transfer.\r","from":"Address to debet the tokens from.\r","to":"Recipient address.\r"}},"transferOwnership(address)":{"details":"Allows the current owner to set the pendingOwner address.\r","params":{"newOwner":"The address to transfer ownership to.\r"}}}},"userdoc":{"methods":{"renounceOwnership()":{"notice":"Renouncing to ownership will leave the contract without an owner.\r It will not be possible to call the functions with the `onlyOwner`\r modifier anymore.\r"}}}},"settings":{"compilationTarget":{"EUR.sol":"EUR"},"evmVersion":"byzantium","libraries":{},"optimizer":{"enabled":true,"runs":1000},"remappings":[]},"sources":{"EUR.sol":{"keccak256":"0x3a9e18d08b2024b6047d1fb34e37e900da1504c0a0450230f5350353482131e7","urls":["bzzr://671e865af093ac5c47880286b03931e6904da989750fcec187452ef7ee4afe93"]}},"version":1}