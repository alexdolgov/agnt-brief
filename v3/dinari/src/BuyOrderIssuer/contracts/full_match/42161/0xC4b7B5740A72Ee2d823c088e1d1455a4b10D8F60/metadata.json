unction"},{"inputs":[],"name":"treasury","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"}],"name":"upgradeTo","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"},{"internalType":"bytes","name":"data","type":"bytes"}],"name":"upgradeToAndCall","outputs":[],"stateMutability":"payable","type":"function"}],"devdoc":{"author":"Dinari (https://github.com/dinaricrypto/sbt-contracts/blob/main/src/BuyOrderIssuer.sol) This order processor emits market orders to buy the underlying asset that are good until cancelled Fees are calculated upfront and held back from the order amount The payment is escrowed until the order is filled or cancelled Payment is automatically refunded if the order is cancelled Implicitly assumes that asset tokens are BridgedERC20 and can be minted","errors":{"AmountTooLarge()":[{"details":"Amount too large"}],"DuplicateOrder()":[{"details":"Order already exists"}],"NotRequester()":[{"details":"msg.sender is not order requester"}],"OrderNotFound()":[{"details":"Order does not exist"}],"OrderTooSmall()":[{"details":"Order is too small to pay fees"}],"Paused()":[{"details":"Orders are paused"}],"ZeroAddress()":[{"details":"Zero address"}],"ZeroValue()":[{"details":"Zero value"}]},"events":{"AdminChanged(address,address)":{"details":"Emitted when the admin account has changed."},"BeaconUpgraded(address)":{"details":"Emitted when the beacon is changed."},"CancelRequested(bytes32,address)":{"details":"Emitted when order cancellation is requested"},"DefaultAdminDelayChangeCanceled()":{"details":"Emitted when a {pendingDefaultAdminDelay} is reset if its schedule didn't pass."},"DefaultAdminDelayChangeScheduled(uint48,uint48)":{"details":"Emitted when a {defaultAdminDelay} change is started, setting `newDelay` as the next delay to be applied between default admin transfer after `effectSchedule` has passed."},"DefaultAdminTransferCanceled()":{"details":"Emitted when a {pendingDefaultAdmin} is reset if it was never accepted, regardless of its schedule."},"DefaultAdminTransferScheduled(address,uint48)":{"details":"Emitted when a {defaultAdmin} transfer is started, setting `newAdmin` as the next address to become the {defaultAdmin} by calling {acceptDefaultAdminTransfer} only after `acceptSchedule` passes."},"Initialized(uint8)":{"details":"Triggered when the contract has been initialized or reinitialized."},"OrderCancelled(bytes32,address,string)":{"details":"Emitted when order is cancelled, terminal"},"OrderFeesSet(address)":{"details":"Emitted when `orderFees` is set"},"OrderFill(bytes32,address,uint256,uint256)":{"details":"Emitted for each fill"},"OrderFulfilled(bytes32,address)":{"details":"Emitted when order is completely filled, terminal"},"OrderRequested(bytes32,address,(address,address,address,bool,uint8,uint256,uint256,uint256,uint8,uint256),bytes32)":{"details":"Fully specifies order details and salt used to generate order ID"},"OrdersPaused(bool)":{"details":"Emitted when orders are paused/unpaused"},"RoleAdminChanged(bytes32,bytes32,bytes32)":{"details":"Emitted when `newAdminRole` is set as ``role``'s admin role, replacing `previousAdminRole` `DEFAULT_ADMIN_ROLE` is the starting admin for all roles, despite {RoleAdminChanged} not being emitted signaling this. _Available since v3.1._"},"RoleGranted(bytes32,address,address)":{"details":"Emitted when `account` is granted `role`. `sender` is the account that originated the contract call, an admin role bearer except when using {AccessControl-_setupRole}."},"RoleRevoked(bytes32,address,address)":{"details":"Emitted when `account` is revoked `role`. `sender` is the account that originated the contract call:   - if using `revokeRole`, it is the admin role bearer   - if using `renounceRole`, it is the role bearer (i.e. `account`)"},"TreasurySet(address)":{"details":"Emitted when `treasury` is set"},"Upgraded(address)":{"details":"Emitted when the implementation is upgraded."}},"kind":"dev","methods":{"acceptDefaultAdminTransfer()":{"details":"Completes a {defaultAdmin} transfer previously started with {beginDefaultAdminTransfer}. After calling the function: - `DEFAULT_ADMIN_ROLE` should be granted to the caller. - `DEFAULT_ADMIN_ROLE` should be revoked from the previous holder. - {pendingDefaultAdmin} should be reset to zero values. Requirements: - Only can be called by the {pendingDefaultAdmin}'s `newAdmin`. - The {pendingDefaultAdmin}'s `acceptSchedule` should've passed."},"beginDefaultAdminTransfer(address)":{"details":"Starts a {defaultAdmin} transfer by setting a {pendingDefaultAdmin} scheduled for acceptance after the current timestamp plus a {defaultAdminDelay}. Requirements: - Only can be called by the current {defaultAdmin}. Emits a DefaultAdminRoleChangeStarted event."},"cancelDefaultAdminTransfer()":{"details":"Cancels a {defaultAdmin} transfer previously started with {beginDefaultAdminTransfer}. A {pendingDefaultAdmin} not yet accepted can also be cancelled with this function. Requirements: - Only can be called by the current {defaultAdmin}. May emit a DefaultAdminTransferCanceled event."},"cancelOrder((address,address,address,uint256,uint256),bytes32,string)":{"details":"Only callable by operator","params":{"orderRequest":"Order request to cancel","reason":"Reason for cancellation","salt":"Salt used to generate unique order ID"}},"changeDefaultAdminDelay(uint48)":{"details":"Initiates a {defaultAdminDelay} update by setting a {pendingDefaultAdminDelay} scheduled for getting into effect after the current timestamp plus a {defaultAdminDelay}. This function guarantees that any call to {beginDefaultAdminTransfer} done between the timestamp this method is called and the {pendingDefaultAdminDelay} effect schedule will use the current {defaultAdminDelay} set before calling. The {pendingDefaultAdminDelay}'s effect schedule is defined in a way that waiting until the schedule and then calling {beginDefaultAdminTransfer} with the new delay will take at least the same as another {defaultAdmin} complete transfer (including acceptance). The schedule is designed for two scenarios: - When the delay is changed for a larger one the schedule is `block.timestamp + newDelay` capped by {defaultAdminDelayIncreaseWait}. - When the delay is changed for a shorter one, the schedule is `block.timestamp + (current delay - new delay)`. A {pendingDefaultAdminDelay} that never got into effect will be canceled in favor of a new scheduled change. Requirements: - Only can be called by the current {defaultAdmin}. Emits a DefaultAdminDelayChangeScheduled event and may emit a DefaultAdminDelayChangeCanceled event."},"defaultAdmin()":{"details":"Returns the address of the current `DEFAULT_ADMIN_ROLE` holder."},"defaultAdminDelay()":{"details":"Returns the delay required to schedule the acceptance of a {defaultAdmin} transfer started. This delay will be added to the current timestamp when calling {beginDefaultAdminTransfer} to set the acceptance schedule. NOTE: If a delay change has been scheduled, it will take effect as soon as the schedule passes, making this function returns the new delay. See {changeDefaultAdminDelay}."},"defaultAdminDelayIncreaseWait()":{"details":"Maximum time in seconds for an increase to {defaultAdminDelay} (that is scheduled using {changeDefaultAdminDelay}) to take effect. Default to 5 days. When the {defaultAdminDelay} is scheduled to be increased, it goes into effect after the new delay has passed with the purpose of giving enough time for reverting any accidental change (i.e. using milliseconds instead of seconds) that may lock the contract. However, to avoid excessive schedules, the wait is capped by this function and it can be overrode for a custom {defaultAdminDelay} increase scheduling. IMPORTANT: Make sure to add a reasonable amount of time while overriding this value, otherwise, there's a risk of setting a high new delay that goes into effect almost immediately without the possibility of human intervention in the case of an input error (eg. set milliseconds instead of seconds)."},"fillOrder((address,address,address,uint256,uint256),bytes32,uint256,uint256)":{"details":"Only callable by operator","params":{"fillAmount":"Amount of order token to fill","orderRequest":"Order request to fill","receivedAmount":"Amount of received token","salt":"Salt used to generate unique order ID"}},"getFeesForOrder(address,uint256)":{"details":"Fees zero if no orderFees contract is set","params":{"inputValue":"Total input value subject to fees","token":"Payment token for order"},"returns":{"flatFee":"Flat fee for order","percentageFee":"Percentage fee for order"}},"getInputValueForOrderValue(address,uint256)":{"details":"Fees zero if no orderFees contract is set","params":{"orderValue":"Final order value","token":"Payment token for order"},"returns":{"flatFee":"Flat fee for order","inputValue":"Total input value subject to fees","percentageFee":"Percentage fee for order"}},"getOrderId((address,address,address,bool,uint8,uint256,uint256,uint256,uint8,uint256),bytes32)":{"params":{"order":"Order to get ID for","salt":"Salt used to generate unique order ID"}},"getOrderIdFromOrderRequest((address,address,address,uint256,uint256),bytes32)":{"details":"Compliant with EIP-712 for convenient offchain computation","params":{"orderRequest":"Order request to get ID for","salt":"Salt used to generate unique order ID"}},"getOrderRequestForOrder((address,address,address,bool,uint8,uint256,uint256,uint256,uint8,uint256))":{"details":"Declared pure to be calculable for hypothetical orders"},"getRemainingOrder(bytes32)":{"params":{"id":"Order ID to check"}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getTotalReceived(bytes32)":{"params":{"id":"Order ID to check"}},"grantRole(bytes32,address)":{"details":"See {AccessControl-grantRole}. Reverts for `DEFAULT_ADMIN_ROLE`."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"initialize(address,address,address)":{"details":"Treasury cannot be zero address","params":{"orderFees_":"Fee specification contract","owner":"Owner of contract","treasury_":"Address to receive fees"}},"isOrderActive(bytes32)":{"params":{"id":"Order ID to check"}},"multicall(bytes[])":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Receives and executes a batch of function calls on this contract."},"owner()":{"details":"See {IERC5313-owner}."},"pendingDefaultAdmin()":{"details":"Returns a tuple of a `newAdmin` and an accept schedule. After the `schedule` passes, the `newAdmin` will be able to accept the {defaultAdmin} role by calling {acceptDefaultAdminTransfer}, completing the role transfer. A zero value only in `acceptSchedule` indicates no pending admin transfer. NOTE: A zero address `newAdmin` means that {defaultAdmin} is being renounced."},"pendingDefaultAdminDelay()":{"details":"Returns a tuple of `newDelay` and an effect schedule. After the `schedule` passes, the `newDelay` will get into effect immediately for every new {defaultAdmin} transfer started with {beginDefaultAdminTransfer}. A zero value only in `effectSchedule` indicates no pending delay change. NOTE: A zero value only for `newDelay` means that the next {defaultAdminDelay} will be zero after the effect schedule."},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"renounceRole(bytes32,address)":{"details":"See {AccessControl-renounceRole}. For the `DEFAULT_ADMIN_ROLE`, it only allows renouncing in two steps by first calling {beginDefaultAdminTransfer} to the `address(0)`, so it's required that the {pendingDefaultAdmin} schedule has also passed when calling this function. After its execution, it will not be possible to call `onlyRole(DEFAULT_ADMIN_ROLE)` functions. NOTE: Renouncing `DEFAULT_ADMIN_ROLE` will leave the contract without a {defaultAdmin}, thereby disabling any functionality that is only available for it, and the possibility of reassigning a non-administrated role."},"requestCancel((address,address,address,uint256,uint256),bytes32)":{"details":"Only callable by initial order requesterEmits CancelRequested event to be sent to fulfillment service (operator)","params":{"orderRequest":"Order request to cancel","salt":"Salt used to generate unique order ID"}},"requestOrder((address,address,address,uint256,uint256),bytes32)":{"details":"Emits OrderRequested event to be sent to fulfillment service (operator)","params":{"orderRequest":"Order request to submit","salt":"Salt used to generate unique order ID"}},"revokeRole(bytes32,address)":{"details":"See {AccessControl-revokeRole}. Reverts for `DEFAULT_ADMIN_ROLE`."},"rollbackDefaultAdminDelay()":{"details":"Cancels a scheduled {defaultAdminDelay} change. Requirements: - Only can be called by the current {defaultAdmin}. May emit a DefaultAdminDelayChangeCanceled event."},"selfPermit(address,uint256,uint256,uint8,bytes32,bytes32)":{"details":"The `owner` is always msg.sender and the `spender` is always address(this).","params":{"deadline":"A timestamp, the current blocktime must be less than or equal to this timestamp","r":"Must produce valid secp256k1 signature from the holder along with `v` and `s`","s":"Must produce valid secp256k1 signature from the holder along with `r` and `v`","token":"The address of the token spent","v":"Must produce valid secp256k1 signature from the holder along with `r` and `s`","value":"The amount that can be spent of token"}},"setOrderFees(address)":{"details":"Only callable by admin","params":{"fees":"Order fees contract"}},"setOrdersPaused(bool)":{"details":"Only callable by admin","params":{"pause":"Pause orders if true, unpause if false"}},"setTreasury(address)":{"details":"Only callable by admin Treasury cannot be zero address","params":{"account":"Address to receive fees"}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"upgradeTo(address)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."}},"stateVariables":{"_feeState":{"details":"orderId => FeeState"}},"version":1},"userdoc":{"errors":{"PRBMath_MulDiv_Overflow(uint256,uint256,uint256)":[{"notice":"Thrown when the resultant value in {mulDiv} overflows uint256."}]},"kind":"user","methods":{"ADMIN_ROLE()":{"notice":"Admin role for managing treasury, fees, and paused state"},"ASSETTOKEN_ROLE()":{"notice":"Asset token role for whitelisting asset tokens"},"OPERATOR_ROLE()":{"notice":"Operator role for filling and cancelling orders"},"PAYMENTTOKEN_ROLE()":{"notice":"Payment token role for whitelisting payment tokens"},"cancelOrder((address,address,address,uint256,uint256),bytes32,string)":{"notice":"Cancel an order"},"fillOrder((address,address,address,uint256,uint256),bytes32,uint256,uint256)":{"notice":"Fill an order"},"getFeesForOrder(address,uint256)":{"notice":"Get fees for an order"},"getIn