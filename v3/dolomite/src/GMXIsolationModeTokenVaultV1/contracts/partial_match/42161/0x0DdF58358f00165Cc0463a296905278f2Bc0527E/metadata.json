akerAccounts":"The accounts that will be used for the maker side of the trades involving                                      `TraderType.InternalLiquidity`.","_marketIdsPath":"The path of market IDs to use for each trade action. Length should be equal                                      to `_tradersPath.length + 1`.","_minOutputAmountWei":"The minimum output amount expected to be received by the user.","_tradersPath":"The path of traders to use for each trade action. Length should be equal to                                      `_marketIdsPath.length - 1`.","_userConfig":"The user configuration for the trade. Setting the `balanceCheckFlag` to                                      `BalanceCheckFlag.From` will check that the user's `_borrowAccountNumber`                                      and `_fromAccountNumber` is non-negative after the trade."}},"dolomiteRegistry()":{"returns":{"_0":"The registry used to discover important addresses for Dolomite"}},"executeDepositIntoVault(address,uint256)":{"params":{"_amount":"The amount of the vault's underlying token to transfer.","_from":"The sender of the tokens into this vault."}},"executeWithdrawalFromVault(address,uint256)":{"params":{"_amount":"The amount of the vault's underlying token to transfer out.","_recipient":"The address to receive the withdrawal."}},"swapExactInputForOutput(uint256,uint256[],uint256,uint256,(uint8,uint256,address,bytes)[],(address,uint256)[],(uint256,uint8,uint8))":{"details":"End-user function for swapping an exact amount of input for a minimum amount of output. Reverts if          `_tradeAccountNumber` is 0.","params":{"_inputAmountWei":"The input amount (in wei) to use for the initial trade action. Setting this                                      value to `uint(-1)` will use the user's full balance.","_makerAccounts":"The accounts that will be used for the maker side of the trades involving                                      `TraderType.InternalLiquidity`.","_marketIdsPath":"The path of market IDs to use for each trade action. Length should be equal                                      to `_tradersPath.length + 1`.","_minOutputAmountWei":"The minimum output amount expected to be received by the user.","_tradeAccountNumber":"The account number to use for the vault's trade. Cannot be 0.","_tradersPath":"The path of traders to use for each trade action. Length should be equal to                                      `_marketIdsPath.length - 1`.","_userConfig":"The user configuration for the trade. Setting the `balanceCheckFlag` to                                      `BalanceCheckFlag.From` will check that the user's `_tradeAccountNumber`                                      is non-negative after the trade. Setting the `balanceCheckFlag` to                                      `BalanceCheckFlag.To` has no effect."}},"swapExactInputForOutputAndRemoveCollateral(uint256,uint256,uint256[],uint256,uint256,(uint8,uint256,address,bytes)[],(address,uint256)[],(uint256,uint8,uint8))":{"details":"End-user function for removing collateral from the vault (in the case where `_marketIdsPath[last]` is          the underlying marketId) or the vault owner (in the case where `_marketIdsPath[last]` is not the          underlying marketId). Reverts if `_borrowAccountNumber` is 0 or if `_toAccountNumber` is not 0 (and          the `_marketIdsPath[0]` is the underlying). Reverts if the user has a negative balance before the swap          for `_marketIdsPath[last]`.","params":{"_borrowAccountNumber":"The account number to use for the vault's trade.","_inputAmountWei":"The input amount (in wei) to use for the initial trade action. Setting this                                      value to `uint(-1)` will use the user's full balance.","_makerAccounts":"The accounts that will be used for the maker side of the trades involving                                      `TraderType.InternalLiquidity`.","_marketIdsPath":"The path of market IDs to use for each trade action. Length should be equal                                      to `_tradersPath.length + 1`.","_minOutputAmountWei":"The minimum output amount expected to be received by the user.","_toAccountNumber":"The account number to receive the collateral transfer after the trade.","_tradersPath":"The path of traders to use for each trade action. Length should be equal to                                      `_marketIdsPath.length - 1`.","_userConfig":"The user configuration for the trade. Setting the `balanceCheckFlag` to                                      `BalanceCheckFlag.From` will check that the user's `_tradeAccountNumber`                                      is non-negative after the trade. Setting the `balanceCheckFlag` to                                      `BalanceCheckFlag.To` has no effect."}},"underlyingBalanceOf()":{"returns":{"_0":"The amount of `UNDERLYING_TOKEN` that are currently in this vault."}}},"title":"GMXIsolationModeTokenVaultV1","version":1},"userdoc":{"kind":"user","methods":{"closeBorrowPositionWithUnderlyingVaultToken(uint256,uint256)":{"notice":"End-user function for closing a borrow position involving the vault factory's underlying token. Should          only be executable by the vault owner. Reverts if `_borrowAccountNumber` is 0 or if `_toAccountNumber`          is not 0."},"depositIntoVaultForDolomiteMargin(uint256,uint256)":{"notice":"End-user function for depositing the vault factory's underlying token into DolomiteMargin. Should only          be executable by the vault owner OR the vault factory."},"executeDepositIntoVault(address,uint256)":{"notice":"Attempts to deposit assets into this vault from the vault's owner. Reverts if the caller is not the          Vault Factory."},"executeWithdrawalFromVault(address,uint256)":{"notice":"Attempts to withdraw assets from this vault to the recipient. Reverts if the caller is not the          Vault Factory."},"initialize()":{"notice":"Initializes the vault contract. Should only be executable once by the proxy."},"multicall(bytes[])":{"notice":"End-user function for calling more than one vault function at a time. Should only          be executable by the vault owner."},"openBorrowPosition(uint256,uint256,uint256)":{"notice":"End-user function for opening a borrow position involving the vault factory's underlying token. Should          only be executable by the vault owner. Reverts if `_fromAccountNumber` is not 0 or if `_toAccountNumber`          is 0."},"openMarginPosition(uint256,uint256,uint256,uint256)":{"notice":"End-user function for opening a margin position involving the vault factory's underlying token. Should          only be executable by the vault owner. Reverts if `_fromAccountNumber` is not 0 or if `_toAccountNumber`          is 0. The `_borrowMarketId` is unused except for emitting the event needed to index the Subgraph."},"repayAllForBorrowPosition(uint256,uint256,uint256,uint8)":{"notice":"End-user function for transferring collateral involving anything BUT the vault factory's underlying          token. Should only be executable by the vault owner. Throws if the `_marketId` is set to the vault          factory's underlying token. Reverts if `_borrowAccountNumber` is 0."},"transferFromPositionWithOtherToken(uint256,uint256,uint256,uint256,uint8)":{"notice":"End-user function for transferring collateral from a position using anything BUT the vault factory's          underlying token. Should only be executable by the vault owner. Throws if the `_marketId` is set to the          vault factory's underlying token. Reverts if `_borrowAccountNumber` is 0."},"transferFromPositionWithUnderlyingToken(uint256,uint256,uint256)":{"notice":"End-user function for transferring collateral from a position using the vault factory's underlying          token. Should only be executable by the vault owner. Reverts if `_borrowAccountNumber` is 0 or if          `_toAccountNumber` is not 0."},"transferIntoPositionWithOtherToken(uint256,uint256,uint256,uint256,uint8)":{"notice":"En