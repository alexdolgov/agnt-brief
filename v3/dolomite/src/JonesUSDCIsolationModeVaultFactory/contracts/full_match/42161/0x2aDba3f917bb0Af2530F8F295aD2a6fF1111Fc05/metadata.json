alMarketIds()":{"returns":{"_0":"The market IDs of the assets that can be used as collateral in a position with this wrapped asset. An          empty array indicates that any non-isolation mode asset can be borrowed against it. To indicate that no          assets can be used as collateral, return an array with a single element containing #NONE."}},"allowableDebtMarketIds()":{"returns":{"_0":"The market IDs of the assets that can be borrowed in a position with this wrapped asset. An empty array          indicates that any non-isolation mode asset can be borrowed against it."}},"allowance(address,address)":{"details":"See {IERC20-allowance}."},"approve(address,uint256)":{"details":"See {IERC20-approve}. NOTE: If `amount` is the maximum `uint256`, the allowance is not updated on `transferFrom`. This is semantically equivalent to an infinite approval. Requirements: - `spender` cannot be the zero address."},"balanceOf(address)":{"details":"See {IERC20-balanceOf}."},"createVault(address)":{"params":{"_account":"The account owner to create the vault for"}},"createVaultAndDepositIntoDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to deposit","_toAccountNumber":"The account number of the account to which the tokens will be deposited"}},"decimals()":{"details":"Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5.05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overridden; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"decreaseAllowance(address,uint256)":{"details":"Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."},"depositIntoDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to deposit","_toAccountNumber":"The account number of the account to which the tokens will be deposited"}},"enqueueTransferFromDolomiteMargin(address,uint256)":{"params":{"_amountWei":"The amount of tokens to transfer from Dolomite Margin to the token converter","_vault":"The address of the vault that the token converter is interacting with"}},"enqueueTransferIntoDolomiteMargin(address,uint256)":{"params":{"_amountWei":"The amount of tokens to transfer into Dolomite Margin","_vault":"The address of the vault that the token converter is interacting with"}},"getAccountByVault(address)":{"params":{"_vault":"The vault that's used by an account for depositing/withdrawing"},"returns":{"_account":"The address of the account that owns the `_vault`"}},"getQueuedTransferByCursor(uint256)":{"params":{"_transferCursor":"The cursor used to key into the mapping of queued transfers"},"returns":{"_0":"The transfer enqueued in the mapping at the cursor's position"}},"getVaultByAccount(address)":{"params":{"_account":"The account owner to get the vault for"},"returns":{"_vault":"  The address of the vault created for `_account`. Returns address(0) if no vault has been                   created yet for this account."}},"increaseAllowance(address,uint256)":{"details":"Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address."},"isIsolationAsset()":{"returns":{"_0":"This function should always return `true`. It's used by The Graph to index this contract as a Wrapper."}},"isTokenConverterTrusted(address)":{"returns":{"_0":"True if the token converter is currently in-use by this contract."}},"name()":{"details":"Returns the name of the token."},"ownerSetIsTokenConverterTrusted(address,bool)":{"params":{"_isTrusted":"True if the token converter is trusted, false otherwise","_tokenConverter":"The address of the token converter contract to set whether or not it's trusted for                          executing transfers to/from vaults"}},"ownerSetUserVaultImplementation(address)":{"params":{"_userVaultImplementation":"The address of the new vault implementation contract"}},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `amount`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `amount`. - the caller must have allowance for ``from``'s tokens of at least `amount`."},"withdrawFromDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to withdraw","_fromAccountNumber":"The account number of the account from which the tokens will be withdrawn"}}},"title":"JonesUSDCIsolationModeVaultFactory","version":1},"userdoc":{"kind":"user","methods":{"calculateVaultByAccount(address)":{"notice":"Same as `getVaultByAccount`, but always returns the user's non-zero vault address."},"createVault(address)":{"notice":"Creates the vault for `_account`"},"createVaultAndDepositIntoDolomiteMargin(uint256,uint256)":{"notice":"Creates the vault for `msg.sender`"},"depositIntoDolomiteMargin(uint256,uint256)":{"notice":"This function should only be called by a user's vault contract"},"enqueueTransferFromDolomiteMargin(address,uint256)":{"notice":"Enqueues a transfer from Dolomite Margin to the token converter. Assumes msg.sender is a trusted token          converter, else reverts. Reverts if `_vault` is not a valid vault contract."},"enqueueTransferIntoDolomiteMargin(address,uint256)":{"notice":"Enqueues a transfer into Dolomite Margin from the vault. Assumes msg.sender is a trusted token          converter, else reverts. Reverts if `_vault` is not a valid vault contract."},"isTokenConverterTrusted(address)":{"notice":"A token converter is used to convert this underlying token into a Dolomite-compatible one for deposit          or withdrawal"},"ownerInitialize(address[])":{"notice":"Initializes this contract's variables that are dependent on this token being added to DolomiteMargin."},"ownerSetIsTokenConverterTrusted(address,bool)":{"notice":"A token converter is used to convert this underlying token into a Dolomite-compatible one for deposit          or withdrawal"},"withdrawFromDolomiteMargin(uint256,uint256)":{"notice":"This function should only be called by a user's vault contract"}},"notice":"The wrapper around the plvGLP token that is used to create user vaults and manage the entry points that a          user can use to interact with DolomiteMargin from the vault.","version":1}},"settings":{"compilationTarget":{"contracts/external/jones/jusdc/JonesUSDCIsolationModeVaultFactory.sol":"JonesUSDCIsolationModeVaultFactory"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"details":{"constantOptimizer":true,"cse":true,"deduplicate":true,"inliner":true,"jumpdestRemover":true,"orderLiterals":true,"peephole":true,"yul":false},"runs":10000},"remappings":[]},"sources":{"@openzeppelin/contracts/security/Reentranc