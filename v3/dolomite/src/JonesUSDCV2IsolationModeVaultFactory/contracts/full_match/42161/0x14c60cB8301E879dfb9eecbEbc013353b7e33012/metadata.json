ls":"See {IERC20-approve}. NOTE: If `amount` is the maximum `uint256`, the allowance is not updated on `transferFrom`. This is semantically equivalent to an infinite approval. Requirements: - `spender` cannot be the zero address."},"balanceOf(address)":{"details":"See {IERC20-balanceOf}."},"createVault(address)":{"params":{"_account":"The account owner to create the vault for"}},"createVaultAndDepositIntoDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to deposit","_toAccountNumber":"The account number of the account to which the tokens will be deposited"}},"decimals()":{"details":"Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5.05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overridden; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"depositIntoDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to deposit","_toAccountNumber":"The account number of the account to which the tokens will be deposited"}},"enqueueTransferFromDolomiteMargin(address,uint256)":{"params":{"_amountWei":"The amount of tokens to transfer from Dolomite Margin to the token converter","_vault":"The address of the vault that the token converter is interacting with"}},"enqueueTransferIntoDolomiteMargin(address,uint256)":{"params":{"_amountWei":"The amount of tokens to transfer into Dolomite Margin","_vault":"The address of the vault that the token converter is interacting with"}},"getAccountByVault(address)":{"params":{"_vault":"The vault that's used by an account for depositing/withdrawing"},"returns":{"_account":"The address of the account that owns the `_vault`"}},"getQueuedTransferByCursor(uint256)":{"params":{"_transferCursor":"The cursor used to key into the mapping of queued transfers"},"returns":{"_0":"The transfer enqueued in the mapping at the cursor's position"}},"getVaultByAccount(address)":{"params":{"_account":"The account owner to get the vault for"},"returns":{"_vault":"  The address of the vault created for `_account`. Returns address(0) if no vault has been                   created yet for this account."}},"isIsolationAsset()":{"returns":{"_0":"This function should always return `true`. It's used by The Graph to index this contract as a Wrapper."}},"isTokenConverterTrusted(address)":{"returns":{"_0":"True if the token converter is currently in-use by this contract."}},"name()":{"details":"Returns the name of the token."},"ownerSetIsTokenConverterTrusted(address,bool)":{"params":{"_isTrusted":"True if the token converter is trusted, false otherwise","_tokenConverter":"The address of the token converter contract to set whether or not it's trusted for                          executing transfers to/from vaults"}},"ownerSetUserVaultImplementation(address)":{"params":{"_userVaultImplementation":"The address of the new vault implementation contract"}},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `amount`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `amount`. - the caller must have allowance for ``from``'s tokens of at