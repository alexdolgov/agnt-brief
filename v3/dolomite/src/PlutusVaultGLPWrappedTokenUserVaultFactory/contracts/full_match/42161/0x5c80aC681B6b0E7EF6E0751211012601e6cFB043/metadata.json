etails":"See {IERC20-balanceOf}."},"createVault(address)":{"params":{"_account":"The account owner to create the vault for"}},"createVaultAndDepositIntoDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to deposit","_toAccountNumber":"The account number of the account to which the tokens will be deposited"}},"decimals()":{"details":"Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5.05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overridden; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"decreaseAllowance(address,uint256)":{"details":"Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."},"depositIntoDolomiteMargin(uint256,uint256)":{"params":{"_amountWei":"The amount of tokens to deposit","_toAccountNumber":"The account number of the account to which the tokens will be deposited"}},"enqueueTransferFromDolomiteMargin(address,uint256)":{"params":{"_amountWei":"The amount of tokens to transfer from Dolomite Margin to the token converter","_vault":"The address of the vault that the token converter is interacting with"}},"enqueueTransferIntoDolomiteMargin(address,uint256)":{"params":{"_amountWei":"The amount of tokens to transfer into Dolomite Margin","_vault":"The address of the vault that the token converter is interacting with"}},"getAccountByVault(address)":{"para