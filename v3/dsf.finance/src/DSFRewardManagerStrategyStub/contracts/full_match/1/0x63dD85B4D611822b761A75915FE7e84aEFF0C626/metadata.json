"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"rewardManager","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_rewardManager","type":"address"}],"name":"setRewardManager","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"totalHoldings","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256[3]","name":"","type":"uint256[3]"},{"internalType":"enum DSFRewardManagerStrategyStub.WithdrawalType","name":"","type":"uint8"},{"internalType":"uint128","name":"","type":"uint128"}],"name":"withdraw","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"pure","type":"function"},{"inputs":[],"name":"withdrawAll","outputs":[],"stateMutability":"pure","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"author":"Andrei Averin — CTO dsf.finance","errors":{"OwnableInvalidOwner(address)":[{"details":"The owner is not a valid owner account. (eg. `address(0)`)"}],"OwnableUnauthorizedAccount(address)":[{"details":"The caller account is not authorized to perform an operation."}]},"kind":"dev","methods":{"autoCompound()":{"details":"Must NOT revert."},"calcSharesAmount(uint256[3],bool)":{"details":"Stubbed to zero."},"calcWithdrawOneCoin(uint256,uint128)":{"details":"Stubbed to zero."},"claimManagementFees()":{"details":"Must NOT revert."},"deposit(uint256[3])":{"details":"Always reverts to guarantee DSF can never move liquidity into this pool."},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"totalHoldings()":{"details":"Must NOT revert."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"withdraw(address,uint256,uint256[3],uint8,uint128)":{"details":"Always reverts to guarantee this pool can never be used as a liquidity source/sink."},"withdrawAll()":{"details":"Always reverts (same rationale as withdraw())."}},"title":"DSFRewardManagerStrategyStub","version":1},"userdoc":{"kind":"user","methods":{"autoCompound()":{"notice":"Called by DSF.autoCompoundAll() in a loop."},"calcSharesAmount(uint256[3],bool)":{"notice":"View helper used by DSF/UI."},"calcWithdrawOneCoin(uint256,uint128)":{"notice":"View helper used by DSF/UI."},"claimManagementFees()":{"notice":"Called by DSF.claimAllManagementFee() in a loop."},"deposit(uint256[3])":{"notice":"DSF deposit entrypoint."},"dsf()":{"notice":"DSF core contract address"},"rewardManager()":{"notice":"RewardManager address used for holdings-forwarding"},"setRewardManager(address)":{"notice":"Update RewardManager address (in case of RM upgrade/migration)."},"totalHoldings()":{"notice":"Called by DSF.totalHoldings()/lpPrice() aggregation."},"withdraw(address,uint256,uint256[3],uint8,uint128)":{"notice":"DSF withdraw entrypoint."},"withdrawAll()":{"notice":"DSF withdraw-all entrypoint."}},"notice":"A \"plug / stub\" strategy intended to be used as a DSF pool strategy when a wrong address (e.g., RewardManager) was mistakenly added into DSF pools and cannot be removed. Goals: 1) Do NOT break DSF global loops:    - DSF.autoCompoundAll()   -> strategy.autoCompound() MUST NOT revert    - DSF.claimAllManagementFee() -> strategy.claimManagementFees() MUST NOT revert    - DSF.totalHoldings() / lpPrice() -> strategy.totalHoldings() MUST NOT revert 2) Prevent DSF from ever moving liquidity into this pool:    - deposit(...) MUST revert    - withdraw(...) MUST revert    - withdrawAll() MUST revert 3) Forward accounting:    - totalHoldings() returns RewardManager.totalHoldings()      so DSF can include RewardManager holdings in its aggregated holdings math (if desired). Safety notes: - This is NOT a yield strategy. - Never set this pool as defaultDepositPid / defaultWithdrawPid. - Never use it in moveFundsBatch sources/receivers. Compatibility: - Matches DSF.sol calls and existing strategy signatures in your codebase   (CurveConvexStratBaseMk2 / CurveConvexExtraStratBaseMk2).","version":1}},"settings":{"compilationTarget":{"contracts/strategies/DSFRewardManagerStrategyStub.sol":"DSFRewardManagerStrategyStub"},"evmVersion":"osaka","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":20},"remappings":[],"viaIR":true},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0xff6d0bb2e285473e5311d9d3caacb525ae3538a80758c10649a4d61029b017bb","license":"MIT","urls":["bzz-raw://8ed324d3920bb545059d66ab97d43e43ee85fd3bd52e03e401f020afb0b120f6","dweb:/ipfs/QmfEckWLmZkDDcoWrkEvMWhms66xwTLff9DDhegYpvHo1a"]},"@openzeppelin/contracts/utils/Context.sol":{"keccak256":"0x493033a8d1b176a037b2cc6a04dad01a5c157722049bbecf632ca876224dd4b2","license":"MIT","urls":["bzz-raw://6a708e8a5bdb1011c2c381c9a5cfd8a9a956d7d0a9dc1bd8bcdaf52f76ef2f12","dweb:/ipfs/Qmax9WHBnVsZP46ZxEMNRQpLQnrdE4dK8LehML1Py8FowF"]},"contracts/strategies/DSFRewardManagerStrategyStub.sol":{"keccak256":"0x64eb804a41b310e4fcf7daade86e560efcefbe9cf9a2cca8e82dc935e6be7da8","license":"MIT","urls":["bzz-raw://0f88689e325b876820dc6ec14d6186cc9f3f4066b30aff5f9eeba6bfd9ca62d3","dweb:/ipfs/QmZscvataDoYzQrHZRAzeGjupS2V4YJkYv68KW9YYzQhBb"]}},"version":1}