,"type":"uint16"}],"name":"setDefaultSlippageBps","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newFD","type":"address"}],"name":"setFeeDistributor","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"address[]","name":"path","type":"address[]"}],"name":"setPathToUsdt","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"pid","type":"uint256"},{"internalType":"bool","name":"v","type":"bool"}],"name":"setPoolBlacklisted","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newRouter","type":"address"}],"name":"setRouter","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bytes4","name":"interfaceId","type":"bytes4"}],"name":"supportsInterface","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"swapAllAuto","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bytes","name":"payload","type":"bytes"},{"internalType":"uint256","name":"minAmountOut","type":"uint256"},{"internalType":"bool","name":"useOracleGuard","type":"bool"},{"internalType":"uint16","name":"maxDevBps","type":"uint16"}],"name":"swapManualRoute","outputs":[{"internalType":"uint256","name":"netOut","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bytes","name":"payloadA","type":"bytes"},{"internalType":"bytes","name":"payloadB","type":"bytes"},{"internalType":"uint16","name":"percentA","type":"uint16"},{"internalType":"uint256","name":"minAmountOut","type":"uint256"},{"internalType":"bool","name":"useOracleGuard","type":"bool"},{"internalType":"uint16","name":"maxDevBps","type":"uint16"}],"name":"swapManualSplit","outputs":[{"internalType":"uint256","name":"netOut","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"totalHoldings","outputs":[{"internalType":"uint256","name":"netUSDT_1e18","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"Andrei Averin — CTO dsf.finance","details":"Important assumptions:         - DSF.autoCompoundAll() makes strategies push reward tokens to this contract (RewardManager)         - Router.getAmountsOut() returns NET out amount (fees included) for the final token in path         - USDT uses 6 decimals; internal \"pricing\" uses 1e18 scale where needed","errors":{"AccessControlBadConfirmation()":[{"details":"The caller of a function is not the expected one. NOTE: Don't confuse with {AccessControlUnauthorizedAccount}."}],"AccessControlUnauthorizedAccount(address,bytes32)":[{"details":"The `account` is missing a role."}],"OwnableInvalidOwner(address)":[{"details":"The owner is not a valid owner account. (eg. `address(0)`)"}],"OwnableUnauthorizedAccount(address)":[{"details":"The caller account is not authorized to perform an operation."}],"ReentrancyGuardReentrantCall()":[{"details":"Unauthorized reentrant call."}],"SafeERC20FailedOperation(address)":[{"details":"An operation with an ERC-20 token failed."}]},"events":{"RoleAdminChanged(bytes32,bytes32,bytes32)":{"details":"Emitted when `newAdminRole` is set as ``role``'s admin role, replacing `previousAdminRole` `DEFAULT_ADMIN_ROLE` is the starting admin for all roles, despite {RoleAdminChanged} not being emitted to signal this."},"RoleGranted(bytes32,address,address)":{"details":"Emitted when `account` is granted `role`. `sender` is the account that originated the contract call. This account bears the admin role (for the granted role). Expected in cases where the role was granted using the internal {AccessControl-_grantRole}."},"RoleRevoked(bytes32,address,address)":{"details":"Emitted when `account` is revoked `role`. `sender` is the account that originated the contract call:   - if using `revokeRole`, it is the admin role bearer   - if using `renounceRole`, it is the role bearer (i.e. `account`)"}},"kind":"dev","methods":{"DSFAutoCompoundAll()":{"details":"Intended to claim/push rewards from all strategies to RewardManager      Only callable by OPERATOR_ROLE"},"addOperator(address)":{"details":"Only callable by DEFAULT_ADMIN_ROLE","params":{"op":"Address to grant operator permissions"}},"constructor":{"params":{"dsf_":"DSF core address","feeDistributor_":"Fee recipient address","router_":"UniversalRouter address"}},"getAutoSwapTokens()":{"returns":{"_0":"Array of whitelisted reward tokens"}},"getBestRoute(address,address,uint256)":{"details":"Simple proxy to router.getBestRoute()         Provides:         - Top1 1-hop route         - Top1 2-hop route         - Top2 1-hop route         - Top2 2-hop route         - Suggested split configuration","params":{"amountIn":"Input amount","tokenIn":"Input token address","tokenOut":"Output token address"},"returns":{"amountOut1HopTop1":"Output for best 1-hop route (rank 1)","amountOut1HopTop2":"Output for best 1-hop route (rank 2)","amountOut2HopTop1":"Output for best 2-hop route (rank 1)","amountOut2HopTop2":"Output for best 2-hop route (rank 2)","best1HopRouteTop1":"Encoded best 1-hop route (rank 1)","best1HopRouteTop2":"Encoded best 1-hop route (rank 2)","best2HopRouteTop1":"Encoded best 2-hop route (rank 1)","best2HopRouteTop2":"Encoded best 2-hop route (rank 2)","splitAmountOut":"   Estimated output using suggested split","splitPercentA":"    Suggested percent allocation to route A (1..99)"}},"getPathToUsdt(address)":{"params":{"token":"Input token address"},"returns":{"_0":"Swap path (token ... USDT)"}},"getPoolsInfo()":{"details":"Returns multiple arrays (tuple of arrays) instead of an array of structs         to ensure compatibility with all UI/Analytics tools and avoid ABI-decoding issues.         Iterates over all DSF pools and includes only:         - Pools not blacklisted         - Pools with a valid deployed strategy         - Pools not pointing to this RewardManager (self-pid guard)","returns":{"LPprice":"     Array of computed share prices (1e18 precision)","lpShares":"    Array of total LP shares per pool","pids":"        Array of pool IDs","strategies":"  Array of strategy addresses","totalHolding":"Array of total holdings in USDT (1e18 precision)"}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"isOperator(address)":{"params":{"op":"Address to check"},"returns":{"_0":"True if address has operator role"}},"managerCompoundAllToDepositPool(uint256)":{"params":{"amountUSDT":"0 = use entire USDT balance after swaps"}},"managerCompoundAllToWithdrawPool(uint256)":{"params":{"amountUSDT":"0 = use entire USDT balance after swaps"}},"managerCompoundManual(uint256[],uint16[],uint256)":{"params":{"amountUSDT":"0 = use entire USDT balance of RewardManager","bps":"Weights in bps (sum = 10_000)","pids":"DSF pool ids"}},"managerCompoundRebalanceToTarget(uint256,uint256)":{"details":"Logic:         1) autoCompoundAll + auto-swap rewards -> USDT         2) pay management fee         3) compute targetPrice = dsf.totalHoldings / dsf.totalSupply         4) allocate net USDT to pools below target proportionally to their deficits         5) leftover (rounding) goes to last allocated pool, otherwise to min-price pool","params":{"amountUSDT":"0 = use entire USDT balance after swaps","maxPoolsToScan":"0 = scan all pools, otherwise scan first N for gas control"}},"managerCompoundToDepositPool(uint256)":{"params":{"amountUSDT":"0 = use entire USDT balance of RewardManager"}},"managerCompoundToWithdrawPool(uint256)":{"params":{"amountUSDT":"0 = use entire USDT balance of RewardManager"}},"owner()":{"details":"Returns the address of the current owner."},"removeAutoSwapToken(address)":{"details":"Uses swap-pop to remove token from autoSwapTokens array","params":{"token":"Token address to remove"}},"removeOperator(address)":{"details":"Only callable by DEFAULT_ADMIN_ROLE","params":{"op":"Address to revoke operator permissions from"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `callerConfirmation`. May emit a {RoleRevoked} event."},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."},"setDSF(address)":{"details":"newDsf must be a deployed contract","params":{"newDsf":"Address of the new DSF contract"}},"setDefaultSlippageBps(uint16)":{"details":"bps must be <= 10_000","params":{"bps":"Slippage in basis points (100% = 10_000)"}},"setFeeDistributor(address)":{"details":"newFD must be a deployed contract","params":{"newFD":"Address of the new fee distributor"}},"setPathToUsdt(address,address[])":{"details":"Requirements:         - token must be a deployed contract         - path length >= 2         - path[0] == token         - path[last] == USDT         Replaces any previously stored path.         Adds token to autoSwapTokens if not already present","params":{"path":"Swap path (token ... USDT)","token":"Reward token address"}},"setPoolBlacklisted(uint256,bool)":{"details":"Reverts if `pid` is out of DSF pool range","params":{"pid":"DSF pool id","v":"True to blacklist, false to unblacklist"}},"setRouter(address)":{"details":"newRouter must be a deployed contract","params":{"newRouter":"Address of the new router"}},"supportsInterface(bytes4)":{"details":"Returns true if this contract implements the interface defined by `interfaceId`. See the corresponding https://eips.ethereum.org/EIPS/eip-165#how-interfaces-are-identified[ERC section] to learn more about how these ids are created. This function call must use less than 30 000 gas."},"swapAllAuto()":{"details":"Public entrypoint for operators/keepers         Computes a single deadline as `block.timestamp + TRADE_DEADLINE`         and executes `_swapAllAuto(deadline)` to swap all eligible tokens         Tokens with zero balance or missing swap path are skipped"},"swapManualRoute(bytes,uint256,bool,uint16)":{"details":"Requirements:         - payload must encode (module,index,quotedOut,tokenIn,tokenOut,amountIn,route)         - tokenIn must be a valid contract         - amountIn > 0         Reads tokenIn and amountIn directly from payload,         approves router for amountIn, and forwards execution","params":{"maxDevBps":"Max allowed deviation (bps) for oracle guard","minAmountOut":"Minimum output required","payload":"ABI-encoded route payload","useOracleGuard":"Whether oracle guard is enabled"},"returns":{"netOut":"        Output amount returned by router"}},"swapManualSplit(bytes,bytes,uint16,uint256,bool,uint16)":{"details":"Requirements:         - percentA must be in range 1..99         - tokenIn in both payloads must match         - amountIn encoded in both payloads must match and be > 0         Approves router once for totalIn and forwards parameters","params":{"maxDevBps":"Max deviation (bps) for oracle guard","minAmountOut":"Minimum total output expected","payloadA":"First encoded route","payloadB":"Second encoded route","percentA":"Percentage allocated to payloadA (1..99)","useOracleGuard":"Whether oracle guard is enabled"},"returns":{"netOut":"        Total output received"}},"totalHoldings()":{"details":"Calculation:         1. Reads native USDT balance held by RewardManager (1e6 decimals)         2. Iterates over whitelisted autoSwapTokens:            - For each token, reads balance            - Quotes NET USDT value via router.getAmountsOut()            - Adds quoted NET amount to grossUSDT         3. Computes DSF management fee on grossUSDT         4. Returns (grossUSDT - fee) scaled to 1e18 precision         Important:         - Router is assumed to return NET output already         - All intermediate accounting is done in native USDT decimals (1e6)         - Final result is converted to 1e18 precision","returns":{"netUSDT_1e18":"Net holdings expressed in USDT terms (1e18 precision)"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."}},"stateVariables":{"TRADE_DEADLINE":{"details":"Swap deadline offset in seconds (33m20s)"},"USDT_DECIMALS_SCALE":{"details":"USDT (1e6) -> 1e18 multiplier"},"WETH":{"details":"Mainnet token addresses used for default routing configuration"},"_pathToUsdt":{"details":"token => swap path to USDT (token ... USDT)"},"defaultSlippageBps":{"details":"minOut = quoteNet * (10_000 - bps) / 10_000"}},"title":"RewardManager","version":1},"userdoc":{"kind":"user","methods":{"BPS_DENOMINATOR()":{"notice":"Basis points denominator (100% = 10_000)"},"DSFAutoCompoundAll()":{"notice":"Triggers DSF.autoCompoundAll()"},"OPERATOR_ROLE()":{"notice":"Role for automated operations (bots/keepers)"},"PRICE_SCALE()":{"notice":"Scale used for 1e18 math"},"addOperator(address)":{"notice":"Grants OPERATOR_ROLE to an address"},"autoSwapTokens(uint256)":{"notice":"Whitelist of tokens eligible for auto-swap"},"defaultSlippageBps()":{"notice":"Default slippage for auto-swaps (bps)."},"dsf()":{"notice":"DSF core contract"},"feeDistributor()":{"notice":"Recipient of DSF management fee (currently Gnosis Safe)"},"getAutoSwapTokens()":{"notice":"Returns list of tokens enabled for auto-swap"},"getBestRoute(address,address,uint256)":{"notice":"Returns best swap routes for a given token pair and amount"},"getPathToUsdt(address)":{"notice":"Returns stored swap path from token to USDT"},"getPoolsInfo()":{"notice":"Returns a snapshot of all active DSF pools"},"isAutoSwapToken(address)":{"notice":"Quick membership check for autoSwapTokens"},"isOperator(address)":{"notice":"Returns whether an address has OPERATOR_ROLE."},"isPoolBlacklisted(uint256)":{"notice":"Pool blacklist (pid => disabled)"},"managerCompoundAllToDepositPool(uint256)":{"notice":"Full pipeline: DSF.autoCompoundAll() -> auto-swap whitelist tokens -> pay fee -> deposit net into default deposit pid"},"managerCompoundAllToWithdrawPool(uint256)":{"notice":"Full pipeline: DSF.autoCompoundAll() -> auto-swap whitelist tokens -> pay fee -> deposit net into default withdraw pid"},"managerCompoundManual(uint256[],uint16[],uint256)":{"notice":"Manual allocation: list of pids + bps weights (sum must be 10_000)"},"managerCompoundRebalanceToTarget(uint256,uint256)":{"notice":"Rebalance allocations to move pool share prices toward DSF global price (totalHoldings/totalSupply)"},"managerCompoundToDepositPool(uint256)":{"notice":"Sends USDT to DSF default deposit pool strategy via managerCompound()"},"managerCompoundToWithdrawPool(uint256)":{"notice":"Sends USDT to DSF default withdraw pool strategy via managerCompound()"},"removeAutoSwapToken(address)":{"notice":"Removes token from auto-swap whitelist and clears its stored path"},"removeOperator(address)":{"notice":"Revokes OPERATOR_ROLE from an address"},"router()":{"notice":"UniversalRouter used for swaps"},"setDSF(address)":{"notice":"Updates the DSF core contract address"},"setDefaultSlippageBps(uint16)":{"notice":"Updates default slippage (in basis points) used for auto-swaps"},"setFeeDistributor(address)":{"notice":"Updates the management fee recipient"},"setPathToUsdt(address,address[])":{"notice":"Sets swap path from `token` to USDT and enables it for auto-swap"},"setPoolBlacklisted(uint256,bool)":{"notice":"Enables or disables a DSF pool for RewardManager allocations"},"setRouter(address)":{"notice":"Updates the UniversalRouter address"},"swapAllAuto()":{"notice":"Swaps all whitelisted reward tokens into USDT using an internal deadline"},"swapManualRoute(bytes,uint256,bool,uint16)":{"notice":"Executes a manual swap via router.swapRoute()"},"swapManualSplit(bytes,bytes,uint16,uint256,bool,uint16)":{"notice":"Executes a manual split swap via router.swapSplit()"},"totalHoldings()":{"notice":"Returns RewardManager net holdings denominated in USDT (1e18 scale)"}},"notice":"Aggregates rewards from DSF strategies, swaps them to USDT via UniversalRouter,         pays DSF management fee to feeDistributor, and re-deploys USDT into selected pools         using strategy.managerCompound()","version":1}},"settings":{"compilationTarget":{"contracts/RewardManager.sol":"RewardManager"},"evmVersion":"osaka","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":20},"remappings":[],"viaIR":true},"sources":{"@openzeppelin/contracts/access/AccessControl.sol":{"keccak256":"0x1a6b4f6b7798ab80929d491b89d5427a9b3338c0fd1acd0ba325f69c6f1646af","license":"MIT","urls":["bzz-raw://7bb7f346c12a14dc622bc105ce3c47202fbc89f4b153a28a63bb68193297330c","dweb:/ipf