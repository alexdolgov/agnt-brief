ils":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"rescueTokens(address,address,uint256)":{"params":{"amount":"Amount to transfer","to":"Recipient address","token":"ERC20 token address"}},"setAsEthLike(address,bool)":{"params":{"isAsEth":"If true, use ETH-denominated route for oracle price","token":"Token address"}},"setOracleConfig(address,bool,uint16,uint256)":{"params":{"deviationBps":"Max allowed negative deviation vs oracle in bps","enabled":"Enable/disable oracle guard checks","maxStaleness":"Acceptable feed age in seconds (0 = skip staleness check)","reg":"Feed Registry address (0 to keep current)"}},"setSplitForPath(address[],bool,uint256,uint16)":{"details":"Path key is computed as keccak256(abi.encode(path)).         If `threshold == 0`, split is considered \"not configured\".         Split is applied only when:           - enabled == true           - amountIn >= threshold           - a second distinct router has a valid quote","params":{"bpsA":"Share of first router in basis points (0..10000)","enabled":"Whether split is enabled for this path","path":"Exact swap path (length >= 2)","threshold":"Minimum amountIn required to trigger splitting"}},"setdefaultSlippageBpsCurve3(uint16)":{"params":{"newBps":"New slippage in basis points (0..10000)"}},"setdefaultSlippageBpsV2(uint16)":{"params":{"newBps":"New slippage in basis points (0..10000)"}},"swapExactTokensForTokens(uint256,uint256,address[],address,uint256)":{"details":"High-level flow:         1) If `path` is a direct Curve 3Pool stable->stable swap (length == 2):              - uses `curve3Pool.exchange(i, j, amountIn, minOutUsed)`              - if `amountOutMin == 0`, computes `minOutUsed` from Curve quote using `defaultSlippageBpsCurve3`              - if oracle guards are enabled and oracle price is available & fresh, reverts if Curve quote                is worse than oracle by more than `maxDeviationBps`              - transfers final tokenOut to `to`         2) Otherwise (V2 routers Uni/Sushi):              - finds top-1 and top-2 router quotes among enabled venues              - applies split only when the per-path SplitCfg is enabled AND:                    * threshold > 0                    * amountIn >= threshold                    * a second distinct router exists with a valid quote              - if `amountOutMin == 0`, computes per-leg minOut using `defaultSlippageBpsV2`              - if oracle guards are enabled and oracle price is available & fresh, reverts if the expected                DEX output (single quote or sum of re-quotes in split) is worse than oracle by more than `maxDeviationBps`              - pulls `amountIn` from msg.sender, approves router(s), executes swap(s) sending outputs to `to`","params":{"amountIn":"Exact tokens to swap (pulled from msg.sender)","amountOutMin":"Global minimum acceptable output (0 => compute local minOut from quotes + default slippage)","deadline":"Unix timestamp after which the tx must revert","path":"Swap path (length >= 2)","to":"Recipient of output tokens"},"returns":{"amounts":"     If split: [amountIn, totalOut]; otherwise: V2 router amounts array"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."}},"title":"SwapAdapterMk3Module","version":1},"userdoc":{"kind":"user","methods":{"DENOM_ETH()":{"notice":"Chainlink denominations (as per Feed Registry)"},"FEED_REGISTRY_MAINNET()":{"notice":"Chainlink Feed Registry (mainnet by default; can be updated by owner)"},"asEthLike(address)":{"notice":"Tokens priced \"as ETH\" (e.g., WETH, stETH, wstETH)"},"clearSplitForPath(address[])":{"notice":"Remove split configuration for a given path"},"constructor":{"notice":"Initializes router configs. Zero address means \"skip\""},"defaultSlippageBpsV2()":{"notice":"Default slippage applied when caller passes `amountOutMin == 0` (in bps)"},"feedRegistry()":{"notice":"Oracle guard configuration"},"getAmountsOut(uint256,address[])":{"notice":"V2-compatible `getAmountsOut` with optional oracle-guard filtering"},"rescueTokens(address,address,uint256)":{"notice":"Emergency token withdrawal by the owner"},"setAsEthLike(address,bool)":{"notice":"Mark/unmark token to be priced \"as ETH\" in oracle math"},"setOracleConfig(address,bool,uint16,uint256)":{"notice":"Set oracle configuration (Feed Registry, toggle, deviation, staleness)"},"setSplitForPath(address[],bool,uint256,uint16)":{"notice":"Configure split settings for an exact swap path"},"setdefaultSlippageBpsCurve3(uint16)":{"notice":"Update the default slippage Curve3 bps used when `amountOutMin == 0`"},"setdefaultSlippageBpsV2(uint16)":{"notice":"Update the default slippage V2 bps used when `amountOutMin == 0`"},"splitForPath(bytes32)":{"notice":"Per-path split settings (key = keccak256(abi.encode(path)))"},"swapExactTokensForTokens(uint256,uint256,address[],address,uint256)":{"notice":"Execute an exact-in swap with optional auto-split and oracle guards"}},"notice":"Aggregates UniV2/SushiV2 quotes, optionally splits execution         across top-2 venues, and enforces Chainlink-based price sanity checks","version":1}},"settings":{"compilationTarget":{"contracts/swap/SwapAdapterMk3.sol":"SwapAdapterMk3Module"},"evmVersion":"osaka","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":20},"remappings":[],"viaIR":true},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0xff6d0bb2e285473e5311d9d3caacb525ae3538a80758c10649a4d61029b017bb","license":"MIT","urls":["bzz-raw://8ed324d3920bb545059d66ab97d43e43ee85fd3bd52e03e401f020afb0b120f6","dweb:/ipfs/QmfEckWLmZkDDcoWrkEvMWhms66xwTLff9DDhegYpvHo1a"]},"@openzeppelin/contracts/interfaces/IERC1363.sol":{"keccak256":"0xd5e