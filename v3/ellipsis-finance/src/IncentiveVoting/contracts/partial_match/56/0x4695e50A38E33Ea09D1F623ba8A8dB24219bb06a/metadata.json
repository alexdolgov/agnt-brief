y":"view","type":"function"},{"inputs":[{"internalType":"address[]","name":"_tokens","type":"address[]"},{"internalType":"uint256[]","name":"_votes","type":"uint256[]"}],"name":"vote","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_voteIndex","type":"uint256"},{"internalType":"uint256","name":"_yesVotes","type":"uint256"}],"name":"voteForTokenApproval","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{"availableVotes(address)":{"params":{"_user":"Address to query"},"returns":{"_0":"uint Amount of unused votes"}},"commitTokenApprovalQuorum(uint256)":{"details":"Quorum can only be modified within a defined range of 10-50%. A three day delay is required between commiting and applying the change, in order to discourge malicious actions from the contract owner."},"createTokenApprovalVote(address)":{"details":"Emissions are only available to approved LP tokens. This prevents incentives being given to pools with malicious assets. We trust lockers to vote in the best longterm interests of the protocol :)","params":{"_token":"Token address to create a vote for"},"returns":{"_voteIndex":"uint Index value used to reference the vote"}},"getRewardsPerSecond(address,uint256)":{"details":"Calculate and return the rewards per second for a given LP token. Called by `EllipsisLpStaker` when determining the emissions that each pool is entitled to."},"getUserVotes(address,uint256)":{"returns":{"_totalVotes":"Total number of votes from `_user` this week for all pools","_voteData":"Dynamic array of (token address, votes for token)"}},"getVotes(uint256)":{"returns":{"_totalVotes":"Total number of votes this week for all pools","_voteData":"Dynamic array of (token address, votes for token)"}},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setTokenApproval(address,bool)":{"details":"This can only be called on tokens that were already voted in, it cannot be used to bypass the voting process. It is intended to block emissions in case of an exploit or act of maliciousness from a token within an approved pool."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"vote(address[],uint256[])":{"details":"A user may vote as many times as they like within a week, so long as their total available votes are not exceeded. If they receive additional votes by locking more tokens within `tokenLocker`, they can vote immediately. Votes can only be added - not modified or removed. Votes only apply to the following week - they do not carry over. A user must resubmit their vote each week.","params":{"_tokens":"List of addresses of LP tokens to vote for","_votes":"Votes to allocate to `_tokens`. Values are additive, they do not include previous votes. For example, if you have already allocated 100 votes and wish to allocate a total of 300, the vote amount should be given as 200."}},"voteForTokenApproval(uint256,uint256)":{"details":"Votes last for one week. Weight for voting is based on the last completed week at the time the vote was created. A vote passes once the percent of weight given exceeds `tokenApprovalQuorumPct`. It is not possible to vote against a proposed token, users who wish to do so should instead abstain from voting.","params":{"_voteIndex":"Array index referencing the vote","_yesVotes":"Number of votes to cast in favor. End users can set as 2**256-1 to vote with all available weight. Integragors may wish to vote with only a portion of their available weight, in order to more accurately reflect a sub-vote within their userbase."}}},"version":1},"userdoc":{"kind":"user","methods":{"applyTokenApprovalQuorum()":{"notice":"Apply a change to the required quorum for token approval votes"},"availableVotes(address)":{"notice":"Get the amount of unused votes for for the current week being voted on"},"commitTokenApprovalQuorum(uint256)":{"notice":"Commit a change to the required quorum for token approval votes."},"createTokenApprovalVote(address)":{"notice":"Create a new vote to enable protocol emissions on a given token"},"getUserVotes(address,uint256)":{"notice":"Get data on current votes `_user` has made in the active week"},"getVotes(uint256)":{"notice":"Get data on the current votes made in the active week"},"setTokenApproval(address,bool)":{"notice":"Modify the approval for a token to receive incentives."},"vote(address[],uint256[])":{"notice":"Allocate votes toward LP tokens to receive emissions in the following week"},"voteForTokenApproval(uint256,uint256)":{"notice":"Vote in favor of approving a new token for protocol emissions"}},"version":1}},"settings":{"compilationTarget":{"IncentiveVoting.sol":"IncentiveVoting"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"Context.sol":{"keccak256":"0xe2e337e6dde9ef6b680e07338c493ebea1b5fd09b43424112868e9cc1706bca7","license":"MIT","urls":["bzz-raw://6df0ddf21ce9f58271bdfaa85cde98b200ef242a05a3f85c2bc10a8294800a92","dweb:/ipfs/QmRK2Y5Yc6BK7tGKkgsgn3aJEQGi5aakeSPZvS65PV8Xp3"]},"IERC20.sol":{"keccak256":"0xbbc8ac883ac3c0078ce5ad3e288fbb3ffcc8a30c3a98c0fda0114d64fc44fca2","license":"MIT","urls":["bzz-raw://87a7a5d2f6f63f84598af02b8c50ca2df2631cb8ba2453e8d95fcb17e4be9824","dweb:/ipfs/QmR76hqtAcRqoFj33tmNjcWTLrgNsAaakYwnKZ8zoJtKei"]},"IncentiveVoting.sol":{"keccak256":"0xbb3e76e58df350d881ae6e6576b651453eb93439dc4255c7e2a82b3621fc71b5","urls":["bzz-raw://b6818902db9d24eb416d8a1b1696cad7d309f194193ede1a44fb012c6758eba3","dweb:/ipfs/QmUB3Ver3kicM4ijvFhvh9g