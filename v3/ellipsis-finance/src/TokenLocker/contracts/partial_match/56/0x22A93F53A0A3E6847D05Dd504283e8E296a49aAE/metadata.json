r's total \"lock weight\" is calculated as the sum of [number of tokens] * [weeks until unlock] for all active locks. Fees are distributed porportionally according to a user's lock weight as a percentage of the total lock weight. At the start of each new week, each lock's weeks until unlock is reduced by 1. Locks that reach 0 week no longer receive any weight, and tokens may be withdrawn by calling `initiateExitStream`.","params":{"_amount":"Amount of tokens to lock. This balance transfered from the caller.","_user":"Address to create a new lock for (does not have to be the caller)","_weeks":"The number of weeks for the lock."}},"registerLegacyLocks(address)":{"details":"Each users with a v1 lock must call once to register their balance. V1 locks are given a 4x boost to their weight relative to the unlock time.","params":{"_user":"User address to register"}}},"version":1},"userdoc":{"kind":"user","methods":{"claimableExitStreamBalance(address)":{"notice":"Get the amount of tokens available to withdraw from the active exit stream."},"extendLock(uint256,uint256,uint256)":{"notice":"Extend the length of an existing lock."},"getActiveUserLocks(address)":{"notice":"Get data on a user's active token locks"},"initiateExitStream()":{"notice":"Create an exit stream, to withdraw tokens in expired locks over 1 week"},"lock(address,uint256,uint256)":{"notice":"Deposit tokens into the contract to create a new lock."},"registerLegacyLocks(address)":{"notice":"Register EPSv1 locked balances within the v2 protocol"},"setBlockThirdPartyActions(bool)":{"notice":"Allow or block third-party calls to deposit, withdraw or claim rewards on behalf of the caller"},"streamableBalance(address)":{"notice":"Get the amount of `stakingToken` in expired locks that is eligible to be released via an exit stream."},"totalWeight()":{"notice":"Get the current total lock weight"},"userBalance(address)":{"notice":"Get the total balance held in this contract for a user, including both active and expired locks"},"userWeight(address)":{"notice":"Get the current lock weight for a user"},"weeklyUnlocksOf(address,uint256)":{"notice":"Get the token balance that unlocks for a user in a given week"},"weeklyWeight(address,uint256)":{"notice":"Get the user lock weight and total lock weight for the given week"},"weeklyWeightOf(address,uint256)":{"notice":"Get the lock weight for a user in a given week"},"withdrawExitStream()":{"notice":"Withdraw tokens from an active or completed exit stream"}},"version":1}},"settings":{"compilationTarget":{"TokenLocker.sol":"TokenLocker"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"Address.sol":{"keccak256":"0x2ccf9d2313a313d41a791505f2b5abfdc62191b5d4334f7f7a82691c088a1c87","license":"MIT","urls":["bzz-raw://b3a57d0854b2fdce6ebff933a48dca2445643d1eccfc27f00292e937f26c6a58","dweb:/ipfs/QmW45rZooS9TqR4YXUbjRbtf2Bpb5ouSarBvfW1LdGprvV"]},"IERC20.sol":{"keccak256":"0xbbc8ac883ac3c0078ce5ad3e288fbb3ffcc8a30c3a98c0fda0114d64fc44fca2","license":"MIT","urls":["bzz-raw://87a7a5d2f6f63f84598af02b8c50ca2df2631cb8ba2453e8d95fcb17e4be9824","dweb:/ipfs/QmR76hqtAcRqoFj33tmNjcWTLrgNsAaakYwnKZ8zoJtKei"]},"SafeERC20.sol":{"keccak256":"0x47a6cc8dcdc0d45809841c9a59429fa8bfd3c3c0586c2d46e167d720040e977e","license":"MIT","urls":["bzz-raw://4c9253b3b7f3be8fb24c8b61ac328d87d25202817d2282c33e9a28ea9694bd34","dweb:/ipfs/QmYNt8FPhxZ9ByvRGmNmDDyjwS9nBMXhpQVSD1Q71hWrBx"]},"TokenLocker.sol":{"keccak256":"0xdefe9b7a5d8d880ba7a3e5842dbfbfc722ec75aa66c2455d0d2a5119fcb80559","urls":["bzz-raw://7ee205087dcedadfaf38f4cfc653dfb111b4adfc92c363162e9f30c98ab966d9","dweb:/ipfs/QmedvX1XxFJ7Q4JdEQ3d6NnXSW9oJnH2cqgxri6ZyTdXvN"]}},"version":1}