NewInputToken(address)":{"notice":"Approves a new input token for the zapper. Use this method to add new input tokens to be accepted by the zapper"},"breakLP(address,uint256)":{"notice":"Breaks LP (_from) and returns the single assets to the sender"},"setRoutePairAddress(address,address)":{"notice":"Helps store intermediate route information to convert a token to WBNB"},"withdraw(address)":{"notice":"Recovers stuck tokens in the contract"},"zapBNBToLP(address)":{"notice":"Create LP (_to) from BNB"},"zapTokenToLP(address,uint256,address)":{"notice":"Creates LP (_to) from a single asset (_from). Use this when the _from asset is not BNB"}},"notice":"A zapper implementation which converts a single asset into a ESHARE/ETH or EMP/ETH liquidity pair. And breaks a liquidity pair to single assets","version":1}},"settings":{"compilationTarget":{"Zapper.sol":"Zapper"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"Zapper.sol":{"keccak256":"0x11705f8a6217b114cc2db7e4b62cc35dca84c3fa052c9304d8d293e14790792b","license":"MIT","urls":["bzz-raw://0d9ab6f4972a3b0982068e1b26fb14bff47e931c21d031b8e84f4a7b014db900","dweb:/ipfs/QmUnmgae4fSBb1dYtm4LAWi6LTSxnSDCSbxS29SG65mTxE"]}},"version":1}