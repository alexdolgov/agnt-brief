nfiguration based on the given parameters, and fetches any neededVRFCoordinatorV2 configuration from the coordinator.","params":{"_coordinatorGasOverheadLink":"reflects the gas overhead of the coordinator's        fulfillRandomWords function for link payment.","_coordinatorGasOverheadNative":"reflects the gas overhead of the coordinator's        fulfillRandomWords function for native payment.","_coordinatorGasOverheadPerWord":"reflects the gas overhead per word of the coordinator's        fulfillRandomWords function.","_coordinatorLinkPremiumPercentage":"is the coordinator's premium ratio in percentage for requests paid in link.","_coordinatorNativePremiumPercentage":"is the coordinator's premium ratio in percentage for requests paid in native.","_fallbackWeiPerUnitLink":"is the backup LINK exchange rate used when the LINK/NATIVE feed        is stale.","_fulfillmentFlatFeeLinkDiscountPPM":"is the flat fee discount in millionths of native that VRFCoordinatorV2Plus        charges for link payment.","_fulfillmentFlatFeeNativePPM":"is the flat fee in millionths of native that VRFCoordinatorV2Plus        charges for native payment.","_keyHash":"to use for requesting randomness.","_maxNumWords":"is the max number of words that can be requested in a single wrapped VRF request","_stalenessSeconds":"is the number of seconds before we consider the feed price to be stale        and fallback to fallbackWeiPerUnitLink.","_wrapperGasOverhead":"reflects the gas overhead of the wrapper's fulfillRandomWords        function."}},"setFulfillmentTxSize(uint32)":{"params":{"size":"is the size of the fulfillment transaction in bytes."}},"withdraw(address)":{"params":{"_recipient":"is the address that should receive the LINK funds."}},"withdrawNative(address)":{"params":{"_recipient":"is the address that should receive the native funds."}}},"stateVariables":{"lastRequestId":{"return":"the request ID of the most recent VRF V2 request made by this wrapper. This should only be relied option within the same transaction that the request was made.","returns":{"_0":"the request ID of the most recent VRF V2 request made by this wrapper. This should only be relied option within the same transaction that the request was made."}},"s_fulfillmentTxSizeBytes":{"details":"this is the size of a VRF v2 fulfillment's calldata abi-encoded in bytes.proofSize = 13 words = 13 * 256 = 3328 bitscommitmentSize = 5 words = 5 * 256 = 1280 bitsdataSize = proofSize + commitmentSize = 4608 bitsselector = 32 bitstotal data size = 4608 bits + 32 bits = 4640 bits = 580 bytes"}},"version":1},"userdoc":{"kind":"user","methods":{"acceptOwnership()":{"notice":"Allows an ownership transfer to be completed by the recipient."},"calculateRequestPrice(uint32,uint32)":{"notice":"Calculates the price of a VRF request with the given callbackGasLimit at the currentblock."},"calculateRequestPriceNative(uint32,uint32)":{"notice":"Calculates the price of a VRF request in native with the given callbackGasLimit at the currentblock."},"disable()":{"notice":"disable this contract so that new requests will be rejected. When disabled, new requestswill revert but existing requests can still be fulfilled."},"enable()":{"notice":"enable this contract so that new requests can be accepted."},"estimateRequestPrice(uint32,uint32,uint256)":{"notice":"Estimates the price of a VRF request with a specific gas limit and gas price."},"estimateRequestPriceNative(uint32,uint32,uint256)":{"notice":"Estimates the price of a VRF request in native with a specific gas limit and gas price."},"getConfig()":{"notice":"getConfig returns the current VRFV2Wrapper configuration."},"onTokenTransfer(address,uint256,bytes)":{"notice":"onTokenTransfer is called by LinkToken upon payment for a VRF request."},"owner()":{"notice":"Get the current owner"},"requestRandomWordsInNative(uint32,uint16,uint32,bytes)":{"notice":"Requests randomness from the VRF V2 wrapper, paying in native token."},"setConfig(uint32,uint32,uint32,uint16,uint8,ui