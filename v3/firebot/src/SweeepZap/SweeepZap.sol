// File: contracts/SweeepZap.sol


pragma solidity ^0.8.26;



interface ISWEEEP {
    function buyPriceEP() external view returns (uint256);
    function buyNFT(uint256 id, uint256 maxPriceEP, bool useFBX, uint256 deadline) external;
    function sellNFT(uint256 id, uint256 minPriceFBX, uint256 deadline) external;
    function stakeAll() external;
}

interface IFIREPOOL {
    function reserveFBX() external view returns (uint256);
    function reserveEP() external view returns (uint256);
    function swapExactFBXForEP(uint256 amountInFBX, uint256 minAmountOutEP, uint256 deadline) external returns (uint256 amountOutEP);
}

interface IERC721Receiver {
    function onERC721Received(address operator, address from, uint256 tokenId, bytes calldata data) external returns (bytes4);
}

contract SweeepZap is IERC721Receiver {

    IERC721 public constant COLLECTION = IERC721(0xE9eeE7294dc7c3bb64FD57A514E755022a333295);
    ISWEEEP public constant SWEEEP = ISWEEEP(0xca1e9c2d0B381933D2A6773D176d5C0AbBa1Eecb);
    IFIREPOOL public constant FIREPOOL = IFIREPOOL(0xE20E046B230a5530438d32ABfBCC3E61d7670234);

    using SafeERC20 for IERC20;
    IERC20 public constant FBX = IERC20(0xD125443F38A69d776177c2B9c041f462936F8218);
    IERC20 public constant EP = IERC20(0x60Ed6aCEF3a96F8CDaF0c0D207BbAfA66e751af2);

    event nftBought(address buyer, uint256 id, uint256 priceFBX, uint256 timestamp);
    event nftSold(address seller, uint256 id, uint256 priceFBX, uint256 timestamp);
    
    constructor() {
        COLLECTION.setApprovalForAll(address(SWEEEP), true);
    }
    
    function onERC721Received(address, address, uint256, bytes memory) public virtual returns (bytes4) {
        return this.onERC721Received.selector;
    }

    function buyPriceFBX() public view returns (uint256) {
        uint256 buyPriceEP = SWEEEP.buyPriceEP();
        return (FIREPOOL.reserveFBX() * buyPriceEP) / (FIREPOOL.reserveEP() - buyPriceEP);
    }

    function buyNFT(uint256 id, uint256 priceFBX, uint256 deadline) public {
        // Receive FBX
        FBX.safeTransferFrom(msg.sender, address(this), priceFBX);
        
        // Swap it for EP
        uint256 buyPriceEP = SWEEEP.buyPriceEP();
        FBX.approve(address(FIREPOOL), priceFBX);
        uint256 amountEP = FIREPOOL.swapExactFBXForEP(priceFBX, buyPriceEP, deadline);
        
        // Buy NFT
        EP.approve(address(SWEEEP), buyPriceEP);
        SWEEEP.buyNFT(id, buyPriceEP, false, deadline);

        // Send remaining EP to Sweeep
        if (amountEP > buyPriceEP) {
            EP.safeTransfer(address(SWEEEP), EP.balanceOf(address(this)));
            SWEEEP.stakeAll();
        }

        // Send NFT to buyer
        COLLECTION.safeTransferFrom(address(this), msg.sender, id);

        // Emit event
        emit nftBought(msg.sender, id, priceFBX, block.timestamp);
    }

    function sellNFT(uint256 id, uint256 priceFBX, uint256 deadline) public {
        // Receive NFT
        COLLECTION.safeTransferFrom(msg.sender, address(this), id);
        
        // Sell NFT
        SWEEEP.sellNFT(id, priceFBX, deadline);
        
        // Swap remaining FBX to EP and send it to Sweeep
        uint256 balanceFBX = FBX.balanceOf(address(this));
        if (balanceFBX > priceFBX) {
            FBX.approve(address(FIREPOOL), balanceFBX - priceFBX);
            uint256 amountEP = FIREPOOL.swapExactFBXForEP(balanceFBX - priceFBX, 0, deadline);
            EP.safeTransfer(address(SWEEEP), amountEP);
            SWEEEP.stakeAll();
        }

        //Send FBX to seller
        FBX.safeTransfer(msg.sender, priceFBX);

        // Emit event
        emit nftSold(msg.sender, id, priceFBX, block.timestamp);
    }
}