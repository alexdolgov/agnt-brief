      Distributes seized collateral (retaining protocol share of the realized bonus,      pushing remainder to filler), runs filler callback, then pulls repayment funds      and approves PositionsManager to debit them from this engine."},"previewDistribution(address,(address,uint256)[],(address,uint256)[])":{"details":"Useful for liquidator bots to predict exact received amounts before submitting         an `rfqFill` / `rfqFillFlash` transaction.","params":{"collOut":"Declared collateral seizure bundle (assets + amounts).","debtIn":"Declared repayment bundle (assets + amounts).","user":"The borrower whose debt shares are checked (zero-share entries excluded)."},"returns":{"fillerAmounts":"  Tokens the filler would receive per `collOut` entry.","protocolAmounts":"Tokens the protocol would retain per `collOut` entry."}},"rfqFill(address,(address,uint256)[],(address,uint256)[],bool)":{"details":"Useful when the liquidator expects to repay without needing held collateral released."}},"stateVariables":{"minRepayUSDWad":{"details":"Set to 0 to disable."},"minResidualCollateralUSDWad":{"details":"Set to 0 to disable."},"minResidualDebtUSDWad":{"details":"Set to 0 to disable."}},"title":"RfqEngine","version":1},"userdoc":{"kind":"user","methods":{"computeMinRepayment(uint256,uint256,uint256,uint256,uint256)":{"notice":"Compute minimum repayment x (USD WAD) to restore HF to `hfTarget` under the         bonus-constrained seizure model."},"computeMinRepaymentWithK(uint256,uint256,uint256,uint256,uint256)":{"notice":"Compute minimum repayment x (USD WAD) to restore HF to `hfTarget` under the         bonus-constrained seizure model for a given maintenance reduction factor `kWad`."},"minRepayUSDWad()":{"notice":"Minimum liquidation repay size in USD-WAD (1e18). Only enforced when collateral is seized."},"minResidualCollateralUSDWad()":{"notice":"Minimum post-liquidation eligible collateral value allowed when debt remains, in USD-WAD."},"minResidualDebtUSDWad()":{"notice":"Minimum post-liquidation debt value allowed when debt remains, in USD-WAD."},"previewDistribution(address,(address,uint256)[],(address,uint256)[])":{"notice":"Preview the collateral distribution for a prospective liquidation.         Returns per-asset filler and protocol token amounts that         `_distributeSeizedCollateral` would produce under current on-chain state."},"rfqFill(address,(address,uint256)[],(address,uint256)[])":{"notice":"RFQ: seize collateral and repay debts without a filler flash callback."},"rfqFill(address,(address,uint256)[],(address,uint256)[],bool)":{"notice":"RFQ: same as `rfqFill`, but allows skipping best-effort engine unwind hooks."},"rfqFillFlash(address,(address,uint256)[],(address,uint256)[],bytes)":{"notice":"Flash RFQ: seize collateral first, allow filler callback to trade, then repay."},"rfqFillFlash(address,(address,uint256)[],(address,uint256)[],bytes,bool)":{"notice":"Flash RFQ: same as `rfqFillFlash`, but allows skipping best-effort engine unwind hooks."}},"notice":"External RFQ engine that rebalances user positions by repaying debt and seizing collateral         using PositionsManager's onlyEngine hooks. Keeps heavy RFQ logic out of PositionsManager.","version":1}},"settings":{"compilationTarget":{"contracts/engines/RfqEngine.sol":"RfqEngine"},"evmVersion":"cancun","libraries":{},"metadata":{"appendCBOR":false,"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@ft-common/=lib/ft-common-contracts/contracts/",":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/",":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/",":ds-test/=lib/ft-common-contracts/lib/openzeppelin-contracts/lib/forge-std/lib/ds-test/src/",":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/",":forge-std/=lib/forge-std/src/",":ft-common-contracts/=lib/ft-common-contracts/",":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/",":openzeppelin-contracts-upgradeabl