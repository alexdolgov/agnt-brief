indexed":false,"name":"genAmount","type":"uint256"}],"name":"onReLoadAndDistribute","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"name":"affiliateID","type":"uint256"},{"indexed":false,"name":"affiliateAddress","type":"address"},{"indexed":false,"name":"affiliateName","type":"bytes32"},{"indexed":true,"name":"roundID","type":"uint256"},{"indexed":true,"name":"buyerID","type":"uint256"},{"indexed":false,"name":"amount","type":"uint256"},{"indexed":false,"name":"timeStamp","type":"uint256"}],"name":"onAffiliatePayout","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"name":"roundID","type":"uint256"},{"indexed":false,"name":"amountAddedToPot","type":"uint256"}],"name":"onPotSwapDeposit","type":"event"}],"devdoc":{"methods":{"buyXid(uint256,uint256)":{"details":"converts all incoming ethereum to keys.\r -functionhash- 0x8f38f309 (using ID for affiliate)\r -functionhash- 0x98a0871d (using address for affiliate)\r -functionhash- 0xa65b37a1 (using name for affiliate)\r","params":{"_affCode":"the ID/address/name of the player who gets the affiliate fee\r","_team":"what team is the player playing for?\r"}},"calcKeysReceived(uint256,uint256)":{"details":"returns the amount of keys you would get given an amount of eth. \r -functionhash- 0xce89c80c\r","params":{"_eth":"amount of eth sent in \r","_rID":"round ID you want price for\r"},"return":"keys received \r"},"getBuyPrice()":{"details":"return the price buyer will pay for next 1 individual key.\r -functionhash- 0x018a25e8\r","return":"price for next key bought (in wei format)\r"},"getCurrentRoundInfo()":{"details":"returns all current round info needed for front end\r -functionhash- 0x747dff42\r","return":"eth invested during ICO phase\rround id \rtotal keys for round \rtime round ends\rtime round started\rcurrent pot \rcurrent team ID & player ID in lead \rcurrent player in leads address \rcurrent player in leads name\rwhales eth in for round\rbears eth in for round\rsneks eth in for round\rbulls eth in for round\rairdrop tracker # & airdrop pot\r"},"getPlayerInfoByAddress(address)":{"details":"returns player info based on address.  if no address is given, it will \r use msg.sender \r -functionhash- 0xee0b5d8b\r","params":{"_addr":"address of the player you want to lookup \r"},"return":"player ID \rplayer name\rkeys owned (current round)\rwinnings vault\rgeneral vault \raffiliate vault \rplayer round eth\r"},"getPlayerVaults(uint256)":{"details":"returns player earnings per vaults \r -functionhash- 0x63066434\r","return":"winnings vault\rgeneral vault\raffiliate vault\r"},"getTimeLeft()":{"details":"returns time left.  dont spam this, you'll ddos yourself from your node \r provider\r -functionhash- 0xc7e284b8\r","return":"time left in seconds\r"},"iWantXKeys(uint256)":{"details":"returns current eth price for X keys.  \r -functionhash- 0xcf808000\r","params":{"_keys":"number of keys desired (in 18 decimal format)\r"},"return":"amount of eth needed to send\r"},"reLoadXid(uint256,uint256,uint256)":{"details":"essentially the same as buy, but instead of you sending ether \r from your wallet, it uses your unwithdrawn earnings.\r -functionhash- 0x349cdcac (using ID for affiliate)\r -functionhash- 0x82bfc739 (using address for affiliate)\r -functionhash- 0x079ce327 (using name for affiliate)\r","params":{"_affCode":"the ID/address/name of the player who gets the affiliate fee\r","_eth":"amount of earnings to use (remainder returned to gen vault)\r","_team":"what team is the player playing for?\r"}},"receivePlayerInfo(uint256,address,bytes32,uint256)":{"details":"receives name/player info from names contract \r"},"receivePlayerNameList(uint256,bytes32)":{"details":"receives entire player name list \r"},"registerNameXID(string,uint256,bool)":{"details":"use these to register names.  they are just wrappers that will send the\r registration requests to the PlayerBook contract.  So registering here is the \r same as registering there.  UI will always display the last name you registered.\r but you will still own all previously registered names to use as affiliate \r links.\r - must pay a registration fee.\r - name must be unique\r - names will be converted to lowercase\r - name cannot start or end with a space \r - cannot have more than 1 space in a row\r - cannot be only numbers\r - cannot start with 0x \r - name must be at least 1 char\r - max length of 32 characters long\r - allowed characters: a-z, 0-9, and space\r -functionhash- 0x921dec21 (using ID for affiliate)\r -functionhash- 0x3ddd4698 (using address for affiliate)\r -functionhash- 0x685ffd83 (using name for affiliate)\r","params":{"_affCode":"affiliate ID, address, or name of who referred you\r","_all":"set to true if you want this to push your info to all games \r (this might cost a lot of gas)\r","_nameString":"players desired name\r"}},"withdraw()":{"details":"withdraws all of your earnings.\r -functionhash- 0x3ccfd60b\r"}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"FoMo3Dlong.sol":"FoMo3Dlong"},"evmVersion":"byzantium","libraries":{},"optimizer":{"enabled":true,"runs":50},"remappings":[]},"sources":{"FoMo3Dlong.sol":{"keccak256":"0xd67dac7998bdd11f5b97a1e5c677d0f1fde8adbdf3292898d68176d10eff177f","urls":["bzzr://9228f0ee276e2a043794ddaeda2f2586b7a614804ef6507568a4035b772d5132"]}},"version":1}