06\r","params":{"_gameID":"game id \r"}},"registerNameXID(string,uint256,bool)":{"details":"registers a name.  UI will always display the last name you registered.\r but you will still own all previously registered names to use as affiliate \r links.\r - must pay a registration fee.\r - name must be unique\r - names will be converted to lowercase\r - name cannot start or end with a space \r - cannot have more than 1 space in a row\r - cannot be only numbers\r - cannot start with 0x \r - name must be at least 1 char\r - max length of 32 characters long\r - allowed characters: a-z, 0-9, and space\r -functionhash- 0x921dec21 (using ID for affiliate)\r -functionhash- 0x3ddd4698 (using address for affiliate)\r -functionhash- 0x685ffd83 (using name for affiliate)\r","params":{"_affCode":"affiliate ID, address, or name of who refered you\r","_all":"set to true if you want this to push your info to all games \r (this might cost a lot of gas)\r","_nameString":"players desired name\r"}},"useMyOldName(string)":{"details":"players use this to change back to one of your old names.  tip, you'll\r still need to push that info to existing games.\r -functionhash- 0xb9291296\r","params":{"_nameString":"the name you want to use \r"}}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"PlayerBook.sol":"PlayerBook"},"evmVersion":"byzantium","libraries":{},"optimizer":{"enabled":true,"runs":50},"remappings":[]},"sources":{"PlayerBook.sol":{"keccak256":"0x77a9ff70b3a060b8790a588e43a4d8b30ac8aedfcff0775a0059fa82b5302d00","urls":["bzzr://f7bc25126068675fa802842a68be7e7ed493def80025b3e134153747bd069422"]}},"version":1}