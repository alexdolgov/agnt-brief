n trasnaction for message executor"},"nonce":{"details":"the counter for celer transactions"},"stakingContract":{"details":"point to the staking contract   ethereum mainnet: 0x4beFa2aA9c305238AA3E0b5D17eB20C045269E9d"}},"version":1},"userdoc":{"events":{"FixedGasFeeSet(uint256)":{"notice":"~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ CONTRCT EVENTS ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"}},"kind":"user","methods":{"executeMessage(address,uint64,bytes,address)":{"notice":"Called by MessageBus to execute a message"},"executeMessageWithTransferFallback(address,address,uint256,uint64,bytes,address)":{"notice":"Only called by MessageBus if         1. executeMessageWithTransfer reverts, or         2. executeMessageWithTransfer returns ExecutionStatus.Fail The contract is guaranteed to have received the right amount of tokens before this function is called."},"executeMessageWithTransferRefund(address,uint256,bytes,address)":{"notice":"Called by MessageBus to process refund of the original transfer from this contract. The contract is guaranteed to have received the refund before this function is called."}},"version":1}},"settings":{"compilationTarget":{"CelerMinterReceiver.sol":"CelerMinterReceiver"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"AccessControl.sol":{"keccak256":"0x9630352bc6b94204d4a5e3ed00a13a70d788dd83b3bbaf08738f06c4278e8511","license":"MIT","urls":["bzz-raw://79772a57cfdabe180cb63fb9a3ec949b45b0806941faac25c779a3b976b0e07b","dweb:/ipfs/QmRJ4tDrTKcCJrGfzY8fM6UrzgaWP8mCXfxBqCSxvr6yck"]},"Address.sol":{"keccak256":"0xf96f969e24029d43d0df89e59d365f277021dac62b48e1c1e3ebe0acdd7f1ca1","license":"MIT","urls":["bzz-raw://ec772b45a624be516f1c81970caa8a2e144301e9d0921cbc1a2789fef39a1269","dweb:/ipfs/QmNyjwxCrGhQMyzLD93oUobJXVe9ceJvRvfXwbEtuxPiEj"]},"CelerMinterReceiver.sol":{"keccak256":"0x77a89da2ee54f203d16c81773a9a8d64aef9c7100d274af956fa371440a4bbd2","license":"MIT","url