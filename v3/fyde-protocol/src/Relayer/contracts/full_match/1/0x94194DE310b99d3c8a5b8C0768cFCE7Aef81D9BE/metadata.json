 parsing the AUM and will execute both deposits and withdraws","params":{"_protocolAUM":"Computed by the keeper off chain"}},"removeFromQuarantine(address)":{"params":{"_asset":"the address of the assset to be removed from the quarantine list"}},"requestDeposit((address,uint256)[],bool,uint256)":{"details":"User have to forward some eth paying for the keeper     Once the function is called the request is stack on the queue","params":{"_keepGovRights":"If true make a governance","_minTRSYExpected":"Slippage parameter ensuring minimum amout of TRSY to be received","_userRequest":"struct containing data"}},"requestGovernanceWithdraw((address,uint256),address,uint256)":{"details":"This function create a request that will be process by the keeperowner of fyde can force withdraw for other users","params":{"_maxTRSYToPay":"maximum amout of stTRSY willing to pay, otherwise withdraw reverts","_user":"address of user who makes the withdraw","_userRequest":"struct containing data"}},"requestWithdraw((address,uint256)[],uint256)":{"details":"User have to forward some eth paying for the keeper     Once the function is called the request is stack on the queue","params":{"_maxTRSYToPay":"Slippage parameter ensure maximum amout of TRSY willing to pay","_userRequest":"struct containing data"}},"setFyde(address)":{"params":{"_fyde":"address of fyde"}},"set_min_quarantine_duration(uint256)":{"params":{"_min_quarantine_duration":"the new minimum quarantine duration"}},"transferOwnership(address)":{"details":"newOwner have to acceptOwnership","params":{"newOwner":"address of the new owner"}},"updateDeviationThreshold(uint16)":{"details":"50 = 0.5 % of deviation"},"updateGasUsageToAction(bytes32,uint256)":{"params":{"_gasUsage":"gas usage","_relayerAction":"hash of the relayer action"}}},"stateVariables":{"actionToGasUsage":{"details":"We hash a string for simplicity : keccak256(\"Deposit_Standard_2\") => Deposit 2 assets in standard pool"},"nonce":{"details":"Only used for tracking even