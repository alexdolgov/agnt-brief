:"data","type":"bytes"}],"name":"upgradeToAndCall","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"userLiquidations","outputs":[{"internalType":"bool","name":"ongoing","type":"bool"},{"internalType":"uint256","name":"token0Left","type":"uint256"},{"internalType":"uint256","name":"token1Left","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"userLps","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"userTotalLpValue","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"account","type":"address"},{"internalType":"uint256[]","name":"tokenIds","type":"uint256[]"}],"name":"vaultClaimStakingReward","outputs":[{"internalType":"uint256","name":"totalReward","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"ListaDAO","kind":"dev","methods":{"batchSyncUserLpValues(address[])":{"details":"Batch sync user LP values      this will alter users' CDP position","params":{"users":"array of user addresses"}},"claimLeftOverLpTokens()":{"details":"Claim leftover LP tokens after liquidation      this will transfer all leftover LP tokens back to the user"},"claimableStakingRewards(address)":{"details":"Get pending reward tokens of this account","params":{"account":"the address of the user"},"returns":{"_0":"totalRewards the total claimable rewards in rewardToken"}},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"daoBurn(address,uint256)":{"details":"liquidation is being kick started by the cdp","params":{"lpAmount":"the amount of collateral(LpUsd)","user":"the address of the user to liquidate"}},"getAmounts(uint256)":{"details":"Get the amounts of token0 and token1 from a LP token","params":{"tokenId":"the tokenId of the LP token"},"returns":{"amount0":"the amount of token0 in the LP","amount1":"the amount of token1 in the LP"}},"getLatestUserTotalLpValue(address)":{"details":"Get the latest appraised value of a user's total LPs","params":{"user":"the address of the user"},"returns":{"userLpTotalValue":"the total appraised value of the user's LPs in USD with 8 decimal places"}},"getLpValue(uint256)":{"details":"Get the appraised value of a LP token in USD","params":{"tokenId":"the tokenId of the LP token"},"returns":{"appraisedValue":"the appraised value in USD with 18 decimal places"}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getRoleMember(bytes32,uint256)":{"details":"Returns one of the accounts that have `role`. `index` must be a value between 0 and {getRoleMemberCount}, non-inclusive. Role bearers are not sorted in any particular way, and their ordering may change at any point. WARNING: When using {getRoleMember} and {getRoleMemberCount}, make sure you perform all queries on the same block. See the following https://forum.openzeppelin.com/t/iterating-over-elements-on-enumerableset-in-openzeppelin-contracts/2296[forum post] for more information."},"getRoleMemberCount(bytes32)":{"details":"Returns the number of accounts that have `role`. Can be used together with {getRoleMember} to enumerate all bearers of a role."},"getUserLeftoverLpTokens(address)":{"details":"Get the leftover LP tokens of a user","params":{"user":"the address of the user"},"returns":{"_0":"an array of tokenIds of the user's leftover LPs"}},"getUserLps(address)":{"details":"Get the LPs of a user","params":{"user":"the address of the user"},"returns":{"_0":"an array of tokenIds of the user's LPs"}},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"initialize(address,address,address,address,address,address,address,uint256,uint256,uint256,string)":{"details":"initialize contract","params":{"_admin":"admin address","_bot":"bot address","_lpDiscountRate":"exchange rate of LP in USD","_manager":"manager address","_maxLpPerUser":"max LPs per user","_minLpValue":"minimum LP value in USD","_pancakeStakingHub":"PancakeStakingHub address","_pauser":"pauser address"}},"liquidation(address,address,uint256,bytes,bool)":{"details":"User's position is being liquidated      when `isLeftOver` is false, a liquidator buys the LP token from the user and pays the debt      liquidity will be removed from user's LP and transformed to token0 and token1, then transferred them to the recipient(liquidator)      if user has multiple LPs, the function will liquidate from the lowest value LP to the highest value LP until `amount` is covered      when `isLeftOver` is true, the CDP position is fully liquidated      the remaining LP token, including token0 and token1 will be transferred to user","params":{"amount":"the amount of LP_USD to be bought by the liquidator","data":"bytes consist of 4 uint256 variables: amount0min, amount1Min, tokenId, deadline","isLeftOver":"whether the liquidation is left over or not","owner":"the address of the user to liquidate","recipient":"the address of the liquidator or user"}},"pause()":{"details":"pause the contract"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"peek()":{"details":"Returns the price of the LP token in USD with 18 decimal places      1 LpUsd = 1 USD"},"provide(uint256)":{"details":"deposit LP token to the provider      this will transfer the LP token to the provider and mint LP_USD to the user","params":{"tokenId":"the tokenId of the LP token"}},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"release(uint256)":{"details":"release LP token from the provider      this will transfer the LP token back to the user and burn LP_USD","params":{"tokenId":"the tokenId of the LP token"}},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `account`. May emit a {RoleRevoked} event."},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."},"setLpDiscountRate(uint256)":{"details":"Set lpDiscountRate","params":{"_lpDiscountRate":"the exchange rate"}},"setMaxLpPerUser(uint256)":{"details":"Set maxLpPerUser","params":{"_maxLpPerUser":"the max LPs per user"}},"setMinLpValue(uint256)":{"details":"Set minLpValue","params":{"_minLpValue":"the minimum LP value in USD"}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"syncUserLpValues(address)":{"details":"Sync user LP values      this will alter user's CDP position","params":{"user":"the address of the user"}},"unpause()":{"details":"resume contract"},"upgradeTo(address)":{"details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"vaultClaimStakingReward(address,uint256[])":{"details":"Harvest function to claim rewards from PancakeSwap Staking Hub"}},"stateVariables":{"MANAGER":{"details":"ROLES"},"cdp":{"details":"STATE VARIABLES"}},"title":"PancakeSwapV3LpProvider","version":1},"userdoc":{"kind":"user","methods":{"getLatestUserTotalLpValue(address)":{"notice":"for external use only"},"getUserLps(address)":{"notice":"for external use only"},"liquidation(address,address,uint256,bytes,bool)":{"notice":"-------------- IMPORTANT NOTE --------------      In order to let the liquidation process to complete,       omit the value check at CASE 3      Case 1. Partial Liquidation: If the user is being partially liquidated (i.e., userLps[owner].length > 0 after burning),              we must ensure that the sum of token0Value and token1Value is enough to cover the required amount. This prevents              under-collateralization in normal cases and ensures the liquidator receives sufficient value for the debt repaid.      Case 2. Normal CDP Bad Debt:               - All token0/token1 covers all collateral(LPUSD), but collateral couldn't cover debt                i.e. Sale.tab > Sale.lot && Sale.lot < all LP's value       Case 3. CDP + Liquidator Bad Debt :               - All token0/token1 COULD NOT cover all collateral(LPUSD), but collateral couldn't cover debt                i.e. Sale.tab > Sale.lot && Sale.lot > all LP's value              - at this case, we will by pass the value check, liquidator repay the debt but receive NO token0 and token1"}},"notice":"This contract allows users to lend LisUSD from the ListaDAO CDP by depositing PancakeSwap V3 LP tokens","version":1}},"settings":{"compilationTarget":{"contracts/ceros/provider/pancakeswapLpProvider/PancakeSwapV3LpProvider.sol":"PancakeSwapV3LpProvider"},"evmVersion":"london","libraries":{"contracts/ceros/provider/pancakeswapLpProvider/PancakeSwapV3LpProvider.sol:PcsV3LpLiquidationHelper":"0x51a0c6468ecaa8c4ad7bc3012a3889597f3d90c8","contracts/ceros/provider/pancakeswapLpProvider/PancakeSwapV3LpProvider.sol:PcsV3LpNumbersHelper":"0x969d3fc88ccaf7367f8442bd9bd69d22f4576be3"},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100},"remappings":[":@chainlink/=node_modules/@chainlink/",":@openzeppelin/=node_modules/@openzeppelin/",":@pythnetwork/=node_modules/@pythnetwork/",":eth-gas-reporter/=node_modules/eth-gas-reporter/",":forge-std/=lib/forge-std/src/",":hardhat/=node_modules/hardhat/"]},"sources":{"contracts/ceros/interfaces/ICdp.sol":{"keccak256":"0x5f0f543640efbd9ad8916243dc57e7eed62f9a57f06e08171498cdccb12a929d","license":"GPL-3.0-only","urls":["bzz-raw://baa42f423773b1447f42e4792f4083b1653d94f44e6ef4dd7d5630660957fcba","dweb:/ipfs/Qmct3UNBbd7eho2TBE4qeAkxaXomykWbUT6FXdJ4xMcTw2"]},"contracts/ceros/interfaces/ILpUsd.sol":{"keccak256":"0x00bd5939969420873dea1d7c533490c3979934659a6da572533891e4a8a1f478","license":"GPL-2.0-or-later","urls":["bzz-raw://a465320366b1836853da053074a56a909df9881b7ad8de362b4591e895c19ee5","dweb:/ipfs/QmcNjkvmisov84wPMyTz9zkgotkSrYUN9egVXRXVScj3rp"]},"contracts/ceros/interfaces/IMasterChefV3.sol":{"keccak256":"0xe4a2da53759897d7b691db735b6ad678bcf9e6377f0d2e4d6cb381c928385018","license":"GPL-2.0-or-later","urls":["bzz-raw://8d35882426663f507fd7a963b76f025c621d86784b6e7e6af58b85e58c89c47e","dweb:/ipfs/QmWk4kdT8Vfs4RVmTFHBBkqQcaM2L6wktEA45vJupFqttB"]},"contracts/ceros/interfaces/INonfungiblePositionManager.sol":{"keccak256":"0x587c9b48d409efafc95c83def9f34b798774972762ca473d3f4433fab