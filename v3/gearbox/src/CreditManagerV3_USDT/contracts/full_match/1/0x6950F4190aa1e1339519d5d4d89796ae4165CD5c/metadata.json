l the target contract with"},"returns":{"result":"Call result"}},"fees()":{"returns":{"_feeInterest":"Percentage of accrued interest taken by the protocol as profit","_feeLiquidation":"Percentage of liquidated account value taken by the protocol as profit","_feeLiquidationExpired":"Percentage of liquidated expired account value taken by the protocol as profit","_liquidationDiscount":"Percentage of liquidated account value that is used to repay debt","_liquidationDiscountExpired":"Percentage of liquidated expired account value that is used to repay debt"}},"flagsOf(address)":{"details":"Does not revert if `creditAccount` is not opened in this credit manager"},"fullCollateralCheck(address,uint256,uint256[],uint16,bool)":{"custom:expects":"Credit facade ensures that `creditAccount` is opened in this credit manager","details":"Even when `collateralHints` are specified, quoted tokens are evaluated before non-quoted ones","params":{"collateralHints":"Optional array of token masks to check first to reduce the amount of computation        when known subset of account's collateral tokens covers all the debt","creditAccount":"Credit account to check","enabledTokensMask":"Bitmask of account's enabled collateral tokens","minHealthFactor":"Health factor threshold in bps, the check fails if `twvUSD < minHealthFactor * totalDebtUSD`","useSafePrices":"Whether to use safe prices when evaluating collateral"},"returns":{"enabledTokensMaskAfter":"Bitmask of account's enabled collateral tokens after potential cleanup"}},"getTokenByMask(uint256)":{"details":"Reverts if `tokenMask` doesn't correspond to any known collateral token","params":{"tokenMask":"Collateral token mask in the credit manager"},"returns":{"token":"Token address"}},"getTokenMaskOrRevert(address)":{"details":"Reverts if `token` is not recognized as collateral in the credit manager","params":{"token":"Token address"},"returns":{"tokenMask":"Collateral token mask in the credit manager"}},"isLiquidatable(address,uint16)":{