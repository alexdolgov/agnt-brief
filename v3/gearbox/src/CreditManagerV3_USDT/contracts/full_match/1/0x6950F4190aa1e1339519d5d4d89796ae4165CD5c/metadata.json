ing after repayment)","tokensToEnable":"Tokens that should be enabled after the operation         (underlying mask on increase, zero on decrease)"}},"openCreditAccount(address)":{"params":{"onBehalfOf":"Owner of a newly opened credit account"},"returns":{"creditAccount":"Address of the newly opened credit account"}},"revokeAdapterAllowances(address,(address,address)[])":{"details":"Exists primarily to allow users to revoke allowances on accounts from old account factory on mainnetReverts if any of provided tokens is not recognized as collateral in the credit manager","params":{"creditAccount":"Account to revoke allowances for","revocations":"Array of spender/token pairs"}},"setActiveCreditAccount(address)":{"params":{"creditAccount":"Credit account to set as active or `INACTIVE_CREDIT_ACCOUNT_ADDRESS` to unset it"}},"setCollateralTokenData(address,uint16,uint16,uint40,uint24)":{"details":"If `token` is `underlying`, sets LT to `ltInitial` and ignores other parametersReverts if `token` is not recognized as collateral in the credit manager","params":{"ltFinal":"LT at the end of the ramp in bps","ltInitial":"LT at the beginning of the ramp in bps","rampDuration":"Ramp duration in seconds","timestampRampStart":"Timestamp of the beginning of the ramp","token":"Token to set parameters for"}},"setContractAllowance(address,address)":{"details":"Reverts if `targetContract` or `adapter` is this contract's address","params":{"adapter":"Address of the adapter contract to use to access the third-party contract,        passing `address(0)` will forbid accessing `targetContract`","targetContract":"Address of the third-pary contract for which the adapter is set,        passing `address(0)` will forbid using `adapter`"}},"setCreditConfigurator(address)":{"params":{"_creditConfigurator":"Address of the new credit configurator"}},"setCreditFacade(address)":{"params":{"_creditFacade":"Address of the new credit facade"}},"setFees(uint16,uint16,uint16,uint16,uint16)":{"params":{"_feeInte