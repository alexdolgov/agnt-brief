":"Reverts if `token` is not recognized as collateral in the credit manager","params":{"amount":"Amount to withdraw","creditAccount":"Credit account to withdraw collateral from","to":"Address to transfer token to","token":"Token to withdraw"},"returns":{"tokensToDisable":"Mask of tokens that should be disabled after the operation         (`token` mask if withdrawing the entire balance, zero otherwise)"}}},"title":"Credit manager V3 USDT","version":1},"userdoc":{"errors":{"ActiveCreditAccountNotSetException()":[{"notice":"Thrown when attempting to execute a protocol interaction without active credit account set"}],"ActiveCreditAccountOverridenException()":[{"notice":"Thrown when Credit Facade tries to write over a non-zero active Credit Account"}],"AllowanceFailedException()":[{"notice":"Thrown if an attempt to approve a collateral token to adapter's target contract fails"}],"CallerNotAdapterException()":[{"notice":"Thrown on attempting to call an access restricted function not as allowed adapter"}],"CallerNotConfiguratorException()":[{"notice":"Thrown on attempting to call an access restricted function not as configurator"}],"CallerNotCreditFacadeException()":[{"notice":"Thrown on attempting to call an access restricted function not as credit facade"}],"CloseAccountWithNonZeroDebtException()":[{"notice":"Thrown when attempting to close an account with non-zero debt"}],"CreditAccountDoesNotExistException()":[{"notice":"Thrown on attempting to perform an action for a credit account that does not exist"}],"DebtToZeroWithActiveQuotasException()":[{"notice":"Thrown when trying to repay all debt while having active quotas"}],"DebtUpdatedTwiceInOneBlockException()":[{"notice":"Thrown when trying to update credit account's debt more than once in the same block"}],"IncorrectParameterException()":[{"notice":"Thrown on incorrect input parameter"}],"InsufficientRemainingFundsException()":[{"notice":"Thrown when value of funds remaining on the account after liquidation is insufficient"}],"NotEnoughCollateralException()":[{"notice":"Thrown on failing a full collateral check after multicall"}],"TargetContractNotAllowedException()":[{"notice":"Thrown on attempting to interact with an address that is not a valid target contract"}],"TokenAlreadyAddedException()":[{"notice":"Thrown on attempting to add a token that is already in a collateral list"}],"TokenNotAllowedException()":[{"notice":"Thrown on attempting to receive a token that is not a collateral token or was forbidden"}],"TooManyEnabledTokensException()":[{"notice":"Thrown if more than the maximum number of tokens were enabled on a credit account"}],"TooManyTokensException()":[{"notice":"Thrown on configurator attempting to add more than 255 collateral tokens"}],"UpdateQuotaOnZeroDebtAccountException()":[{"notice":"Thrown when a zero-debt account attempts to update quota"}],"ZeroAddressException()":[{"notice":"Thrown on attempting to set an important address to zero address"}]},"events":{"SetCreditConfigurator(address)":{"notice":"Emitted when new credit configurator is set"}},"kind":"user","methods":{"accountFactory()":{"notice":"Account factory contract address"},"adapterToContract(address)":{"notice":"Mapping adapter => target contract"},"addCollateral(address,address,address,uint256)":{"notice":"Adds `amount` of `payer`'s `token` as collateral to `creditAccount`"},"addToken(address)":{"notice":"Adds `token` to the list of collateral tokens, see `_addToken` for details"},"addressProvider()":{"notice":"Address provider contract address"},"approveCreditAccount(address,uint256)":{"notice":"Instructs active credit account to approve `amount` of `token` to adater's target contract"},"approveToken(address,address,address,uint256)":{"notice":"Instructs `creditAccount` to approve `amount` of `token` to `spender`"},"calcDebtAndCollateral(address,uint8)":{"notice":"Returns `creditAccount`'s debt and collateral data with level of detail controlled by `task`"},"closeCreditAccount(address)":{"notice":"Closes a credit account"},"collateralTokenByMask(uint256)":{"notice":"Returns collateral token's address and liquidation threshold by its mask"},"collateralTokensCount()":{"notice":"Number of known collateral tokens"},"contractToAdapter(address)":{"notice":"Mapping target contract => adapter"},"creditAccountInfo(address)":{"notice":"Mapping credit account => account info (owner, debt amount, etc.)"},"creditAccounts()":{"notice":"Returns an array of all credit accounts opened in this credit manager"},"creditAccounts(uint256,uint256)":{"notice":"Returns chunk of up to `limit` credit accounts opened in this credit manager starting from `offset`"},"creditAccountsLen()":{"notice":"Returns the number of open credit accounts opened in this credit manager"},"creditConfigurator()":{"notice":"Address of the connected credit configurator"},"creditFacade()":{"notice":"Address of the connected credit facade"},"enabledTokensMaskOf(address)":{"notice":"Returns `creditAccount`'s enabled tokens mask"},"execute(bytes)":{"notice":"Instructs active credit account to call adapter's target contract with provided data"},"externalCall(address,address,bytes)":{"notice":"Instructs `creditAccount` to make an external call to target with `callData`"},"fees()":{"notice":"Returns credit manager's fee parameters (all fields in bps)"},"flagsOf(address)":{"notice":"Returns `creditAccount`'s flags as a bit mask"},"fullCollateralCheck(address,uint256,uint256[],uint16,bool)":{"notice":"Performs full check of `creditAccount`'s collateral to ensure it is sufficiently collateralized,         might disable tokens with zero balances"},"getActiveCreditAccountOrRevert()":{"notice":"Returns active credit account, reverts if it is not set"},"getBorrowerOrRevert(address)":{"notice":"Returns `creditAccount`'s owner or reverts if account is not opened in this credit manager"},"getTokenByMask(uint256)":{"notice":"Returns collateral token's address by its mask in the credit manager"},"getTokenMaskOrRevert(address)":{"notice":"Returns `token`'s collateral mask in the credit manager"},"isLiquidatable(address,uint16)":{"notice":"Whether `creditAccount`'s health factor is below `minHealthFactor`"},"liquidateCreditAccount(address,(uint256,uint256,uint256,uint128,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,address[],address),address,bool)":{"notice":"Liquidates a credit account         - Removes account's quotas, and, if there's loss incurred on liquidation,           also zeros out limits for account's quoted tokens in the quota keeper         - Repays debt to the pool         - Ensures that the value of funds remaining on the account is sufficient         - Transfers underlying surplus (if any) to the liquidator         - Resets account's debt, quota interest and fees to zero"},"liquidationThresholds(address)":{"notice":"Returns collateral token's liquidation threshold"},"ltParams(address)":{"notice":"Returns `token`'s liquidation threshold ramp parameters"},"manageDebt(address,uint256,uint256,uint8)":{"notice":"Increases or decreases credit account's debt"},"maxEnabledTokens()":{"notice":"Maximum number of tokens that a credit account can have enabled as collateral"},"name()":{"notice":"Credit manager name"},"openCreditAccount(address)":{"notice":"Opens a new credit account"},"pool()":{"notice":"Address of the pool credit manager is connected to"},"poolQuotaKeeper()":{"notice":"Returns address of the quota keeper connected to the pool"},"priceOracle()":{"notice":"Price oracle contract address"},"quotedTokensMask()":{"notice":"Bitmask of quoted tokens"},"revokeAdapterAllowances(address,(address,address)[])":{"notice":"Revokes credit account's allowances for specified spender/token pairs"},"setActiveCreditAccount(address)":{"notice":"Sets/unsets active credit account adapters can interact with"},"setCollateralTokenData(address,uint16,uint16,uint40,uint24)":{"notice":"Sets `token`'s liquidation threshold ramp parameters"},"setContractAllowance(address,addre