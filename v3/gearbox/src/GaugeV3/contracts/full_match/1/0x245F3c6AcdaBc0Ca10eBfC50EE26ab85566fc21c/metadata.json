poch(bool)":{"details":"The epoch can be frozen to prevent rate updates during gauge/staking contracts migration","params":{"status":"The new status"}},"unvote(address,uint96,bytes)":{"params":{"extraData":"Gauge specific parameters (encoded into `extraData` to adhere to the voting contract interface)        * token - address of the token to unvote for        * lpSide - whether the side to remove votes for is the LP side","user":"The user that submitted votes","votes":"Amount of votes to remove"}},"vote(address,uint96,bytes)":{"params":{"extraData":"Gauge specific parameters (encoded into `extraData` to adhere to the voting contract interface)        * token - address of the token to vote for        * lpSide - whether the side to add votes for is the LP side","user":"The user that submitted votes","votes":"Amount of votes to add"}}},"title":"Gauge V3","version":1},"userdoc":{"errors":{"CallerNotConfiguratorException()":[{"notice":"Thrown on attempting to call an access restricted function not as configurator"}],"CallerNotControllerException()":[{"notice":"Thrown on attempting to call an access restricted function not as controller or configurator"}],"CallerNotPausableAdminException()":[{"notice":"Thrown on attempting to pause a contract without pausable admin rights"}],"CallerNotUnpausableAdminException()":[{"notice":"Thrown on attempting to unpause a contract without unpausable admin rights"}],"CallerNotVoterException()":[{"notice":"Thrown on attempting to call an access restricted function not as voter"}],"IncorrectParameterException()":[{"notice":"Thrown on incorrect input parameter"}],"InsufficientVotesException()":[{"notice":"Thrown when attempting to unvote more votes than there are"}],"TokenNotAllowedException()":[{"notice":"Thrown on attempting to receive a token that is not a collateral token or was forbidden"}],"ZeroAddressException()":[{"notice":"Thrown on attempting to set an important address to zero address"}]},"events":{"AddQuotaToken(address,uint16,uint16)":{"notice":"Emitted when a new quota token is added in the PoolQuotaKeeper"},"NewController(address)":{"notice":"Emitted when new external controller is set"},"SetFrozenEpoch(bool)":{"notice":"Emitted when the frozen epoch status changes"},"SetQuotaTokenParams(address,uint16,uint16)":{"notice":"Emitted when quota interest rate parameters are changed"},"Unvote(address,address,uint96,bool)":{"notice":"Emitted when a user removes a vote"},"UpdateEpoch(uint16)":{"notice":"Emitted when epoch is updated"},"Vote(address,address,uint96,bool)":{"notice":"Emitted when a user submits a vote"}},"kind":"user","methods":{"acl()":{"notice":"ACL contract address"},"addQuotaToken(address,uint16,uint16)":{"notice":"Adds a new quoted token to the gauge and sets the initial rate params         If token is not added to the quota keeper, adds it there as well"},"constructor":{"notice":"Constructor"},"controller()":{"notice":"External controller address"},"epochFrozen()":{"notice":"Whether gauge is frozen and rates cannot be updated"},"epochLastUpdate()":{"notice":"Epoch when the rates were last updated"},"getRates(address[])":{"notice":"Computes rates for an array of tokens based on the current votes"},"isTokenAdded(address)":{"notice":"Whether token is added to the gauge as quoted"},"pause()":{"notice":"Pauses contract, can only be called by an account with pausable admin role"},"pool()":{"notice":"Address of the pool this gauge is connected to"},"quotaRateParams(address)":{"notice":"Mapping from token address to its rate parameters"},"setController(address)":{"notice":"Sets new external controller, can only be called by configurator"},"setFrozenEpoch(bool)":{"notice":"Sets the frozen epoch status"},"unpause()":{"notice":"Unpauses contract, can only be called by an account with unpausable admin role"},"unvote(address,uint96,bytes)":{"notice":"Removes user's existing votes for the provided token and side and updates the epoch if necessary"},"updateEpoch()":{"notice":"Updates the e