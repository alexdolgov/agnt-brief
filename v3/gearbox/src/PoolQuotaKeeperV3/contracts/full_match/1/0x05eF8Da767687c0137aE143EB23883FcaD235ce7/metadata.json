stateMutability":"view","type":"function"},{"inputs":[],"name":"unpause","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"creditAccount","type":"address"},{"internalType":"address","name":"token","type":"address"},{"internalType":"int96","name":"requestedChange","type":"int96"},{"internalType":"uint96","name":"minQuota","type":"uint96"},{"internalType":"uint96","name":"maxQuota","type":"uint96"}],"name":"updateQuota","outputs":[{"internalType":"uint128","name":"caQuotaInterestChange","type":"uint128"},{"internalType":"uint128","name":"fees","type":"uint128"},{"internalType":"bool","name":"enableToken","type":"bool"},{"internalType":"bool","name":"disableToken","type":"bool"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"updateRates","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"version","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"}],"devdoc":{"kind":"dev","methods":{"accrueQuotaInterest(address,address[])":{"params":{"creditAccount":"Credit account to accrue interest for","tokens":"Array tokens to accrue interest for"}},"addCreditManager(address)":{"params":{"_creditManager":"Address of the new credit manager"}},"addQuotaToken(address)":{"params":{"token":"Address of the token"}},"constructor":{"params":{"_pool":"Pool address"}},"getQuotaAndOutstandingInterest(address,address)":{"params":{"creditAccount":"Account to compute the values for","token":"Token to compute the values for"},"returns":{"outstandingInterest":"Quota interest accrued since the last update","quoted":"Account's token quota"}},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"removeQuotas(address,address[],bool)":{"params":{"creditAccount":"Credit account to remove quotas for","setLimitsToZero":"Whether tokens quota limits should be set to zero","tokens":"Array of tokens to remove quotas for"}},"setGauge(address)":{"params":{"_gauge":"Address of the new gauge contract"}},"setTokenLimit(address,uint96)":{"params":{"limit":"The limit to set","token":"Address of token to set the limit for"}},"setTokenQuotaIncreaseFee(address,uint16)":{"params":{"fee":"The new fee value in bps","token":"Token to set the fee for"}},"updateQuota(address,address,int96,uint96,uint96)":{"params":{"creditAccount":"Credit account to update the quota for","maxQuota":"Maximum allowed quota amount","minQuota":"Minimum deisred quota amount","requestedChange":"Requested quota change in pool's underlying asset units","token":"Token to update the quota for"},"returns":{"caQuotaInterestChange":"Token quota interest accrued by account since the last update","disableToken":"Whether the token needs to be disabled as collateral","enableToken":"Whether the token needs to be enabled as collateral","fees":"Quota increase fees, if any"}}},"stateVariables":{"accountQuotas":{"details":"Mapping from (creditAccount, token) to account's token quota params"},"creditManagerSet":{"details":"The list of all allowed credit managers"},"quotaTokensSet":{"details":"The list of all quoted tokens"}},"title":"Pool quota keeper V3","version":1},"userdoc":{"errors":{"CallerNotConfiguratorException()":[{"notice":"Thrown on attempting to call an access restricted function not as configurator"}],"CallerNotControllerException()":[{"notice":"Thrown on attempting to call an access restricted function not as controller or configurator"}],"CallerNotCreditManagerException()":[{"notice":"Thrown on attempting to call an access restricted function not as credit manager"}],"CallerNotGaugeException()":[{"notice":"Thrown on attempting to call an access restricted function not as gauge"}],"CallerNotPausableAdminException()":[{"notice":"Thrown on attempting to pause a contract without pausable admin rights"}],"CallerNotUnpausableAdminException()":[{"notice":"Thrown on attempting to unpause a contract without unpausable admin rights"}],"IncompatibleCreditManagerException()":[{"notice":"Thrown by pool-adjacent contracts when a credit manager being connected has a wrong pool address"}],"IncorrectParameterException()":[{"notice":"Thrown on incorrect input parameter"}],"QuotaIsOutOfBoundsException()":[{"notice":"Thrown when the quota is outside of min/max bounds"}],"RegisteredCreditManagerOnlyException()":[{"notice":"Thrown when an address is expected to be a registered credit manager, but is not"}],"TokenAlreadyAddedException()":[{"notice":"Thrown on attempting to add a token that is already in a collateral list"}],"TokenIsNotQuotedException()":[{"notice":"Thrown when attempting to use quota-related logic for a token that is not quoted in quota keeper"}],"ZeroAddressException()":[{"notice":"Thrown on attempting to set an important address to zero address"}]},"events":{"AddCreditManager(address)":{"notice":"Emitted when a new credit manager is allowed"},"AddQuotaToken(address)":{"notice":"Emitted when a new token is added as quoted"},"NewController(address)":{"notice":"Emitted when new external controller is set"},"SetGauge(address)":{"notice":"Emitted when the gauge is updated"},"SetQuotaIncreaseFee(address,uint16)":{"notice":"Emitted when a new one-time quota increase fee is set for a token"},"SetTokenLimit(address,uint96)":{"notice":"Emitted when a new total quota limit is set for a token"},"UpdateQuota(address,address,int96)":{"notice":"Emitted when account's quota for a token is updated"},"UpdateTokenQuotaRate(address,uint16)":{"notice":"Emitted when token's quota rate is updated"}},"kind":"user","methods":{"accrueQuotaInterest(address,address[])":{"notice":"Updates credit account's interest indexes for provided tokens"},"acl()":{"notice":"ACL contract address"},"addCreditManager(address)":{"notice":"Adds an address to the set of allowed credit managers"},"addQuotaToken(address)":{"notice":"Adds a new quota token"},"constructor":{"notice":"Constructor"},"contractsRegister()":{"notice":"Contracts register contract address"},"controller()":{"notice":"External controller address"},"creditManagers()":{"notice":"Returns the list of allowed credit managers"},"cumulativeIndex(address)":{"notice":"Returns current quota interest index for a token in ray"},"gauge()":{"notice":"Address of the gauge"},"getQuota(address,address)":{"notice":"Returns account's quota params for a token"},"getQuotaAndOutstandingInterest(address,address)":{"notice":"Returns credit account's token quota and interest accrued since the last update"},"getQuotaRate(address)":{"notice":"Returns quota interest rate for a token in bps"},"getTokenQuotaParams(address)":{"notice":"Returns global quota params for a token"},"isQuotedToken(address)":{"notice":"Whether a token is quoted"},"lastQuotaRateUpdate()":{"notice":"Timestamp of the last quota rates update"},"pause()":{"notice":"Pauses contract, can only be called by an account with pausable admin role"},"pool()":{"notice":"Address of the pool"},"poolQuotaRevenue()":{"notice":"Returns the pool's quota revenue (in units of underlying per year)"},"quotedTokens()":{"notice":"Returns an array of all quoted tokens"},"removeQuotas(address,address[],bool)":{"notice":"Removes credit account's quotas for provided tokens         - Sets account's tokens quotas to zero         - Optionally sets quota limits for tokens to zero, effectively preventing further exposure           to them in extreme cases (e.g., liquidations with loss)         - Does not update account's interest indexes (can be skipped since quotas are zero)         - Decreases pool's quota revenue"},"setController(address)":{"notice":"Sets new external controller, can only be called by configurator"},"setGauge(address)":{"notice":"Sets a new gauge contract to compute quota rates"},"setTokenLimit(address,uint96)":{"notice":"Sets the total quota limit for a token"},"setTokenQuotaIncreaseFee(address,uint16)":{"notice":"Sets the one-time quota increase fee for a token"},"underlying()":{"notice":"Address of the underlying token"},"unpause()":{"notice":"Unpauses contract, can only be called by an account with unpausable admin role"},"updateQuota(address,address,int96,uint96,uint96)":{"notice":"Updates credit account's quota for a token         - Updates account's interest index         - Updates account's quota by requested delta subject to the total quota limit (which is considered           to be zero for tokens added to the quota keeper but not yet activated via `updateRates`)         - Checks that the resulting quota is no less than the user-specified min desired value           and no more than system-specified max allowed value         - Updates pool's quota revenue"},"updateRates()":{"notice":"Updates quota rates         - Updates global token cumulative indexes before changing rates         - Queries new rates for all quoted tokens from the gauge         - Sets new pool quota revenue"},"version()":{"notice":"Contract version"}},"notice":"In Gearbox V3, quotas are used to limit the system exposure to risky assets.         In order for a risky token to be counted towards credit account's collateral, account owner must \"purchase\"         a quota for this token, which entails two kinds of payments:         * interest that accrues over time with rates determined by the gauge (more suited to leveraged farming), and         * increase fee that is charged when additional quota is purchased (more suited to leveraged trading).         Quota keeper stores information about quotas of accounts in all credit managers connected to the pool, and         performs calculations that help to keep pool's expected liquidity and credit managers' debt consistent.","version":1}},"settings":{"compilationTarget":{"node_modules/@gearbox-protocol/core-v3/contracts/pool/PoolQuotaKeeperV3.sol":"PoolQuotaKeeperV3"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1000},"remappings":[":@1inch/=node_modules/@1in