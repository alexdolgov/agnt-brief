uld not expect the reserve price feed to always differ from the main one, although         most often that would be the case.Price oracle additionaly provides \"safe\" conversion functions, which use minimum of main         and reserve feed prices (the latter is assumed to be zero if reserve feed is not set).         There are also trusted price feeds, for which safe prices are simply main feed prices.","version":1}},"settings":{"compilationTarget":{"node_modules/@gearbox-protocol/core-v3/contracts/core/PriceOracleV3.sol":"PriceOracleV3"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1000},"remappings":[":@1inch/=node_modules/@1inch/",":@chainlink/=node_modules/@chainlink/",":@eth-optimism/=node_modules/@eth-optimism/",":@gearbox-protocol/=node_modules/@gearbox-protocol/",":@openzeppelin/=node_modules/@openzeppelin/",":@redstone-finance/=node_modules/@redstone-finance/",":ds-test/=lib/forge-std/lib/ds-test/src/",":eth-gas-reporter/=node_modules/eth-gas-reporter/",":forge-std/=lib/forge-std/src/"]},"sources":{"node_modules/@gearbox-protocol/core-v2/contracts/interfaces/IACL.sol":{"keccak256":"0xb2613ba2579762637ef8143f2b49c3dd3a2119f949fd57875ef420575d6c9184","license":"MIT","urls":["bzz-raw://f7ba653bdd000d05ed5975c243b806fb93ded00dd10b391fcbb7523eaa893f05","dweb:/ipfs/QmfJf8hLhSsRucVVmtHSjKAzQ5tS3PpVKDmYEuiSTyVNSp"]},"node_modules/@gearbox-protocol/core-v2/contracts/interfaces/IPriceFeed.sol":{"keccak256":"0xc095eb67afb7abfc634c8a150bcf4e9f1d67d921cd1d809ff29d787b8a331fa9","license":"MIT","urls":["bzz-raw://9a45f144bec8cbcb12b23064d0928ba3452461d7f0d049289fb3eb591a456e4d","dweb:/ipfs/Qmca6hZJbjBzBkUA7EQ2vxy5XKWCtPXtGnjmJ5rCDPVeya"]},"node_modules/@gearbox-protocol/core-v2/contracts/interfaces/IPriceOracleBase.sol":{"keccak256":"0xa7c0056e2ccb2cd939fc191ec77a982bcba93440935439bc49a3f61b286c2c11","license":"MIT","urls":["bzz-raw://3b89677cfe10c5666147552992d0b12c2c65c1f04a0f71bc335989a4c47451a2","dweb:/ipfs