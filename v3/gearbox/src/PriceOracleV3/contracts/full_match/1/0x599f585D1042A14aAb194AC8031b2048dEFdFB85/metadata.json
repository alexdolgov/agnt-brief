ller or configurator"}],"CallerNotPausableAdminException()":[{"notice":"Thrown on attempting to pause a contract without pausable admin rights"}],"CallerNotUnpausableAdminException()":[{"notice":"Thrown on attempting to unpause a contract without unpausable admin rights"}],"IncorrectParameterException()":[{"notice":"Thrown on incorrect input parameter"}],"IncorrectPriceException()":[{"notice":"Thrown when price feed returns incorrect price for a token"}],"IncorrectPriceFeedException()":[{"notice":"Thrown on attempting to set a token price feed to an address that is not a correct price feed"}],"IncorrectTokenContractException()":[{"notice":"Thrown on attempting to use a non-ERC20 contract or an EOA as a token"}],"PriceFeedDoesNotExistException()":[{"notice":"Thrown on attempting to interact with a price feed for a token not added to the price oracle"}],"StalePriceException()":[{"notice":"Thrown when token's price feed becomes stale"}],"ZeroAddressException()":[{"notice":"Thrown on attempting to set an important address to zero address"}]},"events":{"NewController(address)":{"notice":"Emitted when new external controller is set"},"SetPriceFeed(address,address,uint32,bool,bool)":{"notice":"Emitted when new price feed is set for token"},"SetReservePriceFeed(address,address,uint32,bool)":{"notice":"Emitted when new reserve price feed is set for token"},"SetReservePriceFeedStatus(address,bool)":{"notice":"Emitted when new reserve price feed status is set for a token"}},"kind":"user","methods":{"acl()":{"notice":"ACL contract address"},"constructor":{"notice":"Constructor"},"controller()":{"notice":"External controller address"},"convert(uint256,address,address)":{"notice":"Converts `amount` of `tokenFrom` into `tokenTo` amount"},"convertFromUSD(uint256,address)":{"notice":"Converts `amount` of USD (with 8 decimals) into `token` amount"},"convertToUSD(uint256,address)":{"notice":"Converts `amount` of `token` into USD amount (with 8 decimals)"},"getPrice(address)":{"notice"