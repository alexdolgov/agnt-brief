s":[{"internalType":"uint256","name":"_blockNumber","type":"uint256"}],"name":"totalSupplyAt","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"userPointEpoch","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"userPointHistory","outputs":[{"internalType":"int128","name":"bias","type":"int128"},{"internalType":"int128","name":"slope","type":"int128"},{"internalType":"uint256","name":"ts","type":"uint256"},{"internalType":"uint256","name":"blk","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":true,"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"userRewardPerTokenPaid","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function"},{"constant":false,"inputs":[],"name":"withdraw","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"Voting Weight tracking & Decay            -> Curve Finance (MIT) - forked & ported to Solidity            -> https://github.com/curvefi/curve-dao-contracts/blob/master/contracts/VotingEscrow.vy        osolmaz - Research & Reward distributions        alsco77 - Solidity implementation","details":"Supports:           1) Tracking MTA Locked up (LockedBalance)           2) Pull Based Reward allocations based on Lockup (Static Balance)           3) Decaying voting weight lookup through CheckpointedERC20 (balanceOf)           4) Ejecting fully decayed participants from reward allocation (eject)           5) Migration of points to v2 (used as multiplier in future) ***** (rewardsPaid)           6) Closure of contract (expire)","methods":{"balanceOf(address)":{"details":"Gets curent user voting weight (aka effectiveStake)","params":{"_owner":"User for which to return the balance"},"return":"uint256 Balance of user"},"balanceOfAt(address,uint256)":{"details":"Gets a users votingWeight at a given blockNumber","params":{"_blockNumber":"Block at which to calculate balance","_owner":"User for which to return the balance"},"return":"uint256 Balance of user"},"checkpoint()":{"details":"Public function to trigger global checkpoint"},"claimReward()":{"details":"Claims outstanding rewards for the sender. First updates outstanding reward allocation and then transfers."},"createLock(uint256,uint256)":{"details":"Creates a new lock","params":{"_unlockTime":"Time at which the stake should unlock","_value":"Total units of StakingToken to lockup"}},"earned(address)":{"details":"Calculates the amount of unclaimed rewards a user has earned","params":{"_addr":"User address"},"return":"Total reward amount earned"},"eject(address)":{"details":"Ejects a user from the reward allocation, given their lock has freshly expired. Leave it to the user to withdraw and claim their rewards.","params":{"_addr":"Address of the user"}},"exit()":{"details":"Withdraws and consequently claims rewards for the sender"},"expireContract()":{"details":"Ends the contract, unlocking all stakes. No more staking can happen. Only withdraw and Claim."},"getDuration()":{"details":"Gets the duration of the rewards period"},"getLastUserPoint(address)":{"details":"Gets the last available user point","params":{"_addr":"User address"},"return":"bias i.e. yslope i.e. linear gradientts i.e. time point was logged"},"getRewardToken()":{"details":"Gets the RewardsToken"},"increaseLockAmount(uint256)":{"details":"Increases amount of stake thats locked up & resets decay","params":{"_value":"Additional units of StakingToken to add to exiting stake"}},"increaseLockLength(uint256)":{"details":"Increases length of lockup & resets decay","params":{"_unlockTime":"New unlocktime for lockup"}},"lastTimeRewardApplicable()":{"details":"Gets the last applicable timestamp for this reward period"},"notifyRewardAmount(uint256)":{"details":"Notifies the contract that new rewards have been added. Calculates an updated rewardRate based on the rewards in period.","params":{"_reward":"Units of RewardToken that have been added to the pool"}},"rewardPerToken()":{"details":"Calculates the amount of unclaimed rewards per token since last update, and sums with stored to give the new cumulative reward per token","return":"'Reward' per staked token"},"setRewardsDistribution(address)":{"details":"Change the rewardsDistributor - only called by mStable governor","params":{"_rewardsDistributor":"Address of the new distributor"}},"staticBalanceOf(address)":{"details":"Gets the most recent Static Balance (bias) for a user","params":{"_addr":"User for which to retrieve static balance"},"return":"uint256 balance"},"totalSupply()":{"details":"Calculates current total supply of votingWeight","return":"totalSupply of voting token weight"},"totalSupplyAt(uint256)":{"details":"Calculates total supply of votingWeight at a given blockNumber","params":{"_blockNumber":"Block number at which to calculate total supply"},"return":"totalSupply of voting token weight at the given blockNumber"},"withdraw()":{"details":"Withdraws all the senders stake, providing lockup is over"}},"title":"IncentivisedVotingLockup"},"userdoc":{"methods":{},"notice":"Lockup MTA, receive vMTA (voting weight that decays over time), and earn        rewards based on staticWeight"}},"settings":{"compilationTarget":{"IncentivisedVotingLockup.sol":"IncentivisedVotingLockup"},"evmVersion":"istanbul","libraries":{},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"IncentivisedVotingLockup.sol":{"keccak256":"0x9b33aca6c6b39b25033c8d5513298cef2d10371d102ebd49c7160d613bce9b93","urls":["bzz-raw://251c655c5023ef1819c0e7692cb0aeec05344117404555f0a4