d by a new owner to accept an ownership transfer\r"},"acceptTokenOwnership()":{"details":"deprecated, backward compatibility\r"},"addReserve(address,uint32)":{"details":"defines the reserve token for the converter\r can only be called by the owner while the converter is inactive and the\r reserve wasn't defined yet\r ","params":{"_token":"address of the reserve token\r","_weight":"reserve weight, represented in ppm, 1-1000000\r"}},"connectorTokenCount()":{"details":"deprecated, backward compatibility\r"},"connectorTokens(uint256)":{"details":"deprecated, backward compatibility\r"},"connectors(address)":{"details":"deprecated, backward compatibility\r"},"convert(address,address,uint256,address,address)":{"details":"converts a specific amount of source tokens to target tokens\r can only be called by the bancor network contract\r ","params":{"_amount":"amount of tokens to convert (in units of the source token)\r","_beneficiary":"wallet to receive the conversion result\r ","_sourceToken":"source ERC20 token\r","_targetToken":"target ERC20 token\r","_trader":"address of the caller who executed the conversion\r"},"return":"amount of tokens received (in units of the target token)\r"},"converterType()":{"details":"returns the converter type\r ","return":"see the converter types in the the main contract doc\r"},"getConnectorBalance(address)":{"details":"deprecated, backward compatibility\r"},"getReturn(address,address,uint256)":{"details":"deprecated, backward compatibility\r"},"hasETHReserve()":{"details":"checks whether or not the converter has an ETH reserve\r ","return":"true if the converter has an ETH reserve, false otherwise\r"},"isActive()":{"details":"returns true if the converter is active, false otherwise\r ","return":"true if the converter is active, false otherwise\r"},"isV28OrHigher()":{"details":"checks whether or not the converter version is 28 or higher\r ","return":"true, since the converter version is 28 or higher\r"},"reserveBalance(address)":{"details":"