nchor ownership\r the new owner needs to accept the transfer\r can only be called by the converter upgrder while the upgrader is the owner\r note that prior to version 28, you should use 'transferAnchorOwnership' instead\r ","params":{"_newOwner":"new token owner\r"}},"transferOwnership(address)":{"details":"allows transferring the contract ownership\r the new owner still needs to accept the transfer\r can only be called by the contract owner\r ","params":{"_newOwner":"new contract owner\r"}},"transferTokenOwnership(address)":{"details":"deprecated, backward compatibility\r"},"updateRegistry()":{"details":"updates to the new contract-registry\r"},"upgrade()":{"details":"upgrades the converter to the latest version\r can only be called by the owner\r note that the owner needs to call acceptOwnership on the new converter after the upgrade\r"},"withdrawETH(address)":{"details":"withdraws ether\r can only be called by the owner if the converter is inactive or by upgrader contract\r can only be called after the upgrader contract has accepted the ownership of this contract\r can only be called if the converter has an ETH reserve\r ","params":{"_to":"address to send the ETH to\r"}},"withdrawFromAnchor(address,address,uint256)":{"details":"withdraws tokens held by the anchor and sends them to an account\r can only be called by the owner\r ","params":{"_amount":"amount to withdraw\r","_to":"account to receive the new amount\r","_token":"ERC20 token contract address\r"}},"withdrawTokens(address,address,uint256)":{"details":"withdraws tokens held by the converter and sends them to an account\r can only be called by the owner\r note that reserve tokens can only be withdrawn by the owner while the converter is inactive\r unless the owner is the converter upgrader contract\r ","params":{"_amount":"amount to withdraw\r","_to":"account to receive the new amount\r","_token":"ERC20 token contract address\r"}}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"LiquidTokenCo