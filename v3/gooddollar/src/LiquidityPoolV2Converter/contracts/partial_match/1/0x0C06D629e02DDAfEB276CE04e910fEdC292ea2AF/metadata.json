hdrawn by the owner while the converter is inactive\r unless the owner is the converter upgrader contract\r ","params":{"_amount":"amount to withdraw\r","_to":"account to receive the new amount\r","_token":"ERC20 token contract address\r"}}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"LiquidityPoolV2Converter.sol":"LiquidityPoolV2Converter"},"evmVersion":"byzantium","libraries":{},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"LiquidityPoolV2Converter.sol":{"keccak256":"0xc4c97f5b69ec3286d1fcc672cade44498b76479c6d9a1e78a3e9f0b4bc90ee0e","urls":["bzzr://0c4823017797146cd4c8e0043a0b3cdff2d9df4fb209582e79d4b32eec5ed85a"]}},"version":1}