nternalType":"uint256","name":"_amount","type":"uint256"}],"name":"withdrawTokens","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"details":"The Liquidity Protection Store contract serves as the storage of the liquidity protection mechanism. It holds the data and tokens and is non upgradable.","events":{"BalanceLocked(address,uint256,uint256)":{"details":"triggered when network tokens are locked","params":{"_amount":"amount of network tokens","_expirationTime":"lock expiration time","_provider":"provider of the network tokens"}},"BalanceUnlocked(address,uint256)":{"details":"triggered when network tokens are unlocked","params":{"_amount":"amount of network tokens","_provider":"provider of the network tokens"}},"PoolWhitelistUpdated(address,bool)":{"details":"triggered when the pool whitelist is updated","params":{"_added":"true if the pool was added to the whitelist, false if it was removed","_poolAnchor":"pool anchor"}},"ProtectionAdded(address,address,address,uint256,uint256)":{"details":"triggered when liquidity protection is added","params":{"_poolAmount":"amount of pool tokens","_poolToken":"pool token address","_provider":"liquidity provider","_reserveAmount":"amount of reserve tokens","_reserveToken":"reserve token address"}},"ProtectionRemoved(address,address,address,uint256,uint256)":{"details":"triggered when liquidity protection is removed","params":{"_poolAmount":"amount of pool tokens","_poolToken":"pool token address","_provider":"liquidity provider","_reserveAmount":"amount of reserve tokens","_reserveToken":"reserve token address"}},"ProtectionUpdated(address,uint256,uint256,uint256,uint256)":{"details":"triggered when liquidity protection is updated","params":{"_newPoolAmount":"new amount of pool tokens","_newReserveAmount":"new amount of reserve tokens","_prevPoolAmount":"previous amount of pool tokens","_prevReserveAmount":"previous amount of reserve tokens","_provider":"liquidity provider"}},"SystemBalanceUpdated(address,uint256,uint256)":{"details":"triggered when the system balance for a given token is updated","params":{"_newAmount":"new amount","_prevAmount":"previous amount","_token":"token address"}}},"kind":"dev","methods":{"acceptOwnership()":{"details":"used by a new owner to accept an ownership transfer"},"addLockedBalance(address,uint256,uint256)":{"details":"adds new locked network token balance can only be called by the contract owner","params":{"_amount":"token amount","_expirationTime":"lock expiration time","_provider":"liquidity provider"},"returns":{"_0":"new locked balance index"}},"addPoolToWhitelist(address)":{"details":"adds a pool to the whitelist can only be called by the contract owner","params":{"_poolAnchor":"pool anchor"}},"addProtectedLiquidity(address,address,address,uint256,uint256,uint256,uint256,uint256)":{"details":"adds protected liquidity can only be called by the contract owner","params":{"_poolAmount":"pool token amount","_poolToken":"pool token address","_provider":"liquidity provider","_reserveAmount":"reserve token amount","_reserveRateD":"rate of 1 protected reserve token in units of the other reserve token (denominator)","_reserveRateN":"rate of 1 protected reserve token in units of the other reserve token (numerator)","_reserveToken":"reserve token address","_timestamp":"timestamp"},"returns":{"_0":"new protected liquidity id"}},"decSystemBalance(address,uint256)":{"details":"decreases the system balance for a given token can only be called by the contract owner","params":{"_amount":"token amount","_token":"token address"}},"incSystemBalance(address,uint256)":{"details":"increases the system balance for a given token can only be called by the contract owner","params":{"_amount":"token amount","_token":"token address"}},"isPoolWhitelisted(address)":{"details":"checks whether a given pool is whitelisted","params":{"_poolAnchor":"pool anchor"},"returns":{"_0":"true if the given pool is whitelisted, false otherwise"}},"lockedBalance(address,