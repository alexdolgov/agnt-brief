 store"}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getRoleMember(bytes32,uint256)":{"details":"Returns one of the accounts that have `role`. `index` must be a value between 0 and {getRoleMemberCount}, non-inclusive. Role bearers are not sorted in any particular way, and their ordering may change at any point. WARNING: When using {getRoleMember} and {getRoleMemberCount}, make sure you perform all queries on the same block. See the following https://forum.openzeppelin.com/t/iterating-over-elements-on-enumerableset-in-openzeppelin-contracts/2296[forum post] for more information."},"getRoleMemberCount(bytes32)":{"details":"Returns the number of accounts that have `role`. Can be used together with {getRoleMember} to enumerate all bearers of a role."},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"lastRemoveTimes()":{"details":"returns the last remove times","returns":{"_0":"the last remove times"}},"networkTokenGovernance()":{"details":"returns the network token governance","returns":{"_0":"the network token governance"}},"onAddingLiquidity(address,address,address,uint256,uint256)":{"details":"liquidity provision notification callback. The callback should be called *after* the liquidity is added in the LP contract.","params":{"poolAnchor":"the pool token representing the rewards pool","provider":"the owner of the liquidity","reserveToken":"the reserve token of the added liquidity"}},"onRemovingLiquidity(uint256,address,address,address,uint256,uint256)":{"details":"liquidity removal callback. The callback must be called *before* the liquidity is removed in the LP contract","params":{"poolAnchor":"the pool token representing the rewards pool","provider":"the owner of the liquidity","reserveToken":"the reserve token of the removed liquidity"}},"pendingReserveRewards(address,address,address)":{"details":"returns specific provider's pending rewards for a specific participating pool/reserve","params":{"poolToken":"the pool token representing the new rewards pool","provider":"the owner of the liquidity","reserveToken":"the reserve token representing the liquidity in the pool"},"returns":{"_0":"all pending rewards"}},"pendingRewards(address)":{"details":"returns specific provider's pending rewards for all participating pools","params":{"provider":"the owner of the liquidity"},"returns":{"_0":"all pending rewards"}},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `account`."},"restoreRegistry()":{"details":"restores the previous contract-registry"},"restrictRegistryUpdate(bool)":{"details":"restricts the permission to update the contract-registry","params":{"_onlyOwnerCanUpdateRegistry":"indicates whether or not permission is restricted to owner only"}},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role."},"rewardsMultiplier(address,address,address)":{"details":"returns the current rewards multiplier for a provider in a given pool","params":{"poolToken":"the pool to query","provider":"the owner of the liquidity","reserveToken":"the reserve token representing the liquidity in the pool"},"returns":{"_0":"rewards multiplier"}},"stakeRewards(uint256,address)":{"details":"stakes specific pending rewards from all participating pools","params":{"maxAmount":"an optional cap on the rewards to stake","poolToken":"the pool token representing the new rewards pool"},"returns":{"_0":"all staked rewards and the ID of the new position"}},"store()":{"details":"returns the staking rewards store","returns":{"_0":"the staking rewards store"}},"totalClaimedRewards(address)":{"details":"returns specific provider's total claimed rewards from all participating pools","params":{"provider":"the owner of the liquidity"},"returns":{"_0":"total claimed rewards from all participating pools"}},"transferOwnership(address)":{"details":"allows transferring the contract ownership the new owner still needs to accept the transfer can only be called by the contract owner","params":{"_newOwner":"new contract owner"}},"updateRegistry()":{"details":"updates to the new contract-registry"},"updateRewards(address[])":{"details":"updates pending rewards for a list of providers","params":{"providers":"owners of the liquidity"}}},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"compilationTarget":{"/Users/yudi/git/staking-rewards/packages/solidity/contracts/StakingRewards.sol":"StakingRewards"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"/Users/yudi/git/staking-rewards/packages/solidity/contracts/IStakingRewardsStore.sol":{"keccak256":"0x7d6c41aa0b1293e28d2e6fbd4d4bea6e46254d75211319136095c7fac89569b2","license":"MIT","urls":["bzz-raw://d14c44aa6d7a225eb29a2c8c074484c38fedcf43dea6c352ad0120320ce1af2e","dweb:/ipfs/Qme1iGk7Nr4N4JYp3Cp81eVWpv9RCxdPtfTa3d8eq8M5Sd"]},"/Users/yudi/git/staking-rewards/packages/solidity/contracts/StakingRewards.sol":{"keccak256":"0x6918d978e648e8dd6c10f67e12444a46c4dd7097eca7540c17ec54fd52cd8440","license":"MIT","urls":["bzz-raw://66c6ce410be689f4d404f9ea0eb67e38406dc26d25df0447eff509c8ca405cb7","dweb:/ipfs/Qmc4jfiip8E