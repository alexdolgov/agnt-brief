view","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"kind":"dev","methods":{"gridexPlaceMakerOrderCallback(uint256,uint256,bytes)":{"details":"In this implementation, you are required to pay the grid tokens owed for the maker order. The caller of the method must be a grid deployed by the canonical GridFactory. At most one of amount0 and amount1 is a positive number","params":{"amount0":"The grid will receive the amount of token0 upon placement of the maker order. In the receiving case, the callback must send this amount of token0 to the grid","amount1":"The grid will receive the amount of token1 upon placement of the maker order. In the receiving case, the callback must send this amount of token1 to the grid","data":"Any data passed through by the caller via the IGrid#placeMakerOrder call"}},"placeMakerOrder((uint256,address,address,address,int24,bool,int24,uint128))":{"returns":{"orderId":"The unique identifier of the order"}},"placeMakerOrderInBatch((uint256,address,address,address,int24,bool,(int24,uint128)[]))":{"returns":{"orderIds":"The unique identifiers of the orders"}},"placeRelativeOrder((uint256,address,address,address,int24,bool,uint128,int160,uint160,uint160))":{"params":{"parameters":"The parameters for the relative order"},"returns":{"orderId":"The unique identifier of the order"}},"refundNativeToken()":{"details":"This method is suitable for the following 2 scenarios: 1. When using exactInput, the inputted Ether is not fully consumed due to insufficient liquidity so,    remaining Ether can be withdrawn through this method 2. When using exactOutput, the inputted Ether is not fully consumed because the slippage settings are too high, henceforth, the remaining Ether can be withdrawn through this method"},"sweepToken(address,uint256,address)":{"details":"The amountMinimum parameter prevents malicious contracts from stealing the token from users","params":{"amountMinimum":"The minimum amount of tokens required for a transfer","recipient":"The destination address of the tokens","token":"The contract address of the tokens which will be transferred to the `recipient`"}},"unwrapWETH9(uint256,address)":{"details":"The amountMinimum parameter prevents malicious contracts from stealing WETH9 from users.","params":{"amountMinimum":"The minimum amount of WETH9 to unwrap","recipient":"The address receiving ETH"}}},"title":"The implementation for the maker order manager","version":1},"userdoc":{"kind":"user","methods":{"createGridAndInitialize((address,address,int24,uint160,address,(int24,uint128)[],(int24,uint128)[]))":{"notice":"Creates the grid and initializes the grid with the given parameters"},"gridexPlaceMakerOrderCallback(uint256,uint256,bytes)":{"notice":"Called to `msg.sender` after executing a place maker order via IGrid#placeMakerOrder"},"initialize((address,address,int24,uint160,address,(int24,uint128)[],(int24,uint128)[]))":{"notice":"Initializes the grid with the given parameters"},"placeMakerOrder((uint256,address,address,address,int24,bool,int24,uint128))":{"notice":"Places a maker order on the grid"},"placeMakerOrderInBatch((uint256,address,address,address,int24,bool,(int24,uint128)[]))":{"notice":"Places maker orders on the grid"},"placeRelativeOrder((uint256,address,address,address,int24,bool,uint128,int160,uint160,uint160))":{"notice":"Places a relative order"},"refundNativeToken()":{"notice":"Refunds any native token(e.g. ETH) balance held by this contract to the `msg.sender`"},"sweepToken(address,uint256,address)":{"notice":"Transfers the full amount of a token held by this contract to a recipient"},"unwrapWETH9(uint256,address)":{"notice":"Unwraps the contract's WETH9 balance and sends it to recipient as ETH."}},"version":1}},"settings":{"compilationTarget":{"contracts/MakerOrderManager.sol":"MakerOrderManager"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100000000},"remappings":[]},"sources":{"@gridexprotocol/