rnalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"oracle","outputs":[{"internalType":"contract IOracle","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"pnl","outputs":[{"internalType":"contract IPnL","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"pnlDistribution","outputs":[{"internalType":"uint256[2]","name":"newTrancheBalances","type":"uint256[2]"},{"internalType":"int256","name":"profit","type":"int256"},{"internalType":"int256","name":"loss","type":"int256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_newGTranche","type":"address"}],"name":"prepareMigration","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"contract IPnL","name":"_pnl","type":"address"}],"name":"setPnL","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_newThreshold","type":"uint256"}],"name":"setUtilisationThreshold","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"tokenBalances","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bool","name":"","type":"bool"}],"name":"trancheBalances","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"utilisation","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"utilisationThreshold","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"_amount","type":"uint256"},{"internalType":"uint256","name":"_index","type":"uint256"},{"internalType":"bool","name":"_tranche","type":"bool"},{"internalType":"address","name":"_recipient","type":"address"}],"name":"withdraw","outputs":[{"internalType":"uint256","name":"yieldTokenAmounts","type":"uint256"},{"internalType":"uint256","name":"calcAmount","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{"deposit(uint256,uint256,bool,address)":{"details":"this function will revert if a senior tranche deposit makes the utilisation     exceed the utilisation ratio","params":{"_amount":"amount of yield token user deposits","_index":"index of yield token deposited","_recipient":"recipient of tranche tokens","_tranche":"tranche user wishes to go into"},"returns":{"calcAmount":"value of tranche token in common denominator (USD)","trancheAmount":"amount of tranche tokens minted"}},"finalizeMigration()":{"details":"Updates the state of the tranche post migration.     This function should ultimately be removed"},"getTrancheToken(bool)":{"params":{"_tranche":"boolean representation of tranche token"},"returns":{"trancheToken":"senior or junior tranche"}},"getYieldToken(uint256)":{"details":"this function needs to be modified if the number of tokens is changed","params":{"_index":"index of desired token"},"returns":{"yieldToken":"tranches underlying yield token at index"}},"getYieldTokenDecimals(uint256)":{"details":"this function needs to be modified if the number of tokens is changed","params":{"_index":"index of desired token"},"returns":{"decimals":"token decimals"}},"getYieldTokenValues()":{"details":"this function needs to be modified if the number of tokens is changed","returns":{"values":"Amount of underlying tokens of yield tokens"}},"migrate(address)":{"details":"Assumes same mapping of yield tokens but you can have more at increased indexes     in the new tranche. This function should be behind a timelock.","params":{"_oldGTranche":"address of the old GTranche"}},"migrateFromOldTranche()":{"details":"Can only be run once and is and intermediary step to move assets     from gro-protocol to GSquared. This function is ultimately going to     be removed from newer iterations of this smart contract as it serves     no purpose for new tranches."},"owner()":{"details":"Returns the address of the current owner."},"prepareMigration(address)":{"details":"This should be kept behind a timelock as the address could be any EOA    which could drain funds. This function should ultimately be removed","params":{"_newGTranche":"address of new GTranche"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setPnL(address)":{"params":{"_pnl":"new pnl logic"}},"setUtilisationThreshold(uint256)":{"params":{"_newThreshold":"target utilisation threshold"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"withdraw(uint256,uint256,bool,address)":{"details":"this function will revert if a senior tranche deposit makes the utilisation","params":{"_amount":"amount of tranche tokens to redeem","_index":"index of yield token the user wishes to withdraw","_recipient":"recipient of the yield tokens","_tranche":"tranche user wishes to redeem"},"returns":{"calcAmount":"value of tranche token in common denominator (USD)","yieldTokenAmounts":"amount of underlying tokens withdrawn"}}},"title":"GTranche","version":1},"userdoc":{"kind":"user","methods":{"deposit(uint256,uint256,bool,address)":{"notice":"Handles deposit logic for GTranche:     User deposits underlying yield tokens which values get calculated     to a common denominator used to price the tranches in. This operation     relies on the existence of a relation/oracle module that allows this     contract to establish a relation between the underlying yield tokens.     Any unearned profit will be realized before the tokens are minted,     effectively stopping the user from front-running profit."},"finalizeMigration()":{"notice":"Transfer funds and update Tranches values"},"gTokenTotalAssets()":{"notice":"This function exists to support the older versions of the GToken     return value of underlying token based on caller"},"getTrancheToken(bool)":{"notice":"Get the underlying tranche token by id (bool)"},"getYieldToken(uint256)":{"notice":"Get the underlying yield token by index"},"getYieldTokenDecimals(uint256)":{"notice":"Get the underlying yield tokens decimals by index"},"getYieldTokenValues()":{"notice":"Get values of all underlying yield tokens"},"migrate(address)":{"notice":"Migrate assets from old GTranche to new GTranche"},"migrateFromOldTranche()":{"notice":"Migrates funds from the old gro protocol"},"pnlDistribution()":{"notice":"View of current asset distribution"},"prepareMigration(address)":{"notice":"Set the target for the migration"},"setPnL(address)":{"notice":"Set the pnl logic of the tranche"},"setUtilisationThreshold(uint256)":{"notice":"Set the threshold for when utilisation will prohibit deposit     from the senior tranche, or withdrawals for the junior"},"utilisation()":{"notice":"Get the current utilisation ratio of the tranche in BP"},"withdraw(uint256,uint256,bool,address)":{"notice":"Handles withdrawal logic:     User redeems an amount of tranche token for underlying yield tokens, any loss/profit     will be realized before the tokens are burned, effectively stopping the user from     front-running losses or lose out on gains when redeeming"}},"notice":"GTranche - Lego block for handling tranching     ###############################################     GTranche Specification     ###############################################     The GTranche provides a novel way for insurance to be implemented on the blockchain,         allowing for users who seek a safer yield opportunity (senior tranche) to do so by         providing part of their deposit as leverage for an insurer (junior tranche). Which         is done by distributing parts of the yield generated by underlying tokens based         on the demand for insurance (utilisation ratio).     This version of the tranche takes advantage of the new tokenized vault standard     (https://eips.ethereum.org/EIPS/eip-4626) and acts as a wrapper for 4626 token in     order to generate and distribute yield.     This contract is one part of two required to define a tranche:         1) GTranche module - defines a set of tokens, and handles accounting             and yield distribution between the Senior and Junior tranche.         2) oracle/relation module - defines the relation between the tokens in             the tranche     The following logic is covered in the GTranche contract:         - Deposit:             - User deposits takes an EIP-4626 token and evaluates it to a common denominator,                which indicates the value of their deposit and the number of tranche tokens                that get minted         - Withdrawal:             - User withdrawals takes tranche tokens and evaluates their value to EIP-4626 tokens,                which indicates the number of tokens that should be returned to the user                on withdrawal         - PnL:             - User interactions evaluates the latest price per share of the underlying                4626 compatible tokens, effectively handling front-running of gains/losses.                Its important that the underlying EIP-4626 cannot be price manipulated, as this                would break the pnl functionality of this contract.","version":1}},"settings":{"compilationTarget":{"GTranche.sol":"GTranche"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"Address.sol":{"keccak256":"0x2ccf9d2313a313d41a791505f2b5abfdc62191b5d4334f7f7a82691c088a1c87","license":"MIT","urls":["bzz-raw://b3a57d0854b2fdce6ebff933a48dca2445643d1eccfc27f00292e937f26c6a58","dweb:/ipfs/QmW45rZooS9TqR4YXUbjRbtf2Bpb5ouSarBvfW1LdGprvV"]},"Constants.sol":{"keccak256":"0x779ac39da628f19d36a81d6e8a43d0f7e69b7f29be63936f3406591344b4888a","license":"AGPLv3","urls":["bzz-raw://a768f7dc30cb2cc41482529048b0ce726c9d7745a64473c6a6817df0c9df17e9","dweb:/ipfs/QmWeKiVHmRMLPH5RndMTorxvaF5GKVYGD9jsihgGNHdwdq"]},"Context.sol":{"keccak256":"0xe2e337e6dde9ef6b680e07338c493ebea1b5fd09b43424112868e9cc1706bca7","license":"MIT","urls":["bzz-raw://6df0ddf21ce9f58271bdfaa85cde98b200ef242a05a3f85c2bc10a8294800a92","dweb:/ipfs/QmRK2Y5Yc6BK7tGKkgsgn3aJEQGi5aakeSPZvS65PV8Xp3"]},"ERC20.sol":{"keccak256":"0x5c52dda5cb918fc6815f321a9c2a328dd38d5cb811e39cb6ed5847388e0f7af6","license":"AGPL-3.0-only","urls":["bzz-raw://573c85b979ecf3050abf30ca89e98fff2ea563eab9556e89c9f16fd6bf67c6fa","dweb:/ipfs/Qmc1pRDHxxiiAAQKDybjqyCzttRh4C3Cs5nSctiz8bwXDS"]},"ERC4626.sol":{"keccak256":"0xe8ffd5df333a80f08cf1aaff7434a5d5d4af7ad27c9d40e43910fd5e0c14e712","license":"MIT","urls":["bzz-raw://0abcee4410340b02db04eaf303c45e52b71d3494d7923374d1ac06697ef7ef8b","dweb:/ipfs/QmQuVHEXk6hYCfZafBDQrty43i42moWNNrf5NExE6QLbFs"]},"Errors.sol":{"keccak256":"0xb38c20b6f14e609bbe02f8eee43df74a6bf7e400ac603c1cc53ff94b043fe3db","license":"AGPLv3","urls":["bzz-raw://d08224b80cbc0d9d34caa34211e2515a9d6e11b7274caf2cfad7372374cd342f","dweb:/ipfs/QmfCo4d1QSNzCKEN7aUBAoMPhFPweL2wHJqwwbmRbxXkJE"]},"FixedTokensCurve.sol":{"keccak256":"0xed94c22522a2a4bd786159fb6199473db01fe