":"recipient","type":"address"}],"name":"withdrawSingleByExchange","outputs":[{"internalType":"uint256","name":"usdAmount","type":"uint256"},{"internalType":"uint256","name":"balance","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"i","type":"uint256"},{"internalType":"uint256","name":"minAmount","type":"uint256"},{"internalType":"address","name":"recipient","type":"address"}],"name":"withdrawSingleByLiquidity","outputs":[{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{"approveVaults(uint256)":{"params":{"index":"Index of vaultAdaptors underlying asset"}},"depositStable(bool)":{"params":{"rebalance":"Is the deposit for a rebalance Y/N"}},"distributeCurveVault(uint256,uint256[3])":{"params":{"amount":"Amount to pull out","delta":"Distribution of assets to vaults (%BP)"}},"invest(uint256,uint256[3])":{"params":{"delta":"Target distribution of investment (%BP)","depositAmount":"LP amount to invest"}},"investSingle(uint256[3],uint256,uint256)":{"details":"i and j represent the two least exposed vaults, any invested assets     targeting the most exposed vault will be exchanged for i, the least     exposed asset.","params":{"i":"Index of target stablecoin/vault","inAmounts":"Stable coin amounts","j":"Index of target stablecoin/vault"}},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setInvestToCurveThreshold(uint256)":{"params":{"_investToCurveThreshold":"New invest threshold"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"withdrawSingleByExchange(uint256,uint256,address)":{"details":"withdrawSingle Swaps available assets in the lifeguard into target assets        using the Curve exhange function. This asset is then sent to target recipient","params":{"i":"Index of token to exchange to","minAmount":"Acceptable minimum amount of token to recieve","recipient":"Recipient of assets"}},"withdrawSingleByLiquidity(uint256,uint256,address)":{"details":"withdrawSingle Swaps available assets in the lifeguard into target assets        using the Curve exhange function. This asset is then sent to target recipient","params":{"i":"Token index","minAmount":"Acceptable minimum amount of token to recieve","recipient":"Recipient of assets"}}},"version":1},"userdoc":{"kind":"user","methods":{"approveVaults(uint256)":{"notice":"Approve vault adaptor to pull from lifeguard"},"assets(uint256)":{"notice":"Mapping of asset amounts in lifeguard (DAI, USDC, USDT)"},"availableLP()":{"notice":"Total available (not reserved for Curve vault) assets held by contract (denoted in LP tokens)"},"ctrlPaused()":{"notice":"Returns true if the contract is paused, and false otherwise"},"deposit()":{"notice":"Deposit assets into Curve pool"},"depositStable(bool)":{"notice":"Deposit lifeguards stablecoins into Curve pool"},"distributeCurveVault(uint256,uint256[3])":{"notice":"Pull out and redistribute Curve vault assets (3Crv) to underlying stable vaults"},"getBuoy()":{"notice":"Return underlying buoy"},"invest(uint256,uint256[3])":{"notice":"Deposit into underlying vaults"},"investSingle(uint256[3],uint256,uint256)":{"notice":"Invest target stablecoins into specified vaults. The two     specified vaults, i and j should represent the least and second least     exposed vaults. This function will exchanges any unwanted stablecoins     (most exposed) to the least exposed vaults underlying asset (i)."},"investToCurveVault()":{"notice":"Invest assets into Curve vault"},"investToCurveVaultTrigger()":{"notice":"Check if lifeguard is ready to invest into the Curve vault"},"setDependencies()":{"notice":"Approve the wihtdrawHandler to pull from lifeguard"},"setInvestToCurveThreshold(uint256)":{"notice":"Set the upper limit to the amount of assets the lifeguard will     hold on to before signaling that an invest to Curve action is necessary."},"withdrawSingleByExchange(uint256,uint256,address)":{"notice":"Exchange underlying assets into one token"},"withdrawSingleByLiquidity(uint256,uint256,address)":{"notice":"Withdraw single asset from Curve pool"}},"notice":"Contract for interactions with curve3pool     Handles asset swapping and investment into underlying vaults for larger deposits.         The lifeguard also handles interaction with any Curve pool token vaults (currently 3Crv),         This vault is treated specially as it causes exposures against all three stablecoins:             1) Large deposits that go through the lifeguard on their way into the vault adapters                 may have a set percentage of their assets left in the lifeguard for later deposit into                 the Curve vault - This is a binary action determined by the current Curve exposure.             2) Withdrawals will only happen from the Curve vault in edge cases - when withdrawal is                 greater than total amount of assets in stablecoin vaults.             3) The lifeguard can pull out assets from the Curve vault and redistribute it to the                 underlying stablecoin vaults to avoid overexposure.     In addition the lifeguard allows the system to toggle additional price checks on     each deposit/withdrawal (see buoy for more details)","version":1}},"settings":{"compilationTarget":{"LifeGuard3Pool.sol":"LifeGuard3Pool"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"LifeGuard3Pool.sol":{"keccak256":"0x4ccd