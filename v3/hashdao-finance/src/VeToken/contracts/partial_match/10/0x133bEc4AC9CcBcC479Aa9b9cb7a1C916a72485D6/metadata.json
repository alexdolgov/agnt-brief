],"name":"setWhitelist","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"symbol","outputs":[{"internalType":"string","name":"","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"token","outputs":[{"internalType":"contract IERC20","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"totalSupply","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"unpause","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"unstakeNft","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"users","outputs":[{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"uint256","name":"lastRelease","type":"uint256"},{"internalType":"uint256","name":"stakedNftId","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"whitelist","outputs":[{"internalType":"contract Whitelist","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"_amount","type":"uint256"}],"name":"withdraw","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{"balanceOf(address)":{"details":"explicity override multiple inheritance"},"claimable(address)":{"params":{"_addr":"the address to check"},"returns":{"_0":"amount of vePTP that can be claimed by user"}},"decimals()":{"details":"Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5.05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overridden; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"deposit(uint256)":{"params":{"_amount":"the amount of token to deposit"}},"getStakedNft(address)":{"params":{"_addr":"the addres of the nft staker"},"returns":{"_0":"id of the staked nft by _addr user if the user haven't stake any nft, tx reverts"}},"getStakedToken(address)":{"params":{"_addr":"the user address to check"},"returns":{"_0":"staked amount of token"}},"getVotes(address)":{"details":"votes should only count if account has > threshold% of current cap reachedinvVoteThreshold = (1/threshold%)*100","returns":{"_0":"the valid votes"}},"isUser(address)":{"params":{"_addr":"the user address to check"},"returns":{"_0":"true if the user has token in stake, false otherwise"}},"name()":{"details":"Returns the name of the token."},"owner()":{"details":"Returns the address of the current owner."},"pause()":{"details":"pause pool, restricting certain operations"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setGenerationRate(uint256)":{"params":{"_generationRate":"the new max ratio"}},"setInvVoteThreshold(uint256)":{"params":{"_invVoteThreshold":"the new var Formula is invVoteThreshold = (1 / th) * 100"}},"setMasterChef(address)":{"params":{"_masterchef":"the new masterchef address"}},"setMaxCap(uint256)":{"params":{"_maxCap":"the new max ratio"}},"setNftAddress(address)":{"params":{"_nft":"the new NFT contract address"}},"setWhitelist(address)":{"params":{"_whitelist":"the new whitelist address"}},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"explicity override multiple inheritance"},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"unpause()":{"details":"unpause pool, enabling certain operations"},"withdraw(uint256)":{"params":{"_amount":"the amount of token to unstake Note Beware! you will loose all of your vePTP if you unstake any amount of token!"}}},"stateVariables":{"ERC721_RECEIVED":{"details":"Magic value for onERC721Received Equals to bytes4(keccak256(\"onERC721Received(address,address,uint256,bytes)\"))"},"invVoteThreshold":{"details":"inverse of the threshold to apply. Example: th = 5% => (1/5) * 100 => invVoteThreshold = 20 Example 2: th = 3.03% => (1/3.03) * 100 => invVoteThreshold = 33 Formula is invVoteThreshold = (1 / th) * 100"},"whitelist":{"details":"contract addresses are by default unable to stake token, they must be previously whitelisted to stake token "}},"title":"VeToken","version":1},"userdoc":{"events":{"Staked(address,uint256)":{"notice":"events describing staking, unstaking and claiming"},"StakedNft(address,uint256)":{"notice":"events describing NFT staking and unstaking"}},"kind":"user","methods":{"claim()":{"notice":"claims accumulated vePTP"},"claimable(address)":{"notice":"Calculate the amount of vePTP that can be claimed by user"},"deposit(uint256)":{"notice":"deposits PTP into contract"},"generationRate()":{"notice":"the rate of veToken generated per second, per token staked"},"getStakedNft(address)":{"notice":"gets id of the staked nft"},"getStakedToken(address)":{"notice":"returns staked amount of token for user"},"getVotes(address)":{"notice":"get votes for vePTP"},"invVoteThreshold()":{"notice":"invVvoteThreshold threshold.voteThreshold is the tercentage of cap from which votes starts to count for governance proposals."},"isUser(address)":{"notice":"checks wether user _addr has token staked"},"masterchef()":{"notice":"the masterchef contract"},"maxCap()":{"notice":"max veToken to staked token ratio Note if user has 10 token staked, they can only have a max of 10 * maxCap veToken in balance"},"nft()":{"notice":"the NFT contract"},"onERC721Received(address,address,uint256,bytes)":{"notice":"This function is called when users stake NFTs When Platypus NFT sent via safeTransferFrom(), we regard this action as staking the NFT Note that transferFrom() is ignored by this function"},"setGenerationRate(uint256)":{"notice":"sets generation rate"},"setInvVoteThreshold(uint256)":{"notice":"sets invVoteThreshold"},"setMasterChef(address)":{"notice":"sets masterPlatpus address"},"setMaxCap(uint256)":{"notice":"sets maxCap"},"setNftAddress(address)":{"notice":"sets NFT contract address"},"setWhitelist(address)":{"notice":"sets whitelist address"},"token()":{"notice":"the toen token"},"unstakeNft()":{"notice":"unstakes current user nft"},"users(address)":{"notice":"user info mapping"},"whitelist()":{"notice":"whitelist wallet checker"},"withdraw(uint256)":{"notice":"withdraws staked token"}},"notice":"Platypus Venom: the staking contract for PTP, as well as the token used for governance. Note Venom does not seem to hurt the Platypus, it only makes it stronger. Allows depositing/withdraw of token and staking/unstaking ERC721. Here are the rules of the game: If you stake token, you generate veToken at the current `generationRate` until you reach `maxCap` If you unstake any amount of token, you loose all of your veToken. ERC721 staking does not affect generation nor cap for the moment, but it will in a future upgrade. Note that it's ownable and the owner wields tremendous power. The ownership will be transferred to a governance smart contract once Platypus is sufficiently distributed and the community can show to govern itself.","version":1}},"settings":{"comp