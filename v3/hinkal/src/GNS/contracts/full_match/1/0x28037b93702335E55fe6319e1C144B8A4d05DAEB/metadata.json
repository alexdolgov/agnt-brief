","name":"_nSignalIn","type":"uint256"}],"name":"nSignalToTokens","outputs":[{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint256","name":"_subgraphNumber","type":"uint256"},{"internalType":"uint256","name":"_nSignalIn","type":"uint256"}],"name":"nSignalToVSignal","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"nameSignals","outputs":[{"internalType":"uint256","name":"vSignal","type":"uint256"},{"internalType":"uint256","name":"nSignal","type":"uint256"},{"internalType":"bytes32","name":"subgraphDeploymentID","type":"bytes32"},{"internalType":"uint32","name":"reserveRatio","type":"uint32"},{"internalType":"bool","name":"disabled","type":"bool"},{"internalType":"uint256","name":"withdrawableGRT","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"ownerTaxPercentage","outputs":[{"internalType":"uint32","name":"","type":"uint32"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"bytes32","name":"_subgraphDeploymentID","type":"bytes32"},{"internalType":"bytes32","name":"_versionMetadata","type":"bytes32"},{"internalType":"bytes32","name":"_subgraphMetadata","type":"bytes32"}],"name":"publishNewSubgraph","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint256","name":"_subgraphNumber","type":"uint256"},{"internalType":"bytes32","name":"_subgraphDeploymentID","type":"bytes32"},{"internalType":"bytes32","name":"_versionMetadata","type":"bytes32"}],"name":"publishNewVersion","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_controller","type":"address"}],"name":"setController","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint8","name":"_nameSystem","type":"uint8"},{"internalType":"bytes32","name":"_nameIdentifier","type":"bytes32"},{"internalType":"string","name":"_name","type":"string"}],"name":"setDefaultName","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint32","name":"_ownerTaxPercentage","type":"uint32"}],"name":"setOwnerTaxPercentage","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"subgraphs","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint256","name":"_subgraphNumber","type":"uint256"},{"internalType":"uint256","name":"_tokensIn","type":"uint256"}],"name":"tokensToNSignal","outputs":[{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint256","name":"_subgraphNumber","type":"uint256"},{"internalType":"bytes32","name":"_subgraphMetadata","type":"bytes32"}],"name":"updateSubgraphMetadata","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint256","name":"_subgraphNumber","type":"uint256"},{"internalType":"uint256","name":"_vSignalIn","type":"uint256"}],"name":"vSignalToNSignal","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_graphAccount","type":"address"},{"internalType":"uint256","name":"_subgraphNumber","type":"uint256"}],"name":"withdraw","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"details":"The Graph Name System contract provides a decentralized naming system for subgraphs used in the scope of the Graph Network. It translates subgraph names into subgraph versions. Each version is associated with a Subgraph Deployment. The contract has no knowledge of human-readable names. All human readable names emitted in events.","events":{"GRTWithdrawn(address,uint256,address,uint256,uint256)":{"details":"Emitted when a nameCurator withdraws its GRT from a deprecated name signal pool"},"NSignalBurned(address,uint256,address,uint256,uint256,uint256)":{"details":"Emitted when a name curator burns its nSignal, which in turn burns the vSignal, and receives GRT"},"NSignalMinted(address,uint256,address,uint256,uint256,uint256)":{"details":"Emitted when a name curator deposits its vSignal into an nSignal curve to mint nSignal"},"NameSignalDisabled(address,uint256,uint256)":{"details":"Emitted when an nSignal curve has been permanently disabled"},"NameSignalEnabled(address,uint256,bytes32,uint32)":{"details":"Emitted when a graphAccount creates an nSignal bonding curve that points to a subgraph deployment"},"NameSignalUpgrade(address,uint256,uint256,uint256,bytes32)":{"details":"Emitted when a graph account upgrades its nSignal curve to point to a new subgraph deployment, burning all the old vSignal and depositing the GRT into the new vSignal curve, creating new nSignal"},"SetDefaultName(address,uint256,bytes32,string)":{"details":"Emitted when graph account sets its default name"},"SubgraphDeprecated(address,uint256)":{"details":"Emitted when a graph account deprecated one of its subgraphs"},"SubgraphMetadataUpdated(address,uint256,bytes32)":{"details":"Emitted when graph account sets a subgraphs metadata on IPFS"},"SubgraphPublished(address,uint256,bytes32,bytes32)":{"details":"Emitted when a `graph account` publishes a `subgraph` with a `version`. Every time this event is emitted, indicates a new version has been created. The event also emits a `metadataHash` with subgraph details and version details."}},"kind":"dev","methods":{"acceptProxy(address)":{"details":"Accept to be an implementation of proxy."},"acceptProxyAndCall(address,bytes)":{"details":"Accept to be an implementation of proxy and then call a function from the new implementation as specified by `_data`, which should be an encoded function call. This is useful to initialize new storage variables in the proxied contract."},"approveAll()":{"details":"Approve curation contract to pull funds."},"burnNSignal(address,uint256,uint256,uint256)":{"details":"Allow a nameCurator to burn some of its nSignal and get GRT in return","params":{"_graphAccount":"Subgraph owner","_nSignal":"The amount of nSignal the nameCurator wants to burn","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators","_tokensOutMin":"Expected minimum amount of tokens to receive"}},"deprecateSubgraph(address,uint256)":{"details":"Deprecate a subgraph. Can only be done by the graph account owner.","params":{"_graphAccount":"Account that is deprecating the subgraph","_subgraphNumber":"Subgraph number for the account"}},"getCuratorNSignal(address,uint256,address)":{"details":"Get the amount of name signal a curator has on a name pool.","params":{"_curator":"Curator to look up to see n signal balance","_graphAccount":"Subgraph owner","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators"},"returns":{"_0":"Amount of name signal owned by a curator for the name pool"}},"initialize(address,address,address)":{"details":"Initialize this contract."},"isPublished(address,uint256)":{"details":"Return whether a subgraph name is published.","params":{"_graphAccount":"Account being checked","_subgraphNumber":"Subgraph number being checked for publishing"},"returns":{"_0":"Return true if subgraph is currently published"}},"mintNSignal(address,uint256,uint256,uint256)":{"details":"Allow a name curator to mint some nSignal by depositing GRT","params":{"_graphAccount":"Subgraph owner","_nSignalOutMin":"Expected minimum amount of name signal to receive","_subgraphNumber":"Subgraph owners subgraph number","_tokensIn":"The amount of tokens the nameCurator wants to deposit"}},"nSignalToTokens(address,uint256,uint256)":{"details":"Calculate tokens returned for an amount of name signal.","params":{"_graphAccount":"Subgraph owner","_nSignalIn":"Name signal being exchanged for tokens","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators"},"returns":{"_0":"Amount of tokens returned for an amount of nSignal"}},"nSignalToVSignal(address,uint256,uint256)":{"details":"Calculate vSignal to be returned for an amount of name signal.","params":{"_graphAccount":"Subgraph owner","_nSignalIn":"Name signal being exchanged for vSignal","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators"},"returns":{"_0":"Amount of vSignal that can be returned"}},"publishNewSubgraph(address,bytes32,bytes32,bytes32)":{"details":"Allows a graph account to publish a new subgraph, which means a new subgraph number will be used.","params":{"_graphAccount":"Account that is publishing the subgraph","_subgraphDeploymentID":"Subgraph deployment ID of the version, linked to the name","_subgraphMetadata":"IPFS hash for the subgraph metadata","_versionMetadata":"IPFS hash for the subgraph version metadata"}},"publishNewVersion(address,uint256,bytes32,bytes32)":{"details":"Allows a graph account to publish a new version of its subgraph. Version is derived from the occurrence of SubgraphPublished being emitted. The first time SubgraphPublished is called would be Version 0","params":{"_graphAccount":"Account that is publishing the subgraph","_subgraphDeploymentID":"Subgraph deployment ID of the version, linked to the name","_subgraphNumber":"Subgraph number for the account","_versionMetadata":"IPFS hash for the subgraph version metadata"}},"setController(address)":{"params":{"_controller":"Controller contract address"}},"setDefaultName(address,uint8,bytes32,string)":{"details":"Allows a graph account to set a default name","params":{"_graphAccount":"Account that is setting its name","_name":"The name being set as default","_nameIdentifier":"The unique identifier that is used to identify the name in the system","_nameSystem":"Name system account already has ownership of a name in"}},"setOwnerTaxPercentage(uint32)":{"details":"Set the owner fee percentage. This is used to prevent a subgraph owner to drain all the name curators tokens while upgrading or deprecating and is configurable in parts per hundred.","params":{"_ownerTaxPercentage":"Owner tax percentage"}},"tokensToNSignal(address,uint256,uint256)":{"details":"Calculate name signal to be returned for an amount of tokens.","params":{"_graphAccount":"Subgraph owner","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators","_tokensIn":"Tokens being exchanged for name signal"},"returns":{"_0":"Amount of name signal and curation tax"}},"updateSubgraphMetadata(address,uint256,bytes32)":{"details":"Allows a graph account update the metadata of a subgraph they have published","params":{"_graphAccount":"Account that owns the subgraph","_subgraphMetadata":"IPFS hash for the subgraph metadata","_subgraphNumber":"Subgraph number"}},"vSignalToNSignal(address,uint256,uint256)":{"details":"Calculate nSignal to be returned for an amount of vSignal.","params":{"_graphAccount":"Subgraph owner","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators","_vSignalIn":"Amount of vSignal to exchange for name signal"},"returns":{"_0":"Amount of nSignal that can be bought"}},"withdraw(address,uint256)":{"details":"When the subgraph curve is disabled, all nameCurators can call this function and withdraw the GRT they are entitled for its original deposit of vSignal","params":{"_graphAccount":"Subgraph owner","_subgraphNumber":"Subgraph owners subgraph number which was curated on by nameCurators"}}},"title":"GNS","version":1},"userdoc":{"kind":"user","methods":{"setController(address)":{"notice":"Set Controller. Only callable by current controller"}},"version":1}},"settings":{"compilationTarget":{"contracts/discovery/GNS.sol":"GNS"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/math/SafeMath.sol":{"keccak256":"0xba96bc371ba999f452985a98717cca1e4c4abb598dc038a9a9c3db08129b1ba4","license":"MIT","urls":["bzz-raw://26e50e3f7b6482fb6f598f2e006994a74aa492687daa4b3eee7fd4fb5398ce7f","dweb:/ipfs/QmZudqoPSkA4USLMFsBBmt19dDPZFS8aaAmL5R7pECXu6t"]},"@openzeppelin/contracts/token/ERC20/IERC20.sol":{"keccak256":"0xbd74f587ab9b9711801baf667db1426e4a03fd2d7f15af33e0e0d0394e7cef76","license":"MIT","urls":["bzz-raw://2d0913dfbfce90d170df0d496ad7596c0778518e5fa7aba6c32562522546f66b","dweb:/ipfs/QmR6B8nLj2PJf5e1JWD9Nk7ErkAwkqUwadCnvE82FJr1RU"]},"contracts/bancor/BancorFormula.sol":{"keccak256":"0x226c362430ffd624712fe4c7f96706fcbbb474f82716361deb17126d86ed6573","license":"Apache-2.0","urls":["bzz-raw://9319511e2f3f74d46eaab42184e87964fe8c61cb3c60c00194fd1f2ef2c74ecb","dweb:/ipfs/QmYdFrwKHEGa9iVyW1sixmrnys756dpSNoM3rWFmm3rxcc"]},"contracts/curation/ICuration.sol":{"keccak256":"0x47941d5c4e17cdc0844f76cf6e0e0b114d2b5a2ac848c70ccfe0a9b191e67ff5","license":"MIT","urls":["bzz-raw://f740223df4960b08a5d2c6f0803f256b5bb19ffa4467610c7d1375597ef3baac","dweb:/ipfs/QmVTgwmqGqyb1ehfoNwao7h9Q51TnzuVoUdewE2NqKCmfB"]},"contracts/curation/IGraphCurationToken.sol":{"keccak256":"