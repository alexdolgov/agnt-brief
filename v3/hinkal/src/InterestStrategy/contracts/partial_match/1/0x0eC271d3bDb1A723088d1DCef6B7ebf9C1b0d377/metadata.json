"internalType":"uint256","name":"amount","type":"uint256"}],"name":"withdraw","outputs":[{"internalType":"uint256","name":"actualAmount","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"withdrawFees","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{"afterExit(address,uint256,bytes)":{"details":"After exited, the owner can perform ANY call. This is to rescue any funds that didn't get released during exit or got earned afterwards due to vesting or airdrops, etc. "},"harvest(uint256,address)":{"details":"accrue interest and report loss The interest linear interpolation used here is very basic: the more this function is called the smoother the interpolation. Meaning that if we're ramping from 1% to 13% in 30 days and that harvest is called only once on the 15th day, 1% interest will be used for these 15 days and then the next harvest will be around 7%. If we are calling it daily it will smoothly increase by steps of 0.4% (12% / 30 days)"},"safeHarvest(uint256,bool,uint256,bool)":{"details":"maxBalance can be set to 0 to keep the previous value.maxChangeAmount can be set to 0 to allow for full rebalancing.","params":{"harvestRewards":"If we want to claim any accrued reward tokens","maxBalance":"The maximum balance of the underlying token that is allowed to be in BentoBox.","maxChangeAmount":"When rebalancing - the maximum amount that will be deposited to or withdrawn from a strategy to BentoBox.","rebalance":"Whether BentoBox should rebalance the strategy assets to acheive it's target allocation."}},"transferOwnership(address,bool,bool)":{"params":{"direct":"True if `newOwner` should be set immediately. False if `newOwner` needs to use `claimOwnership`.","newOwner":"Address of the new owner.","renounce":"Allows the `newOwner` to be `address(0)` if `direct` and `renounce` is True. Has no effect otherwise."}},"withdraw(uint256)":{"details":"The `actualAmount` should be very close to the amount. The difference should NOT be used to report a loss. That's what harvest is for.","params":{"amount":"The requested amount the caller wants to withdraw."},"returns":{"actualAmount":"The real amount that is withdrawn."}}},"version":1},"userdoc":{"kind":"user","methods":{"claimOwnership()":{"notice":"Needs to be called by `pendingOwner` to claim ownership."},"safeHarvest(uint256,bool,uint256,bool)":{"notice":"Harvest profits while preventing a sandwich attack exploit."},"transferOwnership(address,bool,bool)":{"notice":"Transfers ownership to `newOwner`. Either directly or claimable by the new pending owner. Can only be invoked by the current `owner`."},"withdraw(uint256)":{"notice":"Withdraw assets. The returned amount can differ from the requested amount due to rounding."}},"version":1}},"settings":{"compilationTarget":{"src/strategies/InterestStrategy.sol":"InterestStrategy"},"evmVersion":"london","libraries":{"utils/CauldronLib.sol:CauldronLib":"0x480a0af04186080bac985e595d66ea3bf351eb4d"},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":/=src/",":BoringSolidity/=lib/BoringSolidity/contracts/",":OpenZeppelin/=lib/openzeppelin-contracts/contracts/",":cauldrons/=src/cauldrons/",":ds-test/=lib/forge-std/lib/ds-test/src/",":forge-std/=lib/forge-std/src/",":harvesters/=src/harvesters/",":interfaces/=src/interfaces/",":libraries/=src/libraries/",":mocks/=src/mocks/",":oracles/=src/oracles/",":periphery/=src/periphery/",":strategies/=src/strategies/",":swappers/=src/swappers/",":tokens/=src/tokens/",":utils/=utils/"]},"sources":{"lib/BoringSolidity/contracts/BoringOwnable.sol":{"keccak256":"0x5c95af9d26812f279c232d8908c3e2e4ab5054ec1a76275589be4b40857a281c","license":"MIT","urls":["bzz-raw://73b1d2da3eade6bbe73a7bbcdbd7e956b5cf802b4a12b18506fb43ae119c321c","dweb:/ipfs/QmNoq9bH5gn76mVqmJ17vAkaTpkAqygh7MkvTgbfuV3ku7"]},"lib/BoringSolidity/contracts/interfaces/IERC20.sol"