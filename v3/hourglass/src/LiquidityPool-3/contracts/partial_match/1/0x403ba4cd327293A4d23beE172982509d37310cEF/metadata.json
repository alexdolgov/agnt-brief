ernalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"}],"name":"whitelisted","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_recipient","type":"address"},{"internalType":"uint256","name":"_amount","type":"uint256"}],"name":"withdraw","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"withdrawRequestNFT","outputs":[{"internalType":"contract IWithdrawRequestNFT","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"kind":"dev","methods":{"allocateSourceOfFunds()":{"details":"The LP has two ways of accumulating funds, through eEth staking and through the ether fan page (membership manager).         We want to manipulate which funds we use per deposit. Example, if someone is making 2 deposits, we want to select where the 60 ETH         should come from. The funds will all be held in the LP but we are storing how many validators are spun up per source on the contract.         We simply check which of the sources is below their target allocation and allocate the deposits to it.","returns":{"_0":"The chosen source of funds (EETH or ETHER_FAN)"}},"batchApproveRegistration(uint256[],bytes[],bytes[])":{"details":"This gets called by the Oracle and only when it has confirmed the withdraw credentials of the 1 ETH deposit in the registration         phase match the withdraw credentials stored on the beacon chain. This prevents a front-running attack.","params":{"_pubKey":"The pubKey for each validator being spun up.","_signature":"The signatures for each validator for the 31 ETH transaction that were emitted in the register phase","_validatorIds":"The IDs of the validators to be approved"}},"batchCancelDeposit(uint256[])":{"details":"This is called only in the BNFT player flow","params":{"_validatorIds":"The IDs to be cancelled"}},"batchDepositAsBnftHolder(uint256[],uint256)":{"details":"This function has multiple dependencies that need to be followed before this function will succeed. ","params":{"_candidateBidIds":"validator IDs that have been matched with the BNFT holder on the FE","_numberOfValidators":"how many validators the user wants to spin up. This can be less than the candidateBidIds length.          we may have more Ids sent in than needed to spin up incase some ids fail."},"returns":{"_0":"Array of bids that were successfully processed."}},"batchRegisterAsBnftHolder(bytes32,uint256[],(bytes,bytes,bytes32,string)[],bytes32[],bytes[])":{"details":"This function can only be called by a BNFT player on IDs that have been deposited.  ","params":{"_depositDataRootApproval":"The deposit data roots for each validator for the 31 ETH transaction which will happen in the approval         step. See the Staking Manager for details.","_depositRoot":"This is the deposit root of the beacon chain. Can send in 0x00 to bypass this check in future","_registerValidatorDepositData":"As in the solo staking flow, the BNFT player must send in a deposit data object (see ILiquidityPool for struct data)         to register the validators. However, the signature and deposit data root must be for a 1 ETH deposit","_signaturesForApprovalDeposit":"Much like the deposit data root. This is the signature for each validator for the 31 ETH          transaction which will happen in the approval step.","_validatorIds":"The ids of the validators to register"}},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"deRegisterBnftHolder(address)":{"details":"We allow either the user themselves or admins to remove BNFT players","params":{"_bNftHolder":"Address of the BNFT player to remove"}},"decreaseSourceOfFundsValidators(uint32,uint32)":{"details":"When a user deposits, we increment the number of validators in the allocated source object. However, when a BNFT player cancels          their deposits, we need to decrease this again.","params":{"numberOfEethValidators":"How many eEth validators to decrease","numberOfEtherFanValidators":"How many etherFan validators to decrease"}},"owner()":{"details":"Returns the address of the current owner."},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"registerAsBnftHolder(address)":{"details":"BNFT players reach out to Etherfi externally and then Etherfi will register them","params":{"_user":"The address of the BNFT player to register"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"requestMembershipNFTWithdraw(address,uint256,uint256)":{"details":"Transfers the amount of eETH from MembershipManager to the WithdrawRequestNFT contract & mints an NFT to the recipient","params":{"amount":"requested amount to withdraw from contract","fee":"the burn fee to be paid by the recipient when the withdrawal is claimed (WithdrawRequestNFT.claimWithdraw)","recipient":"address that will be issued the NFT"},"returns":{"_0":"uint256 requestId of the WithdrawRequestNFT"}},"requestWithdraw(address,uint256)":{"details":"Transfers the amount of eETH from msg.senders account to the WithdrawRequestNFT contract & mints an NFT to the msg.sender","params":{"amount":"requested amount to withdraw from contract","recipient":"address that will be issued the NFT"},"returns":{"_0":"uint256 requestId of the WithdrawRequestNFT"}},"requestWithdrawWithPermit(address,uint256,(uint256,uint256,uint8,bytes32,bytes32))":{"details":"accepts PermitInput signed data to approve transfer of eETH (EIP-2612) so withdraw request can happen in 1 tx","params":{"_amount":"requested amount to withdraw from contract","_owner":"address that will be issued the NFT","_permit":"signed permit data to approve transfer of eETH"},"returns":{"_0":"uint256 requestId of the WithdrawRequestNFT"}},"setNumValidatorsToSpinUpInBatch(uint128)":{"params":{"_newSize":"the number to set it to"}},"setStakingTargetWeights(uint32,uint32)":{"details":"Fund sources are different ways where the LP receives funds. Currently, there is just through EETH staking and ETHER_FAN (membership manager)","params":{"_eEthWeight":"The target weight for eEth","_etherFanWeight":"The target weight for EtherFan"}},"sharesForWithdrawalAmount(uint256)":{"details":"withdrawal rounding errors favor the protocol by rounding up"},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateAdmin(address,bool)":{"params":{"_address":"the new address to set as admin"}},"upgradeTo(address)":{"details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"withdraw(address,uint256)":{"details":"Burns user balance from msg.senders account & Sends equal amount of ETH back to the recipient","params":{"_amount":"the amount to withdraw from contract i