256","name":"_maxDiff","type":"int256"}],"name":"checkDiffAbs","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"int256","name":"_minBps","type":"int256"},{"internalType":"int256","name":"_maxBps","type":"int256"}],"name":"checkDiffRel","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"saveAssets","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"savedAssetsBlock","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"savedAssetsValue","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"}],"devdoc":{"details":"this contract uses 0 decimals of precision and bps (1/10_000) for the checks, so that values are more human readable.","kind":"dev","methods":{"checkDiffAbs(int256,int256)":{"details":"use this in the following scenarios: Example 1: you expect no changes, you can call checkDiffAbs(0, 0) to ensure that there is no change in assets. Example 2: you expect to lose 100$, and want to revert if the loss is greater than 110$, then you can call checkDiffAbs(-110, 0). This will also revert if there is an unexpected gain. Example 3: you expect to gain 100$, and want to revert if the profit is less than 90$, then you can call checkDiffAbs(90, 200). This will also revert if there is an unexpected gain greater than 200$.","params":{"_maxDiff":"the maximum difference in dollars (0 decimals)"}},"checkDiffRel(int256,int256)":{"params":{"_maxBps":"maximum basis points of difference (1/10_000) Example 1: you want to revert if the loss is more than 0.3%, then you can call checkDiffRel(-30, 0). This will also revert if there is an unexpected gain. Example 2: you want to revert if the gain is less than 0.3%, then you can call checkDiffRel(30, 100). This will also revert if there is an unexpected gain greater than 1%.","_minBps":"minimum basis po