)":{"params":{"asset":"The address of the disabled asset token","timestamp":"The block timestamp when the asset was disabled"}},"AssetEnabled(uint256,address)":{"params":{"asset":"The address of the enabled asset token","timestamp":"The block timestamp when the asset was enabled"}},"Paused(address)":{"details":"Emitted when the pause is triggered by `account`."},"Unpaused(address)":{"details":"Emitted when the pause is lifted by `account`."}},"kind":"dev","methods":{"assetTokens()":{"details":"MUST include the assetToken of the farmMUST only include tokens that can be freely airdropped to the farm while being accounted properly in the assets() function","returns":{"_0":"Array of supported asset token addresses"}},"assets()":{"details":"Small override because MultiAssetFarmV2.assets() includes the balance of the USDC & syrupUSDC, but not the syrupUSDC that is pending redemption.","returns":{"_0":"Total value of all assets in terms of the primary assetToken"}},"convert(address,address,uint256)":{"params":{"_amountIn":"The amount of input tokens to convert","_tokenIn":"The input token address","_tokenOut":"The output token address"},"returns":{"_0":"The equivalent amount of output tokens"}},"deposit()":{"details":"Note that in airdrops we do not know the amount of assets before the deposit, therefore we emit an event that contains twice the assets after the deposit"},"disableAssets(address[])":{"params":{"_assetList":"Array of asset token addresses to disable"}},"enableAssets(address[])":{"params":{"_assetList":"Array of asset token addresses to enable"}},"isAssetSupported(address)":{"params":{"_asset":"The asset token address to check"},"returns":{"_0":"True if the asset is supported, false otherwise"}},"liquidity()":{"returns":{"_0":"The balance of the primary assetToken held by the farm"}},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"setCore(address)":{"params":{"newCore":"to reference"}},"vaultDepositAuthorized(uint256)":{"params":{"_amount":"The amount of USDC to deposit."},"returns":{"_0":"The number of syrupUSDC shares minted to the farm."}},"vaultRequestRedeem(uint256)":{"params":{"_shares":"The amount of syrupUSDC shares to request for redemption."},"returns":{"_0":"The amount of shares escrowed in the withdrawal manager for processing."}},"withdraw(uint256,address)":{"params":{"amount":"The amount of assetToken to withdraw","to":"The address to send the withdrawn tokens to"}},"withdrawSecondaryAsset(address,uint256,address)":{"params":{"_amount":"The amount of the asset to withdraw","_asset":"The address of the asset token to withdraw","_to":"The address to send the withdrawn tokens to"}}},"title":"MapleFarm","version":1},"userdoc":{"errors":{"InvalidAsset(address)":[{"notice":"Thrown when an invalid asset address is provided"}],"InvalidBalance(address,uint256)":[{"notice":"Thrown when trying to disable an asset with non-zero balance"}],"InvalidFarm(address)":[{"notice":"Thrown when an invalid farm address is provided"}],"InvalidLength()":[{"notice":"Thrown when an invalid array length is provided"}],"InvalidOracle(address)":[{"notice":"Thrown when an asset doesn't have a valid oracle"}]},"events":{"AssetDisabled(uint256,address)":{"notice":"Emitted when an asset is disabled for the farm"},"AssetEnabled(uint256,address)":{"notice":"Emitted when a new asset is enabled for the farm"},"AssetsUpdated(uint256,uint256,uint256)":{"notice":"emitted when there is a deposit of withdrawal from the farm"},"CoreUpdate(address,address)":{"notice":"emitted when the reference to core is updated"}},"kind":"user","methods":{"ASSET_REMOVAL_THRESHOLD()":{"notice":"Base amount of assets required to prevent removal without decimals"},"accounting()":{"notice":"Reference to the accounting contract used for price oracles and asset management"},"assetToken()":{"notice":"the asset used by deposits and withdrawals in the farm"},"assetTokens()":{"notice":"Returns the list of asset tokens that the farm can hold"},"assets()":{"notice":"Returns the total value of all assets held by the farm in terms of the primary assetToken"},"cap()":{"notice":"cap on the amount of assets that can be deposited into the farm"},"convert(address,address,uint256)":{"notice":"Converts a number of tokens to another token based on oracle rates"},"core()":{"notice":"address of the Core contract referenced"},"deposit()":{"notice":"Deposits assets into the farm (used for airdrops)"},"disableAssets(address[])":{"notice":"Disables a set of assets that are no longer required by this farm"},"emergencyAction((address,uint256,bytes)[])":{"notice":"due to inflexibility of current smart contracts, add this ability to be able to execute arbitrary calldata against arbitrary addresses. callable only by governor"},"enableAssets(address[])":{"notice":"Enables a set of assets that will be reported by this farm"},"isAssetSupported(address)":{"notice":"Checks if the farm can hold the given asset token"},"liquidity()":{"notice":"Returns the current liquidity of the farm (held reference assetToken)"},"maxDeposit()":{"notice":"Returns the max deposit amount for the underlying protocol"},"maxSlippage()":{"notice":"Max slippage for depositing and witdhrawing assets from the farm."},"pause()":{"notice":"set pausable methods to paused"},"setCap(uint256)":{"notice":"set the deposit cap of the farm"},"setCore(address)":{"notice":"WARNING CALLING THIS FUNCTION CAN POTENTIALLY BRICK A CONTRACT IF CORE IS SET INCORRECTLYset new reference to core only callable by governor"},"setMaxSlippage(uint256)":{"notice":"set the max tolerated slippage for depositing and witdhrawing assets from the farm"},"unpause()":{"notice":"set pausable methods to unpaused"},"vaultDepositAuthorized(uint256)":{"notice":"Deposit USDC held by the farm into syrupUSDC via the Maple router."},"vaultRequestRedeem(uint256)":{"notice":"Request redemption of syrupUSDC shares back to USDC through the Maple withdrawal queue."},"withdraw(uint256,address)":{"noti