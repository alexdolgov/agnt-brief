ls":"the recipient can be: - address(0) to distribute the excess as yield normally, - stakedToken to distribute the excess as yield to siUSD holders, - lockingModule to distribute the excess as yield to liUSD holders, - or any other address to send the excess to.note that yield distributed through this function is ignoring the performance fee","params":{"_recipient":"The recipient of the excess safety buffer"}},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"setCore(address)":{"params":{"newCore":"to reference"}},"setInterpolationDuration(uint256)":{"details":"Note that the rate of distribution will only change after the next accrue() call that is distributing a non-zero amount of rewards to the staked users."},"setSafetyBufferSize(uint256)":{"params":{"_safetyBufferSize":"the new safety buffer size"}},"unaccruedYield()":{"details":"Note that yield can be negative if the protocol farms have lost value, or if the oracle price of assets held in the protocol has decreased since last accrue() call, or if more ReceiptTokens entered circulation than assets entered the protocol.","returns":{"_0":"yield as an amount of receiptTokens."}}},"version":1},"userdoc":{"events":{"CoreUpdate(address,address)":{"notice":"emitted when the reference to core is updated"},"YieldAccrued(uint256,int256)":{"notice":"Fired when yield is accrued from frarms"}},"kind":"user","methods":{"accounting()":{"notice":"reference to farm accounting contract"},"canEnterOrExitStakedToken()":{"notice":"Make deposits and withdrawals in the staked token revert unless set to true."},"core()":{"notice":"address of the Core contract referenced"},"emergencyAction((address,uint256,bytes)[])":{"notice":"due to inflexibility of current smart contracts, add this ability to be able to execute arbitrary calldata against arbitrary addresses. callable only by governor"},"escrow()":{"notice":"escrow of rewards to staked users"},"flushExcessSafetyBuffer(address,uint256)":{"notice":"flush the excess safety buffer"},"initialize(address,address,address,address,address,address)":{"notice":"initializer for deployment behind a proxy"},"interpolationDuration()":{"notice":"interpolation duration of rewards to staked users"},"liquidReturnMultiplier()":{"notice":"multiplier for the liquid return, expressed as a percentage with 18 decimals."},"lockingModule()":{"notice":"reference to locking module"},"pause()":{"notice":"set pausable methods to paused"},"performanceFee()":{"notice":"optional performance fee, expressed as a percentage with 18 decimals."},"performanceFeeRecipient()":{"notice":"optional performance fee recipient"},"point()":{"notice":"point used for interpolating rewards of the staked users"},"receiptToken()":{"notice":"reference to receipt token"},"safetyBufferSize()":{"notice":"safety buffer amount. This amount of iUSD is held on the contract and consumed first in case of losses smaller than the safety buffer. It is also replenished first in case of profit, up to the buffer size. The buffer held could exceed safetyBufferSize if there are donations to this contract, or if the buffer size has been reduced since last profit distribution, or if there are no other users to distribute to. The safety buffer is meant to absorb small losses such as slippage or fees when deploying capital to productive farms. safety buffer can be emptied by governance through the use of emergencyAction()."},"setCore(address)":{"notice":"WARNING CALLING THIS FUNCTION CAN POTENTIALLY BRICK A CONTRACT IF CORE IS SET INCORRECTLYset new reference to core only callable by governor"},"setInterpolationDuration(uint256)":{"notice":"set the interpolation duration of StakedToken rewards"},"setLiquidReturnMultiplier(uint256)":{"notice":"set the liquid return multiplier"},"setPerformanceFeeAndRecipient(uint256,address)":{"notice":"set the performance fee and recipient"},"setSafetyBufferSize(uint256)":{"notice":"set the safety buffer size"},"setTargetIlliquidRatio(uint256)":{"notice":"set the target illiquid ratio"},"stakedToken()":{"notice":"reference to staked token"},"targetIlliquidRatio()":{"notice":"target illiquid ratio, expressed as a percentage with 18 decimals. This ratio is the minimum percent of illiquid holdings the protocol is targetting, and if there is a percentage of illiquid users lower than the targetIlliquidRatio, the protocol wil distribute additional rewards to the illiquid users until targetIlliquidRatio is reached."},"unaccruedYield()":{"notice":"returns the yield earned by the protocol since the last accrue() call."},"unpause()":{"notice":"set pausable methods to unpaused"},"vested()":{"notice":"Number of rewards vested to staked users"},"vesting()":{"notice":"Number of rewards interpolating to staked users"}},"notice":"InfiniFi YieldSharing contract V3 this V3 allows the reuse of an existing escrow, adds access control to the accrue() function, and adds a function to flush the excess safety buffer.","version":1}},"settings":{"compilationTarget":{"src/finance/YieldSharingV3.sol":"YieldSharingV3"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":400},"remappings":[":@chainlink/=lib/chainlink-ccip/chains/evm/",":@chainlink/local/=lib/chainlink-local/",":@core/=src/core/",":@cowprotocol/=lib/cowprotocol/src/",":@deployment/=deployment/",":@finance/=src/finance/",":@forge-std/=lib/forge-std/src/",":@funding/=src/funding/",":@gateway/=src/gateway/",":@governance/=src/governance/",":@integrations/=src/integrations/",":@interfaces/=src/interfaces/",":@layerzerolabs/lz-evm-messagelib-v2/=lib/LayerZero-v2/packages/layerzero-v2/evm/messagelib/",":@layerzerolabs/lz-evm-oapp-v2/=lib/LayerZero-v2/packages/layerzero-v2/evm/oapp/",":@layerzerolabs/lz-evm-protocol-v2/=lib/LayerZero-v2/packages/layerzero-v2/evm/protocol/",":@libraries/=src/libraries/",":@locking/=src/locking/",":@openzeppelin/=lib/openzeppelin-contracts/",":@pendle/=lib/pendle-core-v2-public/contracts/",":@pe