ex":"- withdrawal request(index) from which the funds were taken","token":"- address of the token"}},"Initialized(uint64)":{"details":"Triggered when the contract has been initialized or reinitialized."},"Release(address,address,uint256,uint8)":{"params":{"amount":"- amount of token released","client":"- address of the user to whom funds are released","index":"- withdrawal request(index) that was released","token":"- address of the token released"}},"ReleaseLockSet(uint32)":{"params":{"interval":"- the amount of time in seconds which user has to wait between {withdraw()} and {release()}"}},"TradeLockSet(uint32)":{"params":{"interval":"- the amount of time in seconds during which user's funds  can still be used for trading after {withdraw()} request"}},"Upgraded(address)":{"details":"Emitted when the implementation is upgraded."},"Withdraw(address,address,uint256,uint8)":{"details":"Each user is only allowed to make 5 withdrawal requests at once.","params":{"amount":"- amount to be withdrawn","client":"- address of a user withdrawing","index":"- withdrawal request(index)","token":"- address of token"}}},"kind":"dev","methods":{"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"deposit(address,address,uint256)":{"params":{"amount":"- amount to deposit","client":"- address of depositor","token":"- address of token"}},"fundsToWithdraw(address,address,uint8)":{"params":{"client":"- address of the client who sent withdrawal request(s)","index":"- index of the particular withdrawal request (max of 5)","token":"- address of the token withdrawn"},"returns":{"timestamp":"- timestamp of the exact time withdrawal request was submitted","value":"- the amount of funds marked for withdrawal"}},"fundsToWithdrawTotal(address,address)":{"params":{"client":"- address of the user to get balance for","token":"- address of the token to get balance for"},"returns":{"_0":"total amount of client's funds marked for withdrawal"}},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"release(address,uint8)":{"details":"release lock should not be active","params":{"index":"- index in the withdrawal queue","token":"- address of the token to be released"}},"updateBalances(address[],address[],int256[],uint64)":{"details":"can only be called by ledger contracts","params":{"amounts":"- array of amounts of funds to update client balances with","backendId":"- identificator created by Ithaca Backend to track settlement progress","clients":"- array of all client accounts of the settlement batch","tokens":"- array of token addresses for each update row"}},"upgradeToAndCall(address,bytes)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"withdraw(address,uint256)":{"details":"Withdrawal in queue can be utilised for trades if balance in fundlock is insufficient and trade lock is active,","params":{"amount":"- amount to withdraw","token":"- address of token"}}},"title":"Fundlock","version":1},"userdoc":{"events":{"BalancesUpdated(address[],address[],int256[],uint64)":{"notice":"Event fired upon successful client balance update, which signifies the end of the settlement transaction."},"Deposit(address,address,uint256)":{"notice":"Emitted upon successful deposit"},"FundedFromWithdrawal(address,address,uint256,uint256)":{"notice":"Event fired when funds are taken from user's withdrawal queue when user balance is not sufficient to settle the trade."},"Release(address,address,uint256,uint8)":{"notice":"Event fired upon releasing funds (tokens) from Fundlock to a user's wallet."},"ReleaseLockSet(uint32)":{"notice":"Event fired upod setting the {ReleaseLock} interval."},"TradeLockSet(uint32)":{"notice":"Event fired upod setting the {TradeLock} interval."},"Withdraw(address,address,uint256,uint8)":{"notice":"Emitted when funds are added to withdrawal queue"}},"kind":"user","methods":{"balanceSheet(address,address)":{"notice":"Returns the amount of tokens owned by `client`."},"deposit(address,address,uint256)":{"notice":"Function to deposit tokens, to be used in Ithaca"},"fundsToWithdraw(address,address,uint8)":{"notice":"Getter used to pull data about client's withdraw requests."},"fundsToWithdrawTotal(address,address)":{"notice":"Returns the total amount of token flagged for withdrawal for a particular user  that still has active {tradeLock}. This is the SUM of all withdraw requests for a particular token and user."},"release(address,uint8)":{"notice":"Function to release funds after withdrawal request"},"updateBalances(address[],address[],int256[],uint64)":{"notice":"Function to update clients balances"},"withdraw(address,uint256)":{"notice":"Function to add funds to withdrawal queue"}},"notice":"Fundlock is a smart contract managing client deposits.","version":1}},"settings":{"compilationTarget":{"contracts/fundlock/Fundlock.sol":"Fundlock"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":false,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol":{"keccak256":"0x631188737069917d2f909d29ce62c4d48611d326686ba6683e26b72a23bfac0b","license":"MIT","urls":["bzz-raw://7a61054ae84cd6c4d04c0c4450ba1d6de41e27e0a2c4f1bcdf58f796b401c609","dweb:/ipfs/QmUvtdp7X1mRVyC3CsHrtPbgoqWaXHp3S1ZR24tpAQYJWM"]},"@openzeppelin/contracts-upgradeable/proxy/ut