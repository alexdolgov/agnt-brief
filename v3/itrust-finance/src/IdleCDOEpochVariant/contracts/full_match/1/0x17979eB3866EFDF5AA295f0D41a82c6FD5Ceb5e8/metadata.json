uint256)":{"params":{"_limit":"limit in underlying value, 0 means no limit"}},"depositAA(uint256)":{"details":"msg.sender should approve this contract first to spend `_amount` of `token`","params":{"_amount":"amount of `token` to deposit"},"returns":{"_0":"AA tranche tokens minted"}},"depositAARef(uint256,address)":{"details":"msg.sender should approve this contract first to spend `_amount` of `token`","params":{"_amount":"amount of `token` to deposit","_referral":"address of the referral"},"returns":{"_0":"AA tranche tokens minted"}},"depositBB(uint256)":{"details":"msg.sender should approve this contract first to spend `_amount` of `token`","params":{"_amount":"amount of `token` to deposit"},"returns":{"_0":"BB tranche tokens minted"}},"emergencyShutdown()":{"details":"can be called by both the owner and the guardian"},"getApr(address)":{"params":{"_tranche":"tranche address"},"returns":{"_0":"actual apr given current ratio between AA and BB tranches"}},"getContractValue()":{"details":"unclaimed rewards (gov tokens) and `unclaimedFees` are not counted.  Harvested rewards are counted only if enough blocks have passed (`_lockedRewards`)"},"getCurrentAARatio()":{"details":"_virtualBalance is used to have a more accurate/recent value for the AA ratio because it calculates the balance after splitting the accrued interest since the last depositXX/withdrawXX/harvest","returns":{"_0":"AA tranches ratio (in underlying value) considering all interest"}},"getFundsFromBorrower(uint256,uint256,uint256)":{"details":"Get interest and funds for fullfill withdraw requests (normal and instant) from borrower, method is external so it can be used in the try/catch blocks","params":{"_amount":"Amount of interest to transfer","_instantWithdrawRequests":"Total instant withdraw requests","_withdrawRequests":"Total withdraw requests"}},"initialize(uint256,address,address,address,address,address,uint256)":{"details":"Initialize the upgradable contract","params":{"_governanceFund":"address where funds will be sent in case of emergency","_guardedToken":"underlying token","_limit":"contract value limit, can be 0","_owner":"guardian address (can pause, unpause and call emergencyShutdown)","_rebalancer":"rebalancer address","_strategy":"strategy address","_trancheAPRSplitRatio":"trancheAPRSplitRatio value"}},"isWalletAllowed(address)":{"params":{"_user":"User address"},"returns":{"_0":"true if wallet is allowed or keyring address is not set"}},"maxWithdrawable(address,address)":{"params":{"_tranche":"Tranche to withdraw from","_user":"User address"}},"maxWithdrawableInstant(address,address)":{"params":{"_tranche":"Tranche to withdraw from","_user":"User address"}},"owner()":{"details":"Returns the address of the current owner."},"pause()":{"details":"can be called by both the owner and the guardian"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"requestWithdraw(uint256,address)":{"params":{"_amount":"Amount of tranche tokens ","_tranche":"Tranche to withdraw from"},"returns":{"_0":"Amount of underlyings requested"}},"restoreOperations()":{"details":"can be called by the owner only"},"sendFundsToBorrower(uint256)":{"params":{"_amount":"Amount of underlyings to transfer"}},"setEpochParams(uint256,uint256)":{"details":"IMPORTANT: bufferPeriod should not be changed once set otherwise interest calculations will be wrong","params":{"_bufferPeriod":"time between 2 epochs","_epochDuration":"duration in seconds"}},"setFee(uint256)":{"params":{"_fee":"new fee"}},"setFeeReceiver(address)":{"params":{"_feeReceiver":"new fee receiver address"}},"setGuardian(address)":{"params":{"_guardian":"new guardian (pauser) address"}},"setInstantWithdrawParams(uint256,uint256,bool)":{"params":{"_aprDelta":"min apr delta to trigger instant withdraw","_delay":"delay in seconds","_disable":"flag to disable instant withdraw"}},"setIsAYSActive(bool)":{"params":{"_active":"flag to allow Adaptive Yield Split"}},"setKeyringParams(address,uint256,bool)":{"params":{"_keyring":"address of the keyring contract","_keyringAllowWithdraw":"flag to allow anyone to request a withdraw","_keyringPolicyId":"policyId to check for wallet"}},"setLossToleranceBps(uint256)":{"params":{"_diffBps":"tolerance in % (FULL_ALLOC = 100%) for socializing small losses "}},"setMinAprSplitAYS(uint256)":{"params":{"_aprSplit":"min apr split for AA, considering FULL_ALLOC = 100%"}},"setRebalancer(address)":{"params":{"_rebalancer":"new rebalancer address"}},"startEpoch()":{"details":"We calculate the total funds that the borrower should return at the end of the epoch ie interests + fees from normal withdraw requests. We send to the borrower underlyings amounts ie interests +  new deposits - instant withdraw requests if any. If funds are not enough to satisfy all requests then borrower should return the difference before instantWithdrawDeadline. After epoch start there should be no underlyings in this contract"},"stopEpoch(uint256,uint256)":{"details":"Only owner or manager can call this function. Borrower MUST approve this contract","params":{"_interest":"Interest gained in the epoch. This will overwrite the expected interest must be 0 if there is no need to overwrite the expected interest and if > 0 then it should be greater than the pending withdraw fees and newApr must be 0. If `_interest` is 1 then it is interpreted as a special case where we request everything back from the borrower","_newApr":"New apr to set for the next epoch"}},"stopEpochWithDuration(uint256,uint256,uint256)":{"details":"see stopEpoch and setEpochParams for more details, bufferPeriod is not modified","params":{"_duration":"New epoch duration","_interest":"Interest gained in the epoch","_newApr":"New apr to set for the next epoch"}},"tranchePrice(address)":{"params":{"_tranche":"tranche address"},"returns":{"_0":"tranche price, in underlyings, at the last interaction (not considering interest earned  since last interaction)"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"transferToken(address,uint256)":{"params":{"_token":"address of the token to transfer","_value":"amount to transfer"}},"unpause()":{"details":"can be called by both the owner and the guardian"},"virtualPrice(address)":{"params":{"_tranche":"address of the requested tranche"},"returns":{"_virtualPrice":"tranche price considering all interest/losses"}}},"title":"IdleCDO variant that supports epochs. ","version":1},"userdoc":{"kind":"user","methods":{"_setLimit(uint256)":{"notice":"set contract TVL limit"},"allowAAWithdrawRequest()":{"notice":"flag to allow AA withdraw requests"},"allowBBWithdrawRequest()":{"notice":"flag to allow BB withdraw requests"},"allowInstantWithdraw()":{"notice":"flag to allow instant withdraws"},"bufferPeriod()":{"notice":"time between 2 epochs, can be set to 0 to start the next epoch without waiting a specified time"},"claimInstantWithdrawRequest()":{"notice":"Claim an instant withdraw request from the vault. Can be done when epoch is running as funds will get transferred from borrower when epoch starts"},"claimWithdrawRequest()":{"notice":"Claim a withdraw request from the vault. Can be done when at least 1 epoch passed since last withdraw request"},"defaulted()":{"notice":"flag to check if borrower defaulted"},"depositAA(uint256)":{"notice":"pausable"},"depositAARef(uint256,address)":{"notice":"pausable"},"depositBB(uint256)":{"notice":"pausable in _deposit"},"disableInstantWithdraw()":{"notice":"flag to completely disable instant withdraw"},"emergencyShutdown()":{"notice":"pause deposits and redeems for all classes of tranches"},"epochDuration()":{"notice":"duration of the epoch"},"epochEndDate()":{"notice":"end date of the current epoch"},"expectedEpochInterest()":{"notice":"expected interest for the current epoch"},"getContractValue()":{"notice":"calculates the current net TVL (in `token` terms)"},"getCurrentAARatio()":{"notice":"calculates the current AA tranches ratio"},"getInstantWithdrawFunds()":{"notice":"Get funds from borrower to fullfill instant withdraw requests Manager should call this method after instantWithdrawDeadline (when epoch is running)"},"harvest(bool[],bool[],uint256[],uint256[],bytes[])":{"notice":"NOTE: harvest is not performed to transfer funds to the strategy (startEpoch is used)"},"initialize(uint256,address,address,address,address,address,uint256)":{"notice":"can only be called once"},"instantWithdrawAprDelta()":{"notice":"min apr change to trigger instant withdraw"},"instantWithdrawDeadline()":{"notice":"deadline to allow instant withdraw requests"},"instantWithdrawDelay()":{"notice":"delay to allow instant withdraw requests after next epoch starts"},"isEpochRunning()":{"notice":"flag to check if epoch is running"},"isWalletAllowed(address)":{"notice":"Check if wallet is allowed to interact with the contract"},"keyring()":{"notice":"Keyring wallet checker address"},"keyringAllowWithdraw()":{"notice":"flag for enabling anyone to request a withdraw (needed for liquidations)"},"keyringPolicyId()":{"notice":"keyring policyId"},"lastEpochApr()":{"notice":"apr of the last epoch"},"lastEpochInterest()":{"notice":"net underlyings gained last epoch"},"maxWithdrawable(address,address)":{"notice":"Get the max amount of underlyings that can be withdrawn by user"},"maxWithdrawableInstant(address,address)":{"notice":"Get the max amount of underlyings that can be withdrawn instantly by user"},"pause()":{"notice":"Pauses deposits"},"pendingWithdrawFees()":{"notice":"fees from pending withdraw request for the curr epoch"},"requestWithdraw(uint256,address)":{"notice":"Request a withdraw from the vault"},"restoreOperations()":{"notice":"allow deposits and redeems for all classes of tranches"},"sendFundsToBorrower(uint256)":{"notice":"workaround to have safeTransfer to borrower as external and use it in a try/catch block"},"setEpochParams(uint256,uint256)":{"notice":"update epoch duration"},"setInstantWithdrawParams(uint256,uint256,bool)":{"notice":"update instant withdraw params"},"setKeyringParams(address,uint256,bool)":{"notice":"update keyring address"},"setTrancheAPRSplitRatio(uint256)":{"notice":"NOTE: the vault is either a single tranche (ie all interest to senior and set in additionalInit) or AYS is active"},"setUnlentPerc(uint256)":{"notice":"NOTE: unlent perc should always be 0 and set in additionalInit"},"startEpoch()":{"notice":"Start the epoch. No deposits or withdrawals are allowed after this."},"stopEpoch(uint256,uint256)":{"notice":"Stop epoch, accrue interest to the vault and get funds to fullfill normal (ie non-instant) withdraw requests from the prev epoch."},"stopEpochWithDuration(uint256,uint256,uint256)":{"notice":"Stop epoch and set new duration"},"toggleStkIDLEForTranche(address)":{"notice":"NOTE: stkIDLE gating is not used"},"transferToken(address,uint256)":{"notice":"Emergency method, tokens gets transferred to the governanceRecoveryFund address"},"unpause()":{"notice":"Unpauses deposits"},"updateAccounting()":{"notice":"this method updates the accounting of the contract and effectively splits the yield/loss between the AA and BB tranches. This can be called at any time as is called automatically on each deposit/redeem. It's here just to be called when a default happened, as deposits/redeems are paused, but we need to update the loss for junior holders"},"virtualPrice(address)":{"notice":"calculates the current tranches price considering the interest/loss that is yet to be splitted ie the interest/loss generated since the last update of priceAA and priceBB (done on depositXX/withdrawXX/harvest)"},"withdrawAA(uint256)":{"notice":"NOTE: normal withdraw are not allowed"}},"version":1}},"settings":{"compilationTarget":{"contracts/IdleCDOEpochVariant.sol":"IdleCDOEpochVariant"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol":{"keccak256":"0x4075622496acc77fd6d4de4cc30a8577a744d5c75afad33fdeacf1704d6eda98","license":"MIT","urls":["bzz-raw://99c8cb3cd19a44bbfb6612605affb7d8b06cee1f6aa9362a37a8672b4f7eeaf8","dweb:/ipfs/QmasyxFDBUp7k5KFgfDWEzM8PYSKEq7GVznzMJ1VxVRF4B"]},"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol":{"keccak256":"0x89be10e757d242e9b18d5a32c9fbe2019f6d63052bbe46397a430a1d60d7f794","license":"MIT","urls":["bzz-raw://f103ee2e4aecd37aac6ceefe670709cdd7613dee25fa2d4d9feaf7fc0aaa155e","dweb:/ipfs/QmRiNZLoJk5k3HPMYGPGjZFd2ke1ZxjhJZkM45Ec9GH9hv"]},"@openzeppelin/contracts-upgradeable/security/PausableUpgradeable.sol":{"keccak256":"0x40c636b4572ff5f1dc50cf22097e93c0723ee14eff87e99ac2b02636eeca1250","license":"MIT","urls":["bzz-raw://9c7d1f5e15633ab912b74c2f57e24559e66b03232300d4b27ff0f25bc452ecad","dweb:/ipfs/QmYTJkc1cntYkKQ1Tu11nBcJLakiy93Tjytc4XHELo4GmR"]},"@openzeppelin/contracts-upgradeable/security/ReentrancyGuardUpgradeable.sol":{"keccak256":"0xb82ef33f43b6b96109687d91b39c94573fdccaaa423fe28e8ba0977b31c023e0","license":"MIT","urls":["bzz-raw://ec9c629f63e66379f9c868a74f971064701cc6e30583872aa653f8b932518025","dweb:/ipfs/QmY4MnZF2VMFwJkAwpdQwxEWA3KcGbNBKEmAVYePMVQWUR"]},"@openzeppelin/contracts-upgradeable/token/ERC20/ERC20Upgradeable.sol":{"keccak256":"0xd14a627157b9a411d2410713e5dd3a377e9064bd5c194a90748bbf27ea625784","license":"MIT","urls":["bzz-raw://29d6a502187e88fdb4ac51319b6cfc82e7ba886a435480e229e5f838d2da55ee","dweb:/ipfs/QmQNWKr3axXvQowZi31ydXRdeZ7UnE7oN8XAz9FCkx1JhN"]},"@openzeppelin/contracts-upgradeable/token/ERC20/IERC20Upgradeable.sol":{"keccak256":"0x0e1f0f5f62f67a881cd1a9597ac