ag for enabling anyone to request a withdraw (needed for liquidations)"},"keyringPolicyId()":{"notice":"keyring policyId"},"lastEpochApr()":{"notice":"apr of the last epoch, unscaled"},"lastEpochInterest()":{"notice":"net underlyings gained last epoch"},"maxWithdrawable(address,address)":{"notice":"Get the max amount of underlyings that can be withdrawn by user"},"pause()":{"notice":"Pauses deposits"},"pendingWithdrawFees()":{"notice":"fees from pending withdraw request for the curr epoch"},"requestWithdraw(uint256,address)":{"notice":"Request a withdraw from the vault"},"restoreOperations()":{"notice":"allow deposits and redeems for all classes of tranches"},"sendFundsToBorrower(uint256)":{"notice":"workaround to have safeTransfer to borrower as external and use it in a try/catch block"},"setEpochParams(uint256,uint256)":{"notice":"update epoch duration"},"setEpochQueue(address)":{"notice":"set queue used for prefunded processing"},"setInstantWithdrawParams(uint256,uint256,bool)":{"notice":"update instant withdraw params"},"setIsDepositDuringEpochDisabled(bool)":{"notice":"set flag to disable deposits during an epoch"},"setIsInterestMinted(bool)":{"notice":"set flag to mint interest as strategy tokens without moving underlyings"},"setKeyringParams(address,uint256,bool)":{"notice":"update keyring address"},"startEpoch()":{"notice":"Start the epoch. No deposits or withdrawals are allowed after this."},"stopEpoch(uint256,uint256)":{"notice":"Stop epoch, accrue interest to the vault and get funds to fullfill normal (ie non-instant) withdraw requests from the prev epoch."},"stopEpochWithDuration(uint256,uint256,uint256,uint256)":{"notice":"Stop epoch and set new duration"},"transferToken(address,uint256)":{"notice":"Emergency method, tokens gets transferred to the governanceRecoveryFund address"},"unpause()":{"notice":"Unpauses deposits"},"updateAccounting()":{"notice":"this method updates the accounting of the contract and effectively splits the yield/loss between the 