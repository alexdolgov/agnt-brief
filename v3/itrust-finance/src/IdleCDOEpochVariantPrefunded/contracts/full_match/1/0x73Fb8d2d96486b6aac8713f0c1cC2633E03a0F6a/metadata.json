ing value, 0 means no limit"}},"depositAA(uint256)":{"details":"msg.sender should approve this contract first to spend `_amount` of `token`","params":{"_amount":"amount of `token` to deposit"},"returns":{"_0":"AA tranche tokens minted"}},"depositBB(uint256)":{"details":"msg.sender should approve this contract first to spend `_amount` of `token`","params":{"_amount":"amount of `token` to deposit"},"returns":{"_0":"BB tranche tokens minted"}},"depositDuringEpoch(uint256,address)":{"params":{"_amount":"Amount of underlyings","_tranche":"Tranche to deposit into"},"returns":{"_minted":"Amount of tranche tokens minted"}},"emergencyShutdown()":{"details":"can be called by both the owner and the guardian"},"getApr(address)":{"params":{"_tranche":"tranche address"},"returns":{"_0":"actual apr given current ratio between AA and BB tranches"}},"getContractValue()":{"details":"`unclaimedFees` are not counted."},"getCurrentAARatio()":{"details":"_virtualBalance is used to have a more accurate/recent value for the AA ratio because it calculates the balance after splitting the accrued interest since the last depositXX/withdrawXX","returns":{"_0":"AA tranches ratio (in underlying value) considering all interest"}},"getFundsFromBorrower(uint256,uint256,uint256)":{"details":"Get interest and funds for fullfill withdraw requests (normal and instant) from borrower, method is external so it can be used in the try/catch blocks","params":{"_amount":"Amount of interest to transfer","_instantWithdrawRequests":"Total instant withdraw requests","_withdrawRequests":"Total withdraw requests"}},"initialize(uint256,address,address,address,address,address,uint256)":{"details":"Initialize the upgradable contract","params":{"_governanceFund":"address where funds will be sent in case of emergency","_guardedToken":"underlying token","_limit":"contract value limit, can be 0","_owner":"guardian address (can pause, unpause and call emergencyShutdown)","_strategy":"strategy address","_trancheAPRSplitRatio