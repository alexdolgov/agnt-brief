y":"nonpayable","type":"function"},{"inputs":[],"name":"treasury","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"unirouter","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"unpause","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"vault","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"wbnb","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"wbnbToFuelRoute","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"wings","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"wingsToLp0Route","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"wingsToLp1Route","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"wingsToWbnbRoute","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"_amount","type":"uint256"}],"name":"withdraw","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"details":"Implementation of a strategy to get yields from farming LP Pools in JetSwap. JetSwap is an automated market maker (“AMM”) that allows two tokens to be exchanged on the Binance Smart Chain. It is fast, cheap, and allows anyone to participate. JetSwap is aiming to be the #1 liquidity provider on BSC.  * This strategy simply deposits whatever funds it receives from the vault into the selected MasterChef pool. WINGS rewards from providing liquidity are farmed every few minutes, sold and split 50/50. The corresponding pair of assets are bought and more liquidity is added to the MasterChef pool.  * This strat is currently compatible with all LP pools.","methods":{"balanceOf()":{"details":"Function to calculate the total underlaying {lpPair} held by the strat. It takes into account both the funds in hand, as the funds allocated in the MasterChef."},"balanceOfLpPair()":{"details":"It calculates how much {lpPair} the contract holds."},"balanceOfPool()":{"details":"It calculates how much {lpPair} the strategy has allocated in the MasterChef"},"constructor":{"details":"Initializes the strategy with the token to maximize."},"deposit()":{"details":"Function that puts the funds to work. It gets called whenever someone deposits in the strategy's vault contract. It deposits {lpPair} in the MasterChef to farm {wings}"},"harvest()":{"details":"Core function of the strat, in charge of collecting and re-investing rewards. 1. It claims rewards from the MasterChef. 2. It charges the system fees to simplify the split. 3. It swaps the {wings} token for {lpToken0} & {lpToken1} 4. Adds more liquidity to the pool. 5. It deposits the new LP tokens."},"owner()":{"details":"Returns the address of the current owner."},"panic()":{"details":"Pauses deposits. Withdraws all funds from the MasterChef, leaving rewards behind"},"pause()":{"details":"Pauses the strat."},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner.      * NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"unpause()":{"details":"Unpauses the strat."},"withdraw(uint256)":{"details":"Withdraws funds and sents them back to the vault. It withdraws {lpPair} from the MasterChef. The available {lpPair} minus fees is returned to the vault."}}},"userdoc":{"methods":{}}},"settings":{"compilationTarget":{"StrategyWingsLP.sol":"StrategyWingsLP"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":false,"runs":200},"remappings":[]},"sources":{"StrategyWingsLP.sol":{"keccak256":"0x972f1ec3af019f0e0c40c7a49c8257830c54194cde99f92d37100731b19e63f9","urls":["bzz-raw://320da484c4f46e5bdda0f33e29037cb7a29daea888e1700b219ed74ee46f7eea","dweb:/ipfs/QmXoANVExarhh9FRYXdi9pQS39ihg3QmNaCdJUMLvgNDYf"]}},"version":1}