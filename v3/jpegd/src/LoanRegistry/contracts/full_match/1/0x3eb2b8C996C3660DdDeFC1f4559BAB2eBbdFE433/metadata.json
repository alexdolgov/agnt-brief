ported currency"},"closeLoan(address,uint256,address)":{"notice":"Allows the controller to forcefully close a loan without requiring a repayment. Used in liquidations"},"createOrUpdateLendingRequest(uint256,(uint256,uint256,address,address,bool,uint16,uint16,uint16,uint8,uint32),bool,bool)":{"notice":"Function used to create or update lending requests (lenders offering a loan to borrowers)"},"createOrUpdateLoanRequest(address,uint256,(uint256,uint16,uint16,uint16,uint8,uint32))":{"notice":"Function used to create or update loan requests (borrowers requesting a loan from lenders)"},"deleteLendingRequest(uint256,address,bool)":{"notice":"Function used to delete lending requests"},"deleteLoanRequest(address,uint256)":{"notice":"Function used to delete loan requests"},"refinanceLoan(address,uint256,(uint256,uint256,address,address,bool,uint16,uint16,uint16,uint8,uint32),bool)":{"notice":"Function used by lenders to automatically refinance existing loans without the need for any borrower action if the conditions are met. The refinancer pays the accrued debt from the previous loan(s). The amount paid is refunded after the borrower repays. For this function to work, the new loan must respect the following conditions: - Needs to have the same currency - Needs to have the same principal amount - The loan has to end after the previous one - `_request.minimumInterestBps` must be 0 to prevent unwanted additional costs for the borrower - `_request.interestAprBps` must be lower than the previous one by at least `MINIMUM_REFINANCE_INTEREST_CHANGE_BPS`"},"repayLoan(address,uint256,address,bool)":{"notice":"Allows borrowers to repay active loans. Requires fully repaying debt"},"takeLendingRequest(uint256,address,uint256,address,bool,bool,bytes32)":{"notice":"Function used by borrowers to accept lending requests. It works with both existing collateral deposits or new ones. NFTs with already active loans can use this function to refinance their loan by accepting another lending request"},"takeLoanRequest(address,uint256,uint256,address,address,bool,bytes32)":{"notice":"Function used by lenders to accept loan requests. It works with both existing lender deposits or new ones"}},"version":1}},"settings":{"compilationTarget":{"contracts/LoanRegistry.sol":"LoanRegistry"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":false,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol":{"keccak256":"0x6662ec4e5cefca03eeadd073e9469df8d2944bb2ee8ec8f7622c2c46aab5f225","license":"MIT","urls":["bzz-raw://4d8544c6f8daa4d1bc215c6a72fe0acdb748664a105b0e5efc19295667521d45","dweb:/ipfs/QmdGWqdnXT8S3RgCR6aV8XHZrsybieMQLLnug1NtpSjEXN"]},"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol":{"keccak256":"0x631188737069917d2f909d29ce62c4d48611d326686ba6683e26b72a23bfac0b","license":"MIT","urls":["bzz-raw://7a61054ae84cd6c4d04c0c4450ba1d6de41e27e0a2c4f1bcdf58f796b401c609","dweb:/ipfs/QmUvtdp7X1mRVyC3CsHrtPbgoqWaXHp3S1ZR24tpAQYJWM"]},"@openzeppelin/contracts-upgradeable/utils/ContextUpgradeable.sol":{"keccak256":"0xdbef5f0c787055227243a7318ef74c8a5a1108ca3a07f2b3a00ef67769e1e397","license":"MIT","urls":["bzz-raw://08e39f23d5b4692f9a40803e53a8156b72b4c1f9902a88cd65ba964db103dab9","dweb:/ipfs/QmPKn6EYDgpga7KtpkA8wV2yJCYGMtc9K4LkJfhKX2RVSV"]},"@openzeppelin/contracts-upgradeable/utils/introspection/ERC165Upgradeable.sol":{"keccak256":"0xdaba3f7c42c55b2896353f32bd27d4d5f8bae741b3b05d4c53f67abc4dc47ce8","license":"MIT","urls":["bzz-raw://1fa2e61141c602510bcd2cd936ed9561922ac8772a9b9c9a9db091a74e354a45","dweb:/ipfs/QmcHQDDoEBwJmwUbzoVkytvJsBx3KVHYFFnDkvRGWh9Wmh"]},"@openzeppelin/contracts/access/IAccessControl.sol":{"keccak256":"0xb6b36edd6a2999fd243ff226d6cbf84bd71af2432bbd0dfe19392996a1d9cb41","license":"MIT","urls":["bzz-raw://1fd2f35495652e57e3f99bc6c510bc5f7dd398a176ea2e72d8ed730aebc6ca26","dweb:/ipfs/QmTQV6X4gkikTib49cho5iDX3JvSQbdsoEChoDwrk3CbbH"]},"@open