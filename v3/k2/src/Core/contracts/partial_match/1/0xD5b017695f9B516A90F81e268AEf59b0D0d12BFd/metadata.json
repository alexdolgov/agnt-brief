n"}},"initialize(address,address,address,uint32,uint32,uint32)":{"params":{"_hookCallGasLimit":": Max gas that can be used by hook calls to a DSS","_hookGasBuffer":": Minimum gas buffer to run the remaining logic after a DSS hook is called","_manager":": The address of the manager who can do operations that don't put funds at risk.","_supportsInterfaceGasLimit":": Max gas that can be used by `supportsInterface` call to a DSS","_vaultImpl":": The address of the default vault implementation. Usually the standard ERC20 vault impl.","_vetoCommittee":": The address of the veto committee who can cancel/veto slashing requests. Should be a multisig."}},"isAssetAllowlisted(address)":{"details":"Only matters for the `deployVault` flow. Allowlisting is not required for custom vaults.","params":{"asset":": The address of the ERC20 asset to check"},"returns":{"_0":"bool if the asset is allowlisted, false otherwise"}},"isDSSRegistered(address)":{"params":{"dss":"address of the dss."},"returns":{"_0":"boolean indicating dss is registered or not."}},"isOperatorRegisteredToDSS(address,address)":{"params":{"dss":": The address of the DSS to check","operator":": The address of the operator to check"},"returns":{"_0":"{bool} True if the operator is registered to the DSS, false otherwise"}},"isVaultImplAllowListed(address)":{"params":{"vaultImpl":"address of the implementaion"}},"isVaultQueuedForSlashing(address)":{"params":{"vault":"address of the vault."},"returns":{"_0":"boolean where true indicating vault is queued for slashing."}},"owner()":{"details":"Returns the owner of the contract."},"ownershipHandoverExpiresAt(address)":{"details":"Returns the expiry timestamp for the two-step ownership handover to `pendingOwner`."},"pause(uint256)":{"params":{"map":": 256 bitmap for paused and unpaused functions, type(uint256).max to pause all functions"}},"pauseVault(address,uint256)":{"params":{"map":": 256 bitmap for vault paused and unpaused functions, type(uint256).max to pause all functions","vault":": The address of the vault to pause"}},"proxiableUUID()":{"details":"Returns the storage slot used by the implementation, as specified in [ERC1822](https://eips.ethereum.org/EIPS/eip-1822). Note: The `notDelegated` modifier prevents accidental upgrades to an implementation that is a proxy contract."},"registerDSS(uint256)":{"details":"If you want to have 0% slashing, set `maxSlashablePercentageWad` to `1` since 0 is used as a default flag for not set If a operator is set, it will have a non-zero slashable percentage. Hence we can just check for that to see if a DSS is registered","params":{"maxSlashablePercentageWad":"The max slashable percent, in the form of wad, that the DSS can slash per cooldown period"}},"registerOperatorToDSS(address,bytes)":{"params":{"dss":": The address of the DSS to register with","registrationHookData":": The data to pass to the DSS's beforeRegistrationHook"}},"renounceOwnership()":{"details":"Allows the owner to renounce their ownership."},"renounceRoles(uint256)":{"details":"Allow the caller to remove their own roles. If the caller does not have a role, then it will be an no-op for the role."},"requestOwnershipHandover()":{"details":"Request a two-step ownership handover to the caller. The request will automatically expire in 48 hours (172800 seconds) by default."},"requestSlashing((address,uint96[],address[]))":{"params":{"slashingRequest":": The request to slash the operator"}},"requestUpdateVaultStakeInDSS((address,address,bool))":{"details":"Only operator can update the stake of their vaults and logically, only 1 update request is allowed per vault until its completed","params":{"vaultStakeUpdateRequest":": stake update request with to stake/unstake, address of dss and address of vault"}},"revokeRoles(address,uint256)":{"details":"Allows the owner to remove `user` `roles`. If the `user` does not have a role, then it will be an no-op for the role."},"rolesOf(address)":{"details":"Returns the roles of `user`."},"setGasValues(uint32,uint32,uint32)":{"details":"Set to prevent DOS vector as malicious DSS can block calls by using infinite gas","params":{"_hookCallGasLimit":": Gas limit to perform call to DSS for corresponding hook call","_hookGasBuffer":": Buffer gas to perform the rest of hook call","_supportsInterfaceGasLimit":": Gas limit for `supportsInterface` call to DSS"}},"transferOwnership(address)":{"details":"Allows the owner to transfer the ownership to `newOwner`."},"unpause(uint256)":{"params":{"map":": 256 bitmap for paused and unpaused functions, 0 to unpause all functions"}},"unpauseVault(address,uint256)":{"params":{"map":": 256 bitmap for vault paused and unpaused functions, 0 to unpause all functions","vault":": The address of the vault to unpause"}},"unregisterOperatorFromDSS(address)":{"details":"All asset delegations to the DSS must be 0 before the operator can unregister","params":{"dss":": The address of the DSS to unregister from"}},"upgradeToAndCall(address,bytes)":{"details":"Upgrades the proxy's implementation to `newImplementation`. Emits a {Upgraded} event. Note: Passing in empty `data` skips the delegatecall to `newImplementation`."}},"version":1},"userdoc":{"kind":"user","methods":{"allowlistAssets(address[],address[])":{"notice":"Allows the manager to allowlist assets that then vaults can be created for with the asset as the underlying token."},"allowlistVaultImpl(address)":{"notice":"Allows the owner to allowlist a new vault implementation This is meant for custom 4626 vaults like native restaking vaults"},"cancelSlashing((address,uint96,address,address[],uint96[],uint256))":{"notice":"Allows the veto committee to cancel a queued slashing"},"changeImplementationForVault(address,address)":{"notice":"Allows the owner to change the implementation of a specific vault"},"changeStandardImplementation(address)":{"notice":"Allows the owner to change the standard vault implementation and upgrade all vaults using the default implementation to the new implementation."},"deployVaults((address,uint8,address,string,string,bytes)[],address)":{"notice":"Deploys a new restaking vault with the given configuration to an operator"},"extSloads(bytes32[])":{"notice":"Allows reading of arbitrary storage slots. Useful for reading inside embedded structs"},"fetchVaultsStakedInDSS(address,address)":{"notice":"Returns the vaults staked for a given operator in a DSS"},"finalizeSlashing((address,uint96,address,address[],uint96[],uint256))":{"notice":"Allows anyone to finalize a queued slashing and send the slashed assetsto the slashing handler"},"finalizeUpdateVaultStakeInDSS((uint48,uint48,address,(address,address,bool)))":{"notice":"Allows anyone to finish the queued request for an operator to update assets delegated to a DSS"},"getDssMaxSlashablePercentageWad(address)":{"notice":"Returns the max slashable percentageWad by DSS per slashing request."},"getLeverage(address)":{"notice":"Returns the leverage of a given vault"},"getOperatorVaults(address)":{"notice":"Returns the vaults for a given operator"},"implementation()":{"notice":"Returns the implementation of the vault for the given operator"},"implementation(address)":{"notice":"Returns the implementation for a given vault"},"initialize(address,address,address,uint32,uint32,uint32)":{"notice":"Initializes the Core contracts: sets owner, grants roles, and sets default values"},"isAssetAllowlisted(address)":{"notice":"Returns if a given asset is allowlisted"},"isDSSRegistered(address)":{"notice":"Returns true if dss is registered in the protocol."},"isOperatorRegisteredToDSS(address,address)":{"notice":"Returns true if a given operator is registered to a DSS"},"isVaultImplAllowListed(address)":{"notice":"checks whether the given `vaultImplementation` is allowlisted or not"},"isVaultQueuedForSlashing(address)":{"notice":"checks whether a slashing in requested on the given vault."},"pause(uint256)":{"notice":"Pauses the contract functions in an idemptotent way"},"pauseVault(address,uint