{"compiler":{"version":"0.8.23+commit.f704f362"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"contract ISystemVariables","name":"systemVariables_","type":"address"},{"internalType":"contract IUserManager","name":"userManager_","type":"address"},{"internalType":"contract ILendingPoolManager","name":"lendingPoolManager_","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[{"internalType":"uint256","name":"epoch","type":"uint256"}],"name":"ClearingAlreadyExecuted","type":"error"},{"inputs":[],"name":"ConfigurationAddressZero","type":"error"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"},{"internalType":"uint256","name":"targetEpoch","type":"uint256"},{"internalType":"uint256","name":"nextEpoch","type":"uint256"}],"name":"InvalidClearingTargetEpochForLendingPool","type":"error"},{"inputs":[],"name":"InvalidInitialization","type":"error"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"}],"name":"InvalidLendingPool","type":"error"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"},{"internalType":"address","name":"tranche","type":"address"}],"name":"InvalidTranche","type":"error"},{"inputs":[],"name":"LendingPoolIsNotStopped","type":"error"},{"inputs":[],"name":"LendingPoolIsStopped","type":"error"},{"inputs":[],"name":"NotInitializing","type":"error"},{"inputs":[],"name":"OnlyClearingCoordinator","type":"error"},{"inputs":[],"name":"OnlyLendingPoolManager","type":"error"},{"inputs":[{"internalType":"address","name":"sender","type":"address"},{"internalType":"address","name":"ownLendingPool","type":"address"}],"name":"OnlyOwnLendingPool","type":"error"},{"inputs":[{"internalType":"address","name":"sender","type":"address"},{"internalType":"address","name":"ownPendingPool","type":"address"}],"name":"OnlyOwnPendingPool","type":"error"},{"inputs":[{"internalType":"uint256","name":"targetEpoch","type":"uint256"}],"name":"TargetEpochClearingNotStarted","type":"error"},{"inputs":[{"internalType":"uint256","name":"targetEpoch","type":"uint256"}],"name":"UserLoyaltyLevelsNotYetProcessed","type":"error"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"lendingPool","type":"address"},{"indexed":true,"internalType":"uint256","name":"epoch","type":"uint256"},{"components":[{"internalType":"uint256","name":"drawAmount","type":"uint256"},{"internalType":"uint256[]","name":"trancheDesiredRatios","type":"uint256[]"},{"internalType":"uint256","name":"maxExcessPercentage","type":"uint256"},{"internalType":"uint256","name":"minExcessPercentage","type":"uint256"}],"indexed":false,"internalType":"struct ClearingConfiguration","name":"clearingConfig","type":"tuple"}],"name":"ClearingConfigSet","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"lendingPool","type":"address"},{"indexed":true,"internalType":"uint256","name":"epoch","type":"uint256"},{"indexed":false,"internalType":"enum ClearingStatus","name":"clearingStatus","type":"uint8"}],"name":"ClearingExecuted","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"uint64","name":"version","type":"uint64"}],"name":"Initialized","type":"event"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"},{"internalType":"uint256","name":"targetEpoch","type":"uint256"},{"internalType":"uint256","name":"priorityCalculationBatchSize","type":"uint256"},{"internalType":"uint256","name":"acceptRequestsBatchSize","type":"uint256"},{"components":[{"internalType":"uint256","name":"drawAmount","type":"uint256"},{"internalType":"uint256[]","name":"trancheDesiredRatios","type":"uint256[]"},{"internalType":"uint256","name":"maxExcessPercentage","type":"uint256"},{"internalType":"uint256","name":"minExcessPercentage","type":"uint256"}],"internalType":"struct ClearingConfiguration","name":"clearingConfig","type":"tuple"},{"internalType":"bool","name":"isConfigOverridden","type":"bool"}],"name":"doClearing","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"}],"name":"initializeLendingPool","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"}],"name":"isLendingPoolClearingPending","outputs":[{"internalType":"bool","name":"isPending","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"},{"internalType":"uint256","name":"epoch","type":"uint256"}],"name":"lendingPoolClearingStatus","outputs":[{"internalType":"enum ClearingStatus","name":"status","type":"uint8"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"}],"name":"lendingPoolMaxDrawAmount","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"lendingPool","type":"address"}],"name":"nextLendingPoolClearingEpoch","outputs":[{"internalType":"uint256","name":"nextClearingEpoch","type":"uint256"}],"stateMutability":"view","type":"function"}],"devdoc":{"details":"Clearing process is divided into 5 steps: 1. Apply lending pool interests for the target epoch. 2. Calculate pending deposit and withdrawal request priorities. 3. Calculate accepted deposit and withdrawal amounts for each tranche and priority. 4. Process accepted deposit and accepted withdrawal requests. 5. Draw funds. At the end of the clearing lending pool pays owed fees function is triggered to transfer owed fees if available. Clearing is executed for each lending pool separately. Clearing process for a lending pool is executed by calling doClearing function. Clearing must be executed once per epoch for each lending pool to ensure a seamless process. Clearing epochs must be executed in order. User loyalty levels must be processed before proceeding to process user requests (step 2 to 5). Clearing can be executed in multiple transactions by specifying batch sizes for step 2 and step 4. If clearing us not fully processed, clearing can be pending for step 2 or for step 4. Steps 1, 3, and 5 are executed automatically after step 2 or step 4 are completed. Step 1 is executed right when doClearing function is called. Step 2 is executed and processes the amount of user requests specified in the batch size.   If not all user requests are processed, clearing is pending for step 2 until all user requests are processed. Step 3 is executed automatically after step 2 is finished. Step 4 is executed and processes the amount of user requests specified in the batch size.   If not all user requests are processed, clearing is pending for step 4 until all user requests are processed. Step 5 is executed automatically after step 4 is finished. After step 5 is finished, clearing for the target epoch is ended. If clearing for the epoch is executed only after the clearing period, only yield will be applied (step 1) and no user requests will be processed. If clearing is pending for step 2 and the clearing period is over, clearing will be ended and no user requests will be processed. If clearing is pending for step 4 and the clearing period is over, clearing must be fully processed before proceeding to the next epoch clearing. Some lending pool functions are disabled (cancel deposit, cancel withdrawal, force immediate withdrawal) if clearing for the lending pool is pending. Clearing configuration is taken from the lending pool, but can also be overridden for each lending pool and epoch before execution of step 2. If the desired draw amount is more than available funds to draw, the clearing transaction will revert in step 3.   In this case the clearing configuration mush be overridden (to set the valid draw amount) to proceed with the clearing and draw funds.","errors":{"InvalidInitialization()":[{"details":"The contract is already initialized."}],"NotInitializing()":[{"details":"The contract is not initializing."}]},"events":{"Initialized(uint64)":{"details":"Triggered when the contract has been initialized or reinitialized."}},"kind":"dev","methods":{"constructor":{"params":{"lendingPoolManager_":"Lending pool manager contract.","systemVariables_":"System variables contract.","userManager_":"User manager contract."}},"doClearing(address,uint256,uint256,uint256,(uint256,uint256[],uint256,uint256),bool)":{"details":"Can be called multiple times to execute clearing in multiple transactions.","params":{"acceptRequestsBatchSize":"Numbers of user requests to process in step 4. Only used when step 4 is being processed.","clearingConfig":"Clearing configuration to override the lending pool configuration. Is only used when step 3 is processed if `isConfigOverridden` is true.","isConfigOverridden":"True if clearing configuration is overridden.","lendingPool":"Lending pool address.","priorityCalculationBatchSize":"Numbers of user requests to process in step 2. Only used when step 2 is being processed.","targetEpoch":"Target epoch to execute clearing."}},"initializeLendingPool(address)":{"details":"This function must be called after the lending pool is created."},"isLendingPoolClearingPending(address)":{"details":"Clearing is pending if previous epoch clearing is not yet ended or if current clearing is not yet ended and it's clearing time.","params":{"lendingPool":"Lending pool address."},"returns":{"isPending":"True if clearing is pending for the lending pool."}},"lendingPoolMaxDrawAmount(address)":{"details":"Can only be drawn if it's the clearing time and the clearing for the current epoch is not yet processed.","params":{"lendingPool":"Lending pool address."},"returns":{"_0":"maxDrawAmount Maximum amount that can be drawn from the lending pool."}}},"stateVariables":{"_systemVariables":{"details":"System variables contract."},"_userManager":{"details":"User manager contract."}},"title":"ClearingCoordinator contract","version":1},"userdoc":{"errors":{"ConfigurationAddressZero()":[{"notice":"Used when configuring an address with a zero address."}]},"kind":"user","methods":{"constructor":{"notice":"Constructor."},"doClearing(address,uint256,uint256,uint256,(uint256,uint256[],uint256,uint256),bool)":{"notice":"Executes the clearing process for the lending pool."},"initializeLendingPool(address)":{"notice":"Initializes the clearing process for the lending pool."},"isLendingPoolClearingPending(address)":{"notice":"Returns true if clearing for the lending pool is pending."},"lendingPoolMaxDrawAmount(address)":{"notice":"Returns the maximum amount that can be drawn from the lending pool for the current epoch."},"nextLendingPoolClearingEpoch(address)":{"notice":"Returns the next clearing epoch that needs to be processed for the lending pool."}},"notice":"Contract responsible for coordinating clearing process for all lending pools.","version":1}},"settings":{"compilationTarget":{"src/core/clearing/ClearingCoordinator.sol":"ClearingCoordinator"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":800},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol":{"keccak256":"0x631188737069917d2f909d29ce62c4d48611d326686ba6683e26b72a23bfac0b","license":"MIT","urls":["bzz-raw://7a61054ae84cd6c4d04c0c4450ba1d6de41e27e0a2c4f1bcdf58f796b401c609","dweb:/ipfs/QmUvtdp7X1mRVyC3CsHrtPbgoqWaXHp3S1ZR24tpAQYJWM"]},"@openzeppelin/contracts/token/ERC20/IERC20.sol":{"keccak256":"0xc6a8ff0ea489379b61faa647490411b80102578440ab9d84e9a957cc12164e70","license":"MIT","urls":["bzz-raw://0ea104e577e63faea3b69c415637e99e755dcbf64c5833d7140c35a714d6d90c","dweb:/ipfs/Qmau6x4Ns9XdyynRCNNp3RhLqijJjFm7z5fyZazfYFGYdq"]},"@openzeppelin/contracts/token/ERC721/IERC721.sol":{"keccak256":"0x5ef46daa3b58ef2702279d514780316efaa952915ee1aa3396f041ee2982b0b4","license":"MIT","urls":["bzz-raw