ent owner."},"treasuryBurn(uint256)":{"params":{"amount":"The amount of KUSD to burn from treasury"}},"treasuryMint(uint256)":{"params":{"amount":"The amount of KUSD to mint to treasury"}}},"title":"KUSDMinter is responsible to stake/unstake users' Kine MCD (see KMCD) and mint/burn KUSD (see KineUSD) on behalf of users. When user want to mint KUSD against their collaterals (see KToken), KUSDMinter will borrow Knie MCD on behalf of user (which will increase user's debt ratio) and then call KineUSD to mint KUSD to user. When user want to  burn KUSD, KUSDMinter will call KineUSD to burn KUSD from user and  repay Kine MCD on behalf of user. KUSDMinter also let treasury account to mint/burn its balance to keep KUSD amount (the part that user transferred into Kine off-chain trading system) synced with Kine off-chain trading system."},"userdoc":{"methods":{"_setController(address)":{"notice":"Change Kine Controller address to a new one."},"_setKMCD(address)":{"notice":"Change KMCD contract address to a new one."},"_setKUSD(address)":{"notice":"Change KUSD contract address to a new one."},"_setKine(address)":{"notice":"Change Kine contract address to a new one."},"_setRewardDuration(uint256)":{"notice":"Set new reward duration, will start a new round of reward period immediately and recalculate rewardRate."},"_setRewardReleasePeriod(uint256)":{"notice":"Set new reward release period. The unclaimed rewards will be affected immediately."},"_setTreasury(address)":{"notice":"Change treasury account to a new one"},"_setVault(address)":{"notice":"Change vault account to a new one"},"accountStakes(address)":{"notice":"Show account's staked Kine MCD amount"},"burn(uint256)":{"notice":"Burn repay equivalent Kine MCD for user and burn specified amount of KUSD Burn will fail if hasn't reach start time."},"burnMax()":{"notice":"BurnMax unstake and repay all borrowed Kine MCD for user and burn equivalent KUSD"},"claimable(address)":{"notice":"Calculate account's claimable rewards so far."},"earned(address)":{"notice":"Calculate account's earned rewards so far."},"getReward()":{"notice":"Claim the matured rewards of caller. Claim will fail if hasn't reach start time."},"lastTimeRewardApplicable()":{"notice":"Current time which hasn't past this round reward's duration."},"liquidate(address,uint256,uint256,address)":{"notice":"Caller liquidates the staker's Kine MCD and seize staker's collateral. Liquidate will fail if hasn't reach start time."},"mint(uint256)":{"notice":"Mint will borrow equivalent Kine MCD for user, stake borrowed MCD and mint specified amount of KUSD. Call will fail if hasn't reached start time. Mint will fail if hasn't reach start time."},"notifyRewardAmount(uint256)":{"notice":"Notify rewards has been added, trigger a new round of reward period, recalculate reward rate and duration end time. If distributor notify rewards before this round duration end time, then the leftover rewards of this round will roll over to next round and will be distributed together with new rewards in next round of reward period."},"rewardPerToken()":{"notice":"Calculate new accrued reward per staked Kine MCD."},"setRewardDistribution(address)":{"notice":"Set reward distributor to new one."},"totalStakes()":{"notice":"Show total staked Kine MCD amount"},"treasuryBurn(uint256)":{"notice":"Burn KUSD from treasury account to keep on-chain KUSD consist with off-chain trading system"},"treasuryMint(uint256)":{"notice":"Mint KUSD to treasury account to keep on-chain KUSD consist with off-chain trading system"}}}},"settings":{"compilationTarget":{"/Users/daixu/KINE/Codes/kine-protocol/contracts/KUSDMinter.sol":"KUSDMinter"},"evmVersion":"istanbul","libraries":{},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"/Users/daixu/KINE/Codes/kine-protocol/contracts/Address.sol":{"keccak256":"0x1a8e5072509c5ea7365eb1d48030b9be865140c8fb779968da0a459a0e174a11","urls":["bzz-raw://03335b7b07c7c8c8d613cfdd8ec39a0b5ec133ee510bf2fe6cc5a496767bef4b","dweb: