nt to use"},"getDeposit(uint256,address)":{"details":"Used to get the deposited amount in a pool"},"getPendingFirst(uint256,address)":{"details":"used to get the pending amount in a pool"},"getPendingSecond(uint256,address)":{"details":"used to get the pending amount in a pool"},"owner()":{"details":"Returns the address of the current owner."},"pause()":{"details":"used to pause the pools being able to deposit new lpToken"},"pausePool(uint256)":{"details":"used to pause a single pool from being able to deposit new lpToken"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"poolLength()":{"details":"returns the current number of pools"},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"transferOwnership()":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"unpause()":{"details":"used to unpause the pools being able to deposit new lpToken"},"unpausePool(uint256)":{"details":"used to unpause a single pool"},"updatePool(uint256)":{"details":"function used to update the rewards of every investor _pid: is the id of the pool that you want to use"},"withdraw(uint256,uint256)":{"details":"used to withdraw the lpToken _pid: is the id of the pool that you want to use _amount: is the amount of tokens that you want to deposit"},"withdrawAll(uint256)":{"details":"used to withdraw all the lpToken _pid: is the id of the pool that you use"}},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"compilationTarget":{"DoubleMaster.sol":"DoubleMaster"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":false,"runs":200},"remappings":[]},"sources":{"