lfilled","params":{"proposalId":"id of the proposal*"}},"claimAdmin()":{"details":"Allows the pendingAdmin address to finalize the change admin process."},"createBinaryProposal(address,address,(address[],uint256[],string[],bytes[],bool[]),uint256,uint256,string)":{"details":"Creates a Binary Proposal (needs to be validated by the Proposal Validator)","params":{"endTime":"end timestamp of the proposal","executionParams":"data for execution, includes   targets list of contracts called by proposal's associated transactions   weiValues list of value in wei for each proposal's associated transaction   signatures list of function signatures (can be empty) to be used when created the callData   calldatas list of calldatas: if associated signature empty,        calldata ready, else calldata is arguments   withDelegatecalls boolean, true = transaction delegatecalls the taget,         else calls the target","executor":"The ExecutorWithTimelock contract that will execute the proposal","link":"link to the proposal description*","startTime":"start timestamp to allow vote","strategy":"voting power strategy of the proposal"}},"createGenericProposal(address,address,string[],uint256,uint256,string)":{"details":"Creates a Generic Proposal (needs to be validated by the Proposal Validator)    It only gets the winning option without any executions","params":{"endTime":"end timestamp of the proposal","executor":"The ExecutorWithTimelock contract that will execute the proposal","link":"link to the proposal description*","options":"list of options to vote for","startTime":"start timestamp to allow vote","strategy":"voting power strategy of the proposal"}},"execute(uint256)":{"details":"Execute the proposal (If Proposal Queued), only for Binary proposals","params":{"proposalId":"id of the proposal to execute*"}},"getDaoOperator()":{"details":"Getter the address of the daoOperator, that can mainly cancel proposals","returns":{"_0":"The address of the daoOperator*"}},"getProposalById(uint256)