leRevoked} event. Requirements: - the caller must be `account`."},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role."}},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"compilationTarget":{"contracts/mockFeeds/ConfigurableOracleMockFactory.sol":"ConfigurableOracleMockFactory"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/GSN/Context.sol":{"keccak256":"0x910a2e625b71168563edf9eeef55a50d6d699acfe27ceba3921f291829a8f938","license":"MIT","urls":["bzz-raw://248246ac66e6479dce1ad7d4945ec5540c98ceb09881e93c93f7c48d5772925c","dweb:/ipfs/QmXr8tmUiZgEYid6ixeeBRmTdUnASWjKzhP3KRxMPy8fRt"]},"@openzeppelin/contracts/access/AccessControl.sol":{"keccak256":"0xa322b8cae9025e521e0cdbad331af3578db8d6841159fc2c857be56582bd76a2","license":"MIT","urls":["bzz-raw://f9ac295d8ec062dbca395a7acd51ccf14b788e890ab66fa2a271e978ef25fb9c","dweb:/ipfs/QmeXZYWA46T7t2hV8yEa64xd57Q1dpHWHMCrmG974Tiyt3"]},"@openzeppelin/contracts/utils/Address.sol":{"keccak256":"0x07779badf9435bce9a95e4527e892d83a2baae798ba87203db0b22679b40ef35","license":"MIT","urls":["bzz-raw://8ec4827fa61b707dcfee9a53dee11d5932aea5a0d6a90a1ea8057bc07031aaf3","dweb:/ipfs/QmUorRKySeykUmC1o1v5D4WdktefGwwLSxXnTxo4AgyAEs"]},"@openzeppelin/contracts/utils/EnumerableSet.sol":{"keccak256":"0x7412b7c3acc6d3b2b6bad1dadc114e96daa3f82947d127f6184c84156720f88c","license":"MIT","urls":["bzz-raw://04bdbd34e97e5ba9ab6a3efcb31558faecbee8c2b99d24936ba3ef5f9e7e4a4f","dweb:/ipfs/QmRYFrwNENNzyzEnphrTwh1ydT9NPzd6d4CB7ZYGLDz3e2"]},"contracts/mockFeeds/ConfigurableOracleMock.sol":{"keccak256":"0x75eefbf12b070896ffdf1496fcfc5e15278c0fac10e08891be9ccb9b83d922c0","license":"GPL-3.0-only","urls":["bzz-raw://b344311a7601cc2dd36ad70df1e644c4eccffaaa3abdc90c8c38b601ed03