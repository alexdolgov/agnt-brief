es, despite {RoleAdminChanged} not being emitted signaling this. _Available since v3.1._"},"RoleGranted(bytes32,address,address)":{"details":"Emitted when `account` is granted `role`. `sender` is the account that originated the contract call, an admin role bearer except when using {AccessControl-_setupRole}."},"RoleRevoked(bytes32,address,address)":{"details":"Emitted when `account` is revoked `role`. `sender` is the account that originated the contract call:   - if using `revokeRole`, it is the admin role bearer   - if using `renounceRole`, it is the role bearer (i.e. `account`)"}},"kind":"dev","methods":{"balanceOf(address)":{"details":"get veLista balance of account (aka user's Voting Power or Weight)","params":{"account":"account address"},"returns":{"_0":"veLista balance of account"}},"balanceOfAtTime(address,uint256)":{"details":"get veLista balance of account at time","params":{"account":"account address","timestamp":"timestamp in second"},"returns":{"_0":"veLista balance of the account"}},"balanceOfAtWeek(address,uint16)":{"details":"get veLista balance of account at week","params":{"account":"account address","week":"week number"},"returns":{"_0":"veLista balance of account"}},"claim()":{"details":"Claim tokens when the lock period is over","returns":{"_0":"claimed amount"}},"claimPenalty()":{"details":"claim penalty collected from early claim, only manager can call this function"},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"disableAutoLock()":{"details":"disable auto lock"},"earlyClaim()":{"details":"claim tokens even if the lock is still ongoing, resulting in a penalty","returns":{"_0":"claimed amount after penalty"}},"enableAutoLock()":{"details":"enable auto lock"},"extendWeek(uint16)":{"details":"extend number of weeks to lock","params":{"_week":"number of weeks to increase of the lock"}},"getCurrentWeek()":{"details":"get current week number","returns":{"_0":"week number array of TokenAmount structs which includes token address an