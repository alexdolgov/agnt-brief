doc":{"kind":"dev","methods":{"allowance(address,address)":{"details":"See {IERC20-allowance}."},"approve(address,uint256)":{"details":"See {IERC20-approve}. Requirements: - `spender` cannot be the zero address."},"balanceOf(address)":{"details":"See {IERC20-balanceOf}."},"balanceOfUnderlying(address)":{"details":"Does not account for penalties and fees","params":{"user":"- address whose claimable amount to query"},"returns":{"amount":"- claimable amount"}},"decimals()":{"details":"Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5,05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the value {ERC20} uses, unless this function is overridden; NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"decreaseAllowance(address,uint256)":{"details":"Atomically decreases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."},"deposit(address,uint256)":{"params":{"_amount":"- the amount of underlying to deposit","_to":"- the address that will receive the shares"},"returns":{"_shares":"- the amount of shares issued"}},"depositAll(address)":{"params":{"_to":"- the address that will receive the shares"},"returns":{"_shares":"- the amount of shares issued"}},"harvest()":{"details":"Can be called by anyone against an incentive in BPTHarvest logic in the strategy contractHarvest can be called even if permissioned when last staker is      withdrawing from the vault."},"harvest(uint256)":{"details":"Can be called by anyone against an incentive in BPTHarvest logic in the strategy contractHarvest can be called even if permissioned when last staker is      withdrawing from the vault.","params":{"_minAmountOut":"- min amount of BPT to receive for harvest"}},"increaseAllowance(address,uint256)":{"details":"Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address."},"name()":{"details":"Returns the name of the token."},"owner()":{"details":"Returns the address of the current owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setCallIncentive(uint256)":{"params":{"_incentive":"- the amount of the new incentive (in BIPS)"}},"setHarvestPermissions(bool)":{"params":{"_status":"Whether or not harvests are permissioned"}},"setPlatform(address)":{"params":{"_platform":"- the new platform wallet address"}},"setPlatformFee(uint256)":{"params":{"_fee":"- the amount of the new platform fee (in BIPS)"}},"setStrategy(address)":{"details":"Can only be set once","params":{"_strategy":"- address of the strategy contract"}},"setWithdrawalPenalty(uint256)":{"params":{"_penalty":"- the amount of the new penalty (in BIPS)"}},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"totalUnderlying()":{"returns":{"total":"- the total amount of tokens staked"}},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `recipient` cannot be the zero address. - the caller must have a balance of at least `amount`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. Requirements: - `sender` and `recipient` cannot be the zero address. - `sender` must have a balance of at least `amount`. - the caller must have allowance for ``sender``'s tokens of at least `amount`."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateAuthorizedHarvesters(address,bool)":{"params":{"_authorized":"Whether to add or remove harvester","_harvester":"address of the authorized harvester"}},"withdraw(address,uint256)":{"params":{"_shares":"- the number of shares sent","_to":"- address to send underlying to"},"returns":{"withdrawn":"- the amount of underlying returned to the user"}},"withdrawAll(address)":{"params":{"_to":"- address to send underlying to"},"returns":{"withdrawn":"- the amount of underlying returned to the user"}}},"version":1},"userdoc":{"kind":"user","methods":{"balanceOfUnderlying(address)":{"notice":"Returns the amount of underlying a user can claim"},"deposit(address,uint256)":{"notice":"Deposit user funds in the autocompounder and mints tokens representing user's share of the pool in exchange"},"depositAll(address)":{"notice":"Deposit all of user's underlying balance"},"harvest()":{"notice":"Claim rewards and swaps them to auraBAL for restaking"},"harvest(uint256)":{"notice":"Claim rewards and swaps them to auraBAL for restaking"},"setCallIncentive(uint256)":{"notice":"Updates the caller incentive for harvests"},"setHarvestPermissions(bool)":{"notice":"Sets whether only whitelisted addresses can harvest"},"setPlatform(address)":{"notice":"Updates the address to which platform fees are paid out"},"setPlatformFee(uint256)":{"notice":"Updates the part of yield redirected to the platform"},"setStrategy(address)":{"notice":"Set the address of the strategy contract"},"setWithdrawalPenalty(uint256)":{"notice":"Updates the withdrawal penalty"},"totalUnderlying()":{"notice":"Query the amount currently staked"},"updateAuthorizedHarvesters(address,bool)":{"notice":"Adds or remove an address from the harvesters' whitelist"},"withdraw(address,uint256)":{"notice":"Unstake underlying token in proportion to the amount of shares sent"},"withdrawAll(address)":{"notice":"Withdraw all of a users' position as underlying"}},"version":1}},"settings":{"compilationTarget":{"AuraBalVault.sol":"AuraBalVault"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"Address.sol":{"keccak256":"0xd217e5030771ed77e0df8d1028f05abdaba7df6991fc6e03229d8624c1999d9a","license":"MIT","urls":["bzz-raw://6f918396df8f3717ca4d2f978757604eb540b256a87e898e30105fab09010666","dweb:/ipfs/QmczhRz4N5D1vfWU1EGAGStDP57zNMLmqde9GBW3eFbAHR"]},"AuraBalVault.sol":{"keccak256":"0xa83d3cea0149e18bd6b3a4375d022d37df468e2e8d2689d3846f3f555512a731","license":"MIT","urls":["bzz-raw://9b6e99d77b35ae484ec8b9c0ad885602bd33934242201e868d02d7abae245ddc","dweb:/ipfs/QmZRRFHS5VCgV5mYgbbbAo5SFuFommdviJX1CA9fhz1Cxw"]},"Context.sol":{"keccak256":"0xba6ddba08488c0fd0249ecbf73d94db554b664e5460e05335633d38988fb1947","license":"MIT","urls":["bzz-raw://8d39e2090185cd7852447d004adb908b40e2c7adc8831ee1a7d6eb6dea664ddc","dweb:/ipfs/QmQZPEkHcJ8hbEbRr8vvUrCWPs7XRBmwLXbUQc9Mmx39Lx"]},"ERC20.sol":{"keccak256":"0x96a805491bfc0015f01477c5d7f6d5fce283f5c499803f4e2541fdd6f9d15912","license":"MIT","urls":["bzz-raw://5673142ee871d268902ac808619c7911709576e9346e9c3e1b6e3d8f69a35607","dweb:/ipfs/QmS8QRvah4u82fH5fnB9q2SdwUsJ9hvc88QkHv6EXYhhM2"]},"GenericVault.sol":{"keccak256":"0xbb53ceadbcaac2d143eb0a0db4511a2a48e3571a88acf432c458fe4ef54de27a","license":"MIT","urls":["bzz-raw://36acd148cd73fc18b3520135be443ca179e86917e8433e14e