d} event."},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"upgradeTo(address)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."}},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"compilationTarget":{"contracts/Vault.sol":"Vault"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":10},"remappings":[":@yearn-protocol/=lib/yearn-vaults/"],"viaIR":true},"sources":{"@layerzerolabs/solidity-examples/contracts/contracts-upgradable/interfaces/ILayerZeroEndpointUpgradeable.sol":{"keccak256":"0x748e7abf8908f264c6fff8ea7730b1766ab5a262be7962404f7d263066b41487","license":"MIT","urls":["bzz-raw://a1c4c133ab152ff19cf1e06c7a07f1355561fde09f1257bc9b0f623121dce97d","dweb:/ipfs/QmQrVfnpeZz33YkcLBVHWQu9n6q2GenZC6R6Fn8HXGYN29"]},"@layerzerolabs/solidity-examples/contracts/contracts-upgradable/interfaces/ILayerZeroReceiverUpgradeable.sol":{"keccak256":"0x6ce5593a1247719f7209cad8068573c249674b41b859c6379ace1baaea0ed2a3","license":"MIT","urls":["bzz-raw://c9a1ddf18121ad519f07063656ecdf25036f9678e7b8290d6dc87b55fb8b992c","dweb:/ipfs/QmcptHqKR2qenyhYFwQAfzrfSrQCKZgpKu2jMfMhBjKcJ2"]},"@layerzerolabs/solidity-examples/contracts/contracts-upgradable/interfaces/ILayerZeroUserApplicationConfigUpgradeable.sol":{"keccak256":"0xa808baa32db12c453b982320e0c9a8c07aec8c0f3bb36ac2ed26f3ad47476879","license":"MIT","urls":["bz