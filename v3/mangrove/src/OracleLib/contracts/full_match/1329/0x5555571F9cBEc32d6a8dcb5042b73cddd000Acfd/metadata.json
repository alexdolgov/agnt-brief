{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[{"components":[{"internalType":"bool","name":"isStatic","type":"bool"},{"internalType":"contract IOracle","name":"oracle","type":"IOracle"},{"internalType":"int24","name":"staticValue","type":"int24"},{"internalType":"uint16","name":"maxDeviation","type":"uint16"},{"internalType":"uint40","name":"proposedAt","type":"uint40"},{"internalType":"uint8","name":"timelockMinutes","type":"uint8"}],"internalType":"struct OracleData","name":"self","type":"tuple"},{"internalType":"uint256","name":"baseAmount","type":"uint256"},{"internalType":"uint256","name":"quoteAmount","type":"uint256"}],"name":"acceptsInitialMint","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"components":[{"internalType":"bool","name":"isStatic","type":"bool"},{"internalType":"contract IOracle","name":"oracle","type":"IOracle"},{"internalType":"int24","name":"staticValue","type":"int24"},{"internalType":"uint16","name":"maxDeviation","type":"uint16"},{"internalType":"uint40","name":"proposedAt","type":"uint40"},{"internalType":"uint8","name":"timelockMinutes","type":"uint8"}],"internalType":"struct OracleData","name":"self","type":"tuple"},{"internalType":"bool","name":"isSell","type":"bool"},{"internalType":"uint256","name":"received","type":"uint256"},{"internalType":"uint256","name":"sent","type":"uint256"}],"name":"acceptsTrade","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"}],"devdoc":{"author":"Mangrove","details":"Provides functionality to:      - Retrieve current tick values from static or dynamic sources      - Validate trading positions against oracle-defined price ranges      - Enforce timelock periods for oracle configuration changes","kind":"dev","methods":{"acceptsInitialMint(OracleData,uint256,uint256)":{"details":"This function is public (not internal) because it uses TickLib which is a large library.      Making it internal to contracts would largely increase their bytecode size.      The function calculates the tick from the base/quote ratio and validates it's within deviation limits.","params":{"baseAmount":"The amount of base tokens in the initial mint","quoteAmount":"The amount of quote tokens in the initial mint","self":"The oracle data configuration"},"returns":{"_0":"True if the mint ratio is within acceptable oracle deviation, false otherwise"}},"acceptsTrade(OracleData,bool,uint256,uint256)":{"details":"This function is public (not internal) because it uses TickLib which is a large library.      Making it internal to contracts would largely increase their bytecode size.      The function calculates the trade tick from volumes and validates it against oracle constraints.","params":{"isSell":"True if selling base token for quote token, false if buying base with quote","received":"The amount of tokens received from the trade","self":"The oracle data configuration","sent":"The amount of tokens sent in the trade"},"returns":{"_0":"True if the trade tick is within acceptable oracle range, false otherwise"}}},"title":"OracleLib","version":1},"userdoc":{"kind":"user","methods":{"acceptsInitialMint(OracleData,uint256,uint256)":{"notice":"Validates if an initial mint operation is acceptable based on oracle price constraints"},"acceptsTrade(OracleData,bool,uint256,uint256)":{"notice":"Validates if a trade is acceptable based on oracle price constraints"}},"notice":"Library for managing oracle data and price validation","version":1}},"settings":{"compilationTarget":{"src/libraries/OracleLib.sol":"OracleLib"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":10},"remappings":[":@mgv-strats/lib/=lib/mangrove-strats/lib/",":@mgv-strats/script/=lib/mangrove-strats/script/",":@mgv-strats/src/=lib/mangrove-strats/src/",":@mgv-strats/test/=lib/mangrove-strats/test/",":@mgv/forge-st