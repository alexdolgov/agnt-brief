n, the flipped OLKey is used for the opposite offer list."},"returns":{"kandel":"the Kandel contract."}}},"version":1},"userdoc":{"events":{"NewCompoundKandel(address,bytes32,bytes32,address,address)":{"notice":"a new Kandel with Compound V2 router has been deployed.By emitting this data, an indexer will be able to keep track of what Kandel strats are deployed, what market its deployed on, who the owner is and what reserve they use."},"NewTakaraKandel(address,bytes32,bytes32,address,address)":{"notice":"a new Kandel with Takara router has been deployed.By emitting this data, an indexer will be able to keep track of what Kandel strats are deployed, what market its deployed on, who the owner is and what reserve they use."}},"kind":"user","methods":{"KANDEL_GASREQ()":{"notice":"the gasreq to use for offers."},"MGV()":{"notice":"The Mangrove deployment."},"routerDeployer()":{"notice":"The router deployer contract"},"sow((address,address,uint256),bool)":{"notice":"deploys a new Kandel contract for the given seed parameters."}},"version":1}},"settings":{"compilationTarget":{"src/strategies/offer_maker/market_making/kandel/compound/takara/TakaraKandelSeeder.sol":"TakaraKandelSeeder"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100},"remappings":[":@mgv-strats/lib/=lib/",":@mgv-strats/script/=script/",":@mgv-strats/src/=src/",":@mgv-strats/test/=test/",":@mgv/forge-std/=node_modules/@mangrovedao/mangrove-core/lib/forge-std/src/",":@mgv/lib/=node_modules/@mangrovedao/mangrove-core/lib/",":@mgv/script/=node_modules/@mangrovedao/mangrove-core/script/",":@mgv/src/=node_modules/@mangrovedao/mangrove-core/src/",":@mgv/test/=node_modules/@mangrovedao/mangrove-core/test/",":@openzeppelin/contracts/=lib/openzeppelin/contracts/",":@orbit-protocol/contracts/=lib/orbit-protocol/contracts/",":@uniswap/lib/=node_modules/@uniswap/lib/",":@uniswap/v2-core/=node_modules/@uniswap/v2-core/",":@uniswap/v3-core/=node_modules/@uniswap