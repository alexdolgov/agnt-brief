ts":[{"internalType":"uint24","name":"provision","type":"uint24"}],"name":"setProvisions","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"address","name":"from","type":"address"}],"name":"settle","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"address","name":"receiver","type":"address"}],"name":"take","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[{"internalType":"address","name":"token","type":"address"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"address","name":"receiver","type":"address"}],"name":"withdrawFees","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"errors":{"AlreadyInitialized()":[{"details":"Cannot double-initialize."}],"AmountOverflow()":[{"details":"throws when attempting to take/settle an amount that overflows"}],"NewOwnerIsZeroAddress()":[{"details":"The `newOwner` cannot be the zero address."}],"NoHandoverRequest()":[{"details":"The `pendingOwner` does not have a valid handover request."}],"UnableToSettleNative()":[{"details":"throws when attempting to settle native with incorrect `msg.value` or `from` is not the caller"}],"Unauthorized()":[{"details":"The caller is not authorized to call the function."}]},"events":{"OwnershipHandoverCanceled(address)":{"details":"The ownership handover to `pendingOwner` has been canceled."},"OwnershipHandoverRequested(address)":{"details":"An ownership handover to `pendingOwner` has been requested."},"OwnershipTransferred(address,address)":{"details":"The ownership is transferred from `oldOwner` to `newOwner`. This event is intentionally kept the same as OpenZeppelin's Ownable to be compatible with indexers and [EIP-173](https://eips.ethereum.org/EIPS/eip-173), despite it not being as lightweight as a single argument event."}},"kind":"dev","methods":{"authorize(address,bool)":{"details":"Suitable for immediate changes; access control is implementation-specific.","params":{"authorized":"Delegate being granted/revoked privileges.","value":"`true` to grant, `false` to revoke."}},"authorizeWithSig((address,address,bool,uint256,uint256),bytes)":{"details":"Requirements: valid signature by `authorization.authorizer`, `block.timestamp <= authorization.deadline`, and expected `nonce`.","params":{"authorization":"The typed authorization payload.","signature":"EIP-712 signature by `authorization.authorizer`."}},"cancel(bytes32,uint40)":{"details":"Cancels the offer if live, claims remaining promised outbound, any received inbound, and the provision. Effects accrue via flash accounting and must be settled before the end of the surrounding `lock`.","params":{"market":"The market identifier.","offerId":"The offer to cancel."},"returns":{"inbound":"The inbound amount claimed.","outbound":"The remaining outbound (promised) amount returned.","provision":"The provision returned."}},"cancelOwnershipHandover()":{"details":"Cancels the two-step ownership handover to the caller, if any."},"claim(bytes32,uint40)":{"details":"If the offer is not live anymore or has expired (but not yet cleaned), this also retracts the offer and returns the remaining promised amount and provision. Effects are accrued via flash accounting and must be settled before the end of the surrounding `lock`.","params":{"market":"The market identifier.","offerId":"The offer to claim from."},"returns":{"inbound":"The claimed inbound amount.","outbound":"The remaining outbound (promised) amount returned if retracted.","provision":"The provision returned if retracted."}},"clean(bytes32,uint40)":{"details":"Performs only flash-accounting updates; settle after within the `lock`.","params":{"market":"The market identifier.","offerId":"The offer to clean if expired."},"returns":{"bounty":"Native tokens awarded for cleaning.","success":"True if the offer was cleaned."}},"clear(address,uint256)":{"details":"For native token use `address(0)`.All cleared funds will be donated as protocol fees.This function is meant to be called on dust credits that would be otherwise too expensive to transfer.The exact amount to be cleared has to be determined by the caller to ensure not creating debt or not clearing enough.","params":{"amount":"The amount to clear.","token":"The token address (or `address(0)` for native) to clear."}},"completeOwnershipHandover(address)":{"details":"Allows the owner to complete the two-step ownership handover to `pendingOwner`. Reverts if there is no existing ownership handover requested by `pendingOwner`."},"constructor":{"params":{"owner":"The owner of the vif contract","provision":"The provision of the vif contract"}},"consume(address,bytes32,int24,uint256,bool,uint256)":{"details":"`maxTick` caps the per-offer price: stop when an offer's tick exceeds it; use `type(int24).max` for no cap. `fillVolume` is the exact volume to send if `fillWants == false` (exact-inbound), or the exact volume to receive if `fillWants == true` (exact-outbound). `maxOffers` bounds the number of consumed offers to control gas. Fees are paid by the taker in the inbound token and reported as `fee` (denominated in the sent token). Effects use flash accounting and must be settled after.","params":{"fillVolume":"Exact volume to send (if `fillWants == false`) or receive (if `true`).","fillWants":"Whether `fillVolume` represents outbound received (`true`) or inbound sent (`false`).","market":"The market identifier.","maxOffers":"Maximum number of offers to consume.","maxTick":"The maximum acceptable per-offer tick.","taker":"The taker account; must be the caller or have delegated authorization."},"returns":{"bounty":"Native tokens awarded for cleaning expired offers during execution.","fee":"Fee paid by the taker (denominated in sent tokens).","gave":"Tokens sent by the taker (inbound).","got":"Tokens received by the taker (outbound)."}},"eip712Domain()":{"details":"See: https://eips.ethereum.org/EIPS/eip-5267"},"extsload(bytes32)":{"details":"function signature: 0x1e2eaeaf","params":{"slot":"The storage slot to read"},"returns":{"_0":"The 32-byte value at the given slot"}},"exttload(bytes32)":{"details":"function signature: 0xf135baaa","params":{"slot":"The storage slot to read"},"returns":{"_0":"The 32-byte value at the given slot"}},"initialize(address,uint24)":{"details":"initializes the vif contractinitializes the owner and the provisioncan only be called once, then reverts","params":{"owner":"The owner of the vif contract","provision":"The provision of the vif contract"}},"lock(bytes)":{"details":"Caller must implement `ILockCallback`. Inside the callback, actions that modify state accrue transient debts/credits instead of moving tokens. The call reverts if, after the callback, global per-token balances are not net zero.","params":{"data":"Arbitrary data forwarded to the caller's `lockCallback(bytes)`."},"returns":{"result":"The return data from the callback if accounting is balanced."}},"make(address,bytes32,uint40,uint256,int24,uint32,uint24)":{"details":"If `initialOfferId == 0`, a new offer is created; otherwise the existing offer identified by `initialOfferId` is edited. Each offer is immutably bound to its original `maker`; edits must use the same `maker`. Tick is the log base 1.00001 (0.1 bps) of price where price = inboundAmount / outboundAmount. A better price for the maker implies a higher `tick`. `gives` is rounded down to a multiple of the market's `outboundUnits`: gives := floor(gives / outboundUnits) * outboundUnits. Callers must handle that the actually debited `gives` may be lower than requested. Optional expiry (in seconds) can be set via `expiry` (0 for none). If an expiry is set, a provision is required and will be floored up to the global provision requirement; `provision` is specified in provision units. The effective `gives` must satisfy the market minimum volume: effectiveGives >= minOutboundUnits * outboundUnits, otherwise the call reverts. All effects accrue to flash-accounting balances and must be settled before the end of the surrounding `lock`. This function also claims received amount if the offer is edited.","params":{"expiry":"Optional expiry timestamp (0 for none).","gives":"Outbound amount (rounded down to `outboundUnits`).","initialOfferId":"0 to create, or the existing offer id to edit.","maker":"The offer owner; must match the original owner when editing.","market":"The market identifier.","provision":"Provision in provision units; required/floored if `expiry` > 0.","tick":"Log-price in 0.1 bps ticks; higher means better for maker, rounded towards 0 to the closest tick according to the tick spacing."},"returns":{"claimedReceived":"The claimed received amount.","offerId":"The created or updated offer id."}},"openMarket(address,address,uint64,uint64,uint16,uint16,uint32)":{"details":"Id is `keccak256(abi.encode(outboundToken, outboundUnits, inboundToken, inboundUnits, tickSpacing))`. Units are best set to powers of 10 for readability. Fees are scaled on 16 bits where 100% = 1e6.","params":{"fees":"Initial taker fee parameter (scaled; max ~6.5%).","inboundToken":"The inbound token address.","inboundUnits":"Denomination for inbound amounts (prefer power of 10).","minOutboundUnits":"Minimum normalized outbound units per offer.","outboundToken":"The outbound token address.","outboundUnits":"Denomination for outbound amounts (prefer power of 10).","tickSpacing":"The tick spacing for the market."},"returns":{"marketId":"The derived market id."}},"owner()":{"details":"Returns the owner of the contract."},"ownershipHandoverExpiresAt(address)":{"details":"Returns the expiry timestamp for the two-step ownership handover to `pendingOwner`."},"renounceOwnership()":{"details":"Allows the owner to renounce their ownership."},"requestOwnershipHandover()":{"details":"Request a two-step ownership handover to the caller. The request will automatically expire in 48 hours (172800 seconds) by default."},"setActive(bytes32,bool)":{"details":"When inactive, no new orders or market orders; claims/deletions allowed.","params":{"active":"The new status.","marketId":"The market id."}},"setBlacklisted(address,bool)":{"params":{"blacklisted":"The new blacklisted state.","user":"The user to set the blacklisted state for."}},"setFees(bytes32,uint16)":{"details":"Fees are in 16-bit scale where 100% = 1e6 (max ~6.5%).","params":{"fees":"The new fee parameter.","marketId":"The market id."}},"setMinOutboundUnits(bytes32,uint32)":{"params":{"marketId":"The market id.","minOutboundUnits":"The new minimum normalized outbound units."}},"setPaused(bool)":{"params":{"paused":"The new paused state."}},"setProvisions(uint24)":{"params":{"provision":"The provision floor in provision units."}},"settle(address,uint256,address)":{"details":"Applies to global per-token debt/credit. For native token use `address(0)` and attach `msg.value` as needed. Access control and accounting rules are implementation-specific.","params":{"amount":"The amount to settle against current debt.","from":"The address to pull funds from (ignored for native with `msg.value`).","token":"The token address (or `address(0)` for native) to settle."}},"take(address,uint256,address)":{"details":"Applies to global per-token debt/credit. For native token use `address(0)`.","params":{"amount":"The amount to send to `receiver` against current credit.","receiver":"The address receiving the funds.","token":"The token address (or `address(0)` for native) to send."}},"transferOwnership(address)":{"details":"Allows the owner to transfer the ownership to `newOwner`."},"withdraw