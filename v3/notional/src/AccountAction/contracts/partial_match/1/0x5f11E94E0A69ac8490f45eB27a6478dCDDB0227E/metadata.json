en(address,uint16,uint256)":{"details":"emit:CashBalanceChange emit:AccountContextUpdateauth:none","params":{"account":"the account to deposit into","amountExternalPrecision":"the amount of asset tokens in its native decimal precision (i.e. 8 decimals for cTokens).","currencyId":"currency id of the asset token"},"returns":{"_0":"asset tokens minted and deposited to the account in internal decimals (8)"}},"depositUnderlyingToken(address,uint16,uint256)":{"details":"emit:CashBalanceChange emit:AccountContextUpdateauth:none","params":{"account":"the account to deposit into","amountExternalPrecision":"the amount of underlying tokens in its native decimal precision (i.e. 18 decimals for DAI or 6 decimals for USDC). This will be converted to 8 decimals during transfer.","currencyId":"currency id of the asset token that wraps this underlying"},"returns":{"_0":"asset tokens minted and deposited to the account in internal decimals (8)"}},"enableBitmapCurrency(uint16)":{"details":"emit:AccountSettled emit:AccountContextUpdateauth:msg.sender","params":{"currencyId":"the currency to enable the bitmap for. If set to zero then will attempt to disable the bitmap portfolio for the account"}},"settleAccount(address)":{"details":"emit:AccountSettled emit:AccountContextUpdateauth:none","params":{"account":"the account to settle"},"returns":{"_0":"returns true if account has been settled"}},"withdraw(uint16,uint88,bool)":{"details":"emit:CashBalanceChange emit:AccountContextUpdateauth:msg.sender","params":{"amountInternalPrecision":"the amount of cash balance in internal 8 decimal precision to withdraw, this is be denominated in asset cash.","currencyId":"currency id of the asset token","redeemToUnderlying":"true if the tokens should be converted to underlying assets"},"returns":{"_0":"the amount of tokens received by the account denominated in the destination token precision (if"}}},"version":1},"userdoc":{"kind":"user","methods":{"depositAssetToken(address,uint16,uint256)":{"notice":