 proxy address).This method has a `payable` modifier to allow for the calling context to have a `msg.value` set, but should never refer to `msg.value` itself for any of its internal methods.","params":{"dexId":"the dex to execute the trade on","dynamicSlippageLimit":"the slippage limit in 1e8 precision","trade":"trade object"},"returns":{"amountBought":"amount of tokens purchased","amountSold":"amount of tokens sold"}},"getExecutionData(uint16,address,(uint8,address,address,uint256,uint256,uint256,bytes))":{"params":{"dexId":"enum representing the id of the dex","from":"address for the contract executing the trade","trade":"trade object"},"returns":{"executionCallData":"encoded call data for the trade","msgValue":"amount of ETH to transfer to the target, if any","spender":"the address to approve for the soldToken, will be address(0) if the send token is ETH and therefore does not require approval","target":"contract to execute the call against"}},"getOraclePrice(address,address)":{"params":{"baseToken":"address of the first token in the pair, i.e. USDC in USDC/DAI","quoteToken":"address of the second token in the pair, i.e. DAI in USDC/DAI"},"returns":{"answer":"exchange rate in rate decimals","decimals":"number of decimals in the rate, currently hardcoded to 1e18"}},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate that the this implementation remains valid after an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"upgradeTo(address)":{"details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."}},"version":1},"userdoc":{"kind":"user","methods":{"canExecuteTrade(address,uint16,(uint8,address,address,uint256,uint256,uint256,bytes))":{"notice":"Check if the caller is allowed to execute the provided trade object"},"executeTrade(uint16,(uint8,address,address,uint256,uint256,uint256,bytes))":{"notice":"Should be called via delegate call to execute a trade on behalf of the caller."},"executeTradeWithDynamicSlippage(uint16,(uint8,address,address,uint256,uint256,uint256,bytes),uint32)":{"notice":"Executes a trade with a dynamic slippage limit based on chainlink oracles."},"getExecutionData(uint16,address,(uint8,address,address,uint256,uint256,uint256,bytes))":{"notice":"Called to receive execution data for vaults that will execute trades without delegating calls to this contract"},"getOraclePrice(address,address)":{"notice":"Returns the Chainlink oracle price between the baseToken and the quoteToken, the Chainlink oracles. The quote currency between the oracles must match or the conversion in this method does not work. Most Chainlink oracles are baseToken/USD pairs."}},"notice":"TradingModule is meant to be an upgradeable contract deployed to help Strategy Vaults exchange tokens via multiple DEXes as well as receive price oracle information","version":1}},"settings":{"compilationTarget":{"contracts/trading/TradingModule.sol":"TradingModule"},"evmVersion":"cancun","libraries":{"contracts/vaults/common/StrategyUtils.sol:StrategyUtils":"0xe78d09c8b6ccf9c1732d14353a708b75f6c67c67"},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@contracts/=contracts/",":@deployments/=contracts/global/mainnet/",":@interfaces/=interfaces/",":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/",":@