nt256"}],"stateMutability":"payable","type":"function"}],"devdoc":{"kind":"dev","methods":{"deleverageAccount(address,address,address,uint256,bool,bytes)":{"params":{"account":"the address that will exit the vault","depositAmountExternal":"amount of asset cash to deposit","liquidator":"the address that will receive profits from liquidation","redeemData":"calldata sent to the vault when redeeming liquidator profits","transferSharesToLiquidator":"transfers the shares to the liquidator instead of redeeming them","vault":"the vault to enter"},"returns":{"profitFromLiquidation":"amount of vaultShares or cash received from liquidation"}},"enterVault(address,address,uint256,uint256,uint256,uint32,bytes)":{"params":{"account":"the address that will enter the vault","depositAmountExternal":"some amount of additional collateral in the borrowed currency to be transferred to vault","fCash":"amount to borrow","maturity":"the maturity to borrow at","maxBorrowRate":"maximum interest rate to borrow at","vault":"the vault to enter","vaultData":"additional data to pass to the vault contract"},"returns":{"strategyTokensAdded":"the total strategy tokens added to the maturity, including any tokens from settlement. Allows enterVault to be used by off-chain methods to get an accurate simulation of the strategy tokens minted."}},"exitVault(address,address,address,uint256,uint256,uint32,bytes)":{"params":{"account":"the address that will exit the vault","exitVaultData":"passed to the vault during exit","fCashToLend":"amount of fCash to lend","minLendRate":"the minimum rate to lend at","receiver":"the address that will receive profits","vault":"the vault to enter","vaultSharesToRedeem":"amount of vault tokens to exit, only relevant when exiting pre-maturity"},"returns":{"underlyingToReceiver":"amount of underlying tokens returned to the receiver on exit"}},"rollVaultPosition(address,address,uint256,uint256,uint256,uint32,uint32,bytes)":{"params":{"account":"the address that will reenter the vault","depositAmountExternal":"amount to deposit into the new maturity","fCashToBorrow":"amount of fCash to borrow in the next maturity","maturity":"new maturity to borrow at","maxBorrowRate":"slippage protection for new borrow position","minLendRate":"slippage protection for repaying debts","vault":"the vault to reenter"},"returns":{"strategyTokensAdded":"the total strategy tokens added to the maturity, including any tokens rolled from the previous maturity.. Allows rollVaultPosition to be used by off-chain methods to get an accurate simulation of the strategy tokens minted."}}},"version":1},"userdoc":{"kind":"user","methods":{"deleverageAccount(address,address,address,uint256,bool,bytes)":{"notice":"If an account is below the minimum collateral ratio, this method wil deleverage (liquidate) that account. `depositAmountExternal` in the borrow currency will be transferred from the liquidator and used to offset the account's debt position. The liquidator will receive either vaultShares or cash depending."},"enterVault(address,address,uint256,uint256,uint256,uint32,bytes)":{"notice":"Borrows a specified amount of fCash in the vault's borrow currency and deposits it all plus the depositAmountExternal into the vault to mint strategy tokens."},"exitVault(address,address,address,uint256,uint256,uint32,bytes)":{"notice":"Prior to maturity, allows an account to withdraw their position from the vault. Will redeem some number of vault shares to the borrow currency and close the borrow position by lending `fCashToLend`. Any shortfall in cash from lending will be transferred from the account, any excess profits will be transferred to the account. Post maturity, will net off the account's debt against vault cash balances and redeem all remaining strategy tokens back to the borrowed currency and transfer the profits to the account."},"getVaultAccount(address,address)":{"notice":"View Methods *"},"rollVaultPosition(address,address,uint256,uint256,uint256,uint32,uint32,bytes)":{"no