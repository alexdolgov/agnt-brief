tier. ","returns":{"_0":"globalIndex A uint96 array containing the updated global index for each tier.","_1":"adjustedShares A uint128 array containing the updated shares for each tier reflecting the amount of staked ETH in the liquidity pool."}},"claim(uint256)":{"details":"This function allows users to claim the rewards + a new tier, if eligible.","params":{"_tokenId":"The ID of the membership NFT."}},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"owner()":{"details":"Returns the address of the current owner."},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"recoverTierPointsForEap(uint256,uint32)":{"params":{"_eapDepositBlockNumber":"the block number at which the user deposited into the EAP","_tokenId":"The ID of the membership NFT."}},"recoverTierPointsForEapBatch(uint256[],uint32[])":{"params":{"_eapDepositBlockNumbers":"The block numbers at which the users deposited into the EAP","_tokenIds":"The IDs of the membership NFT."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setMaxDepositTopUpPercent(uint8)":{"params":{"_percent":"integer percentage value"}},"setMinDepositWei(uint56)":{"params":{"_valu