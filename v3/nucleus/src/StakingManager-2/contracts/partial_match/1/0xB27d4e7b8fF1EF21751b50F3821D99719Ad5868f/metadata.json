ds(uint256[],bool)":{"notice":"Allows depositing multiple stakes at once"},"batchDepositWithBidIds(uint256[],uint256,address,address,address,uint8,bool,uint256)":{"notice":"Allows depositing multiple stakes at once"},"batchRegisterValidators(bytes32,uint256[],(bytes,bytes,bytes32,string)[])":{"notice":"Batch creates validator object, mints NFTs, sets NB variables and deposits into beacon chain"},"batchRegisterValidators(bytes32,uint256[],address,address,(bytes,bytes,bytes32,string)[],address)":{"notice":"Creates validator object, mints NFTs, sets NB variables and deposits 1 ETH into beacon chain"},"getEtherFiNodeBeacon()":{"notice":"Fetches the address of the beacon contract for future EtherFiNodes (withdrawal safes)"},"getImplementation()":{"notice":"Fetches the address of the implementation contract currently being used by the proxy"},"implementation()":{"notice":"Fetches the address of the implementation contract currently being used by the beacon proxy"},"initialize(address,address)":{"notice":"Initialize to set variables on deployment"},"registerBNFTContract(address)":{"notice":"Instantiates the BNFT interface"},"registerTNFTContract(address)":{"notice":"Instantiates the TNFT interface"},"setEtherFiNodesManagerAddress(address)":{"notice":"Sets the EtherFi node manager contract"},"setLiquidityPoolAddress(address)":{"notice":"Sets the Liquidity pool contract address"},"setMaxBatchDepositSize(uint128)":{"notice":"Sets the max number of deposits allowed at a time"},"updateAdmin(address,bool)":{"notice":"Updates the address of the admin"},"upgradeEtherFiNode(address)":{"notice":"Upgrades the etherfi node"}},"version":1}},"settings":{"compilationTarget":{"src/StakingManager.sol":"StakingManager"},"evmVersion":"paris","libraries":{"src/libraries/DepositRootGenerator.sol:depositRootGenerator":"0x9f4c278a83928494bdaea44be5afc99015076776"},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":2000},"remappings":[":@eigenlayer/=lib/eigenlayer-contracts/src