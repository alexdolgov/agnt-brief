s.","amountXOPNToUserForGETMigration_":"The amount of XOPN tokens allocated to the user as a result of GET token migration. This appears to be a duplicate or incorrectly named return value based on the provided context and might need correction.","amountXOPNToUserForXGETMigration_":"The amount of XOPN tokens allocated to the user for the redemption and migration of XGET tokens."}},"returnCurrentStakeRate()":{"returns":{"_0":"The current stake rate, scaled by 1e18 for precision."}},"returnMigrateDualTokenOutput(uint256,uint256)":{"details":"This function provides a preview of the migration results without actually performing the migration. It's useful for users to understand the benefits of migrating their tokens.","params":{"_amountGET":"The amount of GET tokens the user intends to migrate.","_amountXGET":"The amount of XGET tokens the user intends to redeem and migrate."},"returns":{"amountGETRedeemedByXGET_":"The amount of GET tokens redeemed from the XGET tokens provided.","amountOPNStakedForGETMigration_":"The amount of OPN tokens that will be staked as a result of GET token migration.","amountOPNToUserForGETMigration_":"The amount of OPN tokens the user will receive for the migration of GET tokens.","amountXOPNToUserForGETMigration_":"The amount of XOPN tokens allocated to the user as a result of GET token migration. This appears to be a duplicate or incorrectly named return value based on the provided context and might need correction.","amountXOPNToUserForXGETMigration_":"The amount of XOPN tokens the user will receive for the redemption and migration of XGET tokens."}},"returnStakeRateAtTime(uint256)":{"params":{"_timestamp":"The Unix timestamp for which the stake rate is requested."},"returns":{"_0":"The stake rate at the specified timestamp, scaled by 1e18 for precision."}},"returnTotalAmountGETFromXGETRedemptionMigrated()":{"details":"This function provides a view into the total effectiveness and participation in the migration process, specifically focusing on the XGET to GET redemption aspect. It allows external entities to query the total amount of GET tokens that have been successfully redeemed from XGET tokens, offering insights into the volume of tokens processed in this part of the migration.","returns":{"_0":"The total amount of GET tokens that have been redeemed from XGET tokens as part of the migration process. This includes all GET tokens obtained through the redemption of XGET tokens, across all participants in the migration."}},"setAddressConfig(address,address,address)":{"details":"This function is intended for administrative use to set up or update the contract addresses involved in the migration process. It allows for the configuration of the main OPN token address, the xOPN token address, and the OPN Mint Manager address in a single transaction.","params":{"_openToken":"The address of the OPN token contract. This token represents the primary asset being migrated.","_opnMintManager":"The address of the OPN Mint Manager contract. This contract is responsible for managing the minting of OPN tokens during the migration process.","_xOpenToken":"The address of the xOPN token contract. This token represents a secondary or derivative asset involved in the migration."}},"setMigrationActive(bool)":{"details":"Only callable by the admin. Controls whether the migration is allowed to proceed.","params":{"_setting":"A boolean value to activate (`true`) or deactivate (`false`) the migration."}},"totalGETMigratedInTotal()":{"returns":{"_0":"The total amount of GET tokens migrated to OPN."}},"totalOPNMinted()":{"returns":{"_0":"The total number of OPN tokens minted as a result of migration."}},"totalOPNStakedByTheMigration()":{"returns":{"_0":"The total amount of OPN tokens staked during the migration process."}},"totalOPNSupply()":{"returns":{"_0":"The total supply of OPN tokens."}},"totalXGETRedeemedInTotal()":{"returns":{"_0":"The total number of XGET tokens redeemed during the migration process."}},"totalXOPNSupply()":{"returns":{"_0":"The total supply of XOPN tokens."}}},"version":1},"userdoc":{"kind":"user","methods":{"migrateDualTokens(uint256,uint256)":{"notice":"Migrates specified amounts of GET and XGET tokens to OPN and XOPN tokens, respectively."},"returnCurrentStakeRate()":{"notice":"Returns the current stake rate applied to tokens during the migration."},"returnMigrateDualTokenOutput(uint256,uint256)":{"notice":"Calculates and returns the expected outputs for a dual token migration given specific amounts of GET and XGET tokens."},"returnStakeRateAtTime(uint256)":{"notice":"Returns the stake rate at a specific timestamp during the migration process."},"returnTotalAmountGETFromXGETRedemptionMigrated()":{"notice":"Returns the total amount of GET tokens redeemed from XGET tokens during the migration process."},"setAddressConfig(address,address,address)":{"notice":"Configures the addresses for the OPN token, xOPN token, and OPN Mint Manager contracts."},"setMigrationActive(bool)":{"notice":"Activates or deactivates the migration process."},"totalGETMigratedInTotal()":{"notice":"Calculates the total amount of GET tokens that have been migrated to OPN."},"totalOPNMinted()":{"notice":"Provides the total amount of OPN tokens that have been minted during the migration process."},"totalOPNStakedByTheMigration()":{"notice":"Calculates the total amount of OPN tokens that have been satked as a result of the migration."},"totalOPNSupply()":{"notice":"Fetches the total supply of OPN tokens."},"totalXGETRedeemedInTotal()":{"notice":"Provides the total amount of XGET tokens that have been redeemed as part of the migration process."},"totalXOPNSupply()":{"notice":"Retrieves the total supply of XOPN tokens."}},"version":1}},"settings":{"compilationTarget":{"src/migration/OPNMigration.sol":"OPNMigration"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@solmate/src/=lib/solmate/src/",":contract-test-utils/