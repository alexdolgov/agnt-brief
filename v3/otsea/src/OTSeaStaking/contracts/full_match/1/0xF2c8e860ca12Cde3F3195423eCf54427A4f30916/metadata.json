ress)":{"notice":"Compound rewards by swapping ETH for tokens and creating a new deposit"},"distribute()":{"notice":"Distribute ETH to stakers (only revenue distributor)"},"getCurrentEpoch()":{"notice":"Get the current epoch ID and details"},"getDeposit(address,uint256)":{"notice":"Get a deposit for a user by index"},"getDepositsByList(address,uint256[])":{"notice":"Get a list of deposits for a user by providing a list"},"getDepositsInSequence(address,uint256,uint256)":{"notice":"Get a list of deposits for a user in a sequence from an start index to an end index (inclusive)"},"getEpoch(uint32)":{"notice":"Get details about an epoch"},"getMaroonedETH(address)":{"notice":"Get the amount of marooned ETH for an account"},"getTotalDeposits(address)":{"notice":"Get the total deposits by a user"},"initialize(address)":{"notice":"Initialize and start the first epoch"},"skipEpoch()":{"notice":"Skip epoch (only revenue distributor)"},"stake(uint88)":{"notice":"Stake OTSea tokens and earn ETH"},"toggleDepositing()":{"notice":"Toggle depositing"},"withdraw(uint256[],address)":{"notice":"Withdraw multiple deposits as well as claim their rewards"}},"version":1}},"settings":{"compilationTarget":{"contracts/token/OTSeaStaking.sol":"OTSeaStaking"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0xff6d0bb2e285473e5311d9d3caacb525ae3538a80758c10649a4d61029b017bb","license":"MIT","urls":["bzz-raw://8ed324d3920bb545059d66ab97d43e43ee85fd3bd52e03e401f020afb0b120f6","dweb:/ipfs/QmfEckWLmZkDDcoWrkEvMWhms66xwTLff9DDhegYpvHo1a"]},"@openzeppelin/contracts/interfaces/draft-IERC6093.sol":{"keccak256":"0x60c65f701957fdd6faea1acb0bb45825791d473693ed9ecb34726fdfaa849dd7","license":"MIT","urls":["bzz-raw://ea290300e0efc4d901244949dc4d877fd46e6c5e43dc2b26620e8efab3ab803f","dweb:/ipfs/QmcLLJppxKeJWqHxE2CUkcfhuRTgHSn8J4kijcLa5MYhSt"]},"@openzeppelin/cont