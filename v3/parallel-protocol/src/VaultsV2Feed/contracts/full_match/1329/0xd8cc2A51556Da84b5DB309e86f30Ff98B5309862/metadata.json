{"compiler":{"version":"0.8.28+commit.7893614a"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"vaultV2Address","type":"address"},{"internalType":"address","name":"baseFeedAddress","type":"address"},{"internalType":"address","name":"quoteFeedAddress","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"name":"InvalidRoundId","type":"error"},{"inputs":[],"name":"Overflow","type":"error"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"int256","name":"current","type":"int256"},{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"updatedAt","type":"uint256"}],"name":"AnswerUpdated","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"},{"indexed":true,"internalType":"address","name":"startedBy","type":"address"},{"indexed":false,"internalType":"uint256","name":"startedAt","type":"uint256"}],"name":"NewRound","type":"event"},{"inputs":[],"name":"BASE_FEED_ADDRESS","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"QUOTE_FEED_ADDRESS","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"VAULT_V2_ADDRESS","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"decimals","outputs":[{"internalType":"uint8","name":"","type":"uint8"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"description","outputs":[{"internalType":"string","name":"desc","type":"string"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"roundId","type":"uint256"}],"name":"getAnswer","outputs":[{"internalType":"int256","name":"","type":"int256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint80","name":"_roundId","type":"uint80"}],"name":"getRoundData","outputs":[{"internalType":"uint80","name":"roundId","type":"uint80"},{"internalType":"int256","name":"answer","type":"int256"},{"internalType":"uint256","name":"startedAt","type":"uint256"},{"internalType":"uint256","name":"updatedAt","type":"uint256"},{"internalType":"uint80","name":"answeredInRound","type":"uint80"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"roundId","type":"uint256"}],"name":"getTimestamp","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"latestAnswer","outputs":[{"internalType":"int256","name":"answer","type":"int256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"latestRound","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"pure","type":"function"},{"inputs":[],"name":"latestRoundData","outputs":[{"internalType":"uint80","name":"roundId","type":"uint80"},{"internalType":"int256","name":"answer","type":"int256"},{"internalType":"uint256","name":"startedAt","type":"uint256"},{"internalType":"uint256","name":"updatedAt","type":"uint256"},{"internalType":"uint80","name":"answeredInRound","type":"uint80"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"latestTimestamp","outputs":[{"internalType":"uint256","name":"updatedAt","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"version","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"pure","type":"function"}],"devdoc":{"details":"Chainlink AggregatorV3-style price-feed adapter for a V2-style vault Exposes the price of a vault share (in USD or other base currency) by reading on-chain balances, feed prices, and normalizing values to standard decimals, conforming to the Chainlink aggregator interfaces. Features:  - Aggregates base/quote price feeds and vault balances to compute a unified share price.  - Implements the AggregatorV2V3Interface, supporting Chainlink-style round/answer accessors.  - All responses are for a singleton \"round\" (id = 1) which reflects the current on-chain state. Immutables are memoized for gas efficiency. All computation delegates to minimal arithmetic and library helpers to safely compose vault and feed data.","errors":{"Overflow()":[{"details":"bytes4(keccak256(\"Overflow()\")) = 0x35278d12"}]},"events":{"AnswerUpdated(int256,uint256,uint256)":{"params":{"current":"- The updated answer.","roundId":"- The round ID for which the answer was updated.","updatedAt":"- The timestamp when the answer was updated."}},"NewRound(uint256,address,uint256)":{"params":{"roundId":"- The round ID of the new round.","startedAt":"- The timestamp when the round was started.","startedBy":"- The address of the account that started the round."}}},"kind":"dev","methods":{"constructor":{"details":"- Immutable normalization values (decimals, multipliers, dividers) are computed at construction    for constant-time, gas-efficient computation in all views.","params":{"baseFeedAddress":"Address of the Chainlink feed for the base asset","quoteFeedAddress":"Address of the Chainlink feed for the quote asset","vaultV2Address":"Address of the V2 vault to source balances/metadata from"}},"decimals()":{"returns":{"_0":"The decimal count used for the share price answers"}},"description()":{"returns":{"desc":"A human-readable identifier string"}},"getAnswer(uint256)":{"details":"Reverts if roundId != 1","params":{"roundId":"Round ID (must be 1)"},"returns":{"_0":"answer The current vault share price"}},"getRoundData(uint80)":{"details":"Reverts if any roundId other than 1 is supplied.","params":{"_roundId":"Must be 1 (representing the current round)"},"returns":{"answer":"Latest computed vault share price (see `latestRoundData()`)","answeredInRound":"Always 1","roundId":"Always 1","startedAt":"Always 0","updatedAt":"Timestamp of the latest feed update (oldest of base/quote feeds)"}},"getTimestamp(uint256)":{"details":"Reverts if roundId != 1","params":{"roundId":"Round ID (must be 1)"},"returns":{"_0":"updatedAt Timestamp of last answer update"}},"latestAnswer()":{"returns":{"answer":"The current vault share price in unified decimals"}},"latestRound()":{"returns":{"_0":"Always 1, since this feed supports only a constant singleton round"}},"latestRoundData()":{"returns":{"answer":"The latest calculated vault share price (see V2VaultPricing.price)","answeredInRound":"Always 1","roundId":"Always 1","startedAt":"Always 0 (no real \"startedAt\" concept)","updatedAt":"Timestamp of most recent update from underlying feeds"}},"latestTimestamp()":{"returns":{"updatedAt":"Timestamp (seconds) for latest price update"}},"version()":{"returns":{"_0":"Version constant"}}},"title":"VaultsV2Feed","version":1},"userdoc":{"errors":{"InvalidRoundId()":[{"notice":"Error thrown when a requested roundId is not supported (only '1' is valid)"}],"Overflow()":[{"notice":"The error thrown when the answer is negative or 0, or the decimals are too high"}]},"events":{"AnswerUpdated(int256,uint256,uint256)":{"notice":"Emitted when the answer is updated."},"NewRound(uint256,address,uint256)":{"notice":"Emitted when a new round is started."}},"kind":"user","methods":{"BASE_FEED_ADDRESS()":{"notice":"Chainlink base asset feed address (e.g., asset/USD)"},"QUOTE_FEED_ADDRESS()":{"notice":"Chainlink quote asset feed address (e.g., asset/USD)"},"VAULT_V2_ADDRESS()":{"notice":"Address of the target Vault V2 contract"},"constructor":{"notice":"Initializes the VaultsV2Feed contract, precomputing all normalization coefficients."},"decimals()":{"notice":"Gets the decimals (precision) for this price feed"},"description()":{"notice":"Gets a descriptive string for this feed, e.g. \"Feed: VaultName\""},"getAnswer(uint256)":{"notice":"Gets the answer for a specified round (must be round 1)"},"getRoundData(uint80)":{"notice":"Get historical round data for the AggregatorV3 interface (only roundId=1 is valid)"},"getTimestamp(uint256)":{"notice":"Gets the updatedAt timestamp for a specified round (must be round 1)"},"latestAnswer()":{"notice":"Returns the latest computed vault share price (AggregatorV2-style)"},"latestRound()":{"notice":"Returns the integer round ID of the latest round (always 1)"},"latestRoundData()":{"notice":"Gets the most recent data for the singleton round (AggregatorV3 interface)"},"latestTimestamp()":{"notice":"Returns the timestamp of the oldest update among the two feeds"},"version()":{"notice":"Returns the feed version (always 1; for interface compatibility)"}},"version":1}},"settings":{"compilationTarget":{"src/VaultsV2Feed.sol":"VaultsV2Feed"},"evmVersion":"prague","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":forge-std/=lib/forge-std/src/",":solady/=lib/solady/src/"]},"sources":{"lib/solady/src/utils/FixedPointMathLib.sol":{"keccak256":"0x797c2905d6677fd5a8b046c5b051fd26779c945500eeaa436437c3865e7b654e","license":"MIT","urls":["bzz-raw://c1487a0ab1d903782ba873f63f790a358dc3accbe5c5a528af797433481ca65c","dweb:/ipfs/QmWpscoQZYkCv1Z5zHdrMExiXH5v8HBgBpqw6wvJoQgcrd"]},"lib/solady/src/utils/LibBytes.sol":{"keccak256":"0x8b30da2e6e6989769ac17a022225aca713dc4d1a6afcd4551753adcb57c55497","license":"MIT","urls":["bzz-raw://f450b3dfcf7db097eeabef9bdaaefe6b532eff0ef9e3d04d8b9d04a501489de4","dweb:/ipfs/QmScuQUv4sE4Q439XSkQK87iPqp9nXjoeui8diiassWQkn"]},"lib/solady/src/utils/LibString.sol":{"keccak256":"0x8a6b219f6ccda90c08e2debae62618d78d6f0cef086eb6c9503793d7f12815dd","license":"MIT","urls":["bzz-raw://d1301acbf7371cb51ab01fe3bee8a9b732ee0bcf6cc0db20ed5a3fb9241d675e","dweb:/ipfs/QmXuM4tSfPDeFRvP3nEQmuezp1yEm4HxyWtU41FjiCdxAG"]},"lib/solady/src/utils/SafeTransferLib.sol":{"keccak256":"0xf53a25143307304d9de7186f93f11faae3cc4f722c4b088aed6f4f8f87a02f7a","license":"MIT","urls":["bzz-raw://b722c08826ece540bbc4ee9f825aac501282c0900