8"},{"internalType":"uint32","name":"_prizeIndex","type":"uint32"},{"internalType":"uint96","name":"","type":"uint96"},{"internalType":"address","name":"","type":"address"}],"name":"beforeClaimPrize","outputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"bytes","name":"","type":"bytes"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"boostedVault","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"minTwabOverPrizePeriod","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"nftCollection","outputs":[{"internalType":"contract IERC721","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"prizePool","outputs":[{"internalType":"contract PrizePool","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"tokenIdLowerBound","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"tokenIdUpperBound","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"twabController","outputs":[{"internalType":"contract TwabController","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"author":"G9 Software Inc.","details":"This contract works best with NFTs that have iterating IDs ex. IDs: (1,2,3,4,5,...)","errors":{"InvalidTokenIdBounds(uint256,uint256)":[{"params":{"tokenIdLowerBound":"The provided lower bound","tokenIdUpperBound":"The provided upper bound"}}]},"events":{"BoostedVaultWithPrize(address,address,uint256,uint256)":{"params":{"boostedVault":"The boosted vault","pickAttempts":"The number of times the hook tried to pick a winner","prizeAmount":"The amount of prize tokens contributed","prizePool":"The prize pool the vault was boosted on"}}},"kind":"dev","methods":{"afterClaimPrize(address,uint8,uint32,uint256,address,bytes)":{"details":"If the recipient is set to the prize pool, the prize will be contributed on behalf of the vault that is being boosted. Otherwise this hook does nothing since the prize will have already been redirected to the recipient.","params":{"data":"Arbitrary data received from the `beforeClaimPrize` hook","prize":"The total size of the prize (not including the claim reward)","prizeIndex":"The index of the prize","prizeRecipient":"The recipient of the prize","tier":"The tier of the prize","winner":"The user who won the prize and for whom this hook is attached"}},"beforeClaimPrize(address,uint8,uint32,uint96,address)":{"details":"This prize hook uses the random number from the last awarded prize pool draw to randomly select the receiver of the prize from a list of current NFT holders. The prize data is also used to provide variance in the entropy for each prize so there can be multiple winners per draw.Tries to select a winner until the call runs out of gas before reverting to the backup action of  contributing the prize on behalf of the boosted vault.Returns the number of pick attempts used in the extra hook data.","params":{"prizeIndex":"The index of the prize in the tier","reward":"The reward portion of the prize that will be allocated to the claimer","rewardRecipient":"The recipient of the claim reward","tier":"The tier of the prize","winner":"The user who won the prize and for whom this hook is attached"},"returns":{"_0":"The address of the recipient of the prize","_1":"Arbitrary data that will be passed to the `afterClaimPrize` hook"}},"constructor":{"params":{"boostedVault_":"The The vault that is boosted if a winner cannot be determined","minTwabOverPrizePeriod_":"The minimum TWAB on the `boostedVault_` that the selected winner        must have over the prize period to win the prize; if set to zero, no balance is needed.","nftCollection_":"The ERC721 token whose holders will have a chance to win prizes","prizePool_":"The prize pool that is awarding prizes","tokenIdLowerBound_":"The lower bound of eligible NFT IDs (inclusive)","tokenIdUpperBound_":"The upper bound of eligible NFT IDs (inclusive)"}}},"title":"PoolTogether V5 - Hook that boosts prizes on a vault for holders of an NFT collection","version":1},"userdoc":{"errors":{"BoostedVaultAddressZero()":[{"notice":"Thrown if the boosted vault address is the zero address."}],"InvalidTokenIdBounds(uint256,uint256)":[{"notice":"Thrown if the invalid token ID bounds are provided."}],"NftCollectionAddressZero()":[{"notice":"Thrown if the nft collection address is the zero address."}],"PrizePoolAddressZero()":[{"notice":"Thrown if the prize pool address is the zero address."}]},"events":{"BoostedVaultWithPrize(address,address,uint256,uint256)":{"notice":"Emitted when a vault is boosted with a prize re-contribution."}},"kind":"user","methods":{"afterClaimPrize(address,uint8,uint32,uint256,address,bytes)":{"notice":"Triggered after the prize pool claim prize function is called."},"beforeClaimPrize(address,uint8,uint32,uint96,address)":{"notice":"Triggered before the prize pool claim prize function is called."},"boostedVault()":{"notice":"The vault that is being boosted"},"constructor":{"notice":"Constructor to deploy the hook contract"},"minTwabOverPrizePeriod()":{"notice":"The minimum TWAB that the selected winner must have to win a prize"},"nftCollection()":{"notice":"The ERC721 token whose holders will have a chance to win prizes"},"prizePool()":{"notice":"The prize pool that is awarding prizes"},"tokenIdLowerBound()":{"notice":"The lower bound of eligible NFT IDs (inclusive)"},"tokenIdUpperBound()":{"notice":"The upper bound of eligible NFT IDs (inclusive)"},"twabController()":{"notice":"The twab controller associated with the prize pool"}},"notice":"This prize hook awards the winner's prize to a random holder of a NFT in a specific collection. The winning NFT holder i