nged.","params":{"pendingOwner":"new `_pendingOwner` address."}},"OwnershipTransferred(address,address)":{"details":"Emitted when `_owner` has been changed.","params":{"newOwner":"new `_owner` address.","previousOwner":"previous `_owner` address."}},"RngAuctionCompleted(address,address,uint32,address,uint32,uint64,uint64)":{"params":{"elapsedTime":"The amount of time that the auction ran for in seconds","recipient":"The recipient of the auction reward","rewardFraction":"The fraction of the available rewards to be allocated to the recipient","rng":"The RNGInterface that was used for this auction","rngRequestId":"The RNGInterface request ID","sequenceId":"The sequence ID for the auction"}},"SetNextRngService(address)":{"params":{"rngService":"RNG service address"}}},"kind":"dev","methods":{"auctionElapsedTime()":{"returns":{"_0":"The elapsed time since the auction started in seconds"}},"canStartNextSequence()":{"details":"The auction is complete when the RNG has been requested for the current sequence, therefore the next sequence can be started if the current sequenceId is different from the last auction's sequenceId.","returns":{"_0":"True if the next sequence can be started, false otherwise."}},"claimOwnership()":{"details":"This function is only callable by the `_pendingOwner`."},"computeRewardFraction(uint64)":{"params":{"__auctionElapsedTime":"The elapsed time of the auction in seconds"},"returns":{"_0":"The reward fraction as a UD2x18 value"}},"constructor":{"params":{"auctionDurationSeconds_":"Auction duration in seconds","auctionTargetTime_":"Target time to complete the auction in seconds","firstAuctionTargetRewardFraction_":"Target reward fraction to complete the first auction","owner_":"Address of the RngAuction owner. The owner may swap out the RNG service.","rng_":"Address of the RNG service","sequenceOffset_":"Sequence offset in seconds","sequencePeriod_":"Sequence period in seconds"}},"currentFractionalReward()":{"details":"Uses the last sold fraction as