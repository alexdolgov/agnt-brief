cked in the vault, based on the oracle price."},"getUserVotes(uint256)":{"notice":"Retrieves the voting parameters for a given vault."},"getVaultDiscountPercentage(uint256)":{"notice":"Returns the discount percentage for a given vault"},"isValidCollateral(uint256,uint256)":{"notice":"Calculates if the CDR is valid before taking a further action with a user"},"payBackToken(uint256,uint256,uint256)":{"notice":"payback asset to close loan."},"setAdmin(address)":{"notice":"sets the address that earns interest for maintaining the market"},"setClaimLogic(address)":{"notice":"Sets the external claim logic contract address"},"setFees(uint256,uint256)":{"notice":"sets the interest rate split between the admin and ref"},"setGlobalVotingParams(address[],uint256[])":{"notice":"Sets the global voting parameters for the vault."},"setInterestRate(uint256)":{"notice":"sets the interest charged by a vault."},"setMinCollateralRatio(uint256)":{"notice":"sets the CDR"},"setRef(address)":{"notice":"sets the address that earns interest for providing a borrowable asset"},"setStabilityPool(address)":{"notice":"sets the address used as stability pool for liquidations"},"setTokenURI(string)":{"notice":"updates the metadata"},"setUserVotes(uint256,address[],uint256[])":{"notice":"Sets the user-specific voting parameters for a given vault."},"setVotingContract(address)":{"notice":"Sets the voting contract address."},"updateVaultDebt(uint256)":{"notice":"Adds the interest charged to the vault over the previous time called."},"vaultDebt(uint256)":{"notice":"Returns the debt owned by the vault without tracking the interest"},"withdrawCollateral(uint256)":{"notice":"Withdraws collateral from a specific vault by token id"}},"notice":"Single collateral lending manager with fixed rate interest.","version":1}},"settings":{"compilationTarget":{"contracts/graceVaults/graceQiVault.sol":"graceQiVault"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"run