 clears any existing liquidation watch. This function is used to track vaults for the grace period before liquidation.","params":{"vaultId":"The ID of the vault to check for liquidation status."}},"claimVaultBribes(address[],address[][],uint256)":{"params":{"_bribes":"The addresses of the bribe contracts to claim from.","_tokens":"The token addresses for each bribe contract to claim.","vaultId":"The ID of the vault for which to claim bribes."},"returns":{"_0":"The amounts of each token claimed."}},"claimVaultFees(address[],address[][],uint256)":{"params":{"_fees":"The addresses of the fee contracts to claim from.","_tokens":"The token addresses for each fee contract to claim.","vaultId":"The ID of the vault for which to claim fees."},"returns":{"_0":"The amounts of each token claimed."}},"createVault()":{"returns":{"_0":"uint256 the token id of the vault created."}},"depositCollateral(uint256,uint256)":{"details":"Any address can deposit into a vault","params":{"id":"is the id of the nft collateral to deposit from msg.sender","vaultID":"is the token id of the vault being interacted with."}},"destroyVault(uint256)":{"details":"vault must not have any debt owed to be able to be destroyed.","params":{"vaultID":"the vault ID to destroy"}},"exists(uint256)":{"details":"the erc721 spec allows users to burn/destroy their nft","params":{"vaultID":"is the token id of the vault being checked."},"returns":{"_0":"boolean if the vault exists"}},"extendLockTimeAndCheckLiquidation(uint256,uint256)":{"details":"This function can only be called by the vault owner.After extending the lock time, it checks if the vault is still not liquidatable.","params":{"additionalTime":"The additional lock time in seconds to add to the current lock period.","vaultID":"The ID of the vault for which to extend the lock time."}},"getApproved(uint256)":{"details":"See {IERC721-getApproved}."},"getDebtCeiling()":{"details":"checks the outstanding balance of the borrowable asset within the contract.","returns":{"_0":"available balance of borrowable asset."}},"getEthPriceSource()":{"returns":{"_0":"uint256 is the value retrieved from the oracle used to calculate the available borrowable amounts."}},"getGlobalVotes()":{"returns":{"lpTokens":"An array of global liquidity pool token addresses used for voting.","percentages":"An array of percentages corresponding to the global voting power for each LP token."}},"getTokenPriceSource()":{"returns":{"_0":"uint256 is the value with 8 decimals used to calculate borrowable debt."}},"getTotalValueLocked()":{"returns":{"_0":"uint256 total value locked in vault"}},"getUserVotes(uint256)":{"params":{"vaultId":"The ID of the vault for which to retrieve the voting parameters."},"returns":{"lpTokens":"An array of liquidity pool token addresses used for voting.","percentages":"An array of percentages corresponding to the voting power for each LP token."}},"getVaultDiscountPercentage(uint256)":{"params":{"vaultID":"The ID of the vault"},"returns":{"_0":"uint256 The discount percentage (0-75)"}},"isApprovedForAll(address,address)":{"details":"See {IERC721-isApprovedForAll}."},"isValidCollateral(uint256,uint256)":{"params":{"_collateral":"is the nft id for the collateral we're holding","debt":"is the debt owed by the vault."},"returns":{"_0":"boolean describing if the new CDR is valid."}},"name()":{"details":"See {IERC721Metadata-name}."},"owner()":{"details":"Returns the address of the current owner."},"ownerOf(uint256)":{"details":"See {IERC721-ownerOf}."},"payBackToken(uint256,uint256,uint256)":{"details":"If there is debt, then it can only withdraw up to the min CDR.","params":{"_front":"is the front end that will get the opening","amount":"is the amount of borrowable asset to repay","vaultID":"is the token id of the vault being interacted with."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"safeTransferFrom(address,address,uint256)":{"details":"See {IERC721-safeTransferFrom}."},"safeTransferFrom(address,address,uint256,bytes)":{"details":"See {IERC721-safeTransferFrom}."},"setAdmin(address)":{"details":"cannot be address(0)","params":{"_adm":"is the ratio earned by the address that maintains the market"}},"setApprovalForAll(address,bool)":{"details":"See {IERC721-setApprovalForAll}."},"setClaimLogic(address)":{"details":"Only callable by the contract admin","params":{"_claimLogic":"The address of the claim logic contract"}},"setFees(uint256,uint256)":{"details":"if not set to address(0) then _pool is the only address able to liquidate","params":{"_admin":"is the ratio earned by the address that maintains the market","_ref":"is the ratio earned by the address that provides the borrowable asset"}},"setGlobalVotingParams(address[],uint256[])":{"custom:modifier":"onlyOwner Restricts the function to the contract owner.","details":"Attempts a test vote with vault ID 0 to ensure the parameters are valid before setting them.The function can only be called by the owner of the contract.The lengths of the `_lpTokens` and `_percentages` arrays must match.The `_lpTokens` array cannot be empty.The sum of `_percentages` must equal 100.","params":{"_lpTokens":"An array of liquidity pool token addresses for voting.","_percentages":"An array of percentages corresponding to the voting power for each LP token. The percentages should sum up to 100."}},"setInterestRate(uint256)":{"params":{"_iR":"is the fixed interest charged by a vault"}},"setMinCollateralRatio(uint256)":{"details":"only callable by owner of the contract","params":{"minimumCollateralPercentage":"is the CDR that limits the amount borrowed"}},"setRef(address)":{"details":"cannot be address(0)","params":{"_ref":"is the address that provides the borrowable asset"}},"setStabilityPool(address)":{"details":"if not set to address(0) then _pool is the only address able to liquidate","params":{"_pool":"is the address that can execute liquidations"}},"setTokenURI(string)":{"details":"it currently uses an ipfs json","params":{"_baseURI":"is the url for the nft metadata"}},"setUserVotes(uint256,address[],uint256[])":{"details":"Stores the LP tokens and their corresponding voting percentages for a vault.The lengths of the `_lpTokens` and `_percentages` arrays must match.The `_lpTokens` array cannot be empty.The sum of `_percentages` must equal 1000.","params":{"_lpTokens":"An array of liquidity pool token addresses for voting.","_percentages":"An array of percentages corresponding to the voting power for each LP token. The percentages should sum up to 100.","vaultId":"The ID of the vault for which to set the voting parameters."}},"setVotingContract(address)":{"custom:modifier":"onlyOwner Restricts the function to the contract owner.","details":"The function can only be called by the owner of the contract.","params":{"_voting":"The address of the voting contract."}},"symbol()":{"details":"See {IERC721Metadata-symbol}."},"tokenByIndex(uint256)":{"details":"See {IERC721Enumerable-tokenByIndex}."},"tokenOfOwnerByIndex(address,uint256)":{"details":"See {IERC721Enumerable-tokenOfOwnerByIndex}."},"tokenURI(uint256)":{"details":"See {IERC721Metadata-tokenURI}."},"totalSupply()":{"details":"See {IERC721Enumerable-totalSupply}."},"transferFrom(address,address,uint256)":{"details":"See {IERC721-transferFrom}."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateVaultDebt(uint256)":{"params":{"vaultID":"is the token id of the vault being checked."},"returns":{"_0":"uint256 latest vault debt"}},"vaultDebt(uint256)":{"params":{"vaultID":"is the token id of the vault being checked."},"returns":{"_0":"uint256 debt owed by the vault for further calculation."}},"withdrawCol