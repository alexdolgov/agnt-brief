tives contract"}}},"stateVariables":{"_votingIncentives":{"details":"the list of voting incentives contracts"},"defaultRewardToken":{"details":"the list of deafult reward tokens for external incentives"},"globalFactory":{"details":"The global factory that creates the voting incentives contracts"},"last_votingIncentives":{"details":"The last voting incentives contract deployed"}},"version":1},"userdoc":{"kind":"user","methods":{"CREATE_ROLE()":{"notice":"Role to create voting incentives contracts"},"VOTING_INCENTIVES_FACTORY_MANAGER_ROLE()":{"notice":"Role to manage VotingIncentivesFactory"},"addRewardToVotingIncetives(address,address)":{"notice":"Add a reward token to a given VotingIncetives"},"addRewardsToVotingIncetives(address[],address)":{"notice":"Add multiple reward token to a given VotingIncetives"},"createVotingIncentives(address,address,address,address,address)":{"notice":"create a votingIncentives contract"},"emergencyRecoverERC20(address[],address[],uint256[])":{"notice":"recover an ERC20 from VotingIncetives contracts."},"pauseVotingIncentives(address[])":{"notice":"Pause VotingIncetives contracts"},"pushDefaultRewardToken(address)":{"notice":"set the VotingIncetives factory permission registry"},"recoverERC20AndUpdateData(address[],address[],uint256[])":{"notice":"recover an ERC20 from VotingIncetives contracts and update. "},"removeDefaultRewardToken(address)":{"notice":"set the VotingIncetives factory permission registry"},"removeRewardToVotingIncetives(address,address)":{"notice":"Add a reward token to a given VotingIncetives"},"removeRewardsToVotingIncetives(address[],address)":{"notice":"Add a reward token to a given VotingIncetives"},"setClaimer(address,address[])":{"notice":"Set a new claimer in the VotingIncetivess"},"setGlobalFactory(address)":{"notice":"set a new global factory"},"setVotingIncetivesMinter(address[],address)":{"notice":"set a new minter in given VotingIncetivess"},"setVotingIncetivesOwner(address[],address)":{"notice":"set a ne