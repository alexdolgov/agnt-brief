ion"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"details":"Handles Staking of BNB on BSC","kind":"dev","methods":{"claimUndelegatedAll()":{"details":"Bot uses this function to claim all undelegated funds from Beacon Chain for BSC Feynman upgrade","returns":{"_amount":"- Amount of funds claimed","_uuid":"- the confirmed undelegated uuid"}},"compoundRewards()":{"details":"Allows bot to compound rewards"},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"convertBnbToSnBnb(uint256)":{"details":"Calculates amount of SnBnb for `_amount` Bnb"},"convertSnBnbToBnb(uint256)":{"details":"Calculates amount of Bnb for `_amountInSnBnb` SnBnb"},"delegate()":{"details":"Allows bot to delegate users' funds to native staking contract without reserved BNB","returns":{"_amount":"- Amount of funds transferred for staking"}},"delegateReserve()":{"details":"Allows manager to delegate reserve amount(100 Bnb) to the hard-coded validator;      This function is used to amend the balance difference caused by missing `delegateWithReserve` operations"},"delegateTo(uint256)":{"details":"One time function to delegate to BSC validator right after claimUndelegatedAll","params":{"_amount":"- Amount of bnb to delegate to the hard-coded BSC validator"}},"deposit()":{"details":"Allows user to deposit Bnb at BSC and mints SnBnb for the user"},"depositReserve()":{"details":"Deposit reserved funds to the contract"},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getTokenHubRelayFee()":{"returns":{"_0":"relayFee required by TokenHub contract to transfer funds from BSC -> BC"}},"getUserRequestStatus(address,uint256)":{"details":"Checks if the withdrawRequest is ready to claim","params":{"_idx":"- index of request in UserWithdrawls Array","_user":"- Address of the user who raised WithdrawRequest"},"returns":{"_amount":"- Amount of BNB user would receive on withdra