        _nonReentrantAfter();
    }

    function _nonReentrantBefore() private {
        // On the first call to nonReentrant, _status will be _NOT_ENTERED
        require(_status != _ENTERED, "ReentrancyGuard: reentrant call");

        // Any calls to nonReentrant after this point will fail
        _status = _ENTERED;
    }

    function _nonReentrantAfter() private {
        // By storing the original value once again, a refund is triggered (see
        // https://eips.ethereum.org/EIPS/eip-2200)
        _status = _NOT_ENTERED;
    }

    /**
     * @dev Returns true if the reentrancy guard is currently set to "entered", which indicates there is a
     * `nonReentrant` function in the call stack.
     */
    function _reentrancyGuardEntered() internal view returns (bool) {
        return _status == _ENTERED;
    }
}

// File: contracts/EqualizerPerpetualBuyOut.sol


pragma solidity ^0.8.25;






interface IVENEFT is IERC721 {
    /// @notice Returns (locked amount, unlockTime)
    function locked(uint256 _id) external view returns (int128, uint256);
}

contract EqualizerPerpetualBuyOut is IERC721Receiver, ReentrancyGuard {
    using SafeERC20 for IERC20;

    // -----------------------------------------------------------------------
    // Constants / immutables
    // -----------------------------------------------------------------------
    uint256 public constant BASIS = 1_000;          // 1000 = 1:1 scale
    uint256 public constant veEqualSlashing = 500;  // 50% weight on ve positions

    address public constant SHADOW_TREASURY = 0x5Be2e859D0c2453C9aA062860cA27711ff553432;
    IERC20  public constant EQUAL          = IERC20(0xddF26B42C1d903De8962d3F79a74a501420d5F19);
    IERC20  public constant XSHADOW        = IERC20(0x5050bc082FF4A74Fb6B0B04385dEfdDB114b2424);
    IVENEFT public constant VE_EQUAL       = IVENEFT(0x3045119766352fF250b3d45312Bd0973CBF7235a);

    // XSHADOW paid per EQUAL (scaled by BASIS). e.g., 1000 = 1:1, 800 = 0.8:1
    uint256 public xShadowPerEqual;

    // -----------------------------------------------------------------------
    // Events
    // -----------------------------------------------------------------------
    event ExchangedViaERC721(address indexed user, uint256 tokenId, uint256 equalUnderlying, uint256 xShadowOut);
    event ExchangedViaERC20(address indexed user, uint256 equalIn, uint256 xShadowOut);
    event ExchangeRateUpdated(uint256 xShadowPerEqual);
    event Retrieved(address indexed to, uint256 amount);
    event BackstopCall(address indexed target, bytes data, bool success, bytes returnData);

    // -----------------------------------------------------------------------
    // Constructor
    // -----------------------------------------------------------------------
    constructor(uint256 _xShadowPerEqual) {
        require(_xShadowPerEqual > 0 && _xShadowPerEqual <= BASIS, "bad rate");
        xShadowPerEqual = _xShadowPerEqual;
    }

    // -----------------------------------------------------------------------
    // User flows
    // -----------------------------------------------------------------------

    /// @notice Deposit a veEQUAL NFT; receive XSHADOW based on its locked EQUAL, with a weight (slash).
    function leaveViaERC721(uint256 _tokenID) external nonReentrant {
        (int128 bal, /* unlock */) = VE_EQUAL.locked(_tokenID);
        require(bal > 0, "no underlying");

        uint256 underlying = uint256(uint128(bal)); // safe after bal > 0
        uint256 payout = _calculate(underlying, true);
        require(XSHADOW.balanceOf(address(this)) >= payout, "insufficient XSHADOW");

        // Pull the NFT in (user must approve beforehand).
        // Using transferFrom intentionally (no need to implement receive-state).
        VE_EQUAL.transferFrom(msg.sender, address(this), _tokenID);

        // Pay the user
        XSHADOW.safeTransfer(msg.sender, payout);

        emit ExchangedViaERC721(msg.sender, _tokenID, underlying, payout);
    }

    /// @notice Deposit raw EQUAL; receive XSHADOW at the current rate.
    /// @dev Uses balance-delta to be safe against fee-on-transfer tokens.
    function leaveViaERC20(uint256 _amount) external nonReentrant {
        require(_amount > 0, "zero amount");

        uint256 beforeBal = EQUAL.balanceOf(address(this));
        EQUAL.safeTransferFrom(msg.sender, address(this), _amount);
        uint256 received = EQUAL.balanceOf(address(this)) - beforeBal;
        require(received > 0, "no tokens received");

        uint256 payout = _calculate(received, false);
        require(XSHADOW.balanceOf(address(this)) >= payout, "insufficient XSHADOW");

        XSHADOW.safeTransfer(msg.sender, payout);
        emit ExchangedViaERC20(msg.sender, received, payout);
    }

    // -----------------------------------------------------------------------
    // Views
    // -----------------------------------------------------------------------

    /// @notice Preview how much XSHADOW you'd receive for an amount of EQUAL (or veEQUAL underlying).
    function quote(uint256 _amount, bool _ve) external view returns (uint256) {
        return _calculate(_amount, _ve);
    }

    function _calculate(uint256 _amount, bool _ve) private view returns (uint256) {
        if (_amount == 0) return 0;
        uint256 weightedAmount = _ve ? (_amount * veEqualSlashing) / BASIS : _amount;
        return (weightedAmount * xShadowPerEqual) / BASIS;
    }

    // -----------------------------------------------------------------------
    // Admin (Treasury)
    // -----------------------------------------------------------------------

    function setExchangeRate(uint256 _xShadowPerEqual) external {
        require(msg.sender == SHADOW_TREASURY, "!treasury");
        require(_xShadowPerEqual > 0 && _xShadowPerEqual <= BASIS, "bad rate");
        xShadowPerEqual = _xShadowPerEqual;
        emit ExchangeRateUpdated(_xShadowPerEqual);
    }

    /// @notice Sweep all XSHADOW to treasury (e.g., to rebalance inventory).
    function retrieve() external nonReentrant {
        require(msg.sender == SHADOW_TREASURY, "!treasury");
        uint256 bal = XSHADOW.balanceOf(address(this));
        XSHADOW.safeTransfer(SHADOW_TREASURY, bal);
        emit Retrieved(SHADOW_TREASURY, bal);
    }

    /// @notice Emergency arbitrary call by treasury (e.g., rescue NFTs/EQUAL, claim, etc.)
    function backstop(address x, bytes calldata data) external nonReentrant {
        require(msg.sender == SHADOW_TREASURY, "!treasury");
        (bool success, bytes memory ret) = x.call(data);
        require(success, "failed");
        emit BackstopCall(x, data, success, ret);
    }

    // -----------------------------------------------------------------------
    // ERC721 safe receiver
    // -----------------------------------------------------------------------
    /// @dev We DO NOT accept unsolicited safeTransferFrom to avoid users bricking NFTs here.
    function onERC721Received(
        address, /* operator */
        address, /* from */
        uint256, /* tokenId */
        bytes calldata /* data */
    ) external pure override returns (bytes4) {
        revert("use leaveViaERC721");
    }
}