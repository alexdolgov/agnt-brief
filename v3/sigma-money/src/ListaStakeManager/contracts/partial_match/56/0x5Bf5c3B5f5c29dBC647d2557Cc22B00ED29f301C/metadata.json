s of the user who raised WithdrawRequest"}},"compoundRewards()":{"details":"Allows bot to compound rewards"},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"convertBnbToShares(address,uint256)":{"details":"Calculates amount of shares for _bnbAmount","params":{"_bnbAmount":"- the amount of BNB","_operator":"- the operator address of the validator"},"returns":{"_0":"the amount of shares for given BNB"}},"convertBnbToSnBnb(uint256)":{"details":"Calculates amount of SlisBnb for `_amount` Bnb"},"convertSharesToBnb(address,uint256)":{"details":"Calculates amount of Bnb for _shares","params":{"_operator":"- the operator address of the validator","_shares":"- the amount of shares"},"returns":{"_0":"the amount of BNB for given shares"}},"convertSnBnbToBnb(uint256)":{"details":"Calculates amount of Bnb for `_amountInSlisBnb` SlisBnb"},"delegateTo(address,uint256)":{"details":"Allows bot to delegate users' funds to given BSC validator","params":{"_amount":"- Amount of BNB to delegate","_validator":"- Operator address of the BSC validator to delegate to"}},"delegateVoteTo(address)":{"details":"Allows to delegate all voting power to a specific address; Need to delegate to stake manager itself to track its voting power","params":{"_delegateTo":"- Address to delegate voting power to; cancel delegation if address is this contract"}},"deposit()":{"details":"Allows user to deposit Bnb and mint SlisBnb"},"depositReserve()":{"details":"Used by Redirect Address to deposit reserved funds"},"disableValidator(address)":{"details":"Disables a validator from the contract.      Upon disabled, bot can only undelegete the funds, delegation is not allowed","params":{"_address":"- the operator address of the validator"}},"getAmountToUndelegate()":{"details":"Bot use this method to get the amount of BNB to call undelegateFrom","returns":{"_amountToUndelegate":"Bnb amount to be undelegated by bot"}},"getBotUndelegateRequest(uint256)":{"details":"Retrieves the old undelegate request initiated by Bot","params":{"_uuid":"- UUID of the request; should be uuid of the old stake manager version"}},"getClaimableAmount(address)":{"details":"Query the claimable amount of BNB of a validator","params":{"_validator":"- the operator address of the validator"},"returns":{"_amount":"- the amount of BNB claimable"}},"getDelegated(address)":{"params":{"_validator":"- the operator address of the validator"},"returns":{"_0":"the total amount of BNB staked and reward"}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getTotalBnbInValidators()":{"details":"Returns the total amount of BNB in all validators"},"getUserRequestStatus(address,uint256)":{"details":"Checks if the withdrawRequest is ready to claim","params":{"_idx":"- index of request in UserWithdrawls Array","_user":"- Address of the user who raised WithdrawRequest"},"returns":{"_amount":"- Amount of BNB user would receive on withdraw claim","_isClaimable":"- if the withdraw is ready to claim yet"}},"getUserWithdrawalRequests(address)":{"details":"Retrieves all withdrawal requests initiated by the given address","params":{"_address":"- Address of the requester"},"returns":{"_0":"userWithdrawalRequests array of user withdrawal requests"}},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"initialize(address,address,address,address,uint256,address,address)":{"params":{"_admin":"- Address of the admin","_bot":"- Address of the Bot","_manager":"- Address of the manager","_revenuePool":"- Revenue pool to receive rewards","_slisBnb":"- Address of SlisBnb Token on BNB Smart Chain","_synFee":"- Rewards fee to revenue pool","_validator":"- Validator to delegate BNB"}},"pause()":{"details":"Pauses the contract by Guardian"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"redelegate(address,address,uint256)":{"params":{"_amount":"the bnb amount to be redelegated","dstValidator":"the operator address of the validator to be redelegated to","srcValidator":"the operator address of the validator to be redelegated from"}},"refundCommission(uint256)":{"details":"Allows manager to refund Lista Dao validator's commission to this contract","params":{"_days":"- Number of days to split the refund"}},"removeValidator(address)":{"details":"Removes a disabled validator from the contract","params":{"_address":"- the operator address of the validator"}},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `account`. May emit a {RoleRevoked} event."},"requestWithdraw(uint256)":{"details":"Allow users to request to unstake BNB.","params":{"_amountInSlisBnb":"- Amount of SlisBnb to swap for withdraw"}},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."},"setAnnualRate(uint256)":{"details":"Sets the rate for the protocol fee to be charged on total staked amount","params":{"_annualRate":"- the rate to be charged on total staked amount; 10_000_000 (0.1%) by default"}},"setBSCValidator(address)":{"details":"Sets the operator address of the BSC validator initially delegated to. Call this function after 2nd upgrade done","params":{"_address":"- the operator address of BSC validator"}},"setMinBnb(uint256)":{"details":"Sets the minimum amount of BNB required for a withdrawal","params":{"_amount":"- the minimum amount of BNB required for a withdrawal"}},"setReserveAmount(uint256)":{"details":"Adjust reserve amount. `reserveAmount` is the buffer for undelegation.      Since the actual undelegate amount is slightly smaller than the Bot requested amount due to precision loss,      Bot will add some extra BNB when calling undelegateFrom for the first time, in order to cover the last request.","params":{"amount":"- Amount of Bnb"}},"setSynFee(uint256)":{"details":"Sets the protocol fee to be charged on staking rewards","params":{"_synFee":"- the fee to be charged on rewards; 500_000_000 (5%)"}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"togglePause()":{"details":"Flips the pause state by Admin"},"toggleVote()":{"details":"Flips the vote power flag"},"undelegate()":{"details":"Deprecated after fusion"},"undelegateFrom(address,uint256)":{"details":"Bot uses this function to undelegate BNB from a validator","params":{"_amount":"- Amount of bnb to undelegate","_operator":"- Operator address of validator to undelegate from"},"returns":{"_actualBnbAmount":"- the actual amount of BNB to be undelegated"}},"withdrawReserve(uint256)":{"details":"Used by Redirect Address to withdraw reserved funds","params":{"amount":"- Amount of BNB to withdraw"}}},"title":"Stake Manager Contract","version":1},"userdoc":{"kind":"user","methods":{"delegateTo(address,uint256)":{"notice":"The amount should be greater than minimum delegation"},"getUserRequestStatus(address,uint256)":{"notice":"Use `getUserWithdrawalRequests` to get the userWithdrawlRequests Array"},"requestWithdraw(uint256)":{"notice":"User must have approved this contract to spend SlisBnb"}},"notice":"This contract handles the liquid staking of BNB on BSC through the native StakeHub contract","version":1}},"settings":{"compilationTarget