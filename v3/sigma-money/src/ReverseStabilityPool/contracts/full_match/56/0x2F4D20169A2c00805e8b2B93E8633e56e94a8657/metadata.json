s information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"deposit(uint256)":{"params":{"_amount":"Amount of collateral to deposit."}},"eip712Domain()":{"details":"See {IERC-5267}."},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getUserExitRequest(address)":{"params":{"_user":"The address to query."},"returns":{"_0":"The ExitRequest struct for the user's active request."}},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"initialize(address,string,string,uint256,uint256)":{"params":{"_admin":"The address that receives DEFAULT_ADMIN_ROLE.","_dailyExitCapBps":"The initial daily exit cap in basis points.","_name":"The ERC20 token name for rToken.","_symbol":"The ERC20 token symbol for rToken.","_timeLockDuration":"The initial time-lock duration in seconds."}},"name()":{"details":"Returns the name of the token."},"nonces(address)":{"details":"Returns the current nonce for `owner`. This value must be included whenever a signature is generated for {permit}. Every successful call to {permit} increases ``owner``'s nonce by one. This prevents a signature from being used multiple times."},"permit(address,address,uint256,uint256,uint8,bytes32,bytes32)":{"details":"Sets `value` as the allowance of `spender` over ``owner``'s tokens, given ``owner``'s signed approval. IMPORTANT: The same issues {IERC20-approve} has related to transaction ordering also apply here. Emits an {Approval} event. Requirements: - `spender` cannot be the zero address. - `deadline` must be a timestamp in the future. - `v`, `r` and `s` must be a valid `secp256k1` signature from `owner` over the EIP712-formatted function arguments. - the signature must use ``owner``'s current nonce (see {nonces}). For more information on the signature format, see the https://eips.ethereum.org/EIPS/eip-2612#specification[relevant EIP section]. CAUTION: See Security Considerations above."},"processExits(uint128)":{"params":{"_count":"Maximum number of requests to process."}},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `callerConfirmation`. May emit a {RoleRevoked} event."},"requestExit(uint256)":{"params":{"_amount":"Amount of rToken to exit (will be burned when processed)."}},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."},"setDailyExitCapBps(uint256)":{"params":{"_newBps":"The new daily exit cap (max 10000)."}},"setDepositCap(uint256)":{"params":{"_newCap":"The new deposit cap (0 = unlimited)."}},"setDepositPaused(bool)":{"params":{"_paused":"Whether deposits should be paused."}},"setExitPaused(bool)":{"params":{"_paused":"Whether exits should be paused."}},"setTimeLockDuration(uint256)":{"params":{"_newDuration":"The new time-lock duration in seconds."}},"skipExit(uint128)":{"details":"Only callable when the head request cannot be processed (e.g., amount > dailyCap after totalDeposited shrinks).","params":{"_index":"The queue index to skip (must equal exitQueueHead for safety)."}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `value`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `value`. - the caller must have allowance for ``from``'s tokens of at least `value`."}},"stateVariables":{"BPS_BASE":{"details":"Basis points denominator (10000 = 100%)."},"MIN_TIME_LOCK_DURATION":{"details":"Minimum time-lock duration (1 hour)."},"dailyExitCapBps":{"details":"5000 = 50%, max 10000 = 100%. 0 means no exits allowed."},"userExitIndex":{"details":"0 means no active request (queue indices start at 1 via offset)."}},"title":"ReverseStabilityPool","version":1},"userdoc":{"events":{"AssetManaged(address,uint256)":{"notice":"Emitted when funds are deployed to a strategy."},"DailyExitCapBpsUpdated(uint256,uint256)":{"notice":"Emitted when daily exit cap basis points is updated."},"DepositCapUpdated(uint256,uint256)":{"notice":"Emitted when deposit cap is updated."},"DepositPausedUpdated(bool)":{"notice":"Emitted when deposit pause state is updated."},"Deposited(address,uint256)":{"notice":"Emitted when a user deposits collateral and receives rToken."},"ExitPausedUpdated(bool)":{"notice":"Emitted when exit pause state is updated."},"ExitProcessed(address,uint256)":{"notice":"Emitted when an exit request is processed and collateral returned to user."},"ExitRequested(address,uint256,uint256,uint128)":{"notice":"Emitted when a user submits an exit request."},"ExitSkipped(address,uint256,uint128)":{"notice":"Emitted when an admin skips a stuck exit request, returning rToken to the user."},"StrategyAllocated(address,address,uint96)":{"notice":"Emitted when a strategy is allocated to an asset."},"StrategyKilled(address,address)":{"notice":"Emitted when a strategy is killed and its allocation cleared."},"TimeLockDurationUpdated(uint256,uint256)":{"notice":"Emitted when time-lock duration is updated."}},"kind":"user","methods":{"EMERGENCY_ROLE()":{"notice":"The role for emergency pause/unpause operations."},"OPERATOR_ROLE()":{"notice":"The role for operational parameter adjustments."},"collateralToken()":{"notice":"The address of the collateral token (one asset per RSP instance)."},"currentEpoch()":{"notice":"Current epoch day (block.timestamp / 86400)."},"dailyExitCap()":{"notice":"Cached daily exit cap (set once per epoch from totalDeposited * dailyExitCapBps / BPS_BASE)."},"dailyExitCapBps()":{"notice":"Daily exit cap in basis points of totalDeposited."},"dailyExitedAmount()":{"notice":"Amount already processed today (resets on epoch boundary)."},"deposit(uint256)":{"notice":"Deposit collateral and receive 1:1 rToken."},"depositCap()":{"notice":"Maximum deposit cap. 0 = unlimited."},"depositPaused()":{"notice":"Whether deposits are paused."},"exitPaused()":{"notice":"Whether exits are paused."},"exitQueue(uint128)":{"notice":"Exit queue: index => ExitRequest."},"exitQueueHead()":{"notice":"Queue head pointer (next index to dequeue)."},"exitQueueTail()":{"notice":"Queue tail pointer (next index to enqueue)."},"getUserExitRequest(address)":{"notice":"Returns the active exit request for a user."},"initialize(address,string,string,uint256,uint256)":{"notice":"Initialize the RSP contract."},"processExits(uint128)":{"notice":"Batch-process eligible exit requests from the queue."},"requestExit(uint256)":{"notice":"Submit an exit request, locking rToken in the contract."},"setDailyExitCapBps(uint256)":{"notice":"Update the daily exit cap in basis points."},"setDepositCap(uint256)":{"notice":"Update the deposit cap."},"setDepositPaused(bool)":{"notice":"Pause or unpause deposits."},"setExitPaused(bool)":{"notice":"Pause or unpause exits."},"setTimeLockDuration(uint256)":{"notice":"Update the time-lock duration for exit requests."},"skipExit(uint128)":{"notice":"Skip a stuck exit request at the queue head, returning locked rToken to the user."},"timeLockDuration()":{"notice":"Time-lock duration in seconds for exit requests (default 24 hours)."},"totalDeposited()":{"notice":"Total amount deposited by users (not affected by asset manager operations)."},"userExitIndex(address)":{"notice":"Mapping from user address to their active exit queue index."}},"notice":"Allows users to deposit a single collateral asset and receive 1:1 rToken. Pool assets are deployed to yield strategies via AssetManagement (alloc/manage). Users exit through a time-locked FIFO queue processed by the asset manager.","version":1}},"settings":{"compilationTarget":{"contracts/rsp/ReverseStabilityPool.sol":"ReverseStabilityPool"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol":{"keccak256":"0x6662ec4e5cefca03eeadd073e9469df8d2944bb2ee8ec8f7622c2c46aab5f225","license":"MIT","urls":["bzz-raw://4d8544c6f8daa4d1bc215c6a72fe0acdb748664a105b0e5efc19295667521d45","dweb:/ipfs/QmdGWqdnXT8S3RgCR6aV8XHZrsybieMQLLnug1NtpSjEXN"]},"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol":{"keccak256":"0x631188737069917d2f909d29ce62c4d48611d326686ba6683e26b72a23bfac0b","license":"MIT","urls":["bzz-raw://7a61054ae84cd6c4d04c0c4450ba1d6de41e27e0a2c4f1bcdf58f796b401c609","dweb:/ipfs/QmUvtdp7X1mRVyC3CsHrtPbgoqWaXHp3S1ZR24tpAQYJWM"]},"@openzeppelin/contracts-upgradeable/token/ERC20/ERC20Upgradeable.sol":{"keccak256":"0x9a1766b1921bf91b3e61eb53c7a6e707