roval. Requirements: - `spender` cannot be the zero address."},"balanceOf(address)":{"details":"Returns the value of tokens owned by `account`."},"convertEmissionsToken(uint256)":{"details":"mints xShadows for each shadow."},"createVest(uint256)":{"details":"vesting xShadows --> emissionToken functionality"},"decimals()":{"details":"Returns the number of decimals used to get its user representation. For example, if `decimals` equals `2`, a balance of `505` tokens should be displayed to a user as `5.05` (`505 / 10 ** 2`). Tokens usually opt for a value of 18, imitating the relationship between Ether and Wei. This is the default value returned by this function, unless it's overridden. NOTE: This information is only used for _display_ purposes: it in no way affects any of the arithmetic of the contract, including {IERC20-balanceOf} and {IERC20-transfer}."},"exit(uint256)":{"details":"exit instantly with a penalty","params":{"_amount":"amount of xShadows to exit"}},"exitVest(uint256)":{"details":"handles all situations regarding exiting vests"},"getVestInfo(address,uint256)":{"params":{"_vestID":"vest ID to check","_who":"who to check"},"returns":{"_0":"VestPosition vest info"}},"isExempt(address)":{"params":{"_who":"who to check"},"returns":{"_exempt":"whether it's exempt"}},"name()":{"details":"Returns the name of the token."},"operatorRedeem(uint256)":{"details":"allows the operator to redeem collected xShadows"},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"rescueTrappedTokens(address[],uint256[])":{"details":"allows rescue of any non-stake token"},"startRebase(address,address)":{"details":"start the rebase"},"symbol()":{"details":"Returns the symbol of the token, usually a shorter version of the name."},"totalSupply()":{"details":"Returns the value of tokens in existence."},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `value`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Skips emitting an {Approval} event indicating an allowance update. This is not required by the ERC. See {xref-ERC20-_approve-address-address-uint256-bool-}[_approve]. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `value`. - the caller must have allowance for ``from``'s tokens of at least `value`."}},"stateVariables":{"SHADOW":{"details":"IERC20 declaration of Shadow"},"VOTER":{"details":"declare IVoter"},"exempt":{"details":"stores the addresses that are exempt from transfer limitations when transferring out"},"exemptTo":{"details":"stores the addresses that are exempt from transfer limitations when transferring to them"},"rebaseStarted":{"details":"check if the rebase has started"}},"version":1},"userdoc":{"kind":"user","methods":{"BASIS()":{"notice":"denominator"},"MAX_VEST()":{"notice":"the maximum vesting length"},"MIN_VEST()":{"notice":"the minimum vesting length"},"SLASHING_PENALTY()":{"notice":"max slashing amount"},"VOTE_MODULE()":{"notice":"address of the VoteModule"},"getBalanceResiding()":{"notice":"returns the amount of SHADOW within the contract"},"getVestInfo(address,uint256)":{"notice":"returns the vest info for a user"},"isExempt(address)":{"notice":"whether the address is exempt"},"lastDistributedPeriod()":{"notice":"the last period rebases were distributed"},"migrateOperator(address)":{"notice":"migrates the operator to another contract"},"operator()":{"notice":"address of the operator"},"pause()":{"notice":"pauses the contract"},"pendingRebase()":{"notice":"amount of pvp rebase penalties accumulated pending to be distributed"},"rebase()":{"notice":"function called by the minter to send the rebases once a week"},"setExemption(address[],bool[])":{"notice":"set exemption status for an address"},"unpause()":{"notice":"u