"type":"function"},{"inputs":[{"components":[{"internalType":"int256","name":"ulow","type":"int256"},{"internalType":"int256","name":"u1","type":"int256"},{"internalType":"int256","name":"u2","type":"int256"},{"internalType":"int256","name":"ucrit","type":"int256"},{"internalType":"int256","name":"rmin","type":"int256"},{"internalType":"int96","name":"kmin","type":"int96"},{"internalType":"int96","name":"kmax","type":"int96"},{"internalType":"int256","name":"alpha","type":"int256"},{"internalType":"int256","name":"cminus","type":"int256"},{"internalType":"int256","name":"cplus","type":"int256"},{"internalType":"int256","name":"c1","type":"int256"},{"internalType":"int256","name":"c2","type":"int256"},{"internalType":"int256","name":"dmax","type":"int256"}],"internalType":"struct IDynamicKinkModel.Config","name":"_config","type":"tuple"}],"name":"verifyConfig","outputs":[],"stateMutability":"view","type":"function"}],"devdoc":{"errors":{"FailedDeployment()":[{"details":"The deployment failed."}],"InsufficientBalance(uint256,uint256)":[{"details":"The ETH balance of the account is not enough to perform the operation."}],"InvalidAccountNonce(address,uint256)":[{"details":"The nonce used for an `account` is not the expected current nonce."}],"SafeCastOverflowedIntDowncast(uint8,int256)":[{"details":"Value doesn't fit in an int of `bits` size."}],"SafeCastOverflowedUintToInt(uint256)":[{"details":"An uint value doesn't fit in an int of `bits` size."}]},"events":{"NewDynamicKinkModel(address)":{"params":{"irm":"The address of the newly created DynamicKinkModel instance"}}},"kind":"dev","methods":{"create((int256,int256,int256,int256,int256,int96,int96,int256,int256,int256,int256,int256,int256),(uint32,int96),address,address,bytes32)":{"details":"This function verifies the configuration, creates a clone of the implementation,      initializes it with the provided parameters, and tracks it in the factory.      The same salt will always produce the same address, enabling deterministic deployments.       The function can be used in separate transactions - configurations can be prepared      and validated before being used for Silo creation. ","params":{"_config":"Updatable configuration parameters","_externalSalt":"External salt for the CREATE2 deterministic deployment","_immutableArgs":"Immutable configuration arguments","_initialOwner":"Address that will own and control the created model instance","_silo":"Address of the Silo contract this model will serve"},"returns":{"irm":"The deployed DynamicKinkModel instance (IInterestRateModel interface)"}},"generateConfig((uint64,uint64,uint64,uint64,uint72,uint72,uint72,uint72,uint32,uint32,uint32,uint32,uint32))":{"details":"This function takes intuitive configuration parameters and converts them to the      internal mathematical parameters used by the DynamicKinkModel. It performs      validation to ensure the configuration is mathematically sound and within      acceptable limits.       The conversion includes:      - Converting annual rates to per-second rates      - Calculating slope parameters (kmin, kmax) from rate ranges      - Computing time-based coefficients (c1, c2, cminus, cplus)      - Validating parameter relationships and constraints ","params":{"_default":"User-friendly configuration parameters (utilization thresholds, rates, times)"},"returns":{"config":"Internal configuration parameters ready for model initialization"}},"nonces(address)":{"details":"Returns the next unused nonce for an address."},"predictAddress(address,bytes32)":{"details":"This function calculates the address that would be generated by CREATE2 when      creating a DynamicKinkModel with the given deployer and salt. This enables      front-running protection and allows users to know the address before deployment.       The same deployer and salt will always produce the same predicted address. ","params":{"_deployer":"Address of the account that will deploy the model","_externalSalt":"External salt for the CREATE2 deterministic deployment"},"returns":{"predictedAddress":"The address where the DynamicKinkModel would be deployed"}},"verifyConfig((int256,int256,int256,int256,int256,int96,int96,int256,int256,int256,int256,int256,int256))":{"details":"This function checks if all configuration parameters are within the safe operating ranges      defined by the model whitepaper. Some limits are narrower than the original whitepaper      due to additional research and safety considerations.       For detailed limits, see:      https://silofinance.atlassian.net/wiki/spaces/SF/pages/347963393/DynamicKink+model+config+limits+V1 ","params":{"_config":"The configuration to validate (does not include model state)"}}},"stateVariables":{"DP":{"details":"DP in 18 decimal points used for integer calculations"},"IRM":{"details":"IRM contract implementation address to clone"},"ONE_YEAR":{"details":"seconds per year used in interest calculations."},"createdByFactory":{"details":"This function verifies whether a given address corresponds to a DynamicKinkModel      instance that was deployed through this factory. This is useful for:      - Verifying the authenticity of model instances      - Implementing access controls based on factory creation      - Tracking and managing factory-deployed models ","params":{"_irm":"Address of the DynamicKinkModel contract to check"},"return":"True if the model was created by this factory, false otherwise","returns":{"_0":"True if the model was created by this factory, false otherwise"}}},"version":1},"userdoc":{"errors":{"DeployerCannotBeZero()":[{"notice":"Thrown when trying to predict address with zero deployer address"}]},"events":{"NewDynamicKinkModel(address)":{"notice":"Emitted when a new DynamicKinkModel instance is created"}},"kind":"user","methods":{"create((int256,int256,int256,int256,int256,int96,int96,int256,int256,int256,int256,int256,int256),(uint32,int96),address,address,bytes32)":{"notice":"Creates a new DynamicKinkModel instance using CREA