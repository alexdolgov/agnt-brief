t256,int24,uint256,uint256)":{"params":{"index":"The index of the position within the tick.","notifier":"The address of the notifier.","notifierRewards":"The amount of rewards received by the notifier.","ownerRewards":"The amount of rewards received by the owner.","tick":"The tick of the position.","tickVersion":"The version of the tick."}},"Withdraw(address,int24,uint256,uint256)":{"params":{"index":"The index of the position within the tick.","owner":"The address of the position owner.","tick":"The tick of the position.","tickVersion":"The version of the tick."}}},"kind":"dev","methods":{"acceptOwnership()":{"details":"The new owner accepts the ownership transfer."},"constructor":{"params":{"campaignId":"The campaign ID in the SmarDex rewards provider contract which provides reward tokens to this contract.","rewardsProvider":"The address of the SmarDex rewards provider contract.","usdnProtocol":"The address of the USDN protocol contract."}},"getAccRewardPerShare()":{"details":"This value represents the cumulative rewards per share, scaled for precision. It is updated before each user action.","returns":{"accRewardPerShare_":"The value of the rewards per share accumulator."}},"getLastRewardBlock()":{"details":"This value is updated before each user action.","returns":{"block_":"The block number of the last update."}},"getNotifierRewardsBps()":{"returns":{"notifierRewardsBps_":"The current notifier rewards factor value."}},"getPositionInfo(int24,uint256,uint256)":{"params":{"index":"The index of the position within the tick.","tick":"The tick of the position in the USDN protocol.","tickVersion":"The version of the tick."},"returns":{"info_":"The information of the specified position."}},"getPositionsCount()":{"returns":{"count_":"The total count of deposited positions."}},"getTotalShares()":{"details":"Shares represent the trading exposure of deposited USDN positions.","returns":{"shares_":"The total shares of all positions."}},"harvest(int24,uint256,uint256)":{"details":"If the position is not liquidated, rewards are sent to the owner, and `rewardDebt` is updated. If liquidated, rewards are split between the `msg.sender` and the position's owner, and the position is deleted. This function can notify the farming protocol of a liquidation and reward the notifier. If there are no pending rewards, this function will not perform any actions. However, calling the function may still incur a transaction fee.","params":{"index":"The index of the position within the tick.","tick":"The tick of the position.","tickVersion":"The version of the tick."},"returns":{"isLiquidated_":"Indicates whether the position was liquidated.","rewards_":"The amount of rewards sent to the position's owner. Returns 0 if liquidated."}},"owner()":{"details":"Returns the address of the current owner."},"ownershipCallback(address,(int24,uint256,uint256))":{"params":{"oldOwner":"The previous owner of the position","posId":"The unique position identifier"}},"pendingOwner()":{"details":"Returns the address of the pending owner."},"pendingRewards(int24,uint256,uint256)":{"params":{"index":"The index of the position within the tick.","tick":"The tick of the position.","tickVersion":"The version of the tick."},"returns":{"rewards_":"The amount of pending rewards for the position."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"setNotifierRewardsBps(uint16)":{"params":{"notifierRewardsBps":"The notifier rewards factor value, in basis points."}},"supportsInterface(bytes4)":{"details":"Returns true if this contract implements the interface defined by `interfaceId`. See the corresponding https://eips.ethereum.org/EIPS/eip-165#how-interfaces-are-identified[ERC section] to learn more about how these ids are created. This function call must use less than 30 000 gas."},"transferOwnership(address)":{"details":"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."},"withdraw(int24,uint256,uint256)":{"details":"If the position is not liquidated, rewards are sent to the position's owner, and the position is withdrawn. If liquidated, rewards are split between the `msg.sender` and the position's owner, and the position is deleted.","params":{"index":"The index of the position within the tick.","tick":"The tick of the position.","tickVersion":"The version of the tick."},"returns":{"isLiquidated_":"Indicates whether the position was liquidated.","rewards_":"The amount of rewards sent to the position's owner. Returns 0 if liquidated."}}},"stateVariables":{"SCALING_FACTOR":{"details":"Scaling factor for {_accRewardPerShare}. In the worst case of having 1 wei of reward tokens per block for a duration of 1 block, and with a total number of shares equivalent to 500 million wstETH, the accumulator value increment would still be 2e11 which is precise enough."},"_accRewardPerShare":{"details":"Accumulated reward tokens per share multiplied by {SCALING_FACTOR}. The factor is necessary to represent rewards per shares with enough precision for very small reward quantities and large total number of shares. In the worst case of having a very large number of reward tokens per block (1000e18) and a very small total number of shares (1 wei), this number would not overflow for 1.158e18 blocks which is ~440 billion years."},"_lastRewardBlock":{"details":"Block number when the last rewards were calculated."},"_notifierRewardsBps":{"details":"Ratio of the rewards to be distributed to the notifier in basis points: default is 30%."},"_positions":{"details":"The position information for each locked position, identified by the hash of its `PositionId`."},"_positionsCount":{"details":"The total number of locked positions."},"_totalShares":{"details":"The sum of all locked positions' initial trading exposure."}},"title":"USDN Long Positions Farming","version":1},"userdoc":{"events":{"Deposit(address,int24,uint256,uint256)":{"notice":"A USDN protocol user position has been deposited into the contract."},"Harvest(address,uint256,int24,uint256,uint256)":{"notice":"The rewards have been sent to the owner of a position."},"NotifierRewardsBpsUpdated(uint16)":{"notice":"The notifier rewards factor has been updated."},"Slash(address,uint256,uint256,int24,uint256,uint256)":{"notice":"A position has been deleted and the notifier has received part of the rewards."},"Withdraw(address,int24,uint256,uint256)":{"notice":"A USDN protocol user position has been withdrawn from the contract."}},"kind":"user","methods":{"BPS_DIVISOR()":{"notice":"Denominator for the rewards multiplier, will give a 0.01% basis point."},"CAMPAIGN_ID()":{"notice":"The ID of the campaign in the SmarDex rewards provider contract which provides reward tokens to this contract."},"REWARDS_PROVIDER()":{"notice":"The address of the SmarDex rewards provider contract, which is the source of the reward tokens."},"REWARD_TOKEN()":{"notice":"The address of the reward token."},"USDN_PROTOCOL()":{"notice":"The address of the USDN protocol contract."},"getAccRewardPerShare()":{"notice":"Gets the value of the rewards per share accumulator."},"getLastRewardBlock()":{"notice":"Gets the block number when the rewards accumulator was last updated."},"getNotifierRewardsBps()":{"notice":"Gets the current notifier rewards factor, in basis points."},"getPositionInfo(int24,uint256,uint256)":{"notice":"Retrieves the information of a deposited USDN protocol position."},"getPositionsCount()":{"notice":"Gets the total number of deposited positions."},"getTotalShares()":{"notice":"Gets the total shares of all deposited positions."},"harvest(int24,uint256,uint256)":{"notice":"Claims rewards for a USDN protocol position and updates its status."},"ownershipCallback(address,(int24,uint256,uint256))":{"notice":"This function is called by the USDN protocol on the new position owner after a transfer of ownership"},"pendingRewards(int24,uint256,uint256)":{"notice":"Calculates the pending rewards for a specific position."},"setNotifierRewardsBps(uint16)":{"notice":"Sets the rewards factor for notifiers."},"withdraw(int24,uint256,uint256)":{"notice":"Withdraws a USDN protocol position and claims its rewards."}},"notice":"A contract for farming USDN long positions to earn rewards.","version":1}},"settings":{"compilationTarget":{"src/UsdnLongFarming.sol":"UsdnLongFarming"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":20000},"remappings":[":@chainlink-1.2.0/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@chainlink-1.2.0/",":@chainlink/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@chainlink-1.2.0/",":@openzeppelin-contracts-5.1.0/=dependencies/@openzeppelin-contracts-5.1.0/",":@openzeppelin-contracts-5/=dependencies/@openzeppelin-contracts-5.1.0/",":@openzeppelin-contracts-upgradeable-5.1.0/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@openzeppelin-contracts-upgradeable-5.1.0/",":@openzeppelin/contracts-upgradeable/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@openzeppelin-contracts-upgradeable-5.1.0/",":@openzeppelin/contracts/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@openzeppelin-contracts-5.1.0/",":@pythnetwork-pyth-sdk-solidity-3.1.0/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@pythnetwork-pyth-sdk-solidity-3.1.0/",":@pythnetwork/pyth-sdk-solidity/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@pythnetwork-pyth-sdk-solidity-3.1.0/",":@redstone-finance-evm-connector-0.6.2/=dependencies/@smardex-usdn-contracts-0.24.1/dependencies/@redstone-finance-evm-con