if using `renounceRole`, it is the role bearer (i.e. `account`)"}},"kind":"dev","methods":{"getAdapter(address,address)":{"params":{"tokenIn":"The address of the input token of the swap","tokenOut":"The address of the output token of the swap"},"returns":{"adapter":"The address of the adapter to use for the swap"}},"getInputAmount(address,address,uint256)":{"details":"We are ignoring exchange fees","params":{"amountOut":"The amount of output token to be provided","tokenIn":"The address of the input token","tokenOut":"The address of the output token"},"returns":{"amountIn":"The amount of input tokens that will be taken in exchange of `amountOut`"}},"getInputAmountMax(address,address,uint256)":{"params":{"amountOut":"The amount of output token to be provided","tokenIn":"The address of the input token","tokenOut":"The address of the output token"},"returns":{"amountIn":"The maximum amount of input tokens that will be taken"}},"getOutputAmount(address,address,uint256)":{"details":"We are ignoring exchange fees","params":{"amountIn":"The amount of input token to be provided","tokenIn":"The address of the input token","tokenOut":"The address of the output token"},"returns":{"amountOut":"The amount of output tokens that will be given back in exchange of `amountIn`"}},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getSlippage(address,address)":{"params":{"tokenIn":"The address of the input token of the swap","tokenOut":"The address of the output token of the swap"},"returns":{"slippage":"The maximum accepted slippage for the swap"}},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleGranted} event."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `account`. May emit a {RoleRevoked} event."},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."},"setAdapter(address,address,address)":{"params":{"adapter":"The address of the adapter to use for the swap","tokenIn":"The address of the input token of the swap","tokenOut":"The address of the output token of the swap"}},"setSlippage(address,address,uint256)":{"params":{"slippage":"The maximum accepted slippage for the swap in wad (1e18 = 100%)","tokenIn":"The address of the input token of the swap","tokenOut":"The address of the output token of the swap"}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."},"swapIn(address,address,uint256)":{"details":"The client choose how much tokenIn it wants to provideThe client needs to approve the amountIn of tokenIn","params":{"amountIn":"The amount of input token to be provided","tokenIn":"The address of the input token","tokenOut":"The address of the output token"},"returns":{"amountOut":"The amount of output token given by the exchange"}},"swapOut(address,address,uint256,uint256)":{"details":"The client choose how much tokenOut it wants to obtainThe client needs to approve the getInputAmount of tokenIn","params":{"amountOut":"The amount of output token to be obtained","preApprovedAmountIn":"The amount of input token that the caller has approved to be moved","tokenIn":"The address of the input token","tokenOut":"The address of the output token"},"returns":{"amountIn":"The amount of input token that has been spent"}}},"title":"A simple contract delegated to exchange selection for token pairs swap This contract is meant to reference a Chainlink oracle and check the swaps against the oracle prices, accepting a maximum slippage that can be set for every pair.","version":1},"userdoc":{"kind":"user","methods":{"getAdapter(address,address)":{"notice":"Returns the adapter to use for a pair of tokens"},"getInputAmount(address,address,uint256)":{"notice":"Preview how much tokenIn will be taken in exchange for an amount of tokenOut"},"getInputAmountMax(address,address,uint256)":{"notice":"Preview how much tokenIn will be taken at maximum in the given trade"},"getOutputAmount(address,address,uint256)":{"notice":"Preview how much tokenOut will be given back in exchange of an amount of tokenIn"},"getSlippage(address,address)":{"notice":"Returns the slippage parameter for a given tokens pair swap"},"setAdapter(address,address,address)":{"notice":"Sets a adapter to use for a pair of tokens"},"setSlippage(address,address,uint256)":{"notice":"Sets a slippage parameter for a given tokens pair swap"},"swapIn(address,address,uint256)":{"notice":"Swaps the given amount of tokenIn tokens in exchange for some tokenOut tokens"},"swapOut(address,address,uint256,uint256)":{"notice":"Swaps some tokenIn tokens in exchange for the given amount of tokenOut tokens"}},"version":1}},"settings":{"compilationTarget":{"src/providers/SwapAdapterRouter.sol":"SwapAdapterRouter"},"debug":{"revertStrings":"debug"},"evmVersion":"paris","libraries":{"src/lib/Amount.sol:AmountHelper":"0x425b3b64ed63e4a8426827dd6640d282de4435f0","src/lib/AmountsMath.sol:AmountsMath":"0x91869f15667a8f78d7e89323fbc9a29803417b70","src/lib/EpochController.sol:EpochController":"0xf4f015e8877960940b8e732edd886b2ca2d2c099","src/lib/EpochFrequency.sol:EpochFrequency":"0xbc5c693a11e8cc2cdf19815e19b1d84a092796ec","src/lib/Finance.sol:Finance":"0x1e