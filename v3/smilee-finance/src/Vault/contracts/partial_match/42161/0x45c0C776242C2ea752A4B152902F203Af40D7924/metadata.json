e."},"totalSupply()":{"details":"See {IERC20-totalSupply}."},"transfer(address,uint256)":{"details":"See {IERC20-transfer}. Requirements: - `to` cannot be the zero address. - the caller must have a balance of at least `amount`."},"transferFrom(address,address,uint256)":{"details":"See {IERC20-transferFrom}. Emits an {Approval} event indicating the updated allowance. This is not required by the EIP. See the note at the beginning of {ERC20}. NOTE: Does not update the allowance if the current allowance is the maximum `uint256`. Requirements: - `from` and `to` cannot be the zero address. - `from` must have a balance of at least `amount`. - the caller must have allowance for ``from``'s tokens of at least `amount`."},"transferPayoff(address,uint256,bool)":{"params":{"amount":"The number of base tokens to move","isPastEpoch":"Flag to tell if the payoff is for an expired position","recipient":"The address receiving the quantity"}},"v0()":{"returns":{"_0":"The number of base tokens available for issuing options"}}},"stateVariables":{"baseToken":{"return":"The contract address of the base token","returns":{"_0":"The contract address of the base token"}},"sideToken":{"return":"The contract address of the side token","returns":{"_0":"The contract address of the side token"}}},"version":1},"userdoc":{"kind":"user","methods":{"balances()":{"notice":"Gives portfolio composition for currently active epoch"},"baseToken()":{"notice":"The base token in the pair of the DVP"},"changePauseState()":{"notice":"Pause/Unpause"},"completeWithdraw()":{"notice":"Completes a scheduled withdrawal from a past epoch. Uses finalized share price of the withdrawal creation epoch."},"deltaHedge(int256)":{"notice":"Adjusts the portfolio by trading the given amount of side tokens"},"deposit(uint256,address,uint256)":{"notice":"Provides liquidity for the next epoch"},"dvp()":{"notice":"The address of the DVP paired with this vault"},"emergencyRebalance()":{"notice":"If ever stuck in InsufficientLiquidity 