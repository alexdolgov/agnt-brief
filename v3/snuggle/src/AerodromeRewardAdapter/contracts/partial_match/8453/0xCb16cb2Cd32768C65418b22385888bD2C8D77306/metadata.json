eration ownership verification      - Try-catch for killed gauge handling      - Emergency unstake function","kind":"dev","methods":{"claimRewards(uint256,address)":{"details":"Uses balance-before/after pattern and try-catch for safety      Aerodrome doesn't allow fee collection while staked, so fees0/fees1 are always 0","params":{"recipient":"Address to receive the rewards","tokenId":"The position NFT token ID"},"returns":{"earned":"Amount of staking rewards claimed (AERO/CAKE/etc)","fees0":"Amount of token0 trading fees collected","fees1":"Amount of token1 trading fees collected"}},"constructor":{"params":{"_aero":"AERO token address","_factory":"Aerodrome CLFactory address","_positionManager":"Aerodrome NonfungiblePositionManager address","_stakingManager":"The StakingManager address that can also call this adapter","_treasury":"Treasury address for swept rewards","_vault":"The SnuggleVault address that can call this adapter","_voter":"Aerodrome Voter contract address"}},"emergencyUnstake(uint256)":{"details":"Use only if normal unstake fails due to gauge issues","params":{"tokenId":"The NFT position ID"}},"getGaugeStatus(address)":{"params":{"pool":"The pool address"},"returns":{"alive":"Whether gauge is alive (receiving emissions)","exists":"Whether gauge exists"}},"getStakedGauge(uint256)":{"params":{"tokenId":"The NFT position ID"},"returns":{"_0":"The gauge address (address(0) if not staked)"}},"getStakingContract(address)":{"params":{"pool":"The pool address"},"returns":{"_0":"The staking contract address, or address(0) if none"}},"isStaked(uint256)":{"details":"Returns false if position is being withdrawn (read-only reentrancy protection)","params":{"tokenId":"The position NFT token ID"},"returns":{"_0":"True if staked, false otherwise"}},"onERC721Received(address,address,uint256,bytes)":{"details":"V13-L-03: Only accepts NFTs from the Aerodrome position manager"},"pendingRewards(uint256)":{"details":"Uses try-catch in case gauge is in bad state","params":