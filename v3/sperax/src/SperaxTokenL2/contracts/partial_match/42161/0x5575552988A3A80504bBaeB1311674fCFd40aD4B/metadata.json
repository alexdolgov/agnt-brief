)":{"details":"Transfer to the \"recipient\" some specified 'amount' that is locked until \"releaseTime\""},"unpause()":{"details":"Returns to normal state."}},"stateVariables":{"l1Address":{"return":"address of layer 1 token"}},"title":"SPA Token Contract on Arbitrum (L2)","version":1},"userdoc":{"kind":"user","methods":{"batchTransfer(address[],uint256[])":{"notice":"that excessive gas consumption causes transaction revert"},"bridgeBurn(address,uint256)":{"notice":"should decrease token supply by amount, and should (probably) only be callable by the L1 bridge."},"bridgeMint(address,uint256)":{"notice":"should increase token supply by amount, and should (probably) only be callable by the L1 bridge."},"changeArbToken(address,address)":{"notice":"change the arbitrum bridge address and corresponding L1 token address"},"mintPause()":{"notice":"only Owner call"},"mintUnpause()":{"notice":"only Owner call"},"pause()":{"notice":"only Owner call"},"release(address,uint256)":{"notice":"only Owner call"},"transferWithLock(address,uint256,uint256)":{"notice":"only Owner call"},"unpause()":{"notice":"only Owner call"}},"version":1}},"settings":{"compilationTarget":{"SperaxTokenL2.sol":"SperaxTokenL2"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"SperaxTokenL2.sol":{"keccak256":"0x1d85b2f91abd83e76263a2cec337ea7e497de136ec445e1f495edd95f98123eb","urls":["bzz-raw://2c78f9cf2df1bab366f3dd3caf68443b491337b447daf3a521cbe04a87a609ab","dweb:/ipfs/QmNUgWdHSUXBwRCq9HTkuusZAwYnDkTwJES5xbBY2GcXxd"]}},"version":1}