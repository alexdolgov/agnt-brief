pragma solidity ^0.8.19;

interface IAuraBooster {
    function poolLength() external view returns (uint256);

    function poolInfo(uint256 pid)
        external
        view
        returns (
            address lptoken,
            address token,
            address gauge,
            address crvRewards,
            address stash,
            bool shutdown
        );

    function earmarkRewards(uint256 _pid) external returns (bool);
}
