pragma solidity 0.8.28;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {IVlSDT} from "src/interfaces/IVlSDT.sol";

/**
 * @title IVlFeeDistributor
 * @notice Interface for epoch-based fee distribution to vlSDT holders
 */
interface IVlFeeDistributor {
    ////////////////////////////////////////////////////////////////
    /// --- EVENTS
    ////////////////////////////////////////////////////////////////

    event CheckpointToken(uint256 indexed time, uint256 tokens);
    event Claimed(address indexed user, address indexed receiver, uint256 amount, uint256 claimUpToEpoch);
    event Deposited(address indexed depositor, uint256 amount);
    event Recovered(address indexed emergencyAddress, address indexed token, uint256 amount);
    event EmergencyAddressUpdated(address indexed newEmergencyAddress);
    event Killed();

    ////////////////////////////////////////////////////////////////
    /// --- ERRORS
    ////////////////////////////////////////////////////////////////

    error ContractKilled();
    error ZeroAddress();
    error ZeroAmount();
    error CannotRecoverRewardToken();
    error NoStakers();
    error OnlyOperator();
    error StartEpochTooEarly();

    ////////////////////////////////////////////////////////////////
    /// --- CONSTANTS
    ////////////////////////////////////////////////////////////////

    /// @notice Duration of one epoch in seconds (7 days)
    // solhint-disable-next-line func-name-mixedcase
    function EPOCH_DURATION() external view returns (uint256);

    /// @notice Maximum epochs to process in a single claim call
    // solhint-disable-next-line func-name-mixedcase
    function MAX_CLAIM_EPOCHS() external view returns (uint256);

    /// @notice Maximum epochs to process in a single token checkpoint
    // solhint-disable-next-line func-name-mixedcase
    function MAX_CHECKPOINT_EPOCHS() external view returns (uint256);

    /// @notice Time after which anyone can trigger auto-checkpoint during claims
    // solhint-disable-next-line func-name-mixedcase
    function TOKEN_CHECKPOINT_DEADLINE() external view returns (uint256);

    /// @notice vlSDT contract for balance queries
    // solhint-disable-next-line func-name-mixedcase
    function VLSDT() external view returns (IVlSDT);

    /// @notice Token being distributed as rewards
    // solhint-disable-next-line func-name-mixedcase
    function REWARD_TOKEN() external view returns (IERC20);

    /// @notice Timestamp when distribution starts
    // solhint-disable-next-line func-name-mixedcase
    function START_TIME() external view returns (uint256);

    ////////////////////////////////////////////////////////////////
    /// --- STORAGE GETTERS
    ////////////////////////////////////////////////////////////////

    /// @notice Reward tokens available for distribution per epoch
    function tokensPerEpoch(uint256 epoch) external view returns (uint256);

    /// @notice Last time token checkpoint was called
    function lastTokenTime() external view returns (uint256);

    /// @notice Token balance at last checkpoint
    function tokenLastBalance() external view returns (uint256);

    /// @notice Last claimed epoch timestamp per user
    function lastClaimedEpoch(address user) external view returns (uint256);

    /// @notice Address to receive tokens on emergency recovery
    function emergencyAddress() external view returns (address);

    /// @notice Whether the contract is killed
    function isKilled() external view returns (bool);

    ////////////////////////////////////////////////////////////////
    /// --- TOKEN CHECKPOINTING
    ////////////////////////////////////////////////////////////////

    /// @notice Checkpoint newly received tokens into epoch buckets
    function checkpointToken() external;

    /// @notice Deposit reward tokens and checkpoint
    /// @param amount Amount of reward tokens to deposit
    function deposit(uint256 amount) external;

    ////////////////////////////////////////////////////////////////
    /// --- CLAIMS
    ////////////////////////////////////////////////////////////////

    /// @notice Claim accumulated rewards for the caller
    /// @return amount Total tokens claimed
    function claim() external returns (uint256 amount);

    /// @notice Claim accumulated rewards for a specific user
    /// @dev Only callable by operators.
    /// @param user Address to claim for
    /// @param receiver Address to receive the tokens
    /// @return amount Total tokens claimed
    function claim(address user, address receiver) external returns (uint256 amount);

    /// @notice Claim rewards starting from a specific epoch, skipping earlier ones
    /// @dev Skipped epochs are permanently forfeited.
    /// @param startEpoch Epoch timestamp to start claiming from
    /// @return amount Total tokens claimed
    function claimWithPermanentEpochSkip(uint256 startEpoch) external returns (uint256 amount);

    /// @notice Operator claim starting from a specific epoch, skipping earlier ones
    /// @dev Skipped epochs are permanently forfeited.
    /// @param user Address to claim for
    /// @param receiver Address to receive the tokens
    /// @param startEpoch Epoch timestamp to start claiming from
    /// @return amount Total tokens claimed
    function claimWithPermanentEpochSkip(address user, address receiver, uint256 startEpoch) external returns (uint256 amount);

    ////////////////////////////////////////////////////////////////
    /// --- VIEW FUNCTIONS
    ////////////////////////////////////////////////////////////////

    /// @notice Calculate claimable amount for a user without claiming
    /// @param user Address to check
    /// @param startEpoch Epoch to start from (0 = use default from checkpoints)
    /// @return amount Claimable tokens
    /// @return lastProcessedEpoch The last epoch processed (0 if none)
    function claimable(address user, uint256 startEpoch)
        external
        view
        returns (uint256 amount, uint256 lastProcessedEpoch);

    /// @notice Get the current epoch start timestamp
    /// @return timestamp Epoch start timestamp
    function currentEpoch() external view returns (uint256 timestamp);

    /// @notice Get the epoch start timestamp for a given timestamp
    /// @param _timestamp Timestamp to get the epoch for
    /// @return timestamp Epoch start timestamp
    function epochAt(uint256 _timestamp) external pure returns (uint256 timestamp);

    /// @notice Get tokens distributed for a specific epoch
    /// @param epoch Epoch start timestamp
    /// @return tokens Tokens allocated for that epoch
    function getTokensForEpoch(uint256 epoch) external view returns (uint256 tokens);

    ////////////////////////////////////////////////////////////////
    /// --- OWNER FUNCTIONS
    ////////////////////////////////////////////////////////////////

    /// @notice Kill the contract in emergency
    function kill() external;

    /// @notice Recover accidentally sent tokens (not the reward token)
    /// @param token Token to recover
    function recoverToken(address token) external;

    /// @notice Update emergency return address
    /// @param _emergencyAddress New emergency return address
    function setEmergencyAddress(address _emergencyAddress) external;
}
