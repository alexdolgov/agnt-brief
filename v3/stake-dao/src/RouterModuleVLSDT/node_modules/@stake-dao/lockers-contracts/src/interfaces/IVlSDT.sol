pragma solidity ^0.8.0;

/**
 * @title IVlSDT Interface
 * @notice Interface for vlSDT - Vote Locked SDT
 * @dev Non-transferable ERC20 with flat voting power and 8-week unstake delay.
 *      Replaces veSDT's time-decaying model with constant voting power.
 */
interface IVlSDT {
    // =========================================================================
    //                                 STRUCTS
    // =========================================================================

    /// @notice Unstake request data (packed into single slot: uint160 + uint48 + uint48 = 256 bits)
    /// @param amount The amount of SDT to withdraw
    /// @param deadline The timestamp when withdrawal becomes available
    /// @param createdAt The timestamp when the unstake was requested (for penalty calculation)
    struct UnstakeRequest {
        uint160 amount;
        uint48 deadline;
        uint48 createdAt;
    }

    /// @notice Penalty configuration with 2-step update mechanism (packed into single slot)
    /// @param penaltyReceiver Address that receives penalty SDT (address(0) disables early exit)
    /// @param maxPenaltyBps Current maximum penalty in basis points
    /// @param pendingMaxPenaltyBps Scheduled future maximum penalty in basis points
    /// @param effectiveTimestamp When pendingMaxPenaltyBps becomes active (0 = no pending update)
    struct PenaltyConfig {
        address penaltyReceiver;        // 160 bits - kill switch when address(0)
        uint24 maxPenaltyBps;           //  24 bits
        uint24 pendingMaxPenaltyBps;    //  24 bits
        uint48 effectiveTimestamp;      //  48 bits
        // total: 256 bits, 1 slot
    }

    // =========================================================================
    //                                 EVENTS
    // =========================================================================

    /// @notice Emitted when SDT is staked for vlSDT
    event Staked(address indexed caller, address indexed recipient, uint256 amount);

    /// @notice Emitted when an unstake is requested
    event UnstakeRequested(uint256 indexed id, address indexed owner, uint256 amount, uint256 deadline);

    /// @notice Emitted when an unstake request is cancelled
    event UnstakeCancelled(uint256 indexed id, address indexed owner, uint256 amount);

    /// @notice Emitted when SDT is withdrawn after unstake delay
    event Withdrawn(uint256 indexed id, address indexed owner, address indexed recipient, uint256 amount);

    /// @notice Emitted when the unstake delay is updated
    event UnstakeDelaySet(uint256 oldUnstakeDelay, uint256 newUnstakeDelay);

    /// @notice Emitted when a user withdraws early with penalty
    event WithdrawnEarly(
        uint256 indexed id, address indexed owner, address indexed recipient, uint256 amount, uint256 penaltyAmount
    );

    /// @notice Emitted when the penalty receiver address is updated
    event PenaltyReceiverSet(address indexed oldPenaltyReceiver, address indexed newPenaltyReceiver);

    /// @notice Emitted when a maximum penalty update is scheduled
    event MaxPenaltyUpdateScheduled(uint256 currentMaxBps, uint256 pendingMaxBps, uint256 effectiveTimestamp);

    /// @notice Emitted when a pending maximum penalty update is applied
    event MaxPenaltyUpdateApplied(uint256 oldMaxBps, uint256 newMaxBps);

    /// @notice Emitted when an operator authorization is set or revoked
    event OperatorAuthorizationSet(address indexed operator, bool authorized);

    // =========================================================================
    //                                 ERRORS
    // =========================================================================

    error NonTransferable();
    error AmountMustBeGreaterThanZero();
    error AmountExceedsUsableBalance();
    error RecipientCannotBeZeroAddress();
    error BoostRegistryCannotBeZeroAddress();
    error Unauthorized();
    error UnstakeRequestNotFound();
    error UnstakeRequestNotExpired();
    error UnstakeRequestAlreadyExpired();
    error EarlyExitDisabled();
    error InvalidPenalty();
    error NoPendingUpdate();
    error UpdateNotEffectiveYet();

    // =========================================================================
    //                               CONSTANTS
    // =========================================================================

    // solhint-disable-next-line func-name-mixedcase
    function SDT() external view returns (address);

    // solhint-disable-next-line func-name-mixedcase
    function VE_SDT() external view returns (address);

    // solhint-disable-next-line func-name-mixedcase
    function BOOST_REGISTRY() external view returns (address);

    // solhint-disable-next-line func-name-mixedcase
    function PENALTY_UPDATE_DELAY() external view returns (uint256);

    // =========================================================================
    //                            STATE VARIABLES
    // =========================================================================

    function nonce() external view returns (uint96);
    function unstakeDelay() external view returns (uint160);
    function operators(address operator) external view returns (bool);

    function unstakeRequests(uint256 id) external view returns (uint160 amount, uint48 deadline, uint48 createdAt);
    function penaltyConfig()
        external
        view
        returns (address penaltyReceiver, uint24 maxPenaltyBps, uint24 pendingMaxPenaltyBps, uint48 effectiveTimestamp);

    // =========================================================================
    //                          ERC20 VIEW FUNCTIONS
    // =========================================================================

    function name() external view returns (string memory);
    function symbol() external view returns (string memory);
    function decimals() external view returns (uint8);
    function totalSupply() external view returns (uint256);
    function balanceOf(address account) external view returns (uint256);

    // =========================================================================
    //                      ERC20 DISABLED FUNCTIONS
    // =========================================================================

    function transfer(address to, uint256 amount) external returns (bool);
    function transferFrom(address from, address to, uint256 amount) external returns (bool);
    function approve(address spender, uint256 amount) external returns (bool);
    function allowance(address owner, address spender) external view returns (uint256);

    // =========================================================================
    //                              STAKING
    // =========================================================================

    function stake(uint256 amount, address recipient) external;
    function unstake(uint256 amount) external returns (uint256 id);
    function cancelUnstake(uint256 id) external;

    // =========================================================================
    //                             WITHDRAWAL
    // =========================================================================

    function withdraw(uint256 id, address recipient) external;
    function withdrawEarly(uint256 id, address recipient) external;

    // =========================================================================
    //                              MIGRATION
    // =========================================================================

    function migrateFrom(address user, uint256 amount) external;

    // =========================================================================
    //                           VIEW FUNCTIONS
    // =========================================================================

    function calculatePenalty(uint256 id)
        external
        view
        returns (uint256 penaltyAmount, uint256 penaltyBps, uint256 userReceives, bool canWithdrawEarly);

    // =========================================================================
    //                             CHECKPOINTS
    // =========================================================================

    function balanceOfAt(address user, uint256 timestamp) external view returns (uint256 balance);
    function totalSupplyAt(uint256 timestamp) external view returns (uint256 supply);
    function numCheckpoints(address user) external view returns (uint256 nbrOfCheckpoints);
    function checkpoints(address user, uint256 index) external view returns (uint48 timestamp, uint208 balance);

    // =========================================================================
    //                           GOVERNANCE
    // =========================================================================

    function setUnstakeDelay(uint256 _unstakeDelay) external;
    function setPenaltyReceiver(address _penaltyReceiver) external;
    function scheduleMaxPenaltyUpdate(uint256 _newMaxPenaltyBps) external;
    function applyMaxPenaltyUpdate() external;
    function setOperatorAuthorization(address operator, bool authorized) external;
    function isOperator(address operator) external view returns (bool);

    // =========================================================================
    //                         OWNABLE2STEP FUNCTIONS
    // =========================================================================

    function owner() external view returns (address);
    function pendingOwner() external view returns (address);
    function transferOwnership(address newOwner) external;
    function acceptOwnership() external;
    function renounceOwnership() external;
}
