tails":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeVaults(uint256,uint256,bytes)":{"params":{"_data":"optional encoded function call to be executed after upgrade","_numVaults":"number of vaults to upgrade starting at _startIndex","_startIndex":"index of first vault to upgrade"}}},"title":"Operator Vault Controller Strategy","version":1},"userdoc":{"kind":"user","methods":{"addFee(address,uint256)":{"notice":"adds a new fee"},"addVault(address)":{"notice":"deploys a new vault"},"canDeposit()":{"notice":"returns the available deposit room for this strategy"},"canWithdraw()":{"notice":"returns the available withdrawal room for this strategy"},"checkUpkeep(bytes)":{"notice":"returns whether there are enough buffered tokens to initiate a deposit and the index of the first non-full vault"},"deposit(uint256)":{"notice":"deposits tokens into this strategy"},"depositBufferedTokens(uint256)":{"notice":"deposits buffered tokens into vaults"},"getDepositChange()":{"notice":"returns the deposit change (positive/negative) since deposits were last updated"},"getFees()":{"notice":"returns a list of all fees"},"getMaxDeposits()":{"notice":"returns the maximum that can be deposited into this strategy"},"getMinDeposits()":{"notice":"returns the minimum that must remain this strategy"},"getPendingFees()":{"notice":"returns the  total amount of fees that will be paid on the next update"},"getTotalDeposits()":{"notice":"the total amount of deposits as tracked in this strategy"},"getVaultDepositLimits()":{"notice":"returns the vault deposit limits"},"getVaults()":{"notice":"returns a list of all vaults"},"migrateVaults(uint256,uint256,bytes)":{"notice":"migrates vaults to a new stake controller"},"performUpkeep(bytes)":{"notice":"deposits buffered tokens into vaults if buffered balance exceeds minDepositThreshold"},"setMinDepositThreshold(uint2