iew","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"bytes","name":"","type":"bytes"}],"name":"onERC721Received","outputs":[{"internalType":"bytes4","name":"","type":"bytes4"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_sender","type":"address"},{"internalType":"uint256","name":"_value","type":"uint256"},{"internalType":"bytes","name":"_calldata","type":"bytes"}],"name":"onTokenTransfer","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"priorityPool","outputs":[{"internalType":"contract IPriorityPool","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"proxiableUUID","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"sdlPool","outputs":[{"internalType":"contract ISDLPool","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"staker","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"token","outputs":[{"internalType":"contract IERC20Upgradeable","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"}],"name":"upgradeTo","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newImplementation","type":"address"},{"internalType":"bytes","name":"data","type":"bytes"}],"name":"upgradeToAndCall","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_amountToWithdraw","type":"uint256"},{"internalType":"uint256","name":"_distributionAmount","type":"uint256"},{"internalType":"uint256","name":"_distributionSharesAmount","type":"uint256"},{"internalType":"bytes32[]","name":"_merkleProof","type":"bytes32[]"},{"internalType":"uint256[]","name":"_withdrawalIds","type":"uint256[]"},{"internalType":"uint256[]","name":"_batchIds","type":"uint256[]"},{"internalType":"bytes[]","name":"_data","type":"bytes[]"}],"name":"withdraw","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_tokenId","type":"uint256"},{"internalType":"address","name":"_receiver","type":"address"}],"name":"withdrawRESDLToken","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"withdrawalPool","outputs":[{"internalType":"contract IWithdrawalPool","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"details":"When tokens are queued for deposit, the corresponding liquid staking tokens will be distributed using a merkle tree. The tree is updated once a certain threshold of LSTs is reached at which point LSTs can be claimed. In order for this contract to claim its LSTs (and execute some other funcion calls), merkle data must be passed as an argument. This data is stored on IPFS at the hash which can be queried from this contract. For some functions, this data can be used as is but for ones that require a merkle proof, a merkle tree must be generated using the IPFS data, then a merkle proof generated using the tree.Data may or may not need to be passed when depositing and/or withdrawing depending on the underlying LST implementation. If data does need to be passed, it will need to be fetched from an external source specific to that LST.","kind":"dev","methods":{"claimLSTs(uint256,uint256,bytes32[])":{"params":{"_amount":"amount as recorded in this contract's merkle tree entry (stored on IPFS)","_merkleProof":"merkle proof for this contract's merkle tree entry (generated from IPFS data)","_sharesAmount":"shares amount as recorded in this contract's merkle tree entry (stored on IPFS)"}},"claimRESDLRewards(address[])":{"details":"rewards will be redistributed to the SDL Poolthis contract will be redistrubuted some of its own rewards","params":{"_tokens":"list of tokens to claim rewards for"}},"constructor":{"custom:oz-upgrades-unsafe-allow":"constructor"},"deposit(uint256,bytes[])":{"params":{"_amount":"amount of tokens to deposit","_data":"encoded deposit data"}},"getMerkleIPFSHash()":{"details":"returns CIDv0 with no prefix - prefix must be added and hash must be properly encoded offchain","returns":{"_0":"IPFS hash"}},"getRESDLTokenIds()":{"returns":{"_0":"list of token ids"}},"getTotalClaimableLSTs(uint256)":{"params":{"_distributionSharesAmount":"shares amount as recorded in this contract's merkle tree entry (stored on IPFS)"},"returns":{"_0":"total claimable LSTs"}},"getTotalDeposits()":{"details":"excludes unclaimed LSTs sitting in the priority pool","returns":{"_0":"total LSTs held by contract"}},"getTotalQueuedForDeposit(uint256)":{"params":{"_distributionAmount":"amount as recorded in this contract's merkle tree entry (stored on IPFS)"},"returns":{"_0":"total tokens queued for deposit"}},"getTotalQueuedForWithdrawal()":{"returns":{"_0":"total tokens queued for withdrawal"}},"getTotalWithdrawable(uint256)":{"params":{"_distributionAmount":"amount as recorded in this contract's merkle tree entry (stored on IPFS)"},"returns":{"_0":"total amount withdrawable from the priority pool","_1":"total amount withdrawable from the withdrawal pool","_2":"withdrawal ids for withdrawal from withdrawal pool","_3":"batch ids for withdrawal from withdrawal pool"}},"initialize(address,address,address,address,address,address)":{"params":{"_lst":"address of liquid staking token","_priorityPool":"address of priority pool","_sdlPool":"address of SDL pool","_staker":"address authorized to deposit/withdraw asset tokens","_token":"address of asset token","_withdrawalPool":"address of withdrawal pool"}},"onTokenTransfer(address,uint256,bytes)":{"params":{"_calldata":"encoded deposit data","_sender":"address of sender","_value":"value of transfer"}},"owner()":{"details":"Returns the address of the current owner."},"proxiableUUID()":{"details":"Implementation of the ERC1822 {proxiableUUID} function. This returns the storage slot used by the implementation. It is used to validate the implementation's compatibility when performing an upgrade. IMPORTANT: A proxy pointing at a proxiable contract should not be considered proxiable itself, because this risks bricking a proxy that upgrades to it, by delegating to itself until out of gas. Thus it is critical that this function revert if invoked through a proxy. This is guaranteed by the `notDelegated` modifier."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"upgradeTo(address)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"custom:oz-upgrades-unsafe-allow-reachable":"delegatecall","details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"withdraw(uint256,uint256,uint256,bytes32[],uint256[],uint256[],bytes[])":{"details":"if there is any amount withdrawable from the withdrawal pool, the entire amount will be withdrawn even if it exceeds _amountToWithdraw","params":{"_amountToWithdraw":"amount of tokens to withdraw","_batchIds":"list of batch ids required if finalizing queued withdrawals","_data":"encoded withdrawal data","_distributionAmount":"amount as recorded in this contract's merkle tree entry (stored on IPFS)","_distributionSharesAmount":"shares amount as recorded in this contract's merkle tree entry (stored on IPFS)","_merkleProof":"merkle proof for this contract's merkle tree entry (generated using IPFS data)","_withdrawalIds":"list of withdrawal ids required if finalizing queued withdrawals"}},"withdrawRESDLToken(uint256,address)":{"params":{"_receiver":"address to receive token","_tokenId":"id of token"}}},"title":"Staking Proxy","version":1},"userdoc":{"kind":"user","methods":{"claimLSTs(uint256,uint256,bytes32[])":{"notice":"Claims liquid staking tokens from the priority pool"},"claimRESDLRewards(address[])":{"notice":"Claims rewards from the SDL Pool"},"deposit(uint256,bytes[])":{"notice":"Deposits tokens and/or queues tokens for deposit into the staking pool"},"getMerkleIPFSHash()":{"notice":"Returns the IPFS hash of the current merkle distribution tree"},"getRESDLTokenIds()":{"notice":"Returns a list of reSDL token ids held by this contract"},"getTotalClaimableLSTs(uint256)":{"notice":"Returns the total amount of claimable liquid staking tokens for this contract"},"getTotalDeposits()":{"notice":"Returns the total amount of liquid staking tokens held by this contract"},"getTotalQueuedForDeposit(uint256)":{"notice":"Returns the total amount of tokens queued for deposit into the staking pool by this contract"},"getTotalQueuedForWithdrawal()":{"notice":"Returns the total amount of tokens queued for withdrawal from the staking pool by this contract"},"getTotalWithdrawable(uint256)":{"notice":"Returns the total amount of withdrawable tokens for this contract"},"initialize(address,address,address,address,address,address)":{"notice":"Initializes the contract"},"onERC721Received(address,address,uint256,bytes)":{"notice":"Called when an reSDL token is transferred to this contract using safeTransfer"},"onTokenTransfer(address,uint256,bytes)":{"notice":"ERC677 implementation to receive deposits"},"withdraw(uint256,uint256,uint256,bytes32[],uint256[],uint256[],bytes[])":{"notice":"Withdraws tokens and/or queues tokens for withdrawal from the staking pool"},"withdrawRESDLToken(uint256,address)":{"notice":"Withdraws an reSDL token"}},"notice":"Enables a staker to deposit tokens and earn rewards without ever directly interacting with the LST contracts","version":1}},"settings":{"compilationTarget":{"contracts/core/StakingProxy.sol":"StakingProxy"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":115},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol":{"keccak256":"0x359a1ab89b46b9aba7bcad3fb651924baf4893d15153049b9976b0fc9be1358e","license":"MIT","urls":["bzz-raw://e89863421b4014b96a4b62be76eb3b9f0a8afe9684664a6f389124c0964bfe5c","dweb:/ipfs/Qmbk7xr1irpDuU1WdxXgxELBXxs61rHhCgod7heVcvFx16"]},"@openzeppelin/contracts-upgradeable/interfaces/IERC1967Upgradeable.sol":{"keccak256":"0x47d6e06872b12e72c79d1b5eb55842f860b5fb1207b2317c2358d2766b950a7b","license":"MIT","urls":["bzz-raw://ac55bf6f92fc7b90c6d79d346163a0a02bd5c648c7fede08b20e5da96d4ae2a0","dweb:/ipfs/QmQoSrHhka35iKDK5iyNt8cuXXS5ANXVPjLhfsJjktB8V9"]},"@openzeppelin/contracts-upgradeable/interfaces/draft-IERC1822Upgradeable.sol":{"keccak256":"0x77c89f893e403efc6929ba842b7ccf6534d4ffe03afe31670b4a528c0ad78c0f","license":"MIT","urls":["bzz-raw://496bd9b3df2455d571018c09f0c6badd29713fdeb907c6aa09d8d28cb603f053","dweb:/ipfs/QmXdJDyYs6WMwMh21dez2BYP