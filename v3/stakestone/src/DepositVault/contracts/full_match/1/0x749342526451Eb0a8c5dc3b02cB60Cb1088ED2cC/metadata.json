d and assets have valid oracles/decimals.      Grants infinite approval of assets to the router.","params":{"_accessRegistry":"Address of the access registry contract.","_adminRole":"Address granted the VAULT_ADMIN_ROLE.","_assetsRouter":"Address of the assets router contract.","_defaultAdmin":"Address to receive the DEFAULT_ADMIN_ROLE.","_operatorRole":"Address granted the VAULT_OPERATOR_ROLE.","_oracleRegistry":"Address of the oracle registry contract.","_paramRegistry":"Address of the parameter registry contract.","_underlyingAssets":"Initial list of supported assets.","_vaultToken":"Address of the vault token contract."}},"convertToAssets(address,uint256)":{"details":"Denormalizes values back from 18 decimals to asset decimals.      Uses floor rounding to avoid overestimating asset returns.","params":{"_asset":"Address of the underlying asset.","_shares":"Number of vault shares."},"returns":{"assets_":"Equivalent underlying asset amount.","underlyingPrice_":"Price of the underlying asset.","vaultTokenPrice_":"Price of the vault token."}},"convertToShares(address,uint256)":{"details":"Normalizes `_amount` to 18 decimals before conversion.      Uses floor rounding to avoid overestimating shares.","params":{"_amount":"Amount of underlying asset.","_asset":"Address of the underlying asset."},"returns":{"shares_":"Equivalent vault shares.","underlyingPrice_":"Price of the underlying asset.","vaultTokenPrice_":"Price of the vault token."}},"deposit(address,uint256)":{"details":"Equivalent to `depositFor` with msg.sender as receiver.","params":{"_amount":"Amount of asset to deposit.","_asset":"Address of the asset to deposit."},"returns":{"shares_":"Number of shares minted."}},"depositFor(address,uint256,address)":{"details":"Reverts if receiver is zero address.","params":{"_amount":"Amount of asset to deposit.","_asset":"Address of the asset to deposit.","_receiver":"Recipient of the minted shares."},"returns":{"shares_":"Number of shares minted."}},"exchangePrice()":