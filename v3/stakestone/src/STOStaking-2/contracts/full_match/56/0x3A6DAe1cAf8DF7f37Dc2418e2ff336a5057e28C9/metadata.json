 distributing in-game resources.  - Integrates with ReferralRegistry for bonus hammer rewards.","errors":{"BelowMinimumLockAmount()":[{"details":"Selector: 0xdcb6ca48"}],"EventNotActive()":[{"details":"Selector: 0x0f0c1bc8"}],"EventNotEnded()":[{"details":"Selector: 0xfb141a0d"}],"ExceedMaxRawStoneMintAmount()":[{"details":"Selector: 0x7849ba98"}],"IndexOutOfBounds()":[{"details":"Selector: 0x4e23d035"}],"InvalidArrayLength()":[{"details":"Selector: 0x9d89020a"}],"InvalidPrice()":[{"details":"Selector: 0x00bfc921"}],"InvalidStartTime()":[{"details":"Selector: 0xb290253c"}],"NothingToUnlock()":[{"details":"Selector: 0x764c157f"}],"OwnableInvalidOwner(address)":[{"details":"The owner is not a valid owner account. (eg. `address(0)`)"}],"OwnableUnauthorizedAccount(address)":[{"details":"The caller account is not authorized to perform an operation."}],"UnlockNotMatured()":[{"details":"Selector: 0x2a916d02"}],"ZeroAddress()":[{"details":"Selector: 0xd92e233d"}]},"events":{"SetGoldenStonePrice(uint256,uint256)":{"params":{"newPrice":"New price.","oldPrice":"Previous price."}},"SetHammerPrice(uint256,uint256)":{"params":{"newPrice":"New price.","oldPrice":"Previous price."}},"SetMaxDailyRawStoneMintAmount(uint256,uint256)":{"params":{"newAmount":"The new maximum daily raw stone mint amount.","oldAmount":"The previous maximum daily raw stone mint amount."}},"SetRawStonePrice(uint256,uint256)":{"params":{"newPrice":"New price.","oldPrice":"Previous price."}},"TokenLockedForHammer(address,address,uint256)":{"params":{"amount":"Amount of STO locked.","player":"Address performing the lock.","token":"The STO token address."}},"TokenLockedForRawStone(address,address,uint256)":{"params":{"amount":"Amount of STO locked.","player":"Address performing the lock.","token":"The STO token address."}},"TokenUnlocked(address,address,uint256)":{"params":{"amount":"Amount unlocked.","player":"The user unlocking STO.","token":"The STO token address."}}},"kind":"dev","methods":{"acceptOwnership()":{"details":"The new owner accepts the ownership transfer."},"constructor":{"details":"Start time must be UTC-0 aligned and in the future.","params":{"_expeditionAddr":"GenesisExpedition contract address.","_referralRegistryAddr":"ReferralRegistry contract address.","_startTime":"Event start timestamp.","_stoAddr":"STO token address."}},"getLastUnlockIndex(address)":{"params":{"_player":"Address to query."},"returns":{"index_":"Next unlockable index."}},"getLockEntries(address)":{"params":{"_player":"Address to query."},"returns":{"lockEntries_":"Array of all LockEntry items."}},"getLockEntries(address,uint256,uint256)":{"params":{"_limit":"Number of entries to return.","_player":"Address to query.","_start":"Starting index."},"returns":{"lockEntries_":"Slice of lock entries."}},"getLockEntryLength(address)":{"params":{"_player":"Address to query."},"returns":{"length_":"Number of lock entries."}},"getMintedRawStones(address,uint256)":{"details":"The timestamp parameter is normalized to the corresponding UTC-0 day boundary      using floor-to-day logic before querying storage. The returned value represents      only the raw stones minted on that day, not the cumulative total.      This function is intended for off-chain indexing (e.g., Subgraph) and      historical reward analysis.","params":{"_player":"The address of the player to query.","_timestamp":"Any timestamp within the target day (will be floored to UTC-0)."},"returns":{"_amount":"The number of raw stones minted for the player on the specified day."}},"getTotalLockedAmount(address)":{"params":{"_player":"User address."},"returns":{"lockedAmount_":"Total locked STO."}},"getUnlockableAmount(address)":{"params":{"_player":"Address to query."},"returns":{"unlockableAmount_":"Total unlockable STO."}},"lockFor(uint256,uint256,address)":{"details":"Wrapper around `_lockForResources`.","params":{"_hammers":"Number of hammers to mint.","_rawStones":"Number of raw stones to mint.","_referrer":"Address of the referring user."}},"lockForHammers(uint256,address)":{"params":{"_amount":"Number of hammers to mint.","_referrer":"Referrer address."}},"lockForRawStones(uint256,address)":{"params":{"_amount":"Number of raw stones to mint.","_referrer":"Referrer address."}},"owner()":{"details":"Returns the address of the current owner."},"pendingOwner()":{"details":"Returns the address of the pending owner."},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"setGoldenStonePrice(uint256)":{"params":{"_stoPerGoldenStone":"New price."}},"setHammerPrice(uint256)":{"params":{"_stoPerHammer":"New price."}},"setMaxDailyRawStoneMintAmount(uint256)":{"params":{"_maximumAmount":"New limit."}},"setRawStonePrice(uint256)":{"params":{"_stoPerRawStone":"New price."}},"transferOwnership(address)":{"details":"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one. Can only be called by the current owner. Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer."},"unlock(uint256)":{"details":"- Each lock entry unlocks at: `END_TIME_INDEX + entry.timeIndex`.  - Reverts if any entry in range has not matured.","params":{"_lockIndex":"Last index to unlock (inclusive)."}},"unlockAll()":{"details":"Stops at the first non-mature lock entry."}},"stateVariables":{"mintedRawStones":{"details":"- Keyed by user and floored UTC day timestamp."}},"title":"STOStaking","version":1},"userdoc":{"errors":{"BelowMinimumLockAmount()":[{"notice":"Thrown when user locks less than the required minimum amount."}],"EventNotActive()":[{"notice":"Thrown when an action requires the event to be active but it is not."}],"EventNotEnded()":[{"notice":"Thrown when an action requires the event to have ended but it has not."}],"ExceedMaxRawStoneMintAmount()":[{"notice":"Thrown when a user attempts to lock more than the maximum allowed for raw stones."}],"IndexOutOfBounds()":[{"notice":"Thrown when accessing an array index out of bounds."}],"InvalidArrayLength()":[{"notice":"Thrown when input arrays have mismatched or invalid lengths."}],"InvalidPrice()":[{"notice":"Thrown when an admin sets an invalid price or configuration value."}],"InvalidStartTime()":[{"notice":"Thrown when the staking start time is invalid or misaligned."}],"NothingToUnlock()":[{"notice":"Thrown when a user attempts to unlock but has no unlockable balance."}],"UnlockNotMatured()":[{"notice":"Thrown when user attempts to unlock tokens before maturity."}],"ZeroAddress()":[{"notice":"Thrown when a required address argument is zero."}]},"events":{"SetGoldenStonePrice(uint256,uint256)":{"notice":"Emitted when the STO -> Golden Stone conversion price changes."},"SetHammerPrice(uint256,uint256)":{"notice":"Emitted when the STO -> Hammer conversion price changes."},"SetMaxDailyRawStoneMintAmount(uint256,uint256)":{"notice":"Emitted when the maximum daily raw stone mint limit is updated."},"SetRawStonePrice(uint256,uint256)":{"notice":"Emitted when the STO -> Raw Stone conversion price changes."},"TokenLockedForHammer(address,address,uint256)":{"notice":"Emitted when a player locks STO for hammers."},"TokenLockedForRawStone(address,address,uint256)":{"notice":"Emitted when a player locks STO for raw stones."},"TokenUnlocked(address,address,uint256)":{"notice":"Emitted when locked STO becomes unlocked and is withdrawn."}},"kind":"user","methods":{"DURATION()":{"notice":"Duration of the staking event."},"END_TIME()":{"notice":"Event end timestamp (`START_TIME + DURATION`)."},"END_TIME_INDEX()":{"notice":"UTC-0 day index corresponding to `END_TIME`."},"EXPEDITION_ADDR()":{"notice":"GenesisExpedition contract for distributing Hammers, Raw Stones, Golden Stones."},"REFERRAL_REGISTRY_ADDR()":{"notice":"Referral registry for establishing referrer/referee relationships."},"START_TIME()":{"notice":"Event start timestamp (UTC-0 aligned)."},"START_TIME_INDEX()":{"notice":"UTC-0 day index corresponding to `START_TIME`."},"STO_ADDR()":{"notice":"Address of the STO ERC20 token to be staked."},"constructor":{"notice":"Initializes the STO staking contract."},"getLastUnlockIndex(address)":{"notice":"Returns the next unlockable lock index."},"getLockEntries(address)":{"notice":"Returns all lock entries for a user."},"getLockEntries(address,uint256,uint256)":{"notice":"Paginated lock entry query."},"getLockEntryLength(address)":{"notice":"Returns total number of lock entries for a user."},"getMintedRawStones(address,uint256)":{"notice":"Returns the amount of raw stones minted for a specific player on a given day."},"getTotalLockedAmount(address)":{"notice":"Returns total STO locked by `_player`."},"getUnlockableAmount(address)":{"notice":"Computes how much STO is unlockable at current time."},"lockFor(uint256,uint256,address)":{"notice":"Locks STO for both Hammers and Raw Stones in a single transaction."},"lockForHammers(uint256,address)":{"notice":"Locks STO exclusively for hammers."},"lockForRawStones(uint256,address)":{"notice":"Locks STO exclusively for raw stones."},"maximumDailyRawStoneMintAmount()":{"notice":"Maximum number of raw stones that can be minted by locking sto per day."},"setGoldenStonePrice(uint256)":{"notice":"Updates STO price per Golden Stone."},"setHammerPrice(uint256)":{"notice":"Updates STO price per Hammer."},"setMaxDailyRawStoneMintAmount(uint256)":{"notice":"Updates the maximum daily raw stone mint limit."},"setRawStonePrice(uint256)":{"notice":"Updates STO price per Raw Stone."},"stoPerGoldenStone()":{"notice":"STO amount required to mint one Golden Stone."},"stoPerHammer()":{"notice":"STO amount required to mint one Hammer."},"stoPerRawStone()":{"notice":"STO amount required to mint one Raw Stone."},"unlock(uint256)":{"notice":"Unlocks matured lock entries up to `_lockIndex`."},"unlockAll()":{"notice":"Unlocks all matured lock entries."}},"notice":"Enables users to lock STO tokens during the Genesis Expedition event         to earn Hammers, Raw Stones, and Golden Stones.","version":1}},"settings":{"compilationTarget":{"src/STOStaking.sol":"STOStaking"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/",":@uniswap/v3-periphery/contracts/=lib/v3-periphery/contracts/",":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/",":forge-std/=lib/forge-std/src/",":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/",":openzeppelin-contracts/=lib/openzeppelin-contracts/",":v3-periphery/=lib/v3-periphery/contracts/"]},"sources":{"lib/openzeppelin-contracts/contracts/access/Ownable.sol":{"keccak256":"0xff6d0bb2e285473e5311d9d3caacb525ae3538a80758c10649a4d61029b017bb","license":"MIT","urls":["bzz-raw://8ed324d3920bb545059d66ab97d43e43ee85fd3bd52e03e401f020afb0b120f6","dweb:/ipfs/QmfEckWLmZkDDcoWrkEvMWhms66xwTLff9DDhegYpvHo1a"]},"lib/openzeppelin-contracts/contracts/access/Ownable2Step.sol":{"keccak256":"0xdcad8898fda432696597752e8ec361b87d85c82cb258115427af006dacf7128c","license":"MIT","urls":["bzz-raw://e2c9d517f0c136d54bd00cd57959d25681d4d6273f5bbbc263afe228303772f0","dweb:/ipfs/QmReNFjXBiufByiAAzfSQ2SM5r3qeUErn46BmN3yVRvrek"]},"lib/openzeppelin-contracts/contracts/token/ERC20/IERC20.sol":{"keccak256":"0x74ed01eb66b923d0d0cfe3be84604ac04b76482a55f9dd655e1ef4d367f95bc2","license":"MIT","urls":["bzz-raw://5282825a626cfe924e504274b864a652b0023591fa66f06a067b25b51ba9b303","dweb:/ipfs/QmeCfPykghhMc81VJTrHTC7sF6CRvaA1FXVq2pJhwYp1dV"]},"lib/openzeppelin-contracts/contracts/utils/Context.sol":{"keccak256":"0x493033a8d1b176a037b2cc6a04dad01a5c157722049bbecf632ca876224dd4b2","license":"MIT","urls":["bzz-raw://6a708e8a5bdb1011c2c381c9a5cfd