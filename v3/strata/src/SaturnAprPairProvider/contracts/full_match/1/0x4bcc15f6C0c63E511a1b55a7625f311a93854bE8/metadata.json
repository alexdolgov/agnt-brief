ract IStrcPriceOracle","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"kind":"dev","methods":{"getAPRbase()":{"details":"Formula: (unvestedSTRC * strcPrice / 10^priceDecimals) * SECONDS_PER_YEAR              / remainingVestingTime / totalAssets      Returns 0 when there is no active vesting (between distributions).","returns":{"_0":"apr The annualized base APR as int64, scaled by 1e12"}},"setAprTarget(int64)":{"details":"Called by the Keeper when STRC announces the dividends.      Keeper reads currentDividend from STRC API and applies seniorShare ratio.      Example: currentDividend = 11.5%, seniorShare = 70% → aprTarget = 8.05%","params":{"newAprTarget":"The new target APR, scaled by 1e12"}}},"stateVariables":{"aprTarget":{"details":"Updated by the Keeper when Saturn distributes new STRC rewards (~monthly).      Scaled by 1e12 (12 decimal places)."}},"title":"SaturnAprPairProvider","version":1},"userdoc":{"kind":"user","methods":{"aprTarget()":{"notice":"Senior benchmark APR: fixed % of STRC dividend rate"},"getAPRbase()":{"notice":"Computes annualized STRC dividend yield from on-chain sUSDat vesting state"},"setAprTarget(int64)":{"notice":"Update the target APR (benchmark for Senior tranche)"}},"notice":"Provides target APR (Senior benchmark) and base APR (STRC dividend rate) for the Saturn CDO. Target APR:   - Represents the Senior tranche benchmark: a fixed percentage of the STRC dividend rate.   - Updatable by the feed role (the Keeper reads currentDividend from STRC API     and applies a ratio, e.g. 0.7, to derive the target APR). Base APR:   - Computed on-chain from sUSDat's STRC vesting state and STRC oracle price.   - Represents the current annualized STRC dividend yield.   - With riskPremium = 100%, this value is canceled from the Senior APR calculation     (aprSrt = max(aprTarget, aprBase * 0) = aprTarget).   - Retained for informational purposes (dashboards, monitoring).","version":1}},"settings":{"compilationTarget":