name":"getMorphoMarket","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint8","name":"slot","type":"uint8"}],"name":"getMorphoPosition","outputs":[{"internalType":"uint256","name":"collateral","type":"uint256"},{"internalType":"uint256","name":"borrowShares","type":"uint256"},{"internalType":"uint256","name":"borrowAssets","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getPositionBreakdown","outputs":[{"internalType":"uint256","name":"usdtBalance","type":"uint256"},{"internalType":"uint256","name":"usdcBalance","type":"uint256"},{"internalType":"uint256","name":"reusdBalance","type":"uint256"},{"internalType":"uint256","name":"syBalance","type":"uint256"},{"internalType":"uint256","name":"ptBalance","type":"uint256"},{"internalType":"uint256[4]","name":"morphoCollaterals","type":"uint256[4]"},{"internalType":"uint256[4]","name":"morphoBorrowDebts","type":"uint256[4]"},{"internalType":"uint256","name":"ptToAssetRate","type":"uint256"},{"internalType":"uint256","name":"reusdToUsdtRate","type":"uint256"},{"internalType":"uint256","name":"usdcToUsdtRate","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getPtToAssetRate","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getReusdToUsdtRate","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getTotalAssets","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getUsdcToUsdtRate","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"morphoMarkets","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"pendleMarket","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"pt","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint8","name":"slot","type":"uint8"},{"internalType":"bytes32","name":"newMarketId","type":"bytes32"}],"name":"setMorphoMarket","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newPt","type":"address"},{"internalType":"address","name":"newPendleMarket","type":"address"},{"internalType":"address","name":"newSy","type":"address"}],"name":"setPendleConfig","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"sy","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"details":"Pricing oracles (NOT 1:1 simplification):      - USDT denomination (returned 1:1 since strategy reports in USDT terms)      - USDC → USDT via Chainlink USDC/USD ÷ USDT/USD      - reUSD → USDT via Fluid pool TWAP (oraclePrice with secondsAgos = TWAP_DURATION)      - PT-reUSD → reUSD via Pendle Oracle TWAP, then reUSD → USDT via Fluid TWAP      Re Protocol's reUSD has no Chainlink, Pyth, or Redstone feed available on mainnet.      Curve reUSD/USDC pool exists but has very thin liquidity (~$450K) and exhibits a      6-7% peg deviation from the actual market price quoted on Fluid (where >95% of      reUSD trading volume occurs). The Fluid pool TWAP is therefore the most accurate      and only viable price source. The 15-minute TWAP window provides reasonable      manipulation resistance for an asset whose primary venue is the Fluid pool itself.      Slot loan currency mapping (used to convert per-slot borrow debt):        slot 0 (reUSD/USDC)    → loan = USDC        slot 1 (reUSD/USDT)    → loan = USDT        slot 2 (PT-reUSD/USDC) → loan = USDC        slot 3 (PT-reUSD/USDT) → loan = USDT      ROLLOVER SUPPORT: PT/Pendle market/SY and each Morpho market id can be updated      via setPendleConfig() / setMorphoMarket(). Both setters require totalAssets to remain      within INVARIANCE_TOLERANCE_BPS — generalized check that implicitly enforces empty      old positions (PT balance, SY balance, Morpho collateral, Morpho debt all zero).","kind":"dev","methods":{"denominationToken()":{"details":"The CustomStrategy will verify this matches its own denominationToken","returns":{"_0":"The denomination token address"}},"getPtToAssetRate()":{"details":"The asset is whatever `SY.assetInfo()` reports as the underlying — for SY-reUSD      this is **USDC** (6 dec), NOT reUSD. So the returned value means      `usdcRaw = ptRaw * rate / 1e18`."},"getTotalAssets()":{"details":"This function should aggregate all positions, balances, and pending values      that belong to the strategy and convert them to the denomination token","returns":{"_0":"Total assets value in denomination token units"}}},"stateVariables":{"DECIMAL_DIFF_REUSD_USDC":{"details":"Decimal differences between reUSD (18) and USDC (6)"},"REUSD_USD_FEED":{"details":"Same source Morpho uses for the reUSD collateral oracle on Morpho Blue markets."}},"title":"PendleReUSDAssetsProvider","version":1},"userdoc":{"kind":"user","methods":{"CHAINLINK_STALENESS_THRESHOLD()":{"notice":"Maximum allowed staleness for Chainlink answers (seconds)"},"REUSD_FEED_STALENESS_THRESHOLD()":{"notice":"Maximum allowed staleness for the reUSD NAV feed (seconds; longer than stable feeds)"},"REUSD_USD_FEED()":{"notice":"Re Protocol reUSD/USD Chainlink-style adapter (NAV-driven, push by Chainlink Functions)"},"SLOT_REUSD_USDC()":{"notice":"Slot indices for Morpho markets"},"USDC_USD_FEED()":{"notice":"Chainlink USDC/USD price feed (8 decimals)"},"USDT_USD_FEED()":{"notice":"Chainlink USDT/USD price feed (8 decimals)"},"denominationToken()":{"notice":"Returns the denomination token used by this provider"},"getPtToAssetRate()":{"notice":"Get the current Pendle PT-to-asset rate (1e18 scale)."},"getReusdToUsdtRate()":{"notice":"Get USDT amount equivalent to 1e18 reUSD (6 dec)"},"getTotalAssets()":{"notice":"Returns total assets value denominated in the provider's denominationToken"},"getUsdcToUsdtRate()":{"notice":"Get USDT amount equivalent to 1e6 USDC (6 dec)"}},"notice":"Assets provider for CustomStrategy holding Re Protocol's reUSD positions:         - PT-reUSD positions (Pendle)         - reUSD positions (idle and Morpho collateral)         - 4 Morpho Blue markets (slots 0..3)         - Borrow debt in USDC and/or USDT (slot-dependent loan currency)","version":1}},"settings":{"compilationTarget":{"src/superearn/core/strategy/custom/pendle-reusd/PendleReUSDAssetsProvider.sol":"PendleReUSDAssetsProvider"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":250},"remappings":[":@arbitrum/=node_modules/@arbitrum/",":@bisonai/orakl-contracts/=node_modules/@bisonai/orakl-contracts/",":@chainlink/=node_modules/@chainlink/",":@eth-optimism/=node_modules/@chainlink/contracts/node_modules/@eth-optimism/",":@external/=src/external/",":@metamorpho/src/=lib/metamorpho/src/",":@mock/=src/mock/",":@offchainlabs/=node_modules/@offchainlabs/",":@openzeppelin/contracts-upgradeable/=node_modules/@openzeppelin/contracts-upgradeable-4.9.4/",":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/",":@openzeppelin/contracts@5.0.2/=node_modules/@openzeppelin/contracts-5.0.2/",":@runespear/=src/superearn/v2/messaging/runespear/",":@scroll-tech/=node_modules/@scroll-tech/",":@superearn/=src/superearn/",":@uniswap/=node_modules/@uniswap/",":@yearn-vaults/=src/yearn-vaults/",":@zksync/=node_modules/@zksync/",":base64-sol/=node_modules/base64-sol/",":chainlink-evm/=lib/chainlink-evm/",":ds-test/=lib/metamorpho/lib/forge-std/lib/ds-test/src/",":erc4626-tests/=lib/me