uard,      consistent with stable-pair feed practice elsewhere in this codebase.","kind":"dev","methods":{"denominationToken()":{"details":"The CustomStrategy will verify this matches its own denominationToken","returns":{"_0":"The denomination token address"}},"getTotalAssets()":{"details":"This function should aggregate all positions, balances, and pending values      that belong to the strategy and convert them to the denomination token","returns":{"_0":"Total assets value in denomination token units"}}},"stateVariables":{"DECIMAL_DIFF_USDS_USDT":{"details":"Decimal difference between USDS (18) and USDT (6); USDS = USDT * 1e12"}},"title":"StUSDSAssetsProvider","version":1},"userdoc":{"kind":"user","methods":{"CHAINLINK_STALENESS_THRESHOLD()":{"notice":"Maximum allowed staleness for Chainlink answers (seconds)"},"USDS_USD_FEED()":{"notice":"Chainlink USDS/USD price feed (8 decimals)"},"USDT_USD_FEED()":{"notice":"Chainlink USDT/USD price feed (8 decimals)"},"denominationToken()":{"notice":"Returns the denomination token used by this provider"},"getPositionBreakdown()":{"notice":"Snapshot of strategy balances and current rates"},"getStUsdsToUsdsRate()":{"notice":"USDS amount (18 dec) per 1 stUSDS (1e12 = 1 share, since stUSDS uses 12 decimals)"},"getStUsdsToUsdtRate()":{"notice":"USDT amount (6 dec) per 1 stUSDS (1e12 share)"},"getTotalAssets()":{"notice":"Returns total assets value denominated in the provider's denominationToken"},"getUsdsToUsdtRate()":{"notice":"USDT amount (6 dec) equivalent to 1 USDS (1e18)"}},"notice":"Assets provider for a CustomStrategy holding Sky's stUSDS positions on Ethereum mainnet.","version":1}},"settings":{"compilationTarget":{"src/superearn/core/strategy/custom/stusds/StUSDSAssetsProvider.sol":"StUSDSAssetsProvider"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":250},"remappings":[":@arbitrum/=node_modules/@arbitrum/",":@bisonai/orakl-contracts/=node_modules/@bisonai/orakl