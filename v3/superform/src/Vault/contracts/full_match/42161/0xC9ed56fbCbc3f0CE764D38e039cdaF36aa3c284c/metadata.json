 can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address. - `spender` must have allowance for the caller of at least `subtractedValue`."},"deposit(uint256,address)":{"params":{"assets":"Quantity of tokens to deposit.","receiver":"Receiver of issued vault shares."},"returns":{"shares":"Quantity of vault shares issued to `receiver`."}},"increaseAllowance(address,uint256)":{"details":"Atomically increases the allowance granted to `spender` by the caller. This is an alternative to {approve} that can be used as a mitigation for problems described in {IERC20-approve}. Emits an {Approval} event indicating the updated allowance. Requirements: - `spender` cannot be the zero address."},"initialize(address,address,(uint64,uint64,uint64,uint64),address,uint256,address)":{"details":"This function is called by the factory contract when deploying a new vault.Usually the adapter should already be pre configured. Otherwise a new one can only be added after a ragequit time.","params":{"adapter_":"Adapter which will be used to interact with the wrapped protocol.","asset_":"Underlying Asset which users will deposit.","depositLimit_":"Maximum amount of assets which can be deposited.","feeRecipient_":"Recipient of all vault fees. (Must not be zero address)","fees_":"Desired fees in 1e18. (1e18 = 100%, 1e14 = 1 BPS)","owner":"Owner of the contract. Controls management functions."}},"maxDeposit(address)":{"returns":{"_0":"Maximum amount of underlying `asset` token that may be deposited for a given address. Delegates to adapter."}},"maxMint(address)":{"returns":{"_0":"Maximum amount of vault shares that may be minted to given address. Delegates to adapter."}},"maxRedeem(address)":{"returns":{"_0":"Maximum amount of shares that may be redeemed by `caller` address. Delegates to adapter."}},"maxWithdraw(address)":{"returns":{"_0":"Maximum amount of underlying `asset` token that can be withdrawn by `caller` address. Delegates to adapter."}},"mint(uint256,address)":{"params":{"receiver":"Receiver of issued vault shares.","shares":"Quantity of shares to mint."},"returns":{"assets":"Quantity of assets deposited by caller."}},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"previewDeposit(uint256)":{"details":"This method accounts for issuance of accrued fee shares.","params":{"assets":"Exact amount of underlying `asset` token to deposit"},"returns":{"shares":"of the vault issued in exchange to the user for `assets`"}},"previewMint(uint256)":{"details":"This method accounts for issuance of accrued fee shares.","params":{"shares":"Exact amount of vault shares to mint."},"returns":{"assets":"quantity of underlying needed in exchange to mint `shares`."}},"previewRedeem(uint256)":{"details":"This method accounts for both issuance of fee shares and withdrawal fee.","params":{"shares":"Exact amount of `shares` to redeem"},"returns":{"assets":"quantity of underlying returned in exchange for `shares`."}},"previewWithdraw(uint256)":{"details":"This method accounts for both issuance of fee shares and withdrawal fee.","params":{"assets":"Exact amount of `assets` to withdraw"},"returns":{"shares":"to be burned in exchange for `assets`"}},"proposeAdapter(address)":{"params":{"newAdapter":"A new ERC4626 that should be used as a yield adapter for this asset."}},"proposeFees((uint64,uint64,uint64,uint64))":{"details":"Fees can be 0 but never 1e18 (1e18 = 100%, 1e14 = 1 BPS)","params":{"newFees":"Fees for depositing, withdrawal, management and performance in 1e18."}},"redeem(uint256,address,address)":{"params":{"owner":"Owner of burned vault shares.","receiver":"Receiver of underlying tokens.","shares":"Quantity of vault shares to exchange for underlying tokens."},"returns":{"assets":"Quantity of `asset` sent to `receiver`."}},"setDepositLimit(uint256)":{"params":{"_depositLimit":"Maximum amount of assets that c