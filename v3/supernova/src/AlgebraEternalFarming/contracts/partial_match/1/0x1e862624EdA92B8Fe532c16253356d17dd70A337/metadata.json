 added"},"RewardsCollected(uint256,bytes32,uint256,uint256)":{"notice":"Event emitted when rewards were collected"},"RewardsRatesChanged(uint128,uint128,bytes32)":{"notice":"Event emitted when reward rates were changed"}},"kind":"user","methods":{"FARMINGS_ADMINISTRATOR_ROLE()":{"notice":"Returns hash of 'FARMINGS_ADMINISTRATOR_ROLE', used as role for permissioned actions in farming"},"INCENTIVE_MAKER_ROLE()":{"notice":"Returns hash of 'INCENTIVE_MAKER_ROLE', used as role for incentive creation"},"addRewards((address,address,address,uint256),uint128,uint128)":{"notice":"Add rewards for incentive"},"claimReward(address,address,uint256)":{"notice":"Transfers `amountRequested` of accrued `rewardToken` (if possible) rewards from the contract to the recipient `to`"},"claimRewardFrom(address,address,address,uint256)":{"notice":"Transfers `amountRequested` of accrued `rewardToken` (if possible) rewards from the contract to the recipient `to`only for FarmingCenter"},"collectRewards((address,address,address,uint256),uint256,address)":{"notice":"reward amounts should be updated before calling this method"},"createEternalFarming((address,address,address,uint256),(uint128,uint128,uint128,uint128,uint24),address,address)":{"notice":"Creates a new liquidity farming incentive program"},"deactivateIncentive((address,address,address,uint256),address)":{"notice":"Detach incentive from the pool and deactivate it"},"decreaseRewardsAmount((address,address,address,uint256),uint128,uint128)":{"notice":"Decrease rewards for incentive and withdraw"},"enterFarming((address,address,address,uint256),uint256)":{"notice":"enter farming for Algebra LP token"},"exitFarming((address,address,address,uint256),uint256,address)":{"notice":"exitFarmings for Algebra LP token"},"farmingCenter()":{"notice":"Returns address of current farmingCenter"},"farms(uint256,bytes32)":{"notice":"Returns information about a farmed liquidity NFT"},"getRewardInfo((address,address,address,uint256),uint256)":{"notice":"re