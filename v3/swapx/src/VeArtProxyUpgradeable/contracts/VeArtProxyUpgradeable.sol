pragma solidity 0.8.13;

import {Base64} from "./libraries/Base64.sol";
import {IVeArtProxy} from "./interfaces/IVeArtProxy.sol";

contract VeArtProxyUpgradeable is IVeArtProxy {
    int256 constant private OFFSET19700101 = 2440588;
    uint256 constant private SECONDS_PER_DAY = 24 * 60 * 60;

    function toString(uint value) internal pure returns (string memory) {
        // Inspired by OraclizeAPI's implementation - MIT license
        // https://github.com/oraclize/ethereum-api/blob/b42146b063c7d6ee1358846c198246239e9360e8/oraclizeAPI_0.4.25.sol

        if (value == 0) {
            return "0";
        }
        uint temp = value;
        uint digits;
        while (temp != 0) {
            digits++;
            temp /= 10;
        }
        bytes memory buffer = new bytes(digits);
        while (value != 0) {
            digits -= 1;
            buffer[digits] = bytes1(uint8(48 + uint(value % 10)));
            value /= 10;
        }
        return string(buffer);
    }

    function timestampToDateTime(uint256 timestamp)
        internal
        pure
        returns (uint256 year, uint256 month, uint256 day)
    {
        unchecked {
            (year, month, day) = _daysToDate(timestamp / SECONDS_PER_DAY);
        }
    }

    function _daysToDate(uint256 _days) internal pure returns (uint256 year, uint256 month, uint256 day) {
        unchecked {
            int256 __days = int256(_days);

            int256 L = __days + 68569 + OFFSET19700101;
            int256 N = (4 * L) / 146097;
            L = L - (146097 * N + 3) / 4;
            int256 _year = (4000 * (L + 1)) / 1461001;
            L = L - (1461 * _year) / 4 + 31;
            int256 _month = (80 * L) / 2447;
            int256 _day = L - (2447 * _month) / 80;
            L = _month / 11;
            _month = _month + 2 - 12 * L;
            _year = 100 * (N - 49) + _year + L;

            year = uint256(_year);
            month = uint256(_month);
            day = uint256(_day);
        }
    }

    function outputParameters(uint256 tokenId, uint256 balance, uint256 lockEnd, uint256 value) internal pure returns (string memory _token_id, string memory _balance, string memory _lock_end, string memory _value) {
        _token_id = toString(tokenId);

        (uint256 year, uint256 month, uint256 day) = timestampToDateTime(lockEnd);
        _lock_end = toString(year);
        _lock_end = string(abi.encodePacked(_lock_end, "-"));
        _lock_end = string(abi.encodePacked(_lock_end, toString(month)));
        _lock_end = string(abi.encodePacked(_lock_end, "-"));
        _lock_end = string(abi.encodePacked(_lock_end, toString(day)));

        _balance = toString(balance / 10**18);
        if((balance / 10**14) % 10**4 > 0) {
            _balance = string(abi.encodePacked(_balance, ","));
            _balance = string(abi.encodePacked(_balance, toString((balance / 10**17) % 10)));
            _balance = string(abi.encodePacked(_balance, toString((balance / 10**16) % 10)));
            _balance = string(abi.encodePacked(_balance, toString((balance / 10**15) % 10)));
            _balance = string(abi.encodePacked(_balance, toString((balance / 10**14) % 10)));
        }

        _value = toString(value / 10**18);
        if((value / 10**14) % 10**4 > 0) {
            _value = string(abi.encodePacked(_value, ","));
            _value = string(abi.encodePacked(_value, toString((value / 10**17) % 10)));
            _value = string(abi.encodePacked(_value, toString((value / 10**16) % 10)));
            _value = string(abi.encodePacked(_value, toString((value / 10**15) % 10)));
            _value = string(abi.encodePacked(_value, toString((value / 10**14) % 10)));
        }
    }

