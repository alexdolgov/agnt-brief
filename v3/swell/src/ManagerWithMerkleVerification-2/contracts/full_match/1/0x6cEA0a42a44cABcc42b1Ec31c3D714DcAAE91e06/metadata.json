kleVerification`         3) balancerVault MUST callback to this contract with the same userData"},"isPaused()":{"notice":"Used to pause calls to `manageVaultWithMerkleVerification`."},"manageRoot(address)":{"notice":"A merkle tree root that restricts what data can be passed to the BoringVault."},"manageVaultWithMerkleVerification(bytes32[][],address[],address[],bytes[],uint256[])":{"notice":"Allows strategist to manage the BoringVault."},"pause()":{"notice":"Pause this contract, which prevents future calls to `manageVaultWithMerkleVerification`."},"receiveFlashLoan(address[],uint256[],uint256[],bytes)":{"notice":"Add support for balancer flash loans."},"setManageRoot(address,bytes32)":{"notice":"Sets the manageRoot."},"unpause()":{"notice":"Unpause this contract, which allows future calls to `manageVaultWithMerkleVerification`."},"vault()":{"notice":"The BoringVault this contract can manage."}},"version":1}},"settings":{"compilationTarget":{"src/base/Roles/ManagerWithMerkleVerification.sol":"ManagerWithMerkleVerification"},"evmVersion":"shanghai","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@arbitrum/=node_modules/@arbitrum/",":@axelar-network/=node_modules/@axelar-network/",":@balancer-labs/v2-interfaces/=lib/ion-protocol/lib/balancer-v2-monorepo/pkg/interfaces/",":@balancer-labs/v2-pool-stable/=lib/ion-protocol/lib/balancer-v2-monorepo/pkg/pool-stable/",":@chainlink/=node_modules/@chainlink/",":@chainlink/contracts/=lib/ion-protocol/lib/chainlink/contracts/",":@ds-test/=lib/forge-std/lib/ds-test/src/",":@eth-optimism/=node_modules/@eth-optimism/",":@forge-std/=lib/forge-std/src/",":@ion-protocol/=lib/ion-protocol/src/",":@layerzerolabs/=node_modules/@layerzerolabs/",":@offchainlabs/=node_modules/@offchainlabs/",":@openzeppelin/=lib/openzeppelin-contracts/",":@openzeppelin/contracts-upgradeable/=lib/ion-protocol/lib/openzeppelin-contracts-upgradeable/contracts/",":@openzeppelin/contracts/=lib/openzeppelin