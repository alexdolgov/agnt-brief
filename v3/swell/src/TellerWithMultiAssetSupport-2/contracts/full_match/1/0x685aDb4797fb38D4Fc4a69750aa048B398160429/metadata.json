ly locks shares to the user address, but also serves as the pending deposit period, where deposits can be reverted.If a new shorter share lock period is set, users with pending share locks could make a new deposit to receive 1 wei shares,      and have their shares unlock sooner than their original deposit allows. This state would allow for the user deposit to be refunded,      but only if they have not transferred their shares out of there wallet. This is an accepted limitation, and should be known when decreasing      the share lock period.Callable by OWNER_ROLE."},"unpause()":{"details":"Callable by MULTISIG_ROLE."}},"stateVariables":{"publicDepositHistory":{"details":"Maps deposit nonce to keccak256(address receiver, address depositAsset, uint256 depositAmount, uint256 shareAmount, uint256 timestamp, uint256 shareLockPeriod)."},"shareLockPeriod":{"details":"During this time all transfers from msg.sender will revert, and      deposits are refundable."}},"title":"TellerWithMultiAssetSupport","version":1},"userdoc":{"kind":"user","methods":{"accountant()":{"notice":"The AccountantWithRateProviders this contract is working with."},"addAsset(address)":{"notice":"Adds this asset as a deposit asset."},"beforeTransfer(address)":{"notice":"Implement beforeTransfer hook to check if shares are locked."},"bulkDeposit(address,uint256,uint256,address)":{"notice":"Allows on ramp role to deposit into this contract."},"bulkWithdraw(address,uint256,uint256,address)":{"notice":"Allows off ramp role to withdraw from this contract."},"deposit(address,uint256,uint256)":{"notice":"Allows users to deposit into the BoringVault, if this contract is not paused."},"depositNonce()":{"notice":"The deposit nonce used to map to a deposit hash."},"depositWithPermit(address,uint256,uint256,uint256,uint8,bytes32,bytes32)":{"notice":"Allows users to deposit into BoringVault using permit."},"isPaused()":{"notice":"Used to pause calls to `deposit` and `depositWithPermit`."},"isSupported(address)":{"notice":"Mapping ERC20s to an isSupported bool."},"pause()":{"notice":"Pause this contract, which prevents future calls to `deposit` and `depositWithPermit`."},"refundDeposit(uint256,address,address,uint256,uint256,uint256,uint256)":{"notice":"Allows DEPOSIT_REFUNDER_ROLE to revert a pending deposit."},"removeAsset(address)":{"notice":"Removes this asset as a deposit asset."},"setShareLockPeriod(uint64)":{"notice":"Sets the share lock period."},"shareLockPeriod()":{"notice":"After deposits, shares are locked to the msg.sender's address         for `shareLockPeriod`."},"shareUnlockTime(address)":{"notice":"Maps user address to the time their shares will be unlocked."},"unpause()":{"notice":"Unpause this contract, which allows future calls to `deposit` and `depositWithPermit`."},"vault()":{"notice":"The BoringVault this contract is working with."}},"version":1}},"settings":{"compilationTarget":{"src/base/Roles/TellerWithMultiAssetSupport.sol":"TellerWithMultiAssetSupport"},"evmVersion":"shanghai","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@axelar-network/=node_modules/@axelar-network/",":@balancer-labs/v2-interfaces/=lib/ion-protocol/lib/balancer-v2-monorepo/pkg/interfaces/",":@balancer-labs/v2-pool-stable/=lib/ion-protocol/lib/balancer-v2-monorepo/pkg/pool-stable/",":@chainlink/=node_modules/@chainlink/",":@chainlink/contracts/=lib/ion-protocol/lib/chainlink/contracts/",":@ds-test/=lib/forge-std/lib/ds-test/src/",":@eth-optimism/=node_modules/@eth-optimism/",":@forge-std/=lib/forge-std/src/",":@ion-protocol/=lib/ion-protocol/src/",":@layerzerolabs/=node_modules/@layerzerolabs/",":@openzeppelin/=lib/openzeppelin-contracts/",":@openzeppelin/contracts-upgradeable/=lib/ion-protocol/lib/openzeppelin-contracts-upgradeable/contracts/",":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/",":@solmate/=lib/solmate/src/",":@uniswap/v3-core/=lib/ion-protocol/lib/v3-core/",":@uniswap/v3-periphery/=lib/ion-