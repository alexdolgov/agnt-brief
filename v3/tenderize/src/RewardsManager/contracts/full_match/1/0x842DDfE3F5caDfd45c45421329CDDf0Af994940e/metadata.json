uint256","name":"accRewardsForSubgraphSnapshot","type":"uint256"},{"internalType":"uint256","name":"accRewardsPerSignalSnapshot","type":"uint256"},{"internalType":"uint256","name":"accRewardsPerAllocatedToken","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"_allocationID","type":"address"}],"name":"takeRewards","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"updateAccRewardsPerSignal","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"events":{"RewardsAssigned(address,address,uint256,uint256)":{"details":"Emitted when rewards are assigned to an indexer."},"RewardsDenied(address,address,uint256)":{"details":"Emitted when rewards are denied to an indexer."},"RewardsDenylistUpdated(bytes32,uint256)":{"details":"Emitted when a subgraph is denied for claiming rewards."}},"kind":"dev","methods":{"acceptProxy(address)":{"details":"Accept to be an implementation of proxy."},"acceptProxyAndCall(address,bytes)":{"details":"Accept to be an implementation of proxy and then call a function from the new implementation as specified by `_data`, which should be an encoded function call. This is useful to initialize new storage variables in the proxied contract."},"getAccRewardsForSubgraph(bytes32)":{"details":"Gets the accumulated rewards for the subgraph.","params":{"_subgraphDeploymentID":"Subgraph deployment"},"returns":{"_0":"Accumulated rewards for subgraph"}},"getAccRewardsPerAllocatedToken(bytes32)":{"details":"Gets the accumulated rewards per allocated token for the subgraph.","params":{"_subgraphDeploymentID":"Subgraph deployment"},"returns":{"_0":"Accumulated rewards per allocated token for the subgraph","_1":"Accumulated rewards for subgraph"}},"getAccRewardsPerSignal()":{"details":"Gets the currently accumulated rewards per signal."},"getNewRewardsPerSignal()":{"details":"Gets the issuance of rewards per signal since last updated. Compound interest formula: `a = p(1 + r/n)^nt` The formula is simplified with `n = 1` as we apply the interest once every time step. The `r` is passed with +1 included. So for 10% instead of 0.1 it is 1.1 The simplified formula is `a = p * r^t` Notation: t: time steps are in blocks since last updated p: total supply of GRT tokens a: inflated amount of total supply for the period `t` when interest `r` is applied x: newly accrued rewards token for the period `t`","returns":{"_0":"newly accrued rewards per signal since last update"}},"getRewards(address)":{"details":"Calculate current rewards for a given allocation on demand.","params":{"_allocationID":"Allocation"},"returns":{"_0":"Rewards amount for an allocation"}},"initialize(address,uint256)":{"details":"Initialize this contract."},"isDenied(bytes32)":{"details":"Tells if subgraph is in deny list","params":{"_subgraphDeploymentID":"Subgraph deployment ID to check"}},"onSubgraphAllocationUpdate(bytes32)":{"details":"Triggers an update of rewards for a subgraph. Must be called before allocation on a subgraph changes. NOTE: Hook called from the Staking contract on allocate() and close()","params":{"_subgraphDeploymentID":"Subgraph deployment"},"returns":{"_0":"Accumulated rewards per allocated token for a subgraph"}},"onSubgraphSignalUpdate(bytes32)":{"details":"Triggers an update of rewards for a subgraph. Must be called before `signalled GRT` on a subgraph changes. Note: Hook called from the Curation contract on mint() and burn()","params":{"_subgraphDeploymentID":"Subgraph deployment"},"returns":{"_0":"Accumulated rewards for subgraph"}},"setController(address)":{"params":{"_controller":"Controller contract address"}},"setDenied(bytes32,bool)":{"details":"Denies to claim rewards for a subgraph. NOTE: Can only be called by the subgraph availability oracle","params":{"_deny":"Whether to set the subgraph as denied for claiming rewards or not","_subgraphDeploymentID":"Subgraph deployment ID"}},"setDeniedMany(bytes32[],bool[])":{"details":"Denies to claim rewards for multiple subgraph. NOTE: Can only be called by the subgraph availability oracle","params":{"_deny":"Array of denied status for claiming rewards for each subgraph","_subgraphDeploymentID":"Array of subgraph deployment ID"}},"setIssuanceRate(uint256)":{"details":"Sets the issuance rate. The issuance rate is defined as a percentage increase of the total supply per block. This means that it needs to be greater than 1.0, any number under 1.0 is not allowed and an issuance rate of 1.0 means no issuance. To accommodate a high precision the issuance rate is expressed in wei.","params":{"_issuanceRate":"Issuance rate expressed in wei"}},"setSubgraphAvailabilityOracle(address)":{"details":"Sets the subgraph oracle allowed to denegate distribution of rewards to subgraphs.","params":{"_subgraphAvailabilityOracle":"Address of the subgraph availability oracle"}},"takeRewards(address)":{"details":"Pull rewards from the contract for a particular allocation. This function can only be called by the Staking contract. This function will mint the necessary tokens to reward based on the inflation calculation.","params":{"_allocationID":"Allocation"},"returns":{"_0":"Assigned rewards amount"}},"updateAccRewardsPerSignal()":{"details":"Updates the accumulated rewards per signal and save checkpoint block number. Must be called before `issuanceRate` or `total signalled GRT` changes Called from the Curation contract on mint() and burn()","returns":{"_0":"Accumulated rewards per signal"}}},"version":1},"userdoc":{"kind":"user","methods":{"setController(address)":{"notice":"Set Controller. Only callable by current controller"}},"version":1}},"settings":{"compilationTarget":{"contracts/rewards/RewardsManager.sol":"RewardsManager"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sou