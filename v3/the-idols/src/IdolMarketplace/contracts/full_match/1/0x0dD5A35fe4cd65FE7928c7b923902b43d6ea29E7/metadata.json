":{"params":{"_rewardContractAddress":"The address of the IRewards contract to add."}},"buyGod(uint256)":{"params":{"_godId":"The ID of the God being bought."}},"claimEthRewards(address)":{"params":{"_user":"Address to claim rewards for"}},"claimExtraRewards(address)":{"params":{"_user":"Address to claim rewards for."}},"decreaseVirtueStake(uint256)":{"params":{"_virtueTokenAmt":"The amount of VIRTUE to unstake on behalf of the user. If this amount exceeds the user's current stake, it unstakes their entire stake instead."}},"enterBidForGod(uint256)":{"params":{"_godId":"The ID of the God to create a Bid for."}},"extraRewardsLength()":{"returns":{"_0":"(uint256) The length of the extraRewards array. Duh."}},"getUserVirtueStake(address)":{"params":{"_user":"The address of the user to get the stake for."}},"increaseVirtueStake(uint256)":{"params":{"_virtueTokenAmt":"The amount of VIRTUE to stake on behalf of the user"}},"owner()":{"details":"Returns the address of the current owner."},"postGodListing(uint256,uint256)":{"params":{"_godId":"The ID of the God being listed.","_salePriceInWei":"Specifies the minimum price the God can be bought for using the buyGod function."}},"postGodListingForAddress(uint256,uint256,address)":{"params":{"_godId":"The ID of the God being listed.","_salePriceInWei":"Specifies the minimum price the God can be bought for using the buyGod function.","_toAddress":"The address that the Listing is exclusively meant for."}},"removeGodListing(uint256)":{"params":{"_godId":"The ID of the God whose listing is being removed."}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"setVirtueTokenAddr(address)":{"params":{"_virtueTokenAddr":"The address of the VIRTUE token contract."}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"withdrawBidForGod(uint256)":{"params":{"_godId":"The ID of the God to withdraw the Bid from."}}},"version":1},"userdoc":{"kind":"user","methods":{"acceptBidForGod(uint256,uint256)":{"notice":"acceptBidForGod allows a God owner to accept an existing Bid for a God and transfer the Bid amount to themselves, in exchange for transferring the God to the bidder. 7.5% of the price is also distributed to the VIRTUE rewards controller."},"addExtraReward(address)":{"notice":"addExtraReward appends a reward contract address to the extraRewards array."},"buyGod(uint256)":{"notice":"buyGod is used to buy a listed God for the sales price on its Listing. 7.5% of the price is also distributed to the VIRTUE rewards controller."},"claimEthRewards(address)":{"notice":"claimEthRewards is called to claim ETH rewards on behalf of a user."},"claimExtraRewards(address)":{"notice":"claimExtraRewards is called to claim any rewards from linked extraRewards contracts on behalf of a user."},"clearExtraRewards()":{"notice":"clearExtraRewards removes all entries from the extraRewards array."},"decreaseVirtueStake(uint256)":{"notice":"decreaseVirtueStake decreases a user's VIRTUE stake."},"distributeRewards()":{"notice":"distributeRewards is a payable function that takes ETH from sender and allocates the ETH sent as rewards to all current stakers."},"enterBidForGod(uint256)":{"notice":"enterBidForGod creates a Bid on the specified God for the amount of ETH passed to the function."},"extraRewardsLength()":{"notice":"extraRewardsLength returns the length of the extraRewards array."},"getPendingETHGain(address)":{"notice":"getPendingETHGain returns how much in staking rewards are currently available and still unclaimed by the user."},"getTotalVirtueStake()":{"notice":"getTotalVirtueStake returns total amount of VIRTUE Token staked in the protocol."},"getUserVirtueStake(address)":{"notice":"getUserVirtueStake returns total amount of VIRTUE Token a specific user has staked in the protocol."},"increaseVirtueStake(uint256)":{"notice":"increaseVirtueStake increases a user's VIRTUE stake."},"postGodListing(uint256,uint256)":{"notice":"postGodListing creates a sales listing for a God."},"postGodListingForAddress(uint256,uint256,address)":{"notice":"postGodListingForAddress creates a sales listing for a God exclusively for a single address."},"removeGodListing(uint256)":{"notice":"removeGodListing removes an existing sales listing for a God."},"setVirtueTokenAddr(address)":{"notice":"setVirtueTokenAddr sets the address of the VIRTUE Token ERC20 contract."},"withdrawBidForGod(uint256)":{"notice":"withdrawBidForGod takes down the message sender's previous Bid for a God. It also sends them back the funds they had initially sent when creating the Bid."},"withdrawPendingFunds()":{"notice":"withdrawPendingFunds withdraws any pending funds that the marketplace is holding for the user (e.g. through sales or overriden bids)."}},"notice":"IdolMarketplace is a contract containing functions for listing, bidding on, and exchanging God NFTs.","version":1}},"settings":{"compilationTarget":{"contracts/IdolMarketplace.sol":"IdolMarketplace"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":false,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0x24e0364e503a9bbde94c715d26573a76f14cd2a202d45f96f52134ab806b67b9","license":"MIT","urls":["bzz-raw://e12cbaa7378fd9b62280e4e1d164bedcb4399ce238f5f98fc0eefb7e50577981","dweb:/ipfs/QmXRoFGUgfsaRkoPT5bxNMtSayKTQ8GZATLPXf69HcRA51"]},"@openzeppelin/contracts/interfaces/IERC165.sol":{"keccak256":"0xd04b0f06e0666f29cf7cccc82894de541e19bb30a765b107b1e40bb7fe5f7d7a","license":"MIT","urls":["bzz-raw://7b652499d098e88d8d878374616bb58434301061cae2253298b3f374044e0ddb","dweb:/ipfs/QmbhAzctqo5jrSKU6idHdVyqfmzCcDbNUPvmx4GiXxf