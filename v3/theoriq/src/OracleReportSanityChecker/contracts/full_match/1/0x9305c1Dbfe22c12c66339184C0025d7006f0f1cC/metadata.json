nt256"},{"internalType":"uint256","name":"sharesToBurn","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bytes4","name":"interfaceId","type":"bytes4"}],"name":"supportsInterface","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"}],"devdoc":{"kind":"dev","methods":{"checkAccountingExtraDataListItemsCount(uint256)":{"params":{"_extraDataListItemsCount":"Number of validator exit requests supplied per oracle report"}},"checkAccountingOracleReport(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)":{"params":{"_elRewardsVaultBalance":"el rewards vault balance on Execution Layer for the report reference slot","_postCLBalance":"sum of all Lido validators' balances on the Consensus Layer after the     current oracle report","_postCLValidators":"Lido-participating validators on the CL side after the current oracle report","_preCLBalance":"sum of all Lido validators' balances on the Consensus Layer before the     current oracle report (NB: also include the initial balance of newly appeared validators)","_preCLValidators":"Lido-participating validators on the CL side before the current oracle report","_sharesRequestedToBurn":"shares requested to burn for the report reference slot","_timeElapsed":"time elapsed since the previous oracle report","_withdrawalVaultBalance":"withdrawal vault balance on Execution Layer for the report reference slot"}},"checkExitBusOracleReport(uint256)":{"params":{"_exitRequestsCount":"Number of validator exit requests supplied per oracle report"}},"checkExitedValidatorsRatePerDay(uint256)":{"params":{"_exitedValidatorsCount":"Number of validator exit requests supplied per oracle report"}},"checkNodeOperatorsPerExtraDataItemCount(uint256,uint256)":{"details":"Checks against the same limit as used in checkAccountingExtraDataListItemsCount","params":{"_itemIndex":"Index of item in extra data","_nodeOperatorsCount":"Number of validator exit requests supplied per oracle report"}},"checkSimulatedShareRate(uint256,uint256,uint256,uint256,uint256)":{"params":{"_etherLockedOnWithdrawalQueue":"ether locked on withdrawal queue for the current oracle report","_postTotalPooledEther":"total pooled ether after report applied","_postTotalShares":"total shares after report applied","_sharesBurntDueToWithdrawals":"shares burnt due to withdrawals finalization","_simulatedShareRate":"share rate provided with the oracle report (simulated via off-chain \"eth_call\")"}},"checkWithdrawalQueueOracleReport(uint256,uint256)":{"params":{"_lastFinalizableRequestId":"last finalizable withdrawal request id","_reportTimestamp":"timestamp when the originated oracle report was submitted"}},"constructor":{"params":{"_admin":"address to grant DEFAULT_ADMIN_ROLE of the AccessControl contract","_lidoLocator":"address of the LidoLocator instance","_limitsList":"initial values to be set for the limits list","_managersRoster":"list of the address to grant permissions for granular limits management"}},"getMaxPositiveTokenRebase()":{"details":"Get max positive rebase allowed per single oracle report token rebase happens on total     supply adjustment, huge positive rebase can incur oracle report sandwiching.     stETH balance for the `account` defined as:         balanceOf(account) =             shares[account] * totalPooledEther / totalShares = shares[account] * shareRate     Suppose shareRate changes when oracle reports (see `handleOracleReport`)     which means that token rebase happens:         preShareRate = preTotalPooledEther() / preTotalShares()         postShareRate = postTotalPooledEther() / postTotalShares()         R = (postShareRate - preShareRate) / preShareRate         R > 0 corresponds to the relative positive rebase value (i.e., instant APR) NB: The value is not set by default (explicit initialization required),     the recommended sane values are from 0.05% to 0.1%."},"getRoleAdmin(bytes32)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"getRoleMember(bytes32,uint256)":{"details":"Returns one of the accounts that have `role`. `index` must be a value between 0 and {getRoleMemberCount}, non-inclusive. Role bearers are not sorted in any particular way, and their ordering may change at any point. WARNING: When using {getRoleMember} and {getRoleMemberCount}, make sure you perform all queries on the same block. See the following https://forum.openzeppelin.com/t/iterating-over-elements-on-enumerableset-in-openzeppelin-contracts/2296[forum post] for more information."},"getRoleMemberCount(bytes32)":{"details":"Returns the number of accounts that have `role`. Can be used together with {getRoleMember} to enumerate all bearers of a role."},"grantRole(bytes32,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role."},"hasRole(bytes32,address)":{"details":"Returns `true` if `account` has been granted `role`."},"renounceRole(bytes32,address)":{"details":"Revokes `role` from the calling account. Roles are often managed via {grantRole} and {revokeRole}: this function's purpose is to provide a mechanism for accounts to lose their privileges if they are compromised (such as when a trusted device is misplaced). If the calling account had been revoked `role`, emits a {RoleRevoked} event. Requirements: - the caller must be `account`."},"revokeRole(bytes32,address)":{"details":"Revokes `role` from `account`. If `account` had been granted `role`, emits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role."},"setAnnualBalanceIncreaseBPLimit(uint256)":{"params":{"_annualBalanceIncreaseBPLimit":"new annualBalanceIncreaseBPLimit value"}},"setChurnValidatorsPerDayLimit(uint256)":{"params":{"_churnValidatorsPerDayLimit":"new churnValidatorsPerDayLimit value"}},"setMaxAccountingExtraDataListItemsCount(uint256)":{"params":{"_maxAccountingExtraDataListItemsCount":"new maxAccountingExtraDataListItemsCount value"}},"setMaxExitRequestsPerOracleReport(uint256)":{"params":{"_maxValidatorExitRequestsPerReport":"new maxValidatorExitRequestsPerReport value"}},"setMaxNodeOperatorsPerExtraDataItemCount(uint256)":{"params":{"_maxNodeOperatorsPerExtraDataItemCount":"new maxNodeOperatorsPerExtraDataItemCount value"}},"setMaxPositiveTokenRebase(uint256)":{"params":{"_maxPositiveTokenRebase":"max positive token rebase value with 1e9 precision:     e.g.: 1e6 - 0.1%; 1e9 - 100%     - passing zero value is prohibited     - to allow unlimited rebases, pass max uint64, i.e.: type(uint64).max"}},"setOneOffCLBalanceDecreaseBPLimit(uint256)":{"params":{"_oneOffCLBalanceDecreaseBPLimit":"new oneOffCLBalanceDecreaseBPLimit value"}},"setOracleReportLimits((uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256))":{"params":{"_limitsList":"new limits list"}},"setRequestTimestampMargin(uint256)":{"params":{"_requestTimestampMargin":"new requestTimestampMargin value"}},"setSimulatedShareRateDeviationBPLimit(uint256)":{"params":{"_simulatedShareRateDeviationBPLimit":"new simulatedShareRateDeviationBPLimit value"}},"smoothenTokenRebase(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)":{"params":{"_elRewardsVaultBalance":"elRewards vault balance on Execution Layer for the report calculation moment","_etherToLockForWithdrawals":"ether to lock on withdrawals queue contract","_newSharesToBurnForWithdrawals":"new shares to burn due to withdrawal request finalization","_postCLBalance":"sum of all Lido validators' balances on the Consensus Layer after the     current oracle report","_preCLBalance":"sum of all Lido validators' balances on the Consensus Layer before the     current oracle report","_preTotalPooledEther":"total amount of ETH controlled by the protocol","_preTotalShares":"total amount of minted stETH shares","_sharesRequestedToBurn":"shares requested to burn through Burner for the report calculation moment","_withdrawalVaultBalance":"withdrawal vault balance on Execution Layer for the report calculation moment"},"returns":{"elRewards":"ETH amount allowed to be taken from the EL rewards vault","sharesToBurn":"amount to be burnt (accounting for withdrawals finalization)","simulatedSharesToBurn":"simulated amount to be burnt (if no ether locked on withdrawals)","withdrawals":"ETH amount allowed to be taken from the withdrawals vault"}},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}."}},"title":"Sanity checks for the Lido's oracle report","version":1},"userdoc":{"kind":"user","methods":{"checkAccountingExtraDataListItemsCount(uint256)":{"notice":"Check max accounting extra data list items count"},"checkAccountingOracleReport(uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256)":{"notice":"Applies sanity checks to the accounting params of Lido's oracle report"},"checkExitBusOracleReport(uint256)":{"notice":"Applies sanity checks to the number of validator exit requests supplied to ValidatorExitBusOracle"},"checkExitedValidatorsRatePerDay(uint256)":{"notice":"Check rate of exited validators per day"},"checkNodeOperatorsPerExtraDataItemCount(uint256,uint256)":{"notice":"Check number of node operators reported per extra data item in accounting oracle"},"checkSimulatedShareRate(uint256,uint256,uint256,uint256,uint256)":{"notice":"Applies sanity checks to the simulated share rate for withdrawal requests finalization"},"checkWithdrawalQueueOracleReport(uint256,uint256)":{"notice":"Applies sanity checks to the withdrawal requests finalization"},"getLidoLocator()":{"notice":"returns the address of the LidoLocator"},"getMaxPositiveTokenRebase()":{"notice":"Returns max positive token rebase value with 1e9 precision:     e.g.: 1e6 - 0.1%; 1e9 - 100%     - zero value means uninitialized     - type(uint64).max means unlimited"},"getOracleReportLimits()":{"notice":"Returns the limits list for the Lido's oracle report sanity checks"},"setAnnualBalanceIncreaseBPLimit(uint256)":{"notice":"Sets the new value for the annualBalanceIncreaseBPLimit"},"setChurnValidatorsPerDayLimit(uint256)":{"notice":"Sets the new value for the churnValidatorsPerDayLimit     The limit is applicable for `appeared` and `exited` validators NB: AccountingOracle reports validators as `appeared` once them become `pending`     (might be not `activated` yet). Thus, this limit should be high enough for such cases     because Consensus Layer has no intrinsic churn limit for the amount of `pending` validators     (only for `activated` instead). For Lido it's limited by the max daily deposits via DepositSecurityModule     In contrast, `exited` are reported according to the Consensus Layer churn limit."},"setMaxAccountingExtraDataListItemsCount(uint256)":{"notice":"Sets the new value for the maxAccountingExtraDataListItemsCount"},"setMaxExitRequestsPerOracleReport(uint256)":{"notice":"Sets the new value for the maxValidatorExitRequestsPerReport"},"setMaxNodeOperatorsPerExtraDataItemCount(uint256)":{"notice":"Sets the new value for the max maxNodeOperatorsPerExtraDataItemCount"},"setMaxPositiveTokenRebase(uint256)":{"notice":"Set max positive token rebase allowed per single oracle report token rebase happens     on total supply adjustment, huge positive rebase can incur oracle report sandwiching."},"setOneOffCLBalanceDecreaseBPLimit(uint256)":{"notice":"Sets the new value for the oneOffCLBalanceDecreaseBPLimit"},"setOracleReportLimits((uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256,uint256))":{"notice":"Sets the new values for the limits list"},"setRequestTimestampMargin(uint256)":{"notice":"Sets the new value for the requestTimestampMargin"},"setSimulatedShareRateDeviationBPLimit(uint256)":{"notice":"Sets the new value for the simulatedShareRateDeviationBPLimit"},"smoothenTokenRebase(uint256,uint256,uint256,uint256,uint256,uint256,uint256,u