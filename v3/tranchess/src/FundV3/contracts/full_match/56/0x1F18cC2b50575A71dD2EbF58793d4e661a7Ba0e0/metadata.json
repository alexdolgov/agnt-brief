int256,uint256,uint256,uint256)":{"notice":"Transform share amounts according to the rebalance at a given index.         This function performs no bounds checking on the given index. A non-existent         rebalance transforms anything to a zero vector."},"endOfDay(uint256)":{"notice":"Return end timestamp of the trading day containing a given timestamp.         A trading day starts at UTC time `SETTLEMENT_TIME` of a day (inclusive)         and ends at the same time of the next day (exclusive)."},"endOfWeek(uint256)":{"notice":"Return end timestamp of the trading week containing a given timestamp.         A trading week starts at UTC time `SETTLEMENT_TIME` on a Thursday (inclusive)         and ends at the same time of the next Thursday (exclusive)."},"extrapolateNav(uint256)":{"notice":"Estimate the current NAV of all tranches, considering underlying price change,         accrued protocol fee and accrued interest since the previous settlement.         The extrapolation uses simple interest instead of daily compound interest in         calculating protocol fee and BISHOP's interest. There may be significant error         in the returned values when `timestamp` is far beyond the last settlement."},"feeCollector()":{"notice":"Fee Collector address."},"feeDebt()":{"notice":"Amount of fee not transfered to the fee collector yet."},"fundActivityStartTime()":{"notice":"Start timestamp of the current primary market activity window."},"getEquivalentTotalB()":{"notice":"Equivalent BISHOP supply, as if all QUEEN are split."},"getEquivalentTotalQ()":{"notice":"Equivalent QUEEN supply, as if all BISHOP and ROOK are merged."},"getRebalance(uint256)":{"notice":"Return the rebalance matrix at a given index. A zero struct is returned         if `index` is out of bound."},"getRebalanceSize()":{"notice":"Return the number of historical rebalances."},"getRebalanceTimestamp(uint256)":{"notice":"Return timestamp of the transaction triggering the rebalance at a given index.         Zero is returned if `index` is out of bound."},"historicalEquivalentTotalB(uint256)":{"notice":"Mapping of trading day => equivalent BISHOP supply.         Key is the end timestamp of a trading day. Value is the total supply of BISHOP,         as if all QUEEN are split."},"historicalInterestRate(uint256)":{"notice":"Mapping of trading week => interest rate of BISHOP.         Key is the end timestamp of a trading day. Value is the interest rate captured         after settlement of that day, which will be effective in the following trading day."},"historicalNavs(uint256)":{"notice":"Return NAV of BISHOP and ROOK of the given trading day."},"historicalSplitRatio(uint256)":{"notice":"Return split ratio at a given version.         Zero is returned if `version` is invalid."},"historicalUnderlying(uint256)":{"notice":"Mapping of trading day => underlying assets in the fund.         Key is the end timestamp of a trading day. Value is the underlying assets in         the fund after settlement of that trading day."},"isFundActive(uint256)":{"notice":"Return the status of the fund contract."},"lowerRebalanceThreshold()":{"notice":"Lower bound of `NAV_R / NAV_B` to trigger a rebalance."},"redemptionDebt()":{"notice":"Amount of redemption underlying that the fund owes the primary market"},"refreshAllowance(address,address,uint256)":{"notice":"Transform allowance to a given rebalance version, or to the latest version         if `targetVersion` is zero."},"refreshBalance(address,uint256)":{"notice":"Transform share balance to a given rebalance version, or to the latest version         if `targetVersion` is zero."},"settle()":{"notice":"Settle the current trading day. Settlement includes the following changes         to the fund.         1. Charge protocol fee of the day.         2. Settle all pending creations and redemptions from the primary market.         3. Calculate NAV of the day and trigger rebalance if necessary.         4. Capture new interest rate for BISHOP."},"settlementTime()":{"notice":"UTC time of a day when the fund settles."},"splitRatio()":{"notice":"The amount of BISHOP received by splitting one QUEEN.         This ratio changes on every rebalance."},"tokenUnderlying()":{"notice":"Address of the underlying token."},"trancheAllBalanceOf(address)":{"notice":"Return all three share balances transformed to the latest rebalance version."},"twapOracle()":{"notice":"TwapOracle address for the underlying asset."},"underlyingDecimalMultiplier()":{"notice":"A multipler that normalizes an underlying balance to 18 decimal places."},"upperRebalanceThreshold()":{"notice":"Upper bound of `NAV_R / NAV_B` to trigger a rebalance."}},"version":1}},"settings":{"compilationTarget":{"contracts/fund/FundV3.sol":"FundV3"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts/access/Ownable.sol":{"keccak256":"0x15e2d5bd4c28a88548074c54d220e8086f638a71ed07e6b3ba5a70066fcf458d","license":"MIT","urls":["bzz-raw://90faf5851c02f9bd42c5bfb54d4f0421a2612f50ab80b2c4fa24fa3792071cc2","dweb:/ipfs/QmRGM4F2PcGVF85aTfaA9YBhCHHDqrMhRjyp6fGeBTtirb"]},"@openzeppelin/contracts/math/Math.sol":{"keccak256":"0x363bd3b45201f07c9b71c2edc96533468cf14a3d029fabd82fddceb1eb3ebd9c","license":"MIT","urls":["bzz-raw://d676d5c3a72e5fea8364a1e3e5b488a959aae08d069995b1274027f3845e6521","dweb:/ipfs/Qma7DL738Wje4G9kcwW9bXwTGY4ePR7SMmsMhbULWqmixE"]},"@openzeppelin/contracts/math/SafeMath.sol":{"keccak256":"0xcc78a17dd88fa5a2edc60c8489e2f405c0913b377216a5b26b35656b2d0dab52","license":"MIT","urls":["bzz-raw://526dc85e1f9b9b45830e202568d267d93dde7a4fcccf4ad7798dadcd92304d3c","dweb:/ipfs/QmaoXMB972J3cSDLtBq3xBo4jLwqD2uzXTwujtSPqkYVhR"]},"@openzeppelin/contracts/token/ERC20/IERC20.sol":{"keccak256":"0x5f02220344881ce43204ae4a6281145a67bc52c2bb1290a791857df3d19d78f5","license":"MIT","urls":["bzz-raw://24427744bd3e6cb73c17010119af12a318289c0253a4d9acb8576c9fb3797b08","dweb:/ipfs/QmTL