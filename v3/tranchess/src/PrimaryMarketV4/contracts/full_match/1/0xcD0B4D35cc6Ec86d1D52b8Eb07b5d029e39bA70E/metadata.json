rn value may not be the minimum solution due to rounding errors.","params":{"minUnderlying":"Minimum received underlying amount"},"returns":{"inQ":"QUEEN amount that should be redeemed"}},"getSplit(uint256)":{"params":{"inQ":"QUEEN amount to be split"},"returns":{"outB":"Received BISHOP amount, which is also received ROOK amount"}},"getSplitForB(uint256)":{"params":{"minOutB":"Received BISHOP amount, which is also received ROOK amount"},"returns":{"inQ":"QUEEN amount that should be split"}},"owner()":{"details":"Returns the address of the current owner."},"popRedemptionQueue(uint256)":{"params":{"count":"The number of redemptions to be removed, or zero to completely empty the queue"}},"queueRedemption(address,uint256,uint256,uint256)":{"params":{"inQ":"Spent QUEEN amount","minUnderlying":"Minimum amount of underlying tokens to be received","recipient":"Address that will receive redeemed underlying tokens","version":"The latest rebalance version"},"returns":{"index":"Index of the queued redemption","underlying":"Received underlying amount"}},"redeem(address,uint256,uint256,uint256)":{"params":{"inQ":"Spent QUEEN amount","minUnderlying":"Minimum amount of underlying tokens to be received","recipient":"Address that will receive redeemed underlying tokens","version":"The latest rebalance version"},"returns":{"underlying":"Received underlying amount"}},"redeemAndUnwrap(address,uint256,uint256,uint256)":{"params":{"inQ":"Spent QUEEN amount","minUnderlying":"Minimum amount of underlying tokens to be received","recipient":"Address that will receive redeemed underlying tokens","version":"The latest rebalance version"},"returns":{"underlying":"Received underlying amount"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the o