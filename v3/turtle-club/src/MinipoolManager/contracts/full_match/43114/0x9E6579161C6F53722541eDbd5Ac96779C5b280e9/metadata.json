Rialto calls this to see if a claim would succeed. Does not change state.","params":{"nodeID":"20-byte Avalanche node ID"},"returns":{"_0":"boolean representing if the minipool can become a validator"}},"cancelMinipool(address)":{"params":{"nodeID":"20-byte Avalanche node ID the Owner registered with"}},"cancelMinipoolByMultisig(address,bytes32)":{"params":{"errorCode":"The code that represents the reason for failure","nodeID":"20-byte Avalanche node ID"}},"claimAndInitiateStaking(address)":{"details":"Rialto calls this to claim a minipool for staking and validation on the P-chain.","params":{"nodeID":"20-byte Avalanche node ID"}},"createMinipool(address,uint256,uint256,uint256)":{"params":{"avaxAssignmentRequest":"Amount of requested AVAX to be matched for this Minipool","delegationFee":"Percentage delegation fee in units of ether (2% is 20_000)","duration":"Requested validation period in seconds","nodeID":"20-byte Avalanche node ID"}},"depositFromDelegation(uint256,address)":{"params":{"nodeID":"optional 20-byte Avalance node ID (not stored, emitted in event for tracking purposes)","rewards":"amount of rewards earned"}},"getExpectedAVAXRewardsAmt(uint256,uint256)":{"params":{"avaxAmt":"The amount of AVAX the node staked for their validation period","duration":"The length of validation in seconds"},"returns":{"_0":"The approximate rewards the node should receive from Avalanche for being a validator"}},"getIndexOf(address)":{"params":{"nodeID":"20-byte Avalanche node ID"},"returns":{"_0":"The index for the given minipool"}},"getMinipool(int256)":{"params":{"index":"Index of the minipool"},"returns":{"mp":"struct containing the minipool's properties"}},"getMinipoolByNodeID(address)":{"params":{"nodeID":"20-byte Avalanche node ID"},"returns":{"mp":"struct containing the minipool's properties"}},"getMinipools(uint8,uint256,uint256)":{"params":{"limit":"The limit to the amount of minipools that should be returned","offset":"The number the result should be offset by","status":"The MinipoolStatus to be used as a filter"},"returns":{"minipools":"in the protocol that adhere to the parameters"}},"getTotalAVAXLiquidStakerAmt()":{"details":"Get the total AVAX *actually* withdrawn from ggAVAX and sent to Rialto"},"recordStakingEnd(address,uint256,uint256)":{"details":"Rialto will xfer back all staked avax + avax rewards. Also handles the slashing of node ops GGP bond.","params":{"avaxTotalRewardAmt":"The rewards the node received from Avalanche for being a validator","endTime":"The time the node ID stopped validating Avalanche","nodeID":"20-byte Avalanche node ID"}},"recordStakingEndThenMaybeCycle(address,uint256,uint256)":{"details":"Rialto will xfer back all staked avax + avax rewards. Also handles the slashing of node ops GGP bond.We call recordStakingEnd,recreateMinipool,claimAndInitiateStaking in one tx to prevent liq staker funds from being sniped","params":{"avaxTotalRewardAmt":"The rewards the node received from Avalanche for being a validator","endTime":"The time the node ID stopped validating Avalanche","nodeID":"20-byte Avalanche node ID"}},"recordStakingError(address,bytes32)":{"details":"Rialto was unable to start the validation period, so cancel and refund all money","params":{"errorCode":"The code that represents the reason for failure","nodeID":"20-byte Avalanche node ID"}},"recordStakingStart(address,bytes32,uint256)":{"params":{"nodeID":"20-byte Avalanche node ID","startTime":"Time the node became a validator","txID":"The ID of the transaction that successfully registered the node with Avalanche to become a validator"}},"withdrawForDelegation(uint256,address)":{"params":{"nodeID":"optional 20-byte Avalance node ID (not stored, emitted in event for tracking purposes)"}},"withdrawMinipoolFunds(address)":{"params":{"nodeID":"20-byte Avalanche node ID the Node Operator registered with"}}},"title":"Minipool creation and management","version":1},"userdoc":{"kind":"user","methods":{"calculateGGPSlashAmt(uint256)":{"notice":"Calculates how much GGP should be slashed given an expected avaxRewardAmt"},"canClaimAndInitiateStaking(address)":{"notice":"Verifies that the minipool related the the given node ID is able to a validator"},"cancelMinipool(address)":{"notice":"Owner of a minipool can cancel the (prelaunch) minipool"},"cancelMinipoolByMultisig(address,bytes32)":{"notice":"Multisig can cancel a minipool if a problem was encountered *before* claimAndInitiateStaking() was called"},"claimAndInitiateStaking(address)":{"notice":"Withdraws minipool's AVAX for staking on Avalanche"},"createMinipool(address,uint256,uint256,uint256)":{"notice":"Accept AVAX deposit from node operator to create a Minipool. Node Operator must be staking GGP. Open to public."},"depositFromDelegation(uint256,address)":{"notice":"deposit funds + rewards from delegating liquid staking funds"},"getExpectedAVAXRewardsAmt(uint256,uint256)":{"notice":"Given a duration and an AVAX amt, calculate how much AVAX should be earned via validation rewards"},"getIndexOf(address)":{"notice":"The index of a minipool. Returns -1 if the minipool is not found"},"getMinipool(int256)":{"notice":"Gets the minipool information using the minipool's index"},"getMinipoolByNodeID(address)":{"notice":"Gets the minipool information from the node ID"},"getMinipoolCount()":{"notice":"The total count of minipools in the protocol"},"getMinipools(uint8,uint256,uint256)":{"notice":"Get minipools in a certain status (limit=0 means no pagination)"},"getTotalAVAXLiquidStakerAmt()":{"notice":"Get the total amount of AVAX from liquid stakers that is being used for minipools"},"recordStakingEnd(address,uint256,uint256)":{"notice":"Records the nodeID's validation period end"},"recordStakingEndThenMaybeCycle(address,uint256,uint256)":{"notice":"Records the nodeID's validation period end"},"recordStakingError(address,bytes32)":{"notice":"A staking error occurred while registering the node as a validator"},"recordStakingStart(address,bytes32,uint256)":{"notice":"