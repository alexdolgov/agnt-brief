:[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_indexer","type":"address"},{"internalType":"address","name":"_delegateToIndexer","type":"address"}],"name":"withdrawDelegated","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"events":{"AllocationClosed(address,bytes32,uint256,uint256,address,uint256,address,bytes32,bool)":{"details":"Emitted when `indexer` close an allocation in `epoch` for `allocationID`. An amount of `tokens` get unallocated from `subgraphDeploymentID`. The `effectiveAllocation` are the tokens allocated from creation to closing. This event also emits the POI (proof of indexing) submitted by the indexer. `isDelegator` is true if the sender was one of the indexer's delegators."},"AllocationCollected(address,bytes32,uint256,uint256,address,address,uint256,uint256)":{"details":"Emitted when `indexer` collected `tokens` amount in `epoch` for `allocationID`. These funds are related to `subgraphDeploymentID`. The `from` value is the sender of the collected funds."},"AllocationCreated(address,bytes32,uint256,uint256,address,bytes32)":{"details":"Emitted when `indexer` allocated `tokens` amount to `subgraphDeploymentID` during `epoch`. `allocationID` indexer derived address used to identify the allocation. `metadata` additional information related to the allocation."},"AssetHolderUpdate(address,address,bool)":{"details":"Emitted when `caller` set `assetHolder` address as `allowed` to send funds to staking contract."},"DelegationParametersUpdated(address,uint32,uint32,uint32)":{"details":"Emitted when `indexer` update the delegation parameters for its delegation pool."},"RebateClaimed(address,bytes32,address,uint256,uint256,uint256,uint256,uint256)":{"details":"Emitted when `indexer` claimed a rebate on `subgraphDeploymentID` during `epoch` related to the `forEpoch` rebate pool. The rebate is for `tokens` amount and `unclaimedAllocationsCount` are left for claim in the rebate pool. `delegationFees` collected and sent to delegation pool."},"SetOperator(address,address,bool)":{"details":"Emitted when `indexer` set `operator` access."},"SlasherUpdate(address,address,bool)":{"details":"Emitted when `caller` set `slasher` address as `allowed` to slash stakes."},"StakeDelegated(address,address,uint256,uint256)":{"details":"Emitted when `delegator` delegated `tokens` to the `indexer`, the delegator gets `shares` for the delegation pool proportionally to the tokens staked."},"StakeDelegatedLocked(address,address,uint256,uint256,uint256)":{"details":"Emitted when `delegator` undelegated `tokens` from `indexer`. Tokens get locked for withdrawal after a period of time."},"StakeDelegatedWithdrawn(address,address,uint256)":{"details":"Emitted when `delegator` withdrew delegated `tokens` from `indexer`."},"StakeDeposited(address,uint256)":{"details":"Emitted when `indexer` stake `tokens` amount."},"StakeLocked(address,uint256,uint256)":{"details":"Emitted when `indexer` unstaked and locked `tokens` amount `until` block."},"StakeSlashed(address,uint256,uint256,address)":{"details":"Emitted when `indexer` was slashed for a total of `tokens` amount. Tracks `reward` amount of tokens given to `beneficiary`."},"StakeWithdrawn(address,uint256)":{"details":"Emitted when `indexer` withdrew `tokens` staked."}},"kind":"dev","methods":{"acceptProxy(address)":{"details":"Accept to be an implementation of proxy."},"acceptProxyAndCall(address,bytes)":{"details":"Accept to be an implementation of proxy and then call a function from the new implementation as specified by `_data`, which should be an encoded function call. This is useful to initialize new storage variables in the proxied contract."},"allocate(bytes32,uint256,address,bytes32,bytes)":{"details":"Allocate available tokens to a subgraph deployment.","params":{"_allocationID":"The allocation identifier","_metadata":"IPFS hash for additional information about the allocation","_proof":"A 65-bytes Ethereum signed message of `keccak256(indexerAddress,allocationID)`","_subgraphDeploymentID":"ID of the SubgraphDeployment where tokens will be allocated","_tokens":"Amount of tokens to allocate"}},"allocateFrom(address,bytes32,uint256,address,bytes32,bytes)":{"details":"Allocate available tokens to a subgraph deployment.","params":{"_allocationID":"The allocation identifier","_indexer":"Indexer address to allocate funds from.","_metadata":"IPFS hash for additional information about the allocation","_proof":"A 65-bytes Ethereum signed message of `keccak256(indexerAddress,allocationID)`","_subgraphDeploymentID":"ID of the SubgraphDeployment where tokens will be allocated","_tokens":"Amount of tokens to allocate"}},"claim(address,bool)":{"details":"Claim tokens from the rebate pool.","params":{"_allocationID":"Allocation from where we are claiming tokens","_restake":"True if restake fees instead of transfer to indexer"}},"claimMany(address[],bool)":{"details":"Claim tokens from the rebate pool for many allocations.","params":{"_allocationID":"Array of allocations from where we are claiming tokens","_restake":"True if restake fees instead of transfer to indexer"}},"closeAllocation(address,bytes32)":{"details":"Close an allocation and free the staked tokens. To be eligible for rewards a proof of indexing must be presented. Presenting a bad proof is subject to slashable condition. To opt out for rewards set _poi to 0x0","params":{"_allocationID":"The allocation identifier","_poi":"Proof of indexing submitted for the allocated period"}},"closeAllocationMany((address,bytes32)[])":{"details":"Close multiple allocations and free the staked tokens. To be eligible for rewards a proof of indexing must be presented. Presenting a bad proof is subject to slashable condition. To opt out for rewards set _poi to 0x0","params":{"_requests":"An array of CloseAllocationRequest"}},"closeAndAllocate(address,bytes32,address,bytes32,uint256,address,bytes32,bytes)":{"details":"Close and allocate. This will perform a close and then create a new Allocation atomically on the same transaction.","params":{"_allocationID":"The allocation identifier","_closingAllocationID":"The identifier of the allocation to be closed","_indexer":"Indexer address to allocate funds from.","_metadata":"IPFS hash for additional information about the allocation","_poi":"Proof of indexing submitted for the allocated period","_proof":"A 65-bytes Ethereum signed message of `keccak256(indexerAddress,allocationID)`","_subgraphDeploymentID":"ID of the SubgraphDeployment where tokens will be allocated","_tokens":"Amount of tokens to allocate"}},"collect(uint256,address)":{"details":"Collect query fees for an allocation from state channels. Funds received are only accepted from a valid sender.","params":{"_allocationID":"Allocation where the tokens will be assigned","_tokens":"Amount of tokens to collect"}},"delegate(address,uint256)":{"details":"Delegate tokens to an indexer.","params":{"_indexer":"Address of the indexer to delegate tokens to","_tokens":"Amount of tokens to delegate"},"returns":{"_0":"Amount of shares issued of the delegation pool"}},"getAllocation(address)":{"details":"Return the allocation by ID.","params":{"_allocationID":"Address used as allocation identifier"},"returns":{"_0":"Allocation data"}},"getAllocationState(address)":{"details":"Return the current state of an allocation.","params":{"_allocationID":"Address used as the allocation identifier"},"returns":{"_0":"AllocationState"}},"getDelegation(address,address)":{"details":"Return the delegation from a delegator to an indexer.","params":{"_delegator":"Address of the delegator","_indexer":"Address of the indexer where funds have been delegated"},"returns":{"_0":"Delegation data"}},"getIndexerCapacity(address)":{"details":"Get the total amount of tokens available to use in allocations. This considers the indexer stake and delegated tokens according to delegation ratio","params":{"_indexer":"Address of the indexer"},"returns":{"_0":"Amount of tokens staked by the indexer"}},"getIndexerStakedTokens(address)":{"details":"Get the total amount of tokens staked by the indexer.","params":{"_indexer":"Address of the indexer"},"returns":{"_0":"Amount of tokens staked by the indexer"}},"getSubgraphAllocatedTokens(bytes32)":{"details":"Return the total amount of tokens allocated to subgraph.","params":{"_subgraphDeploymentID":"Address used as the allocation identifier"},"returns":{"_0":"Total tokens allocated to subgraph"}},"getWithdraweableDelegatedTokens((uint256,uint256,uint256))":{"details":"Returns amount of delegated tokens ready to be withdrawn after unbonding period.","params":{"_delegation":"Delegation of tokens from delegator to indexer"},"returns":{"_0":"Amount of tokens to withdraw"}},"hasStake(address)":{"details":"Getter that returns if an indexer has any stake.","params":{"_indexer":"Address of the indexer"},"returns":{"_0":"True if indexer has staked tokens"}},"initialize(address,uint256,uint32,uint32,uint32,uint32,uint32,uint32,uint32,uint32,uint32)":{"details":"Initialize this contract."},"isAllocation(address)":{"details":"Return if allocationID is used.","params":{"_allocationID":"Address used as signer by the indexer for an allocation"},"returns":{"_0":"True if allocationID already used"}},"isDelegator(address,address)":{"details":"Return whether the delegator has delegated to the indexer.","params":{"_delegator":"Address of the delegator","_indexer":"Address of the indexer where funds have been delegated"},"returns":{"_0":"True if delegator of indexer"}},"isOperator(address,address)":{"details":"Return true if operator is allowed for indexer.","params":{"_indexer":"Address of the indexer","_operator":"Address of the operator"}},"setAssetHolder(address,bool)":{"details":"Set an address as allowed asset holder.","params":{"_allowed":"True if asset holder is allowed","_assetHolder":"Address of allowed source for state channel funds"}},"setChannelDisputeEpochs(uint32)":{"details":"Set the period in epochs that need to pass before fees in rebate pool can be claimed.","params":{"_channelDisputeEpochs":"Period in epochs"}},"setController(address)":{"params":{"_controller":"Controller contract address"}},"setCurationPercentage(uint32)":{"details":"Set the curation percentage of query fees sent to curators.","params":{"_percentage":"Percentage of query fees sent to curators"}},"setDelegationParameters(uint32,uint32,uint32)":{"details":"Set the delegation parameters.","params":{"_cooldownBlocks":"Period that need to pass to update delegation parameters","_indexingRewardCut":"Percentage of indexing rewards left for delegators","_queryFeeCut":"Percentage of query fees left for delegators"}},"setDelegationParametersCooldown(uint32)":{"details":"Set the time in blocks an indexer needs to wait to change delegation parameters.","params":{"_blocks":"Number of blocks to set the delegation parameters cooldown period"}},"setDelegationRatio(uint32)":{"details":"Set the delegation ratio. If set to 10 it means the indexer can use up to 10x the indexer staked amount from their delegated tokens","params":{"_delegationRatio":"Delegation capacity multiplier"}},"setDelegationTaxPercentage(uint32)":{"details":"Set a delegation tax percentage to burn when delegated funds are deposited.","params":{"_percentage":"Percentage of delegated tokens to burn as delegation tax"}},"setDelegationUnbondingPeriod(uint32)":{"details":"Set the period for undelegation of stake from indexer.","params":{"_delegationUnbondingPeriod":"Period in epochs to wait for token withdrawals after undelegating"}},"setMaxAllocationEpochs(uint32)":{"details":"Set the max time allowed for indexers stake on allocations.","params":{"_maxAllocationEpochs":"Allocation duration limit in epochs"}},"setMinimumIndexerStake(uint256)":{"details":"Set the minimum indexer stake required to.","params":{"_minimumIndexerStake":"Minimum indexer stake"}},"setOperator(address,bool)":{"details":"Authorize or unauthorize an address to be an operator.","params":{"_allowed":"Whether authorized or not","_operator":"Address to authorize"}},"setProtocolPercentage(uint32)":{"details":"Set a protocol percentage to burn when collecting query fees.","params":{"_percentage":"Percentage of query fees to burn as protocol fee"}},"setRebateRatio(uint32,uint32)":{"details":"Set the rebate ratio (fees to allocated stake).","params":{"_alphaDenominator":"Denominator of `alpha` in the cobb-douglas function","_alphaNumerator":"Numerator of `alpha` in the cobb-douglas function"}},"setSlasher(address,bool)":{"details":"Set or unset an address as allowed slasher.","params":{"_allowed":"True if slasher is allowed","_slasher":"Address of the party allowed to slash indexers"}},"setThawingPeriod(uint32)":{"details":"Set the thawing period for unstaking.","params":{"_thawingPeriod":"Period in blocks to wait for token withdrawals after unstaking"}},"slash(address,uint256,uint256,address)":{"details":"Slash the indexer stake. Delegated tokens are not subject to slashing. Can only be called by the slasher role.","params":{"_beneficiary":"Address of a beneficiary to receive a reward for the slashing","_indexer":"Address of indexer to slash","_reward":"Amount of reward tokens to send to a beneficiary","_tokens":"Amount of tokens to slash from the indexer stake"}},"stake(uint256)":{"details":"Deposit tokens on the indexer stake.","params":{"_tokens":"Amount of tokens to stake"}},"stakeTo(address,uint256)":{"details":"Deposit tokens on the indexer stake.","params":{"_indexer":"Address of the indexer","_tokens":"Amount of tokens to stake"}},"undelegate(address,uint256)":{"details":"Undelegate tokens from an indexer.","params":{"_indexer":"Address of the indexer where tokens had been delegated","_shares":"Amount of shares to return and undelegate tokens"},"returns":{"_0":"Amount of tokens returned for the shares of the delegation pool"}},"unstake(uint256)":{"details":