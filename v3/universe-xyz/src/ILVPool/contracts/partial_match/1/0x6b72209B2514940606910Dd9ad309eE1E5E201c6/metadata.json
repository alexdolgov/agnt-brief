:"address"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"v1YieldMinted","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"vaultRewardsPerWeight","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"weight","outputs":[{"internalType":"uint32","name":"","type":"uint32"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"yieldRewardsPerWeight","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"}],"devdoc":{"details":"ILV Pool contract to be deployed, with all base contracts inherited.Extends functionality working as a router to SushiLP Pool and deployed flash pools.      through functions like `claimYieldRewardsMultiple()` and `claimVaultRewardsMultiple()`,      ILV Pool is trusted by other pools and verified by the factory to aggregate functions      and add quality of life features for stakers.","errors":{"AccessDenied(bytes4,address)":[{"params":{"addr":"an address which access was denied, usually transaction sender","fnSelector":"function selector, defines a function where error was thrown"}}],"InvalidInput(bytes4,uint8)":[{"params":{"fnSelector":"function selector, defines a function where error was thrown","paramIndex":"function parameter index which caused an error thrown"}}],"InvalidState(bytes4,uint256)":[{"params":{"errorCode":"unique error code determining the exact place in code where error was thrown","fnSelector":"function selector, defines a function where error was thrown"}}],"ZeroInput(bytes4,uint8)":[{"params":{"fnSelector":"function selector, defines a function where error was thrown","paramIndex":"function parameter index which caused an error thrown"}}]},"events":{"LogMigratePendingRewards(address,uint256,bool)":{"details":"logs `_migratePendingRewards()`","params":{"from":"user address","pendingRewardsMigrated":"value of pending rewards migrated","useSILV":"whether user claimed v1 pending rewards as ILV or sILV"}},"LogMigrateYieldWeight(address,uint256)":{"details":"logs `_migrateYieldWeights()`","params":{"from":"user address","yieldWeightMigrated":"total amount of weight coming from yield in v1"}},"LogV1YieldMintedMultiple(address,uint256)":{"details":"logs `mintV1YieldMultiple()`.","params":{"from":"user address","value":"number of ILV tokens minted"}}},"kind":"dev","methods":{"balanceOf(address)":{"details":"Loops through stakes and returns total balance.","params":{"_user":"an address to query balance for"},"returns":{"balance":"total staked token balance"}},"blacklistUsers(address[])":{"details":"The intention is to prevent addresses that exploited v1 to be able to move      stake ids to the v2 contracts and to be able to mint any yield from a v1      stake id with the isYield flag set to true.","params":{"_users":"v1 users address array"}},"claimAllRewards(bool)":{"details":"Claims both revenue distribution and yield rewards in one call."},"claimVaultRewards()":{"details":"Calls internal `_claimVaultRewards()` passing `msg.sender` as `_staker`."},"claimVaultRewardsMultiple(address[])":{"details":"Calls multiple pools claimVaultRewardsFromRouter() in order to claim yield in 1 transaction.","params":{"_pools":"array of pool addresses"}},"claimYieldRewards(bool)":{"details":"Calls internal `_claimYieldRewards()` passing `msg.sender` as `_staker`."},"claimYieldRewardsMultiple(address[],bool[])":{"details":"Calls multiple pools claimYieldRewardsFromRouter() in order to claim yield in 1 transaction.","params":{"_pools":"array of pool addresses","_useSILV":"array of bool values telling if the pool should claim reward                 as ILV or sILV"}},"executeMigration(bytes32[],uint256,uint248,uint256,bool,uint256[])":{"details":"Calls internal `_migrateLockedStakes`,  `_migrateYieldWeights`      and `_migratePendingRewards` functions for a complete migration      of a v1 user to v2.See `_migrateLockedStakes` and _`migrateYieldWeights`."},"getStake(address,uint256)":{"details":"See getStakesLength.","params":{"_stakeId":"zero-indexed stake ID for the address specified","_user":"an address to query stake for"},"returns":{"_0":"stake info as Stake structure"}},"getStakesLength(address)":{"details":"See `getStake()`.","params":{"_user":"an address to query stake length for"},"returns":{"_0":"number of stakes for the given address"}},"getTotalReserves()":{"details":"Returns the sum of poolTokenReserve with the deposit reserves in v1.In ILV Pool contract the eDAO stores the v1 reserve value, and      in the SLP pool we're able to query it from the v1 lp pool contract."},"getV1StakeId(address,uint256)":{"details":"Get v1 stake id position through `getV1StakePosition()`.","params":{"_position":"position index in the array","_user":"an address to query stake for"},"returns":{"_0":"stakeId value"}},"getV1StakePosition(address,uint256)":{"details":"Helper function to call `getV1StakeId()`.Reverts if stakeId isn't found.","params":{"_desiredId":"desired stakeId position in the array to find","_user":"an address to query stake for"},"returns":{"position":"stake info as Stake structure"}},"hasMigratedYield(uint256)":{"details":"Returns whether an user of a given _index in the bitmap has already      migrated v1 yield weight stored in the merkle tree or not.","params":{"_index":"user index in the bitmap, can be checked in the off-chain               merkle tree"},"returns":{"_0":"whether user has already migrated yield weights or not"}},"initialize(address,address,address,address,uint64,uint32,address,uint256)":{"details":"Calls `__V2Migrator_init()`."},"migrateLockedStakes(uint256[])":{"details":"External migrateLockedStakes call, used in the Sushi LP pool contract.The function is used by users that want to migrate locked stakes in v1,      but have no yield in the pool. This happens in two scenarios:      1 - The user pool is the Sushi LP pool, which only has stakes;      2 - The user joined ILV pool recently, doesn't have much yield and          doesn't want to migrate their yield weight in the pool;","params":{"_stakeIds":"array of v1 stake ids"}},"mintV1YieldMultiple(uint256[])":{"details":"Aggregates in one single mint call multiple yield stakeIds from v1.reads v1 ILV pool to execute checks, if everything is correct, it stores      in memory total amount of yield to be minted and calls the PoolFactory to mint      it to msg.sender.","params":{"_stakeIds":"array of yield ids in v1 from msg.sender user"}},"moveFundsFromWallet(address)":{"details":"In the ILV Pool we verify that the user isn't coming from v1.If user has weight in v1, we can't allow them to call this      function, otherwise it would throw an error in the new address when calling      mintV1YieldMultiple if the user migrates.","params":{"_to":"new user address, needs to be a fresh address with no stakes"}},"pause(bool)":{"details":"Set paused/unpaused state in the pool contract.","params":{"_shouldPause":"whether the contract should be paused/unpausd"}},"paused()":{"details":"Returns true if the contract is paused, and false otherwise."},"pendingRewards(address)":{"details":"See `_pendingRewards()` for further details.External `pendingRewards()` returns pendingYield and pendingRevDis         accumulated with already stored user.pendingYield and user.pendingRevDis.","params":{"_staker":"an address to calculate yield rewards value for"}},"receiveVaultRewards(uint256)":{"details":"Executed by the vault to transfer vault rewards ILV from the vault      into the pool.This function is executed only for ILV core pools.","params":{"_value":"amount of ILV rewards to transfer into the pool"}},"setMerkleRoot(bytes32)":{"details":"Sets the yield weight tree root.","params":{"_merkleRoot":"32 bytes tree root."}},"setV1GlobalWeight(uint256)":{"details":"Updates value that keeps track of v1 global locked tokens weight.","params":{"_v1GlobalWeight":"new value to be stored"}},"setV1PoolTokenReserve(uint256)":{"details":"Updates value that keeps track of v1 global locked tokens weight.","params":{"_v1PoolTokenReserve":"new value to be stored"}},"setVault(address)":{"details":"Executed only by the factory owner to Set the vault.","params":{"vault_":"an address of deployed IlluviumVault instance"}},"setWeight(uint32)":{"details":"Executed by the factory to modify pool weight; the factory is expected      to keep track of the total pools weight when updating.Set weight to zero to disable the pool.","params":{"_weight":"new weight to set for the pool"}},"stake(uint256,uint64)":{"details":"Requires value to stake and lock duration to be greater than zero.","params":{"_lockDuration":"stake duration as unix timestamp","_value":"value of tokens to stake"}},"stakeAsPool(address,uint256)":{"details":"Executed by other core pools and flash pools      as part of yield rewards processing logic (`_claimYieldRewards()` function).Executed when _useSILV is false and pool is not an ILV pool -      see `CorePool._processRewards()`.","params":{"_staker":"an address which stakes (the yield reward)","_value":"amount to be staked (yield reward amount)"}},"sync()":{"details":"Can be executed by anyone at any time, but has an effect only when      at least one second passes between synchronizations.Executed internally when staking, unstaking, processing rewards in order      for calculations to be correct and to reflect state progress of the contract.When timing conditions are not met (executed too frequently, or after factory      end time), function doesn't throw and exits silently."},"unstake(uint256,uint256)":{"details":"Unstakes a stake that has been previously locked, and is now in an unlocked      state. If the stake has the isYield flag set to true, then the contract      requests ILV to be minted by the PoolFactory. Otherwise it transfers ILV or LP      from the contract balance.","params":{"_stakeId":"stake ID to unstake from, zero-indexed","_value":"value of tokens to unstake"}},"unstakeMultiple((uint256,uint256)[],bool)":{"details":"Executes unstake on multiple stakeIds. See `unstakeLocked()`.Optimizes gas by requiring all unstakes to be made either in yield stakes      or in non yield stakes. That way we can transfer or mint tokens in one call.","params":{"_stakes":"array of stakeIds and values to be unstaked in each stake from                the msg.sender","_unstakingYield":"whether all stakeIds have isYield flag set to true or false,                        i.e if we're minting ILV or transferring pool tokens"}},"upgradeTo(address)":{"details":"Upgrade the implementation of the proxy to `newImplementation`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."},"upgradeToAndCall(address,bytes)":{"details":"Upgrade the implementation of the proxy to `newImplementation`, and subsequently execute the function call encoded in `data`. Calls {_authorizeUpgrade}. Emits an {Upgraded} event."}},"stateVariables":{"__gap":{"details":"Empty reserved space in storage. The size of the __gap array is calculated so that      the amount of storage used by a contract always adds up to the 50.      See https://docs.openzeppelin.com/contracts/4.x/upgradeable#storage_gaps"},"_usersMigrated":{"details":"bitmap mapping merkle tree user indexes to a bit that tells      whether a user has already migrated yield or not."},"merkleRoot":{"details":"stores merkle root related to users yield weight in v1."},"v1PoolTokenReserve":{"details":"Used to calculate vault (revenue distribution) rewards, keeps track      of the correct ILV balance in the v1 core pool."},"v1YieldMinted":{"details":"maps `keccak256(userAddress,stakeId)` to a bool value that tells      if a v1 yield has already been minted by v2 contract."}},"title":"ILV Pool","version":1},"userdoc":{"errors":{"AccessDenied(bytes4,address)":[{"notice":"Thrown on invalid access to a function specified."}],"InvalidInput(bytes4,uint8)":[{"notice":"Thrown on invalid input at index specified in a function specified."}],"InvalidState(bytes4,uint256)":[{"notice":"Thrown on invalid state in a function specified."}],"ZeroInput(bytes4,uint8)":[{"notice":"Thrown on zero input at index specified in a function specified."}]},"kind":"user","methods":{"balanceOf(address)":{"notice":"Returns total staked token balance for the given address.Expected to be called externally through `eth_call`. Gas shouldn't         be an issue here."},"blacklistUsers(address[])":{"notice":"Blacklists a list of v1 user addresses by setting the         _isBlacklisted flag to true."},"claimVaultRewards()":{"notice":"Pool state is updated before calling the internal function."},"claimVaultRewardsMultiple(address[])":{"notice":"ILV pool works as a router for claiming multiple pools registered         in the factory"},"claimYieldRewards(bool)":{"notice":"Pool state is updated before calling the internal function."},"claimYieldRewardsMultiple(address[],bool[])":{"notice":"ILV pool works as a router for claiming multiple pools registered         in the factory."},"getStake(address,uint256)":{"notice":"Returns information on the given stake for the given address."},"getStakesLength(address)":{"notice":"Returns number of stakes for the given address. Allows iteration over stakes."},"getV1StakeId(address,uint256)":{"notice":"Returns a v1 stake id in the `user.v1StakesIds` array."},"getV1StakePosition(address,uint256)":{"notice":"Returns a v1 stake position in the `user.v1StakesIds` array."},"migrateLockedStakes(uint256[])":{"notice":"Most of the times this function will be used in the inherited Sushi         LP pool contract (called by the v1 user coming from sushi pool),         but it's possible that a v1 user coming from the ILV pool decides         to use this function instead of `executeMigration()` defined in         the ILV pool contract."},"mintV1YieldMultiple(uint256[])":{"notice":"V1 won't be able to mint ILV yield anymore. This mean only this function         in the V2 contract is able to mint previously accumulated V1 yield."},"pendingRewards(address)":{"notice":"Calculates current yield rewards value available for address specified."},"setMerkleRoot(bytes32)":{"notice":"Can only be called by the eDAO."},"stake(uint256,uint64)":{"notice":"Stakes specified value of tokens for the specified value of time,      and pays pending yield rewards if any."},"sync()":{"notice":"Service function to synchronize pool state with current time."},"unstakeMultiple((uint256,uint256)[],bool)":{"notice":"User is required to either mint ILV or unstake pool tokens in the function call.         There's no way to do both operations in one call."}},"version":1}},"settings":{"compilationTarget":{"contracts/ILVPool.sol":"ILVPool"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"none"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"@openzeppelin/contracts-upgradeable/proxy/ERC1967/ERC1967UpgradeUpgradeable.sol":{"keccak256":"0xcc3fca7831523600d2cac44ec77ee7e079f70c6910b6d7229ff774eaa5f04cdc","license":"MIT","urls":["bzz-raw://b7831b612db9847586663c82a3d071429520fc5c4ee1a15cb7873ebf15baa42d","dweb:/ipfs/Qmezw3xDRDjm2by9rmNLa575CvqTWBoEMSdimp5nWd9ZfZ"]},"@openzeppelin/contracts-upgradeable/proxy/beacon/IBeaconUpgradeable.sol":{"keccak256":"0xce27d2053e9b7a970532947213c84eed0289ada2d9a91c92b7e1e15f3a466c54","license":"MIT","urls":["bzz-raw://429b36651fab917b4cdfa5e9431b96c5bd3ba73392a31e62a4d92b4b4ae85184","dweb:/ipfs/QmY1SgWuSbxgYCPAibNHT4phA71QzzqagZRunwC7Gm19wq"]},"@openzeppelin/contracts-upgradeable/proxy/utils/Initializable.sol":{"keccak256":"0x8b2abd85d0ece7e866e100e9d47ca9cbec93c87cf71a8d267b2b93eb81f7d5e9","license":"MIT","urls":["bzz-raw://fe9fa1beb63e4a09637701f783982ba80380d630d600c9cafe26b68bf58be1b2","dweb:/ipfs/QmRA3GXhTWys88joD9x8xYhdjzvGwmDGLMMzGw3LxbSEge"]},"@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol":{"keccak256":"0x6eecf5abec3cd10b2e9234936b80b6cb7c174e926542a2f