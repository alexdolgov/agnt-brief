256"},{"internalType":"uint256","name":"totalAssets","type":"uint256"},{"internalType":"uint256","name":"feesOwed","type":"uint256"},{"internalType":"uint8","name":"cellarDecimals","type":"uint8"},{"internalType":"uint8","name":"reserveAssetDecimals","type":"uint8"},{"internalType":"uint32","name":"performanceFee","type":"uint32"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"contract Cellar","name":"","type":"address"}],"name":"pendingMetaData","outputs":[{"internalType":"uint32","name":"pendingManagementFee","type":"uint32"},{"internalType":"uint32","name":"pendingPerformanceFee","type":"uint32"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bytes","name":"performData","type":"bytes"}],"name":"performUpkeep","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"prepareFees","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"contract Cellar","name":"cellar","type":"address"},{"internalType":"uint32","name":"resetPercent","type":"uint32"}],"name":"resetHWM","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"contract Cellar","name":"cellar","type":"address"}],"name":"sendFees","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"gasFeed","type":"address"}],"name":"setGasFeed","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint32","name":"managementFee","type":"uint32"},{"internalType":"uint32","name":"performanceFee","type":"uint32"}],"name":"setupMetaData","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint32","name":"managementFee","type":"uint32"}],"name":"updateManagementFee","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint32","name":"performanceFee","type":"uint32"}],"name":"updatePerformanceFee","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"amount","type":"uint256"}],"name":"withdrawAssetsFromReserves","outputs":[],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"author":"crispymangoes","details":"Important Safety Considerations      - There should be no way for strategists to call `performUpkeep` DURING a rebalance.      - All public mutative functions run reentrancy checks.      - Important meta data, like a Cellar's asset is saved in this contract","kind":"dev","methods":{"performUpkeep(bytes)":{"details":"If cellar is not setup, this function reverts.If not enough time has passed, the cellar does not have its fees calculated.If cellar has pending values that differ from current stored values, they are updated.We also update stored totalAssets, and timestamp when any fees are earned, so that future fee calculations are more accurate."},"prepareFees(uint256)":{"details":"Moves assets from reserves into `feesReadyForClaim`.","params":{"amount":"the amount of reserves to set aside for fees."}},"resetHWM(address,uint32)":{"details":"Resetting HWM will zero out all fees owed.","params":{"resetPercent":"Number between 0 bps and 10,000 bps.                     0 - HWM does not change at all                10,000 - HWM is fully reset to current share price"}}},"title":"Fees And Reserves","version":1},"userdoc":{"kind":"user","methods":{"AUTOMATION_REGISTRY()":{"notice":"Chainlink's Automation Registry contract address.For mainnet use 0x02777053d6764996e594c3E88AF1D58D5363a2e6."},"ETH_FAST_GAS_FEED()":{"notice":"Chainlink Fast Gas Feed for current network.For mainnet use 0x169E633A2D1E6c10dD91238Ba11c4A708dfEF37C."},"FEES_DISTRIBUTOR()":{"notice":"Cosmos address where protocol fees are sent."},"addAssetsToReserves(uint256)":{"notice":"Allows strategists to freely move assets into reserves."},"cellarToUpkeepData(address)":{"notice":"Maps a cellar to its upkeep data."},"changeUpkeepFrequency(uint64)":{"notice":"Strategist callable, value is immediately used."},"changeUpkeepMaxGas(uint64)":{"notice":"Strategist callable, value is immediately used."},"checkUpkeep(bytes)":{"notice":"CheckUpkeep runs several checks on proposed cellars.         - Checks that the Cellar has called setup function.         - Checks that gas is reasonable.         - Checks that enough time has passed.         - Checks that the cellar has pending fees, or that it needs to finish setup."},"feesReadyForClaim(address)":{"notice":"Maps a cellar to the amount of fees it will claim on `sendFees` call."},"gravityBridge()":{"notice":"For ETH Mainnet this is the actual Gravity Bridge.If on another L2, this will be a fee transfer contract         that implements `sendToCosmos`."},"initiateShutdown()":{"notice":"Shutdown the cellar. Used in an emergency or if the cellar has been deprecated."},"isShutdown()":{"notice":"Whether or not the contract is shutdown in case of an emergency."},"liftShutdown()":{"notice":"Restart the cellar."},"metaData(address)":{"notice":"Maps a cellar to its meta data."},"pendingMetaData(address)":{"notice":"Maps a cellar to its pending meta data."},"performUpkeep(bytes)":{"notice":"PerformUpkeep will trust `performData` input if the caller is `AUTOMATION_REGISTRY` otherwise the input is recalcualted."},"resetHWM(address,uint32)":{"notice":"Allows owner to reset a Cellar's Share Price High Watermark."},"sendFees(address)":{"notice":"Takes assets stored in `feesReadyForClaim`, splits it up between strategist and gravity bridge."},"setGasFeed(address)":{"notice":"Allows owner to set a new gas feed.Can be set to zero address to skip gas check."},"setupMetaData(uint32,uint32)":{"notice":"Setup function called when a new cellar begins using this contract"},"updateManagementFee(uint32)":{"notice":"Strategist callable, value is only used after         performUpkeep is ran for the cellar."},"updatePerformanceFee(uint32)":{"notice":"Strategist callable, value is only used after         performUpkeep is ran for the cellar."},"withdrawAssetsFromReserves(uint256)":{"notice":"Allows strategists to freely move assets from reserves."}},"notice":"Allows strategists to move yield in/out of reserves in order to better manage their strategy.Allows strategists to take performance and management fees on their cellars.","version":1}},"settings":{"compilationTarget":{"src/modules/FeesAndReserves.sol":"FeesAndReserves"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@balancer-labs/=lib/balancer-v2-monorepo/../../node_modules/@balancer-labs/",":@balancer/=lib/balancer-v2-monorepo/pkg/",":@ccip/=lib/ccip/",":@chainlink/=lib/chainlink/",":@ds-test/=lib/forge-std/lib/ds-test/src/",":@forge-std/=lib/forge-std/src/",":@openzeppelin/=lib/openzeppelin-contracts/",":@pendle/=lib/pendle-core-v2-public/",":@solmate/=lib/solmate/src/",":@uniswap/v3-core/=lib/v3-core/",":@uniswap/v3-periphery/=lib/v3-periphery/",":@uniswapV3C/=lib/v3-core/contracts/",":@uniswapV3P/=lib/v3-periphery/contracts/",":axelar-gmp-sdk-solidity/=lib/axelar-gmp-sdk-solidity/contracts/",":balancer-v2-monorepo/=lib/balancer-v2-monorepo/",":ccip/=lib/ccip/contracts/",":chainlink/=lib/chainlink/integration-tests/contracts/ethereum/src/",":ds-test/=lib/forge-std/lib/ds-test/src/",":forge-std/=lib/forge-std/src/",":openzeppelin-contracts/=lib/openzeppelin-contracts/",":pendle-core-v2-public/=lib/pendle-core-v2-public/contracts/",":solmate/=lib/solmate/src/",":v3-core/=lib/v3-core/contracts/",":v3-periphery/=lib/v3-periphery/contracts/"]},"sources":{"lib/chainlink/contracts/src/