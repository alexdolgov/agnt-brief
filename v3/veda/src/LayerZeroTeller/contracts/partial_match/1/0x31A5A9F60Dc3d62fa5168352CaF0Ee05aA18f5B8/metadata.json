erator(address)":{"details":"Callable by OWNER_ROLE, and DENIER_ROLE."},"denyTo(address)":{"details":"Callable by OWNER_ROLE, and DENIER_ROLE."},"deposit(address,uint256,uint256)":{"details":"Publicly callable."},"depositAndBridge(address,uint256,uint256,address,bytes,address,uint256)":{"details":"This function will REVERT if `beforeTransfer` hook reverts from:     - shares being locked     - allow listSince call to `bridge` is public, msg.sig is not updated which means any role capabilities regarding this function      are also granted to the `bridge` function."},"depositAndBridgeWithPermit(address,uint256,uint256,uint256,uint8,bytes32,bytes32,address,bytes,address,uint256)":{"details":"This function will REVERT if `beforeTransfer` hook reverts from:     - shares being locked     - allow listSince calls to `depositWithPermit` and `bridge` are public, msg.sig is not updated which means any role capabilities regarding this function      are also granted to the `depositWithPermit` and `bridge` function."},"depositWithPermit(address,uint256,uint256,uint256,uint8,bytes32,bytes32)":{"details":"Publicly callable."},"lzReceive((uint32,bytes32,uint64),bytes32,bytes,address,bytes)":{"details":"Entry point for receiving messages or packets from the endpoint.Entry point for receiving msg/packet from the LayerZero endpoint.","params":{"_executor":"The address of the executor for the received message.","_extraData":"Additional arbitrary data provided by the corresponding executor.","_guid":"The unique identifier for the received LayerZero message.","_message":"The payload of the received message.","_origin":"The origin information containing the source endpoint and sender address.  - srcEid: The source chain endpoint ID.  - sender: The sender address on the src chain.  - nonce: The nonce of the message."}},"nextNonce(uint32,bytes32)":{"details":"_srcEid The source endpoint ID._sender The sender address.The path nonce starts from 1. If 0 is returned it means that there is NO nonce ordered enforcement.Is required by the off-chain executor to determine the OApp expects msg execution is ordered.This is also enforced by the OApp.By default this is NOT enabled. ie. nextNonce is hardcoded to return 0.","returns":{"nonce":"The next nonce."}},"oAppVersion()":{"returns":{"receiverVersion":"The version of the OAppReceiver.sol implementation.","senderVersion":"The version of the OAppSender.sol implementation."}},"pause()":{"details":"Callable by MULTISIG_ROLE."},"refundDeposit(uint256,address,address,uint256,uint256,uint256,uint256)":{"details":"Once a deposit share lock period has passed, it can no longer be reverted.It is possible the admin does not setup the BoringVault to call the transfer hook,      but this contract can still be saving share lock state. In the event this happens      deposits are still refundable if the user has not transferred their shares.      But there is no guarantee that the user has not transferred their shares.Callable by STRATEGIST_MULTISIG_ROLE."},"removeChain(uint32)":{"details":"Callable by MULTISIG_ROLE."},"setChainGasLimit(uint32,uint128)":{"details":"Callable by OWNER_ROLE."},"setDelegate(address)":{"details":"Only the owner/admin of the OApp can call this function.Provides the ability for a delegate to set configs, on behalf of the OApp, directly on the Endpoint contract.","params":{"_delegate":"The address of the delegate to be set."}},"setPeer(uint32,bytes32)":{"details":"Only the owner/admin of the OApp can call this function.Indicates that the peer is trusted to send LayerZero messages to this OApp.Set this to bytes32(0) to remove the peer address.Peer is a bytes32 to accommodate non-evm chains.","params":{"_eid":"The endpoint ID.","_peer":"The address of the peer to be associated with the corresponding endpoint."}},"setShareLockPeriod(uint64)":{"details":"This not only locks shares to the user address, but also serves as the pending deposit period, where deposits can be reverted.If a new shorter share lock period is set, users with pending share locks could make a new deposit to receive 1 wei shares,      and have their shares unlock sooner than their original deposit allows. This state would allow for the user deposit to be refunded,      but only if they have not transferred their shares out of there wallet. This is an accepted limitation, and should be known when decreasing      the share lock period.Callable by OWNER_ROLE."},"stopMessagesFromChain(uint32)":{"details":"Callable by MULTISIG_ROLE."},"stopMessagesToChain(uint32)":{"details":"Callable by MULTISIG_ROLE."},"unpause()":{"details":"Callable by MULTISIG_ROLE."},"updateAssetData(address,bool,bool,uint16)":{"details":"The accountant must also support pricing this asset, else the `deposit` call will revert.Callable by OWNER_ROLE."}},"version":1},"userdoc":{"kind":"user","methods":{"accountant()":{"notice":"The AccountantWithRateProviders this contract is working with."},"addChain(uint32,bool,bool,address,uint128)":{"notice":"Add a chain to the teller."},"allowAll(address)":{"notice":"Allow a user to transfer or receive shares."},"allowFrom(address)":{"notice":"Allow a user to transfer shares."},"allowInitializePath((uint32,bytes32,uint64))":{"notice":"Checks if the path initialization is allowed based on the provided origin."},"allowMessagesFromChain(uint32,address)":{"notice":"Allow messages from a chain."},"allowMessagesToChain(uint32,address,uint128)":{"notice":"Allow messages to a chain."},"allowOperator(address)":{"notice":"Allow an operator to transfer shares."},"allowTo(address)":{"notice":"Allow a user to receive shares."},"assetData(address)":{"notice":"Mapping ERC20s to their assetData."},"beforeTransfer(address,address,address)":{"notice":"Implement beforeTransfer hook to check if shares are locked, or if `from`, `to`, or `operator` are on the deny list.If share lock period is set to zero, then users will be able to mint and transfer in the same tx.         if this behavior is not desired then a share lock period of >=1 should be used."},"bridge(uint96,address,bytes,address,uint256)":{"notice":"Bridge shares to another chain."},"bulkDeposit(address,uint256,uint256,address)":{"notice":"Allows on ramp role to deposit into this contract."},"bulkWithdraw(address,uint256,uint256,address)":{"notice":"Allows off ramp role to withdraw from this contract."},"composeMsgSender()":{"notice":"Retrieves the address responsible for 'sending' composeMsg's to the Endpoint."},"denyAll(address)":{"notice":"Deny a user from transferring or receiving shares."},"denyFrom(address)":{"notice":"Deny a user from transferring shares."},"denyOperator(address)":{"notice":"Deny an operator from transferring shares."},"denyTo(address)":{"notice":"Deny a user from receiving shares."},"deposit(address,uint256,uint256)":{"notice":"Allows users to deposit into the BoringVault, if this contract is not paused."},"depositAndBridge(address,uint256,uint256,address,bytes,address,uint256)":{"notice":"Deposit an asset and bridge the shares to another chain."},"depositAndBridgeWithPermit(address,uint256,uint256,uint256,uint8,bytes32,bytes32,address,bytes,address,uint256)":{"notice":"Deposit an asset and bridge the shares to another chain using a permit."},"depositNonce()":{"notice":"The deposit nonce used to map to a deposit hash."},"depositWithPermit(address,uint256,uint256,uint256,uint8,bytes32,bytes32)":{"notice":"Allows users to deposit into BoringVault using permit."},"endpoint()":{"notice":"Retrieves the LayerZero endpoint associated with the OApp."},"fromDenyList(address)":{"notice":"Mapping `from` address to a bool to deny them from transferring shares."},"idToChains(uint32)":{"notice":"Maps chain selector to chain information."},"isPaused()":{"notice":"Used to pause calls to `deposit` and `depositWithPermit`."},"nativeWrapper()":{"notice":"The native wrapper contract."},"nextNonce(uint32,bytes32)":{"notice":"Retrieves the next nonce for a given source endpoint and sender address."},"oAppVersion()":{"notice":"Retrieves the OApp version information."},"operatorDenyList(address)":{"notice":"Mapping `opeartor` address to a bool to deny them from calling `transfer` or `transferFrom`."},"pause()":{"notice":"Pause this contract, which prevents future calls to `deposit` and `depositWithPermit`."},"peers(uint32)":{"notice":"Retrieves the peer (OApp) associated with a corresponding endpoint."},"previewFee(uint96,address,bytes,address)":{"notice":"Preview fee required to bridge shares in a given feeToken."},"refundDeposit(uint256,address,address,uint256,uint256,uint256,uint256)":{"notice":"Allows DEPOSIT_REFUNDER_ROLE to revert a pending deposit."},"removeChain(uint32)":{"notice":"Remove a chain from the teller."},"setChainGasLimit(uint32,uint128)":{"notice":"Set the gas limit for messages to a chain."},"setDelegate(address)":{"notice":"Sets the delegate address for the OApp."},"setPeer(uint32,bytes32)":{"notice":"Sets the peer address (OApp instance) for a corresponding endpoint."},"setShareLockPeriod(uint64)":{"notice":"Sets the share lock period."},"shareLockPeriod()":{"notice":"After deposits, shares are locked to the msg.sender's address         for `shareLockPeriod`."},"shareUnlockTime(address)":{"notice":"Maps user address to the time their shares will be unlocked."},"stopMessagesFromChain(uint32)":{"notice":"Stop messages from a chain."},"stopMessagesToChain(uint32)":{"notice":"Stop messages to a chain."},"toDenyList(address)":{"notice":"Mapping `to` address to a bool to deny them from receiving shares."},"unpause()":{"notice":"Unpause this contract, which allows future calls to `deposit` and `depositWithPermit`."},"updateAssetData(address,bool,bool,uint16)":{"notice":"Updates the asset data for a given asset."},"vault()":{"notice":"The BoringVault this contract is working with."}},"version":1}},"settings":{"compilationTarget":{"LayerZeroTeller.sol":"LayerZeroTeller"},"evmVersion":"shanghai","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"LayerZeroTeller.sol":{"keccak256":"0x161cd211b566cdec124b03cc640ce74e92ad3698285bb960a5ddf97816bdedfa","license":"UNLICENSED","urls":["bzz-raw://26f33da12425097e92d23c98389f5b5c956e2814e0974c871d9331413e5853d1","dweb:/ipfs/QmSdWEdWvERnfA217Ras3kNK9k9QB2hmbMxog82MdUvPdX"]}},"version":1}