ero address is passed for treasury"}]},"kind":"user","methods":{"convertPrivateFundToPublic()":{"notice":"Converts a private portfolio to a public one, enabling wider access."},"deleteProposedEntryAndExitFee()":{"notice":"Deletes the proposed entry and exit fees, resetting the proposal."},"deleteProposedManagementFee()":{"notice":"Deletes the proposed management fee, resetting the proposal."},"deleteProposedPerformanceFee()":{"notice":"Deletes the proposed performance fee, resetting the proposal."},"proposeNewEntryAndExitFee(uint256,uint256)":{"notice":"Proposes new entry and exit fees, starting a timer for when the changes can be finalized."},"proposeNewManagementFee(uint256)":{"notice":"Proposes a new management fee, starting a timer for when the change can be finalized."},"proposeNewPerformanceFee(uint256)":{"notice":"Proposes a new performance fee, starting a timer for when the change can be finalized."},"removeWhitelistedUser(address[])":{"notice":"This function removes a previously whitelisted user"},"updateAssetManagerTreasury(address)":{"notice":"Updates the address of the asset manager's treasury."},"updateEntryAndExitFee()":{"notice":"Updates the entry and exit fees to the previously proposed fees, after a waiting period."},"updateInitialPortfolioAmount(uint256)":{"notice":"Sets a new initial portfolio price."},"updateManagementFee()":{"notice":"Updates the management fee to the previously proposed fee, after a waiting period."},"updateMinPortfolioTokenHoldingAmount(uint256)":{"notice":"Updates the minimum portfolio token amount required for transactions."},"updatePerformanceFee()":{"notice":"Updates the performance fee to the previously proposed fee, after a waiting period."},"updateTransferability(bool,bool)":{"notice":"Updates the transferability settings for the portfolio."},"whitelistUser(address[])":{"notice":"This function whitelists users which can deposit in a particular portfolio"}},"version":1}},"settings":{"compilationTarget":{"contracts/config