ct which adapter build is currently wired into `SwapRouter`."}},"notice":"Per-DEX adapter for `DexType.Solidly` — Thena, Ramses, Pharaoh, Shadow, Equalizer, and other legacy Solidly forks. dexData encodes `(bool stable)`.","version":1}},"settings":{"compilationTarget":{"contracts/dex/adapters/SolidlyAdapter.sol":"SolidlyAdapter"},"evmVersion":"paris","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@morpho-blue/=lib/morpho-blue/src/",":@openzeppelin/=lib/openzeppelin-contracts/",":ds-test/=lib/solmate/lib/ds-test/src/",":forge-std/=lib/forge-std/src/",":morpho-blue/=lib/morpho-blue/",":openzeppelin-contracts/=lib/openzeppelin-contracts/",":solmate/=lib/solmate/src/"]},"sources":{"contracts/dex/DexAdapterBase.sol":{"keccak256":"0x1a4008459bcfdc6306373eb80c20cdd12f7aa5d706c6a49a639f8284f985a0a7","license":"MIT","urls":["bzz-raw://cead7508cd60a75728fbca1991c1204cde66b9ce32180391abd2bb6fb05966a4","dweb:/ipfs/QmNSeoUepJgJMq1RZ9G19vFR5rQFuHY5VAZgsh11cgUq2s"]},"contracts/dex/IDexAdapter.sol":{"keccak256":"0x9aa12fe5a5561c9a3d150543bdedd7378dee1b66a941e97511862a0d120381d2","license":"MIT","urls":["bzz-raw://84729e3bc33548d20288282cd57b31c1f4dfa1e0d4bd278ce2b378244bf4f63f","dweb:/ipfs/QmRhKRqXxSRwm746t2SLrxnAZD36mD5QQQy5tfYUzf3UST"]},"contracts/dex/ISwapRouter.sol":{"keccak256":"0xcb2f2dae7537cd12857745e09f3a46caf6d715f565c162201820b1b78ffa2b74","license":"MIT","urls":["bzz-raw://c51025e27fa1f404cd52eae82985324ad46d50d0a34010a11a42df7b96cc4a0a","dweb:/ipfs/QmbYBHPRViTrYGXESNhmkwZD9ifyrKz3xmrXr5KoiR5a2a"]},"contracts/dex/SwapTypes.sol":{"keccak256":"0xd29e94476994d0a032b7bff1b49924a1799bb49b38feab6f366924a7d7fc6167","license":"MIT","urls":["bzz-raw://35212351e1794ecd8a6f7733f55225e4c23a96e69477938a2c26ab642c528964","dweb:/ipfs/QmYe6wduxKW4ToMiyWLnSUXbniP8c9Ehg9UrbGVv5PWvFW"]},"contracts/dex/adapters/SolidlyAdapter.sol":{"keccak256":"0xf5030f4513751a6655450b7637002b7dbcd11db564c9a0a0cdc08c6920c23e62","license":"MIT","url