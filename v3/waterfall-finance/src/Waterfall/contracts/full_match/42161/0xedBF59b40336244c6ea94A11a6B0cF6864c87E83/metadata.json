date the swapAndLiquifyEnabled. Can only be called by the current operator."},"updateSwapRouter(address)":{"details":"Update the swap router. Can only be called by the current operator."},"updateTransferTaxRate(uint16)":{"details":"Update the transfer tax rate. Can only be called by the current operator."}},"version":1},"userdoc":{"kind":"user","methods":{"constructor":"Constructs the WaterfallSwapToken contract.","mint(address,uint256)":{"notice":"Creates `_amount` token to `_to`. Must only be called by the owner (MasterChef)."}},"version":1}},"settings":{"compilationTarget":{"Waterfall.sol":"Waterfall"},"evmVersion":"istanbul","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":false,"runs":200},"remappings":[]},"sources":{"Waterfall.sol":{"keccak256":"0x9c7408520e6d74ea93a351cd121ad23198801bdaa80e37fbcf93479650696aa0","urls":["bzz-raw://82f29dbb667cbdff54cf3b80a9d28d713097650715696fbf7fda301356111ba1","dweb:/ipfs/QmdnvnPvqz9NqbdAMCFc1sAJ5WxR3xMM47oqkyGwbM5rux"]}},"version":1}