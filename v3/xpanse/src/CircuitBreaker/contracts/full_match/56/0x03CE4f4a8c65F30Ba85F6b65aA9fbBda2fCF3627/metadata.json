hods. Suspend functionality is public, resume functionality is controlled by owner. * https://docs.synthetix.io/contracts/source/contracts/CircuitBreaker"}},"settings":{"compilationTarget":{"CircuitBreaker.sol":"CircuitBreaker"},"evmVersion":"istanbul","libraries":{},"optimizer":{"enabled":true,"runs":200},"remappings":[]},"sources":{"CircuitBreaker.sol":{"keccak256":"0x2a0cd89dc2469362b50e12efbf52bb1e24f0085b605398d0279e5dee4dd062f6","urls":["bzz-raw://2bf8deb54a09664f402106f4e5c433e1d8ac4dba0a8e5cfea092087adf97cf78","dweb:/ipfs/QmaFh12Z5rRJiqdHsZpPYQf2YveAE32fRifLBkpCcrsycz"]}},"version":1}