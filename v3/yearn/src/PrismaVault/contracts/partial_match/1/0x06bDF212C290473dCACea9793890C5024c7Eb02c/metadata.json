ostDelegate`"}},"getClaimableWithBoost(address)":{"params":{"claimant":"address to query boost amounts for"},"returns":{"boosted":"remaining claimable amount that will receive some amount of boost (including max boost)","maxBoosted":"remaining claimable amount that will receive max boost"}},"registerReceiver(address,uint256)":{"details":"Once this function is called, the receiver ID is immediately eligible for votes within `IncentiveVoting`","params":{"count":"Number of IDs to assign to the receiver","receiver":"Address of the receiver"}},"setBoostDelegationParams(bool,uint256,address)":{"params":{"callback":"Optional contract address to receive a callback each time a claim is made which delegates to the caller's boost.","feePct":"Fee % charged when claims are made that delegate to the caller's boost. Given as a whole number out of 10000. If set to type(uint16).max, the fee is set by calling `IBoostDelegate(callback).getFeePct` prior to each claim.","isEnabled":"is boost delegation enabled?"}},"setEmissionSchedule(address)":{"details":"Callable only by the owner (the DAO admin voter, to change the emission schedule). The new schedule is applied from the start of the next epoch."},"setReceiverIsActive(uint256,bool)":{"details":"Emissions directed to an inactive receiver are instead returned to the unallocated supply. This way potential emissions are not lost due to old emissions votes pointing at a receiver that was phased out.","params":{"id":"ID of the receiver to modify the isActive status for","isActive":"is this receiver eligible to receive emissions?"}},"transferAllocatedTokens(address,address,uint256)":{"details":"Callable only by registered receiver contracts which were previously allocated tokens using `allocateNewEmissions`.","params":{"amount":"Desired amount of tokens to transfer. This value always assumes max boost.","claimant":"Address that is claiming the tokens","receiver":"Address to transfer tokens to"},"returns":{"_0":"bool success"}}},"title":"Pri