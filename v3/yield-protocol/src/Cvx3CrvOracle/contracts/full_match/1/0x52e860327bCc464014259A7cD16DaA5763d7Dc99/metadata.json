","type":"function"},{"inputs":[],"name":"threecrv","outputs":[{"internalType":"contract ICurvePool","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"details":"Both peek() (view) and get() (transactional) are provided for convenience","kind":"dev","methods":{"get(bytes32,bytes32,uint256)":{"details":"Only cvx3crvid and ethId are accepted as asset identifiers.","params":{"base":"Id of base token","baseAmount":"Amount of base token for which to get a quote","quote":"Id of quoted token"},"returns":{"quoteAmount":"Total amount in terms of quoted token","updateTime":"Time quote was last updated"}},"getRoleAdmin(bytes4)":{"details":"Returns the admin role that controls `role`. See {grantRole} and {revokeRole}. To change a role's admin, use {_setRoleAdmin}."},"grantRole(bytes4,address)":{"details":"Grants `role` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - the caller must have ``role``'s admin role."},"grantRoles(bytes4[],address)":{"details":"Grants all of `role` in `roles` to `account`. If `account` had not been already granted `role`, emits a {RoleGranted} event. Requirements: - For each `role` in `roles`, the caller must have ``role``'s admin role."},"hasRole(bytes4,address)":{"details":"Returns `true` if `account` has been granted `role`."},"lockRole(bytes4)":{"details":"Sets LOCK as ``role``'s admin role. LOCK has no members, so this disables admin management of ``role``. Emits a {RoleAdminChanged} event. Requirements: - the caller must have ``role``'s admin role."},"peek(bytes32,bytes32,uint256)":{"details":"Only cvx3crvid and ethId are accepted as asset identifiers.","params":{"base":"Id of base token","baseAmount":"Amount of base token for which to get a quote","quote":"Id of quoted token"},"returns":{"quoteAmount":"Total amount in terms of quoted token","updateTime":"Time quote was last updated"}},"renounceRole(bytes4,address)":{"details":"Revokes `role` from the c