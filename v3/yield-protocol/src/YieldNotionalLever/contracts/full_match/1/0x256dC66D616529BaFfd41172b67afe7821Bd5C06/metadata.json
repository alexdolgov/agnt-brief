ction"},{"inputs":[],"name":"giver","outputs":[{"internalType":"contract Giver","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bytes6","name":"","type":"bytes6"}],"name":"ilkInfo","outputs":[{"internalType":"contract FlashJoin","name":"join","type":"address"},{"internalType":"uint40","name":"maturity","type":"uint40"},{"internalType":"uint16","name":"currencyId","type":"uint16"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bytes6","name":"seriesId","type":"bytes6"},{"internalType":"bytes6","name":"ilkId","type":"bytes6"},{"internalType":"uint256","name":"baseAmount","type":"uint256"},{"internalType":"uint256","name":"borrowAmount","type":"uint256"}],"name":"invest","outputs":[{"internalType":"bytes12","name":"vaultId","type":"bytes12"}],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"ladle","outputs":[{"internalType":"contract ILadle","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"address","name":"","type":"address"},{"internalType":"uint256[]","name":"","type":"uint256[]"},{"internalType":"uint256[]","name":"","type":"uint256[]"},{"internalType":"bytes","name":"","type":"bytes"}],"name":"onERC1155BatchReceived","outputs":[{"internalType":"bytes4","name":"","type":"bytes4"}],"stateMutability":"pure","type":"function"},{"inputs":[{"internalType":"address","name":"","type":"address"},{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"bytes","name":"","type":"bytes"}],"name":"onERC1155Received","outputs":[{"internalType":"bytes4","name":"","type":"bytes4"}],"stateMutability":"pure","type":"function"},{"inputs":[{"internalType":"address","name":"initiator","type":"address"},{"internalType":"address","name":"token","type":"address"},{"internalType":"uint256","name":"borrowAmount","type":"uint256"},{"internalType":"uint256","name":"fee","type":"uint256"},{"internalType":"bytes","name":"data","type":"bytes"}],"name":"onFlashLoan","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"weth","outputs":[{"internalType":"contract IWETH9","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"author":"iamsahu","kind":"dev","methods":{"divest(bytes12,bytes6,bytes6,uint256,uint256,uint256)":{"details":"It is more gas efficient to let the user supply the `seriesId`,     but it should match the pool.","params":{"art":"The debt to repay.","ilkId":"Id of the Ilk","ink":"The amount of collateral to recover.","minOut":"The minimum amount of token to get out of the contract.","seriesId":"The seriesId corresponding to the vault.","vaultId":"The vault to use."}},"invest(bytes6,bytes6,uint256,uint256)":{"params":{"baseAmount":"The amount of own liquidity to supply.","borrowAmount":"The amount of additional liquidity to borrow.","seriesId":"The series to create the vault for."}},"onERC1155BatchReceived(address,address,uint256[],uint256[],bytes)":{"details":"Called by the sender after a batch transfer to verify it was received. Ensures only `id` tokens are received."},"onERC1155Received(address,address,uint256,uint256,bytes)":{"details":"Called by the sender after a transfer to verify it was received. Ensures only `id` tokens are received."},"onFlashLoan(address,address,uint256,uint256,bytes)":{"params":{"borrowAmount":"The amount of fyTokens received.","data":"The data we encoded for the functions. Here, we only check     the first byte for the router.","fee":"The fee that is subtracted in addition to the borrowed     amount when repaying.","initiator":"The initator of the flash loan, must be `address(this)`."}}},"title":"A contract to help users build levered position on notional","version":1},"userdoc":{"kind":"user","methods":{"FLASH_LOAN_RETURN()":{"notice":"By IERC3156, the flash loan should return this constant."},"cauldron()":{"notice":"The Yield Cauldron, handles debt and collateral balances."},"divest(bytes12,bytes6,bytes6,uint256,uint256,uint256)":{"notice":"Unwind a position.     If pre maturity, borrow liquidity tokens to repay `art` debt and     take `ink` collateral. Here are the steps:     1. Flash loan debt amount of fyToken     2. Repay the debt to get collateral (fCash)     3. Use fCash to get the underlying(USDC/DAI/ETH) in return from Notional         3.1 In case of ETH convert it into WETH     4. Use the received underlying to buyFYToken equivalent to the amount which was flash loaned     If post maturity, borrow USDC/DAI/WETH to pay off the debt directly. Here are the steps     1. Flash loan amount of USDC/DAI/WETH equivalent to the debt     2. Pay the debt to get collateral in return which is used to payback the flash loan     This function will take the vault from you using `Giver`, so make     sure you have given it permission to do that."},"giver()":{"notice":"The Giver contract can give vaults on behalf on a user who gave     permission."},"ilkInfo(bytes6)":{"notice":"stores the information of the enabled ilks on the lever"},"invest(bytes6,bytes6,uint256,uint256)":{"notice":"Invest by creating a levered vault.         Here are the steps for USDC/DAI:         1. Transfer `baseAmount` of USDC/DAI from the user         2. Flashloan `borrowAmount` of USDC/DAI from the join         3. Deposit USDC/DAI into notional market to get relevant fCash         4. Pour the received fCash to borrow fyToken         5. Buy base using the borrowed fyToken to pay back the flash loan         Here are the steps for ETH:         1. Flashloan `borrowAmount` of WETH from the join         2. Withdraw WETH to get ETH         3. Deposit ETH into notional market to get relevant fCash         4. Pour the received fCash to borrow fyToken         5. Buy base using the borrowed fyToken to pay back the flash loan"},"ladle()":{"notice":"The Yield Ladle, the primary entry point for most high-level     operations."},"onFlashLoan(address,address,uint256,uint256,bytes)":{"notice":"Called by a flash lender, which can be `usdcJoin` or     `daiJoin` or 'fyToken`. The primary purpose is to check conditions     and route to the correct internal function.     This function reverts if not called through a flashloan initiated     by this contract."},"weth()":{"notice":"WEth."}},"notice":"Each external function has the details on how this works","version":1}},"settings":{"compilationTarget":{"@yield-protocol/yvarb/contracts/YieldNotionalLever.sol":"YieldNotionalLever"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100},"remappings":[]},"sources":{"@yield-protocol/utils-v2/contracts/access/AccessControl.sol":{"keccak256":"0x9705ad36cf0cdac10e2e91ce1bde3a1eb5023191a42e41a0d3bdf9909cf2ee7e","license":"MIT","urls":["bzz-raw://ed6f4d2c3ceee43473b83a73165a37ed8bf0bd1c7a2cd330151792b6a57d680f","dweb:/ipfs/QmX5ZCSsTbtkKDB63oigEnfL5wn4jP6nKwM94g4bGHP3Qc"]},"@yield-protocol/utils-v2/contracts/cast/CastI128U128.sol":{"keccak256":"0x46814b9953e397dba1f7d8484205af3da9e50eb40b479aaf0c3ffe2c4e444cdd","license":"BUSL-1.1","urls":["bzz-raw://21100bf37d3003bc958d8a749a380112ed787c92e154a409310bd2157771f600","dweb:/ipfs/QmXNpHGQt3sXW3WtbTcyNYgRwJXBQkKbo1muRvU5DecLf6"]},"@yield-protocol/utils-v2/contracts/cast/CastU128I128.sol":{"keccak256":"0x977db849cc99cb1beabea9bcbfd271c83e31517c57aed95f6afdf0edd36c3413","license":"BUSL-1.1","urls":["bzz-raw://0ba0271af6fa54587679473866af03cdda7496068b46faed2cb125735714a326","dweb:/ipfs/QmQCYf56sMqn3tmHugsSJ1rr92L2vcgfz5yCAww6XeDz68"]},"@yield-protocol/utils-v2/contracts/cast/CastU256I256.sol":{"keccak256":"0x6721a2ab77e8c2bf7aa07df0051c8c2a6708adf17180be9ffffb99a95dcbbdb5","license":"BUSL-1.1","urls":["bzz-raw://fb229e3ec4fe41c