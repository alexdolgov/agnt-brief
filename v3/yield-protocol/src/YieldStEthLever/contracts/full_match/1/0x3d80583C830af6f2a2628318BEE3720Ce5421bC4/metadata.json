ion"},{"inputs":[],"name":"giver","outputs":[{"internalType":"contract Giver","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"ilkId","outputs":[{"internalType":"bytes6","name":"","type":"bytes6"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bytes6","name":"seriesId","type":"bytes6"},{"internalType":"uint256","name":"baseAmount","type":"uint256"},{"internalType":"uint256","name":"borrowAmount","type":"uint256"},{"internalType":"uint256","name":"minCollateral","type":"uint256"}],"name":"invest","outputs":[{"internalType":"bytes12","name":"vaultId","type":"bytes12"}],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"ladle","outputs":[{"internalType":"contract ILadle","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"initiator","type":"address"},{"internalType":"address","name":"","type":"address"},{"internalType":"uint256","name":"borrowAmount","type":"uint256"},{"internalType":"uint256","name":"fee","type":"uint256"},{"internalType":"bytes","name":"data","type":"bytes"}],"name":"onFlashLoan","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"stableSwap","outputs":[{"internalType":"contract IStableSwap","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"steth","outputs":[{"internalType":"contract IERC20","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"weth","outputs":[{"internalType":"contract IWETH9","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"wethJoin","outputs":[{"internalType":"contract FlashJoin","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"wsteth","outputs":[{"internalType":"contract WstEth","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"wstethJoin","outputs":[{"internalType":"contract FlashJoin","name":"","type":"address"}],"stateMutability":"view","type":"function"}],"devdoc":{"kind":"dev","methods":{"constructor":{"details":"The contract should never own anything in between transactions;     no tokens, no vaults. To save gas we give these tokens full     approval.","params":{"giver_":"The `Giver` contract to use."}},"divest(bytes12,bytes6,uint256,uint256,uint256)":{"details":"It is more gas efficient to let the user supply the `seriesId`,     but it should match the pool.","params":{"art":"The debt to repay.","ink":"The amount of collateral to recover.","minWeth":"Revert the transaction if we don't obtain at least this     much WEth at the end of the operation.","seriesId":"The seriesId corresponding to the vault.","vaultId":"The vault to use."}},"invest(bytes6,uint256,uint256,uint256)":{"params":{"borrowAmount":"The amount of additional liquidity to borrow.","minCollateral":"The minimum amount of collateral to end up with in     the vault. If this requirement is not satisfied, the transaction     will revert.","seriesId":"The series to create the vault for."}},"onFlashLoan(address,address,uint256,uint256,bytes)":{"params":{"borrowAmount":"The amount of fyTokens received.","data":"The data we encoded for the functions. Here, we only check     the first byte for the router.","fee":"The fee that is subtracted in addition to the borrowed     amount when repaying.","initiator":"The initator of the flash loan, must be `address(this)`."}}},"version":1},"userdoc":{"kind":"user","methods":{"FLASH_LOAN_RETURN()":{"notice":"By IERC3156, the flash loan should return this constant."},"cauldron()":{"notice":"The Yield Cauldron, handles debt and collateral balances."},"constructor":{"notice":"Deploy this contract."},"divest(bytes12,bytes6,uint256,uint256,uint256)":{"notice":"Divest a position.     If pre maturity, borrow liquidity tokens to repay `art` debt and     take `ink` collateral. Repay the loan and return remaining     collateral as WEth.     If post maturity, borrow WEth to pay off the debt directly. Convert     the WStEth collateral to WEth and return excess to user.     This function will take the vault from you using `Giver`, so make     sure you have given it permission to do that."},"giver()":{"notice":"The Giver contract can give vaults on behalf on a user who gave     permission."},"ilkId()":{"notice":"The ild ID for WStEth."},"invest(bytes6,uint256,uint256,uint256)":{"notice":"Invest by creating a levered vault.     We invest `FYToken`. For this the user should have given approval     first. We borrow `borrowAmount` extra. We use it to buy Weth,     exchange it to (W)StEth, which we use as collateral. The contract     tests that at least `minCollateral` is attained in order to prevent     sandwich attacks."},"ladle()":{"notice":"The Yield Ladle, the primary entry point for most high-level     operations."},"onFlashLoan(address,address,uint256,uint256,bytes)":{"notice":"Called by a flash lender, which can be `wstethJoin` or     `wethJoin` (for Weth). The primary purpose is to check conditions     and route to the correct internal function.     This function reverts if not called through a flashloan initiated     by this contract."},"stableSwap()":{"notice":"Curve.fi token swapping contract between Ether and StETH."},"steth()":{"notice":"StEth, represents Ether stakes on Lido."},"weth()":{"notice":"WEth."},"wethJoin()":{"notice":"The Yield Protocol Join containing Weth."},"wsteth()":{"notice":"WStEth, wrapped StEth, useful because StEth rebalances."},"wstethJoin()":{"notice":"The Yield Protocol Join containing WstEth."}},"notice":"This contracts allows a user to 'lever up' via StEth. The concept     is as follows: Using Yield, it is possible to borrow Weth, which in     turn can be used as collateral, which in turn can be used to borrow and     so on.     The way to do this in practice is by first borrowing the desired debt     through a flash loan and using this in additon to your own collateral.     The flash loan is repayed using funds borrowed using your collateral.","version":1}},"settings":{"compilationTarget":{"@yield-protocol/yvarb/contracts/YieldStEthLever.sol":"YieldStEthLever"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100},"remappings":[]},"sources":{"@yield-protocol/utils-v2/contracts/access/AccessControl.sol":{"keccak256":"0x9705ad36cf0cdac10e2e91ce1bde3a1eb5023191a42e41a0d3bdf9909cf2ee7e","license":"MIT","urls":["bzz-raw://ed6f4d2c3ceee43473b83a73165a37ed8bf0bd1c7a2cd330151792b6a57d680f","dweb:/ipfs/QmX5ZCSsTbtkKDB63oigEnfL5wn4jP6nKwM94g4bGHP3Qc"]},"@yield-protocol/utils-v2/contracts/cast/CastU128I128.sol":{"keccak256":"0x977db849cc99cb1beabea9bcbfd271c83e31517c57aed95f6afdf0edd36c3413","license":"BUSL-1.1","urls":["bzz-raw://0ba0271af6fa54587679473866af03cdda7496068b46faed2cb125735714a326","dweb:/ipfs/QmQCYf56sMqn3tmHugsSJ1rr92L2vcgfz5yCAww6XeDz68"]},"@yield-protocol/utils-v2/contracts/cast/CastU256U128.sol":{"keccak256":"0x97bfabb12f64e6e710ddf6baa55b2ba05136dbac1d50e59e805d48d3bcae8e50","license":"BUSL-1.1","urls":["bzz-raw://8420cffefc4522b046b64d2f01ab92a78048e08183452e2a0ed17db3e9c16e9b","dweb:/ipfs/QmSdg6Z6SyXhXQSfDFUGUgnLgqjiyD2NAt7UvUqoE83qen"]},"@yield-protocol/utils-v2/contracts/interfaces/IWETH9.sol":{"keccak256":"0xe936c36facaa42d834d665749a5cb6165a0b9372003c02f580d858c2e51e7c9a","license":"MIT","urls":["bzz-raw://1ead78fc49f92458a9c0514abf914da6df2d10578019d18e03fd51eb780ad324","dweb:/ipfs/QmYYyGujCjh94KhkG1PHkSWQR2pnqqkH1wMC3jW9Mnmfv3"]},"@yield-protocol/utils-v2/contracts/math/WMul.sol":{"keccak256":"0xaacd19261e6d614dc11af925e3525b782b49ec3c1ee63ce3f1ff5b0e06f92a57","license":"BUSL-1.1","urls":["bzz-raw://d8fdb23e828863338316505180c4e49a0acbac99dad992821a5875710c575141","dweb:/ipfs/QmSeaBkGL3J8DDX57KnQtWyLsCMvyWrjdnce6keK6iHnSd"]},"@yield-protocol/utils-v2/contracts/token/ER