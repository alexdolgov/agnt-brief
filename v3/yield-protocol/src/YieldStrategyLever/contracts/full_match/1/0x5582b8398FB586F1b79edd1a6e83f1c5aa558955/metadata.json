 either before or after maturity."},"giver()":{"notice":"The Giver contract can give vaults on behalf on a user who gave     permission."},"invest(uint8,bytes6,bytes6,uint256,uint256,uint256,uint256)":{"notice":"Invest by creating a levered vault. The basic structure is     always the same. We borrow FyToken for the series and convert it to     the yield-bearing token that is used as collateral."},"onFlashLoan(address,address,uint256,uint256,bytes)":{"notice":"Called by a flash lender. The primary purpose is to check     conditions and route to the correct internal function.     This function reverts if not called through a flashloan initiated     by this contract."}},"notice":"For leveringup we could flash borrow base instead of fyToken as well","version":1}},"settings":{"compilationTarget":{"@yield-protocol/yvarb/contracts/YieldStrategyLever.sol":"YieldStrategyLever"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":100},"remappings":[]},"sources":{"@yield-protocol/utils-v2/contracts/access/AccessControl.sol":{"keccak256":"0x9705ad36cf0cdac10e2e91ce1bde3a1eb5023191a42e41a0d3bdf9909cf2ee7e","license":"MIT","urls":["bzz-raw://ed6f4d2c3ceee43473b83a73165a37ed8bf0bd1c7a2cd330151792b6a57d680f","dweb:/ipfs/QmX5ZCSsTbtkKDB63oigEnfL5wn4jP6nKwM94g4bGHP3Qc"]},"@yield-protocol/utils-v2/contracts/cast/CastU128I128.sol":{"keccak256":"0x977db849cc99cb1beabea9bcbfd271c83e31517c57aed95f6afdf0edd36c3413","license":"BUSL-1.1","urls":["bzz-raw://0ba0271af6fa54587679473866af03cdda7496068b46faed2cb125735714a326","dweb:/ipfs/QmQCYf56sMqn3tmHugsSJ1rr92L2vcgfz5yCAww6XeDz68"]},"@yield-protocol/utils-v2/contracts/cast/CastU256U128.sol":{"keccak256":"0x97bfabb12f64e6e710ddf6baa55b2ba05136dbac1d50e59e805d48d3bcae8e50","license":"BUSL-1.1","urls":["bzz-raw://8420cffefc4522b046b64d2f01ab92a78048e08183452e2a0ed17db3e9c16e9b","dweb:/ipfs/QmSdg6Z6SyXhXQSfDFUGUgnLgqjiyD2NAt7UvUqoE83qen"]},"@yield-protocol/utils-v2/contracts/token/ERC20.sol"