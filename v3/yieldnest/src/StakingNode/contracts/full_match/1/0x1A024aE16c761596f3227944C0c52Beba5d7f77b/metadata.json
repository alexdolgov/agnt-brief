ype":"function"},{"inputs":[],"name":"getUnverifiedStakedETH","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getWithdrawnETH","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"implementation","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"components":[{"internalType":"contract IStakingNodesManager","name":"stakingNodesManager","type":"address"},{"internalType":"uint256","name":"nodeId","type":"uint256"}],"internalType":"struct IStakingNode.Init","name":"init","type":"tuple"}],"name":"initialize","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"initialUnverifiedStakedETH","type":"uint256"}],"name":"initializeV2","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"nodeId","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"sharesAmount","type":"uint256"}],"name":"queueWithdrawals","outputs":[{"internalType":"bytes32[]","name":"fullWithdrawalRoots","type":"bytes32[]"}],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"queuedSharesAmount","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"stakingNodesManager","outputs":[{"internalType":"contract IStakingNodesManager","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"bool","name":"revertIfNoBalance","type":"bool"}],"name":"startCheckpoint","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"undelegate","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"unverifiedStakedETH","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint64","name":"beaconTimestamp","type":"uint64"},{"components":[{"internalType":"bytes32","name":"beaconStateRoot","type":"bytes32"},{"internalType":"bytes","name":"proof","type":"bytes"}],"internalType":"struct BeaconChainProofs.StateRootProof","name":"stateRootProof","type":"tuple"},{"internalType":"uint40[]","name":"validatorIndices","type":"uint40[]"},{"internalType":"bytes[]","name":"validatorFieldsProofs","type":"bytes[]"},{"internalType":"bytes32[][]","name":"validatorFields","type":"bytes32[][]"}],"name":"verifyWithdrawalCredentials","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"withdrawnETH","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"stateMutability":"payable","type":"receive"}],"devdoc":{"details":"Implements staking node functionality for the YieldNest protocol, enabling ETH staking, delegation, and rewards management. Each StakingNode owns exactl one EigenPod which acts as a delegation unit, as it can be associated with exactly one operator.","errors":{"InvalidInitialization()":[{"details":"The contract is already initialized."}],"NotInitializing()":[{"details":"The contract is not initializing."}],"ReentrancyGuardReentrantCall()":[{"details":"Unauthorized reentrant call."}]},"events":{"Initialized(uint64)":{"details":"Triggered when the contract has been initialized or reinitialized."}},"kind":"dev","methods":{"allocateStakedETH(uint256)":{"details":"Record total staked ETH for this StakingNode"},"completeQueuedWithdrawals((address,address,address,uint256,uint32,address[],uint256[])[],uint256[])":{"details":"Triggers the completion of particular queued withdrawals.      Withdrawals can only be completed if      max(delegationManager.minWithdrawalDelayBlocks(), delegationManager.strategyWithdrawalDelayBlocks(beaconChainETHStrategy))      number of blocks have passed since withdrawal was queued.","params":{"middlewareTimesIndexes":"The middlewareTimesIndex parameter has to do       with the Slasher, which currently does nothing. As of M2, this parameter       has no bearing on anything and can be ignored","withdrawals":"The Withdrawals to complete. This withdrawalRoot (keccak hash of the Withdrawal) must match the                     the withdrawal created as part of the queueWithdrawals call."}},"createEigenPod()":{"details":"If it does not exist, it proceeds to create a new EigenPod via EigenPodManager","returns":{"_0":"The address of the EigenPod associated with this StakingNode."}},"deallocateStakedETH(uint256)":{"details":"This function can only be called by the StakingNodesManager. It emits a DeallocatedStakedETH      event upon successful deallocation.","params":{"amount":"The amount of ETH to deallocate and transfer."}},"delegate(address,(bytes,uint256),bytes32)":{"details":"Delegates the staking node's authority to an operator using a signature with expiry.","params":{"approverSalt":"The unique salt used to prevent replay attacks.","approverSignatureAndExpiry":"The signature of the approver along with its expiry details.","operator":"The address of the operator to whom the delegation is made."}},"getQueuedSharesAmount()":{"returns":{"_0":"The amount of queued shares."}},"getUnverifiedStakedETH()":{"returns":{"_0":"The amount of unverified staked ETH in wei."}},"getWithdrawnETH()":{"returns":{"_0":"The amount of withdrawn ETH."}},"queueWithdrawals(uint256)":{"details":"Queues a validator Principal withdrawal for processing. DelegationManager calls EigenPodManager.decreasesShares which decreases the `podOwner`'s shares by `shares`, down to a minimum of zero.","params":{"sharesAmount":"The amount of shares to be queued for withdrawals."},"returns":{"fullWithdrawalRoots":"An array of keccak256 hashes of each withdrawal created."}},"startCheckpoint(bool)":{"details":"Create a checkpoint used to prove the pod's active validator set. This function can only be called by the Operator.","params":{"revertIfNoBalance":"Forces a revert if the pod ETH balance is 0."}},"undelegate()":{"details":"This function revokes the delegation by calling the `undelegate` method on the `DelegationManager`. It emits an `Undelegated` event with the address of the operator from whom the delegation is being removed."},"verifyWithdrawalCredentials(uint64,(bytes32,bytes),uint40[],bytes[],bytes32[][])":{"details":"Validates the withdrawal credentials for a withdrawal. This activates the staked funds within EigenLayer as shares. verifyWithdrawalCredentials MUST be called for all validators BEFORE they are exited from the beacon chain to keep the getETHBalance return value consistent. If a validator is exited without this call, TVL is double counted for its principal.","params":{"beaconTimestamp":"The timestamp of the oracle that signed the block.","stateRootProof":"The state root proof.","validatorFields":"The validator fields.","validatorFieldsProofs":"The validator fields proofs.","validatorIndices":"The indices of the validators."}}},"stateVariables":{"_unused_former_allocatedETH":{"details":"Monitors the ETH balance that was committed to validators allocated to this StakingNode "},"queuedSharesAmount":{"details":"Amount of shares queued for withdrawal (no longer active in staking). 1 share == 1 ETH. Increases when calling queueWithdrawals, and decreases when calling completeQueuedWithdrawals."},"unverifiedStakedETH":{"details":"Accounts for ETH staked with validators whose withdrawal address is this Node's eigenPod. that is not yet verified with verifyWithdrawalCredentials. Increases when calling allocateETH, and decreases when verifying with verifyWithdrawalCredentials"},"withdrawnETH":{"details":"Accounts for withdrawn ETH balance that can be withdrawn by the StakingNodesManager contract This is made up of both validator principal, rewards and arbitrary ETH sent to the Eigenpod that are withdrawn from Eigenlayer."}},"title":"StakingNode","version":1},"userdoc":{"kind":"user","methods":{"beaconChainETHStrategy()":{"notice":"Returns the beaconChainETHStrategy address used by the StakingNode."},"createEigenPod()":{"notice":"Creates an EigenPod if it does not already exist for this StakingNode."},"deallocateStakedETH(uint256)":{"notice":"Deallocates a specified amount of staked ETH from the withdrawn validator principal          and transfers it to the StakingNodesManager."},"delegate(address,(bytes,uint256),bytes32)":{"notice":"Delegates authority to an operator."},"getInitializedVersion()":{"notice":"Retrieve the version number of the highest/newest initialize         function that was executed."},"getQueuedSharesAmount()":{"notice":"Retrieves the amount of shares currently queued for withdrawal."},"getUnverifiedStakedETH()":{"notice":"Retrieves the amount of unverified staked ETH held by this StakingNode."},"getWithdrawnETH()":{"notice":"Retrieves the amount of ETH that has been withdrawn from Eigenlayer and is held by this StakingNode. Composed of validator principal, validator staking rewards and arbitrary ETH sent to the Eigenpod."},"implementation()":{"notice":"Beacons slot value is defined here: https://github.com/OpenZeppelin/openzeppelin-contracts/blob/afb20119b33072da041c97ea717d3ce4417b5e01/contracts/proxy/ERC1967/ERC1967Upgrade.sol#L142"},"undelegate()":{"notice":"Undelegates the authority previously delegated to an operator."}},"version":1}},"settings":{"compilationTarget":{"src/StakingNode.sol":"StakingNode"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":200},"remappings":[":@eigenlayer/=lib/eigenlayer-contracts/",":@openzeppelin-upgrades-v4.9.0/=lib/eigenlayer-contracts/lib/openzeppelin-contracts-upgradeable-v4.9.0/",":@openzeppelin-upgrades/=lib/eigenlayer-contracts/lib/openzeppelin-contracts-upgradeable/",":@openzeppelin-v4.9.0/=lib/eigenlayer-contrac