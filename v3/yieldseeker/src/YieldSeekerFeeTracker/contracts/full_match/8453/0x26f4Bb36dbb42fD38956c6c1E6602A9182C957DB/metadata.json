mits a {RoleRevoked} event. Requirements: - the caller must have ``role``'s admin role. May emit a {RoleRevoked} event."},"supportsInterface(bytes4)":{"details":"Returns true if this contract implements the interface defined by `interfaceId`. See the corresponding https://eips.ethereum.org/EIPS/eip-165#how-interfaces-are-identified[ERC section] to learn more about how these ids are created. This function call must use less than 30 000 gas."}},"title":"YieldSeekerFeeTracker","version":1},"userdoc":{"errors":{"ZeroAddress()":[{"notice":"Thrown when a zero address is provided where not allowed"}]},"kind":"user","methods":{"getAgentVaultPosition(address,address)":{"notice":"Get vault position for a wallet"},"getAgentYieldTokenFeesOwed(address,address)":{"notice":"Get yield token fees owed for a wallet"},"getFeesOwed(address)":{"notice":"Get the amount of fees owed by a wallet"},"getWalletStats(address)":{"notice":"Get wallet fee statistics"},"recordAgentTokenSwap(address,uint256,uint256)":{"notice":"Record a token swap to base asset and collect fees on yield tokens"},"recordAgentVaultAssetWithdraw(address,uint256,uint256,uint256)":{"notice":"Record a vault asset withdrawal and calculate yield using actual vault balance"},"recordAgentVaultShareDeposit(address,uint256,uint256)":{"notice":"Record a vault share deposit for cost-basis tracking"},"recordAgentVaultShareWithdraw(address,uint256,uint256)":{"notice":"Record a vault share withdrawal and calculate yield"},"recordAgentYieldEarned(uint256)":{"notice":"Record yield earned in base asset"},"recordAgentYieldTokenEarned(address,uint256)":{"notice":"Record yield earned in a non-base asset token and calculate fees owed"},"recordFeePaid(uint256)":{"notice":"Record a fee payment"}},"notice":"Tracks fees for YieldSeeker wallets","version":1}},"settings":{"compilationTarget":{"src/FeeTracker.sol":"YieldSeekerFeeTracker"},"evmVersion":"cancun","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":2