hain","reason":"bytes with the revert information"}},"MessageReceived(address,uint256,bool,uint8,bytes,bytes)":{"params":{"delivered":"flag indicating if message has been delivered","message":"bytes containing the necessary information of a user vote","messageType":"type of the received message","originChainId":"id of the chain where the message originated","originSender":"address that sent the message on the origin chain","reason":"bytes with the revert information"}},"ProposalResultsSent(uint256,uint256,uint256)":{"params":{"againstVotes":"votes cast against the proposal","forVotes":"votes cast in favor of proposal","proposalId":"numeric id of the proposal which results are sent to L1"}},"ProposalVoteConfigurationBridged(uint256,bytes32,uint24,bool)":{"details":"the vote will only be created automatically if when the configuration is bridged, all necessary roots have been registered already.","params":{"blockHash":"hash of the block on L1 when the proposal was activated for voting","proposalId":"id of the proposal bridged to start the vote on","voteCreated":"boolean indicating if the vote has been created or not.","votingDuration":"duration in seconds of the vote"}},"ProposalVoteStarted(uint256,bytes32,uint256,uint256)":{"params":{"endTime":"timestamp of when the voting period ends. (startTime + votingDuration)","l1BlockHash":"block hash from the block on l1 from when the proposal was activated for voting","proposalId":"numeric id of the created proposal","startTime":"timestamp when the proposal was created and ready for voting"}},"VoteEmitted(uint256,address,bool,uint256)":{"params":{"proposalId":"Id of the proposal","support":"boolean, true = vote for, false = vote against","voter":"address of the voter","votingPower":"Power of the voter/vote"}}},"kind":"dev","methods":{"DOMAIN_SEPARATOR()":{"details":"Return cached value if chainId matches cache, otherwise recomputes separator","returns":{"_0":"The domain separator of the token at current chain"}},"closeAndSendVote(uint256)":{"details":"This method will trigger the bridging flow","params":{"proposalId":"id of the proposal to close the vote on and send the voting result to governance"}},"constructor":{"params":{"crossChainController":"address of the CrossChainController contract deployed on current chain. This contract is the one responsible to send here the voting configurations once they are bridged.","gasLimit":"max number of gas to spend on receiving chain (L1) when sending back the voting results","governance":"address of the governance contract*","l1VotingPortal":"address of the L1 Voting Portal contract that communicates with this voting machine","l1VotingPortalChainId":"id of the L1 chain where the voting portal is deployed","votingStrategy":"address of the new VotingStrategy contract"}},"decodeMessage(bytes)":{"params":{"message":"encoded message with message type"},"returns":{"_0":"messageType and governance underlying message"}},"decodeProposalMessage(bytes)":{"params":{"message":"encoded proposal message"},"returns":{"_0":"information to start a proposal vote, including proposalId, blockHash and votingDuration"}},"decodeVoteMessage(bytes)":{"params":{"message":"encoded vote message"},"returns":{"_0":"information to vote on a proposal, including proposalId, voter, support, votingTokens"}},"eip712Domain()":{"details":"See {IERC-5267}."},"getGasLimit()":{"returns":{"_0":"gasLimit the new gas limit"}},"getProposalById(uint256)":{"params":{"proposalId":"id of the proposal to retrieve"},"returns":{"_0":"the proposal information without the users vote"}},"getProposalState(uint256)":{"params":{"proposalId":"id of the proposal to retrieve the state of"},"returns":{"_0":"the state of the proposal"}},"getProposalVoteConfiguration(uint256)":{"params":{"proposalId":"id of the proposal to retrieve the voting configuration from"},"returns":{"_0":"the proposal vote configuration object"}},"getProposalsVoteConfigurationIds(uint256,uint256)":{"details":"This is mainly used to get a list of proposals that require automation in some step of the proposal live cycle.","params":{"size":"length of proposal ids to ask for.","skip":"number of proposal ids to skip. from latest in the list of proposal ids with voting configuration"},"returns":{"_0":"list of proposal ids"}},"getUserProposalVote(address,uint256)":{"params":{"proposalId":"id of the proposal to retrieve the vote from","user":"address of the user that voted"},"returns":{"_0":"the vote (support and voting power) emitted"}},"owner()":{"details":"Returns the address of the current owner."},"receiveCrossChainMessage(address,uint256,bytes)":{"params":{"message":"bytes bridged containing the desired information","originChainId":"id of the chain where the message originated","originSender":"address of the sender of the bridged message"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."},"startProposalVote(uint256)":{"details":"this method can be called by anyone, requiring that the appropriate conditions are met. basically that the proper roots have been registered. It can also be called internally when the bridged message is received and the the required roots have been registered","params":{"proposalId":"id of the proposal to start the vote on."},"returns":{"_0":"the id of the proposal that had the vote started on."}},"submitVote(uint256,bool,(address,uint128,bytes)[])":{"details":"A vote does not need to use all the tokens allowed, can be a subset","params":{"proposalId":"id of the proposal on which the vote will be cast","support":"boolean indicating if the vote is in favor or against the proposal","votingBalanceProofs":"list of objects containing the information necessary to vote using the tokens allowed on the voting strategy."}},"sub