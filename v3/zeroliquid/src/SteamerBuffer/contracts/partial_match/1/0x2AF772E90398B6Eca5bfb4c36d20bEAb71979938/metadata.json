ess)":{"notice":"Emitted when a steamer is updated."},"SetZeroLiquid(address)":{"notice":"Emitted when the zeroliquid is set."}},"kind":"user","methods":{"ADMIN()":{"notice":"The identifier of the role which maintains other roles."},"KEEPER()":{"notice":"The identifier of the keeper role."},"_yieldTokens(address,uint256)":{"notice":"The yieldTokens of each underlying supported by the ZeroLiquid."},"burnCredit()":{"notice":"Burns available credit againt a yield token in the zeroliquid."},"currentExchanged(address)":{"notice":"The total amount of an underlying token that has been exchanged into the steamer, and has not been claimed."},"debtToken()":{"notice":"The debt-token used by the SteamerBuffer."},"depositFunds(address,uint256)":{"notice":"Deposits local collateral into the zeroliquid"},"exchange(address)":{"notice":"Exchanges any available flow into the Steamer. This function is a way for the keeper to force funds to be exchanged into the Steamer. This function will revert if called by any account that is not a keeper. If there is not enough local balance of `underlyingToken` held by the SteamerBuffer any additional funds will be withdrawn from the ZeroLiquid by unwrapping `yieldToken`."},"flowAvailable(address)":{"notice":"The amount of flow available per ERC20."},"flowRate(address)":{"notice":"The flowRate for each address."},"flushToAmo(address,uint256)":{"notice":"Flushes funds to the amo."},"getAvailableFlow(address)":{"notice":"Gets the total available flow for the underlying token The total available flow will be the lesser of `flowAvailable[token]` and `getTotalUnderlyingBuffered`."},"getTotalCredit()":{"notice":"Gets the total credit against the yield token held by the SteamerBuffer."},"getTotalUnderlyingBuffered(address)":{"notice":"Gets the total amount of underlying token that the SteamerBuffer controls in the ZeroLiquid."},"getWeight(address,address)":{"notice":"Gets the weight of the given weight type and token"},"lastFlowrateUpdate(address)":{"not