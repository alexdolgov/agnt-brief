s specific amount(s) of ERC20(s) from locker to ZivoeDAO."},"pullPartial(address,address,uint256,bytes)":{"notice":"Pulls specific amount of ERC20 from locker to ZivoeDAO."},"push(address,address,uint256,bytes)":{"notice":"Pushes an ERC20 token from ZivoeDAO to locker."},"pushERC1155(address,address,uint256[],uint256[],bytes)":{"notice":"Pushes ERC1155 assets from ZivoeDAO to locker."},"pushERC721(address,address,uint256,bytes)":{"notice":"Pushes an NFT from ZivoeDAO to locker."},"pushMulti(address,address[],uint256[],bytes[])":{"notice":"Pushes ERC20(s) from locker to ZivoeDAO."},"pushMultiERC721(address,address[],uint256[],bytes[])":{"notice":"Pushes NFT(s) from ZivoeDAO to locker."}},"notice":"This contract escrows assets for the Zivoe protocol and is governed by TimelockController.         This contract MUST be owned by TimelockController. This ownership MUST be locked through OwnableLocked.         This contract MUST be capable of owning ERC721s & ERC1155s via ERC721Holder and ERC1155Holder.         This contract has the following responsibilities:          - Manage the asset(s) held in escrow:             - Push assets (ERC20, ERC721, ERC1155) to a locker.             - Pull assets (ERC20, ERC721, ERC1155) from a locker.          - MUST enforce a whitelist of lockers for pushing assets, MUST NOT enforce whitelist for pulling asset(s).          - MUST enforce validity of lockers when pushing or pulling through respective endpoint(s), i.e. canPush().","version":1}},"settings":{"compilationTarget":{"lib/zivoe-core-foundry/src/ZivoeDAO.sol":"ZivoeDAO"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":10},"remappings":[]},"sources":{"lib/zivoe-core-foundry/lib/openzeppelin-contracts/contracts/access/Ownable.sol":{"keccak256":"0xa94b34880e3c1b0b931662cb1c09e5dfa6662f31cba80e07c5ee71cd135c9673","license":"MIT","urls":["bzz-raw://40fb1b5102468f783961d0af743f91b9980cf66b50d1d12009f6bb1869cea4d2","dweb:/ipfs/QmYq