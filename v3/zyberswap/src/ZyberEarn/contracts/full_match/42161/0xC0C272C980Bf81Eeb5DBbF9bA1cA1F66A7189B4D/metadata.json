r."},"pendingReward(address,address)":{"params":{"_token":"The address of the token","_user":"The address of the user"},"returns":{"_0":"`_user`'s pending reward token"}},"removeRewardToken(address)":{"params":{"_rewardToken":"The address of the reward token"}},"renounceOwnership()":{"details":"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions anymore. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby removing any functionality that is only available to the owner."},"rewardTokensLength()":{"returns":{"_0":"The length of the array"}},"setDepositFeePercent(uint256)":{"params":{"_depositFeePercent":"The new deposit fee percent"}},"transferOwnership(address)":{"details":"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."},"updateReward(address)":{"details":"Needs to be called before any deposit or withdrawal","params":{"_token":"The address of the reward token"}},"userLockedUntil(address)":{"params":{"_user":"The address of the user"},"returns":{"_0":"timestamp in unix time when user can withdraw his deposited tokens"}},"withdraw(uint256)":{"params":{"_amount":"The amount of ZYB to withdraw"}}},"stateVariables":{"internalZYBBalance":{"details":"Internal balance of ZYB, this gets updated on user deposits & withdrawals this allows to reward users with WETH"},"userInfo":{"details":"Info of each user that stakes ZYB"}},"title":"ZyberEarn","version":1},"userdoc":{"events":{"ClaimReward(address,address,uint256)":{"notice":"Emitted when a user claims reward"},"Deposit(address,uint256,uint256)":{"notice":"Emitted when a user deposits ZYB"},"DepositFeeChanged(uint256,uint256)":{"notice":"Emitted when owner changes the deposit fee percentage"},"EmergencyWithdraw(address,uint256)":{"notice":"Emitted when a user emergency withdraws its ZYB"},"RewardTokenAdded(address)":{"notice":"Emitted when owner adds a token to the r